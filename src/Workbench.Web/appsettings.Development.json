{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true
  },
  "ConnectionStrings": {
    "Workbench": "Data Source=workbench.db",
    "Catalog": "Data Source=App_Data/catalog.db"
  },
  "Tenancy": {
    "BaseDomain": "localhost",
    "HostAdmins": [
      "host@workbench.local"
    ],
    "TenantConnectionString": "Data Source=App_Data/tenants/{tenant}.db",
    "DevelopmentTenants": [
      "acme",
      "beta"
    ]
  },
  "Email": {
    "Mode": "Pickup",
    "PickupFolder": "App_Data/mail"
  },
  "Support": {
    "Email": "support@workbench.local"
  },
  "Assistant": {
    "EnableFakeProvider": true
  },
  "Integrations": {
    "AllowHttp": true,
    "AllowPrivateNetworkTargets": true
  },
  "Costpoint": {
    "Source": "Csv",
    "Csv": {
      "Folder": "samples/costpoint"
    }
  },
  "Authentication": {
    "RequireInvite": false
  },
  "Billing": {
    "CompanyName": "Workbench Federal Services LLC",
    "RemitToAddress": "1200 Example Parkway, Suite 400\nReston, VA 20190",
    "Uei": "WBFEDSVC0001"
  },
  "SupplierPortal": {
    "DemoContactPassword": "portal-demo-2026"
  }
}
