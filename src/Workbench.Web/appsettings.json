{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSQL",
    "MigrateOnStartup": false
  },
  "ConnectionStrings": {
    "Workbench": "",
    "Catalog": ""
  },
  "Tenancy": {
    "Mode": "SingleTenant",
    "BaseDomain": "",
    "HostAdmins": [],
    "TenantConnectionString": ""
  },
  "Authentication": {
    "Oidc": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "Audience": "",
      "Scopes": []
    },
    "Admins": [],
    "RequireInvite": true,
    "Session": {
      "IdleTimeoutMinutes": 30,
      "AbsoluteLifetimeHours": 12,
      "CircuitRevalidationSeconds": 60
    }
  },
  "Expenses": {
    "ReceiptThreshold": 75
  },
  "PerDiem": {
    "LodgingOveragePolicy": "RequiresJustification",
    "JustifiedLodgingCapPercent": 300,
    "Gsa": {
      "BaseUrl": "https://api.gsa.gov/travel/perdiem/v2/"
    }
  },
  "Resourcing": {
    "NonBillableAllowancePercent": 10,
    "FullThresholdPercent": 90,
    "StaffingTolerancePercent": 10
  },
  "Scim": {
    "Enabled": true,
    "BearerToken": ""
  },
  "RateLimiting": {
    "Enabled": true,
    "SignInPerMinute": 20,
    "ScimPerMinute": 300,
    "ApiPerMinute": 600
  },
  "Security": {
    "TlsTerminatedByProxy": false,
    "HstsMaxAgeDays": 365
  },
  "DataProtection": {
    "Store": "Database"
  },
  "Retention": {
    "SecurityEventDays": 365,
    "NotificationDays": 180,
    "ExpiredInviteDays": 90,
    "ProtectedRecordDays": 1095,
    "RunHourUtc": 3
  },
  "OpenTelemetry": {
    "Endpoint": ""
  }
}
