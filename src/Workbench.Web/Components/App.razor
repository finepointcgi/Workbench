@inject Workbench.Web.Security.SessionSettings Session
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1F5AA6" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Workbench" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Workbench.Ui/a11y.css"]" />
    <link rel="stylesheet" href="@Assets["Workbench.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />
    @if (SessionMeta() is { } meta)
    {
        @* Read by js/session.js to warn before the idle sign-out (WCAG 2.2.1). *@
        <meta name="wb-session" data-idle-seconds="@meta.IdleSeconds" data-ends-at="@meta.EndsAt" />
    }
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <SessionGuard @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["js/session.js"]"></script>
    <script src="@Assets["js/pwa.js"]"></script>
    <script src="@Assets["_content/Workbench.Ui/a11y.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>The idle timeout, and when the session's absolute lifetime ends (Unix ms), for a signed-in user.</summary>
    private (long IdleSeconds, long? EndsAt)? SessionMeta()
    {
        var user = HttpContext?.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            return null;
        }

        var signedInAt = Workbench.Web.Security.SessionValidation.SignedInAtUtc(user);
        long? endsAt = signedInAt is { } at ? new DateTimeOffset(at + Session.AbsoluteLifetime, TimeSpan.Zero).ToUnixTimeMilliseconds() : null;
        return ((long)Session.IdleTimeout.TotalSeconds, endsAt);
    }
}
