<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1F5AA6" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Workbench" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Workbench.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <SessionGuard @rendermode="InteractiveServer" />
    <div id="blazor-error-ui" role="alert" data-nosnippet>
        <strong>Something went wrong.</strong> Workbench lost track of this page; anything you saved is safe.
        <a href="" class="reload">Reload the page</a>
        <a href="support/new?from=error" id="wb-error-report">Report this</a>
        <button type="button" class="dismiss" aria-label="Dismiss this message">×</button>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["js/session.js"]"></script>
    <script src="@Assets["js/pwa.js"]"></script>
    <script src="@Assets["js/error-ui.js"]"></script>
</body>

</html>
