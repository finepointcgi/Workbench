{
  "License": {
    "EditionOverride": "Business"
  },
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true
  },
  "ConnectionStrings": {
    "Workbench": "Data Source=/data/workbench.db"
  },
  "Tenancy": {
    "Mode": "SingleTenant"
  },
  "Scim": {
    "Enabled": false
  },
  "Security": {
    "TlsTerminatedByProxy": true
  },
  "Storage": {
    "Root": "/data/blobs"
  },
  "Email": {
    "Mode": "Pickup",
    "PickupFolder": "/data/mail"
  },
  "Support": {
    "Email": "support@workbench.local"
  },
  "Assistant": {
    "EnableFakeProvider": true
  },
  "Costpoint": {
    "Source": "Csv",
    "Csv": {
      "Folder": "/app/samples/costpoint"
    }
  },
  "Billing": {
    "CompanyName": "Workbench Federal Services LLC",
    "RemitToAddress": "1200 Example Parkway, Suite 400\nReston, VA 20190",
    "Uei": "WBFEDSVC0001"
  },
  "Demo": {
    "NightlyReset": true,
    "ResetHourUtc": 8
  }
}
