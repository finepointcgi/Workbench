<PortalLayout View="View" Title="Account">
    <dl class="facts">
        <div><dt>Name</dt><dd>@View.Session!.ContactName</dd></div>
        <div><dt>Email</dt><dd>@View.Session.Email</dd></div>
        <div><dt>Company</dt><dd>@View.Session.VendorName</dd></div>
    </dl>
    <form method="post" action="/supplier/account/password" class="card narrow" aria-labelledby="pw-h">
        <Antiforgery Token="View.Token" />
        <h2 id="pw-h">@(View.Session.HasPassword ? "Change your password" : "Set a password")</h2>
        <p class="hint">Optional: you can always sign in with an emailed link instead. Use at least 12 characters. Changing it signs you out everywhere else.</p>
        @if (View.Session.HasPassword)
        {
            <label for="current">Current password</label>
            <input id="current" name="currentPassword" type="password" autocomplete="current-password" required />
        }
        <label for="new">New password</label>
        <input id="new" name="newPassword" type="password" autocomplete="new-password" minlength="12" required />
        <button type="submit" class="primary">Save password</button>
    </form>
</PortalLayout>

@code {
    [Parameter, EditorRequired] public PortalView View { get; set; } = default!;
}
