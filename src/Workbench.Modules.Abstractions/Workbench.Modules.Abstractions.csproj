<Project Sdk="Microsoft.NET.Sdk">

  <!-- The contract between Workbench and a license module that lives outside this repository. A private module repo references this
       assembly (and Workbench.Contracts) and nothing else of the host's wiring. See docs/operations/module-plugins.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <ProjectReference Include="..\Workbench.Contracts\Workbench.Contracts.csproj" />
  </ItemGroup>

</Project>
