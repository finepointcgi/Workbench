<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Workbench.Domain\Workbench.Domain.csproj" />
    <ProjectReference Include="..\Workbench.Contracts\Workbench.Contracts.csproj" />
    <ProjectReference Include="..\Workbench.Costpoint\Workbench.Costpoint.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Data Protection encrypts vendor TINs (purchasing). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests drive SystemExecution.CreateScope, which is internal so only this assembly's hosted services can use it. -->
    <InternalsVisibleTo Include="Workbench.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <!-- Imports: reads .xlsx exports (Costpoint reports, Smartsheet sheets) incl. outline levels and indentation. MIT. -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <!-- Receipts: reads the text layer of receipt and hotel folio PDFs to suggest expense line values. Apache-2.0. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <!-- Per diem: the shipped sample CONUS rates, for "Load sample rates" and the development seed. -->
    <EmbeddedResource Include="..\..\samples\perdiem\gsa-conus-sample.csv" LogicalName="Workbench.Application.PerDiem.gsa-conus-sample.csv" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
