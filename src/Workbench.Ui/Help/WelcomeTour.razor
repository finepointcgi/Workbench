@* The first sign-in welcome tour for the user's role: a small card that steps through where things are and points at
   each one. Finishing or skipping it is remembered on the server (IHelpStateService), so it shows once per person,
   on any device. Escape skips it. *@
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@using Workbench.Contracts.Support
@implements IAsyncDisposable
@inject IServiceProvider Services
@inject IJSRuntime JS
@inject NavigationManager Navigation

@if (_tour is { } tour && _open)
{
    var step = tour.Steps[_index];
    var last = _index == tour.Steps.Count - 1;
    <div class="wb-tour" role="dialog" aria-modal="false" aria-labelledby="wb-tour-title" aria-describedby="wb-tour-text"
         @onkeydown="OnKeyDown" data-testid="welcome-tour">
        <MudPaper Elevation="8" Class="pa-4 wb-tour-card">
            <div class="d-flex align-center mb-1">
                <MudText Typo="Typo.caption" Class="mud-text-secondary" data-testid="tour-progress">Step @(_index + 1) of @tour.Steps.Count</MudText>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="Close the tour" OnClick="SkipAsync" data-testid="tour-close" />
            </div>
            <h2 id="wb-tour-title" class="wb-tour-title" tabindex="-1" data-testid="tour-title">@step.Title</h2>
            <p id="wb-tour-text" class="wb-tour-text" data-testid="tour-text">@step.Text</p>
            @if (step.LinkHref is not null)
            {
                <MudLink Href="@step.LinkHref" OnClick="FinishAsync" Typo="Typo.body2" Class="d-inline-block mb-2">@step.LinkText</MudLink>
            }
            <div class="d-flex align-center gap-2 mt-2">
                @if (_index == 0)
                {
                    <MudButton Variant="Variant.Text" OnClick="SkipAsync" data-testid="tour-skip">Skip tour</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Text" OnClick="BackAsync" data-testid="tour-back">Back</MudButton>
                }
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NextAsync" data-testid="tour-next">@(last ? "Done" : "Next")</MudButton>
            </div>
        </MudPaper>
    </div>
}

@code {
    /// <summary>What the user may open; the tour waits until they're known to be signed in.</summary>
    [Parameter] public NavAccess Access { get; set; } = NavAccess.Anonymous;

    private Tour? _tour;
    private int _index;
    private bool _open;
    private bool _checked;
    private bool _focusPending;
    private IJSObjectReference? _module;

    protected override async Task OnParametersSetAsync()
    {
        if (_checked || !Access.IsSignedIn || IsMobilePage())
        {
            return;
        }

        _checked = true;
        if (Services.GetService<IHelpStateService>() is not { } state)
        {
            return;
        }

        var tour = Tours.For(Access);
        try
        {
            if ((await state.GetAsync()).HasCompleted(tour.Key))
            {
                return;
            }
        }
        catch (Exception ex) when (NavAccess.IsExpected(ex))
        {
            // Can't tell whether it was seen: don't nag.
            return;
        }

        Open(tour);
    }

    /// <summary>Starts the tour for the user's role again (from the help panel).</summary>
    public async Task RestartAsync()
    {
        if (Services.GetService<IHelpStateService>() is { } state)
        {
            try
            {
                await state.RestartToursAsync();
            }
            catch (Exception ex) when (NavAccess.IsExpected(ex))
            {
            }
        }

        Open(Tours.For(Access));
        StateHasChanged();
    }

    private void Open(Tour tour)
    {
        _tour = tour;
        _index = 0;
        _open = true;
        _focusPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_open || _tour is null || !_focusPending)
        {
            return;
        }

        _focusPending = false;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Workbench.Ui/help.js");
            await _module.InvokeAsync<bool>("highlight", _tour.Steps[_index].Target);
            await _module.InvokeVoidAsync("focus", "wb-tour-title");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // No highlight (prerendering, tests, or the circuit is gone); the card still explains each step.
        }
    }

    private Task NextAsync()
    {
        if (_tour is null)
        {
            return Task.CompletedTask;
        }

        if (_index >= _tour.Steps.Count - 1)
        {
            return FinishAsync();
        }

        _index++;
        _focusPending = true;
        return Task.CompletedTask;
    }

    private Task BackAsync()
    {
        if (_index > 0)
        {
            _index--;
            _focusPending = true;
        }

        return Task.CompletedTask;
    }

    private Task SkipAsync() => FinishAsync();

    private async Task FinishAsync()
    {
        if (_tour is not { } tour || !_open)
        {
            return;
        }

        _open = false;
        await ClearHighlightAsync();
        if (Services.GetService<IHelpStateService>() is { } state)
        {
            try
            {
                await state.CompleteTourAsync(tour.Key);
            }
            catch (Exception ex) when (NavAccess.IsExpected(ex))
            {
                // Not remembered this time; it will show again next sign-in.
            }
        }
    }

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? SkipAsync() : Task.CompletedTask;

    private bool IsMobilePage()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        return path == "m" || path.StartsWith("m/", StringComparison.Ordinal);
    }

    private async Task ClearHighlightAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("clear");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("clear");
                await _module.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
            {
            }
        }
    }
}
