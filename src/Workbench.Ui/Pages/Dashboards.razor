@page "/dashboards"
@using Workbench.Contracts.Dashboards
@using Workbench.Ui.Dashboards
@inject IDashboardService DashboardService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Dashboards · Workbench</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4" HtmlTag="h1">Dashboards</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">New dashboard</MudButton>
</MudStack>

@if (_loading && _dashboards.Count == 0)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_dashboards.Count == 0)
{
    <MudPaper Class="pa-6" Outlined="true"><MudText>No dashboards yet. Create one to track your programs at a glance.</MudText></MudPaper>
}
else
{
    <MudPaper Outlined="true">
        <MudSimpleTable Hover="true" Dense="true">
            <thead>
                <tr><th>Name</th><th>Widgets</th><th>Owner</th><th>Updated (UTC)</th><th style="width:1%"></th></tr>
            </thead>
            <tbody>
                @foreach (var d in _dashboards)
                {
                    <tr @key="d.Id">
                        <td>
                            <MudLink Href="@($"dashboards/{d.Id}")" Typo="Typo.body2">@d.Name</MudLink>
                            @if (d.Description is { } description)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@description</MudText>
                            }
                        </td>
                        <td>@d.WidgetCount</td>
                        <td class="mud-text-secondary">@d.OwnerEmail</td>
                        <td class="mud-text-secondary">@d.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td style="white-space:nowrap">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@($"Rename {d.Name}")" OnClick="() => RenameAsync(d)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@($"Delete {d.Name}")" OnClick="() => DeleteAsync(d)" />
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}

@code {
    private IReadOnlyList<DashboardSummary> _dashboards = [];
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _dashboards = await DashboardService.ListAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Snackbar.Add($"Couldn't reach the Workbench server: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<UpdateDashboardRequest?> AskAsync(string title, DashboardSummary? existing)
    {
        var parameters = new DialogParameters<DashboardDialog>
        {
            { x => x.Name, existing?.Name },
            { x => x.Description, existing?.Description },
            { x => x.SubmitText, existing is null ? "Create" : "Rename" },
        };
        var dialog = await DialogService.ShowAsync<DashboardDialog>(title, parameters);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: UpdateDashboardRequest request } ? request : null;
    }

    private async Task CreateAsync()
    {
        if (await AskAsync("New dashboard", null) is not { } request)
        {
            return;
        }

        try
        {
            var created = await DashboardService.CreateAsync(new CreateDashboardRequest(request.Name, request.Description));
            Navigation.NavigateTo($"dashboards/{created.Id}");
        }
        catch (Exception ex) when (ex is HttpRequestException or ArgumentException)
        {
            Snackbar.Add($"Couldn't create the dashboard: {ex.Message}", Severity.Error);
        }
    }

    private async Task RenameAsync(DashboardSummary dashboard)
    {
        if (await AskAsync("Rename dashboard", dashboard) is not { } request)
        {
            return;
        }

        try
        {
            await DashboardService.UpdateAsync(dashboard.Id, request);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or ArgumentException or Workbench.Contracts.WorkbenchNotFoundException)
        {
            Snackbar.Add($"Couldn't rename the dashboard: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteAsync(DashboardSummary dashboard)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete dashboard", new DialogParameters<ConfirmDialog>
        {
            { x => x.Message, $"Delete \"{dashboard.Name}\" and its {dashboard.WidgetCount} widgets? Sheets aren't affected." },
        });
        if (await dialog.Result is not { Canceled: false })
        {
            return;
        }

        try
        {
            await DashboardService.DeleteAsync(dashboard.Id);
            Snackbar.Add($"Deleted \"{dashboard.Name}\"", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or Workbench.Contracts.WorkbenchNotFoundException)
        {
            Snackbar.Add($"Couldn't delete the dashboard: {ex.Message}", Severity.Error);
        }
    }
}
