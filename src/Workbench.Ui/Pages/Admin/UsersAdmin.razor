@page "/admin/users"
@inject IUserDirectory Users
@inject ICurrentUserContext CurrentUser
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Users and security · Workbench</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-1">Users and security</MudText>
<MudText Class="mud-text-secondary mb-4">
    Who can sign in and how (single sign-on, MFA), what they can do, and the evidence an ISO 27001 auditor asks for: access reviews and the security event log.
</MudText>

@if (_me is null && _loading)
{
    <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" />
}
else if (_tabs.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Users and security are for people with the "Administer users" or "Manage sign-in and security" permission.</MudAlert>
}
else
{
    <MudTabs Elevation="0" Outlined="true" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4"
             ActivePanelIndex="_tab" ActivePanelIndexChanged="OnTabChanged" KeepPanelsAlive="false">
        @foreach (var tab in _tabs)
        {
            <MudTabPanel Text="@tab.Title" Icon="@tab.Icon">
                @switch (tab.Key)
                {
                    case "users": <AdminUsersTab Me="_me!" />; break;
                    case "invites": <AdminInvitesTab />; break;
                    case "reviews": <AdminAccessReviewsTab />; break;
                    case "events": <AdminSecurityEventsTab />; break;
                    case "retention": <AdminRetentionTab />; break;
                    case "sign-in": <AdminSignInTab />; break;
                }
            </MudTabPanel>
        }
    </MudTabs>
}

@code {
    private sealed record Tab(string Key, string Title, string Icon, string Permission);

    // Each tab shows for holders of its permission (the server checks the same ones).
    private static readonly Tab[] AllTabs =
    [
        new("users", "Users", Icons.Material.Filled.People, Permission.AdminUsers),
        new("invites", "Invites", Icons.Material.Filled.PersonAdd, Permission.AdminUsers),
        new("reviews", "Access reviews", Icons.Material.Filled.FactCheck, Permission.AdminSecurity),
        new("events", "Security events", Icons.Material.Filled.Policy, Permission.AdminSecurity),
        new("retention", "Retention", Icons.Material.Filled.Inventory2, Permission.AdminRetention),
        new("sign-in", "Sign-in", Icons.Material.Filled.Key, Permission.AdminSecurity),
    ];

    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    private UserDto? _me;
    private IReadOnlyList<Tab> _tabs = [];
    private bool _loading = true;
    private int _tab;

    protected override void OnParametersSet() => _tab = Math.Max(0, _tabs.ToList().FindIndex(t => t.Key == (TabQuery ?? "users")));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _me = await Users.GetMeAsync();
            var permissions = (await CurrentUser.GetAsync()).Permissions;
            _tabs = AllTabs.Where(t => permissions.Has(t.Permission)).ToList();
            OnParametersSet();
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException or TaskCanceledException)
        {
            Snackbar.Add($"Couldn't load users: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnTabChanged(int index)
    {
        _tab = index;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("tab", _tabs[index].Key), replace: true);
    }
}
