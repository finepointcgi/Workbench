@page "/admin/users"
@inject IUserDirectory Users
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Users and security · Workbench</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-1">Users and security</MudText>
<MudText Class="mud-text-secondary mb-4">
    Who can sign in and how (single sign-on, MFA), what they can do, and the evidence an ISO 27001 auditor asks for: access reviews and the security event log.
</MudText>

@if (_me is null && _loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_me is not { IsAdmin: true })
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Only administrators can manage users.</MudAlert>
}
else
{
    <MudTabs Elevation="0" Outlined="true" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4"
             ActivePanelIndex="_tab" ActivePanelIndexChanged="OnTabChanged" KeepPanelsAlive="false">
        <MudTabPanel Text="Users" Icon="@Icons.Material.Filled.People">
            <AdminUsersTab Me="_me" />
        </MudTabPanel>
        <MudTabPanel Text="Invites" Icon="@Icons.Material.Filled.PersonAdd">
            <AdminInvitesTab />
        </MudTabPanel>
        <MudTabPanel Text="Access reviews" Icon="@Icons.Material.Filled.FactCheck">
            <AdminAccessReviewsTab />
        </MudTabPanel>
        <MudTabPanel Text="Security events" Icon="@Icons.Material.Filled.Policy">
            <AdminSecurityEventsTab />
        </MudTabPanel>
        <MudTabPanel Text="Retention" Icon="@Icons.Material.Filled.Inventory2">
            <AdminRetentionTab />
        </MudTabPanel>
        <MudTabPanel Text="Sign-in" Icon="@Icons.Material.Filled.Key">
            <AdminSignInTab />
        </MudTabPanel>
    </MudTabs>
}

@code {
    private static readonly string[] Tabs = ["users", "invites", "reviews", "events", "retention", "sign-in"];

    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    private UserDto? _me;
    private bool _loading = true;
    private int _tab;

    protected override void OnParametersSet() => _tab = Math.Max(0, Array.IndexOf(Tabs, TabQuery ?? "users"));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _me = await Users.GetMeAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException or TaskCanceledException)
        {
            Snackbar.Add($"Couldn't load users: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnTabChanged(int index)
    {
        _tab = index;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("tab", Tabs[index]), replace: true);
    }
}
