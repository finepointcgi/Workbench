@using System.Text
@using Microsoft.JSInterop
@using Workbench.Contracts
@using Workbench.Contracts.Security
@inject IAccessReviewService Reviews
@inject IDialogService Dialogs
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudText Class="mud-text-secondary mb-3">
    Review who has access every quarter (ISO 27001 A.5.18). Starting a review records each active user's roles, workspaces,
    last sign-in and employee as they are now. Mark each Keep or Revoke; Revoke deactivates the user at once. A completed
    review is kept unchanged as evidence.
</MudText>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
    <MudTextField @bind-Value="_newName" Label="Review name" Placeholder="@DefaultName" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:240px" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlaylistAddCheck" OnClick="StartAsync"
               Disabled="_busy || _summaries.Any(s => !s.IsCompleted)" data-testid="review-start">Start review</MudButton>
</MudStack>

<MudTable T="AccessReviewSummaryDto" Items="_summaries" Loading="_loading" Dense="true" Hover="true" OnRowClick="args => OpenAsync(args.Item!.Id)"
          RowClassFunc="RowClass" Breakpoint="Breakpoint.Sm" Class="mb-4">
    <HeaderContent>
        <MudTh>Review</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Started</MudTh>
        <MudTh>Completed</MudTh>
        <MudTh>Decided</MudTh>
        <MudTh>Revoked</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Review">@context.Name</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(context.IsCompleted ? Color.Success : Color.Warning)">@(context.IsCompleted ? "Completed" : "In progress")</MudChip>
        </MudTd>
        <MudTd DataLabel="Started">@context.StartedAtUtc.ToString("yyyy-MM-dd") · @context.StartedBy</MudTd>
        <MudTd DataLabel="Completed">@(context.CompletedAtUtc is { } done ? $"{done:yyyy-MM-dd} · {context.CompletedBy}" : "—")</MudTd>
        <MudTd DataLabel="Decided">@context.Decided / @context.UserCount</MudTd>
        <MudTd DataLabel="Revoked">@context.Revoked</MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>No access reviews yet.</MudText></NoRecordsContent>
</MudTable>

@if (_review is { } review)
{
    <MudPaper Outlined="true" Class="pa-3" data-testid="review-detail">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.h6" HtmlTag="h2">@review.Summary.Name</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadAsync">CSV</MudButton>
            @if (!review.Summary.IsCompleted)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CompleteAsync" Disabled="_busy || review.Items.Any(i => i.Decision == AccessReviewDecisionKind.Pending)"
                           data-testid="review-complete">Complete review</MudButton>
            }
        </MudStack>
        @if (review.Summary.IsCompleted)
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2">
                Completed @review.Summary.CompletedAtUtc?.ToString("yyyy-MM-dd HH:mm") UTC by @review.Summary.CompletedBy.
                @if (!string.IsNullOrEmpty(review.Notes))
                {
                    <span> Notes: @review.Notes</span>
                }
            </MudAlert>
        }
        <MudTable T="AccessReviewItemDto" Items="review.Items" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>User</MudTh>
                <MudTh>Org roles</MudTh>
                <MudTh>Workspace roles</MudTh>
                <MudTh>Last sign-in (UTC)</MudTh>
                <MudTh>Employee</MudTh>
                <MudTh>Decision</MudTh>
                <MudTh>Comment</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="User">
                    <div>@context.DisplayName</div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.UserEmail</MudText>
                </MudTd>
                <MudTd DataLabel="Org roles">@context.OrgRoles</MudTd>
                <MudTd DataLabel="Workspace roles"><MudText Typo="Typo.body2">@context.WorkspaceRoles</MudText></MudTd>
                <MudTd DataLabel="Last sign-in">
                    @(context.LastSignInAtUtc?.ToString("yyyy-MM-dd") ?? "Never")
                    @if (context.Dormant)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">90+ days</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Employee">@(context.EmployeeName ?? "—")</MudTd>
                <MudTd DataLabel="Decision">
                    @if (review.Summary.IsCompleted || context.AppliedAtUtc is not null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="@(context.Decision == AccessReviewDecisionKind.Revoke ? Color.Error : Color.Success)">@context.Decision</MudChip>
                    }
                    else
                    {
                        <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined">
                            <MudButton Color="@(context.Decision == AccessReviewDecisionKind.Keep ? Color.Success : Color.Default)"
                                       Variant="@(context.Decision == AccessReviewDecisionKind.Keep ? Variant.Filled : Variant.Outlined)"
                                       OnClick="() => DecideAsync(context, AccessReviewDecisionKind.Keep)" aria-label="@($"Keep {context.UserEmail}")">Keep</MudButton>
                            <MudButton Color="Color.Error" Variant="Variant.Outlined"
                                       OnClick="() => DecideAsync(context, AccessReviewDecisionKind.Revoke)" aria-label="@($"Revoke {context.UserEmail}")">Revoke</MudButton>
                        </MudButtonGroup>
                    }
                </MudTd>
                <MudTd DataLabel="Comment">
                    @if (context.Comment is not null)
                    {
                        <MudText Typo="Typo.body2">@context.Comment</MudText>
                    }
                    @if (context.DecidedBy is not null)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.DecidedBy, @context.DecidedAtUtc?.ToString("yyyy-MM-dd HH:mm")</MudText>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private IReadOnlyList<AccessReviewSummaryDto> _summaries = [];
    private AccessReviewDto? _review;
    private bool _loading = true;
    private bool _busy;
    private string? _newName;

    private string RowClass(AccessReviewSummaryDto review, int index) => review.Id == _review?.Summary.Id ? "mud-selected-item" : "cursor-pointer";

    private static string DefaultName => $"{DateTime.UtcNow.Year} Q{(DateTime.UtcNow.Month - 1) / 3 + 1}";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (_summaries.FirstOrDefault() is { } latest)
        {
            await OpenAsync(latest.Id);
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _summaries = await Reviews.ListAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException or TaskCanceledException)
        {
            Snackbar.Add($"Couldn't load access reviews: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenAsync(Guid id)
    {
        try
        {
            _review = await Reviews.GetAsync(id);
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException or WorkbenchNotFoundException)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task StartAsync()
    {
        await RunAsync(async () =>
        {
            _review = await Reviews.StartAsync(string.IsNullOrWhiteSpace(_newName) ? null : _newName);
            _newName = null;
            await LoadAsync();
            Snackbar.Add($"Started {_review.Summary.Name} with {_review.Summary.UserCount} users.", Severity.Success);
        });
    }

    private async Task DecideAsync(AccessReviewItemDto item, AccessReviewDecisionKind decision)
    {
        string? comment = null;
        if (decision == AccessReviewDecisionKind.Revoke)
        {
            var dialog = await Dialogs.ShowAsync<SecurityReasonDialog>($"Revoke {item.DisplayName}'s access?", new DialogParameters<SecurityReasonDialog>
            {
                { d => d.Message, $"{item.UserEmail} will be deactivated now and signed out everywhere. Say why." },
                { d => d.ConfirmText, "Revoke" },
                { d => d.ReasonRequired, true },
            });
            if (await dialog.Result is not { Canceled: false, Data: string reason })
            {
                return;
            }

            comment = reason;
        }

        await RunAsync(async () =>
        {
            await Reviews.DecideAsync(_review!.Summary.Id, item.Id, new AccessReviewDecisionRequest(decision, comment));
            _review = await Reviews.GetAsync(_review.Summary.Id);
            await LoadAsync();
        });
    }

    private async Task CompleteAsync()
    {
        var dialog = await Dialogs.ShowAsync<SecurityReasonDialog>("Complete the access review?", new DialogParameters<SecurityReasonDialog>
        {
            { d => d.Message, "The review and its decisions are then kept unchanged as evidence. Add any notes for the auditor." },
            { d => d.ConfirmText, "Complete" },
        });
        if (await dialog.Result is not { Canceled: false, Data: string notes })
        {
            return;
        }

        await RunAsync(async () =>
        {
            _review = await Reviews.CompleteAsync(_review!.Summary.Id, notes);
            await LoadAsync();
            Snackbar.Add($"{_review.Summary.Name} is complete.", Severity.Success);
        });
    }

    private async Task DownloadAsync()
    {
        if (_review is not { } review)
        {
            return;
        }

        var csv = new StringBuilder("User,Email,OrgRoles,WorkspaceRoles,LastSignInUtc,Employee,NoSignIn90Days,Decision,Comment,DecidedBy,DecidedAtUtc\r\n");
        foreach (var i in review.Items)
        {
            csv.AppendJoin(',', Csv(i.DisplayName), Csv(i.UserEmail), Csv(i.OrgRoles), Csv(i.WorkspaceRoles), i.LastSignInAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "",
                Csv(i.EmployeeName), i.Dormant ? "yes" : "no", i.Decision, Csv(i.Comment), Csv(i.DecidedBy), i.DecidedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "").Append("\r\n");
        }

        csv.Append($"\r\nReview,{Csv(review.Summary.Name)}\r\nStarted,{review.Summary.StartedAtUtc:yyyy-MM-dd HH:mm} UTC,{Csv(review.Summary.StartedBy)}\r\n");
        if (review.Summary.IsCompleted)
        {
            csv.Append($"Completed,{review.Summary.CompletedAtUtc:yyyy-MM-dd HH:mm} UTC,{Csv(review.Summary.CompletedBy)}\r\nNotes,{Csv(review.Notes)}\r\n");
        }

        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Workbench.Ui/financials.js");
        await module.InvokeVoidAsync("downloadText", $"access-review-{review.Summary.Name.Replace(' ', '-')}.csv", "text/csv", csv.ToString());
    }

    private static string Csv(string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return "";
        }

        if (value[0] is '=' or '+' or '-' or '@')
        {
            value = "'" + value;
        }

        return value.IndexOfAny([',', '"', '\r', '\n']) >= 0 ? $"\"{value.Replace("\"", "\"\"")}\"" : value;
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException or HttpRequestException or WorkbenchNotFoundException)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }
}
