@page "/"
@using Microsoft.Extensions.DependencyInjection
@using Workbench.Contracts.Customization
@using Workbench.Contracts.Dashboards
@using Workbench.Contracts.MyTodo
@using Workbench.Ui.Home
@inject IMyTodoService MyTodo
@inject IServiceProvider Services
@inject ISnackbar Snackbar

<PageTitle>My Work · Workbench</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <div>
        <MudText Typo="Typo.h4" HtmlTag="h1" data-testid="greeting">@Greeting()</MudText>
        <MudText Class="mud-text-secondary" data-testid="today">@Now().ToString("dddd, MMMM d", System.Globalization.CultureInfo.InvariantCulture)</MudText>
    </div>
    <MudSpacer />
    @if (_home is not null)
    {
        @if (_customizing)
        {
            <MudButton Variant="Variant.Text" OnClick="ResetAsync" Disabled="@(!_home.Personalized)" data-testid="home-reset">Reset to @(_home.IsBuiltIn ? "the standard" : _home.Source) layout</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check" OnClick="SaveLayoutAsync" data-testid="home-done">Done</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.DashboardCustomize" OnClick="StartCustomizing" data-testid="home-customize">Customize</MudButton>
        }
    }
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="Refresh" OnClick="LoadAsync" Disabled="_loading" />
</MudStack>

<Workbench.Ui.Time.TimerWidget />

@if (_todo is null)
{
    @if (_loading)
    {
        <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    }
}
else
{
    @if (_todo.Unavailable.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" data-testid="unavailable">
            Some things couldn't be checked right now (@string.Join(", ", _todo.Unavailable)). Refresh to try again.
        </MudAlert>
    }

    @if (UsesWidgets)
    {
        @if (_customizing)
        {
            <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.DashboardCustomize">
                Move widgets with the arrows and hide the ones you don't need. Pinned widgets stay. Choose Done to keep your layout.
            </MudAlert>
        }
        <MudGrid Spacing="4" Class="mb-2" data-testid="home-widgets" data-home-source="@_home!.Source">
            @for (var index = 0; index < _order.Count; index++)
            {
                var item = _order[index];
                var position = index;
                @if (item.Hidden && !_customizing)
                {
                    continue;
                }

                <MudItem xs="12" md="@Math.Max(item.Widget.Width, 6)" lg="@item.Widget.Width" @key="item.Widget.Id" data-home-widget="@item.Widget.Title">
                    @if (_customizing)
                    {
                        <MudPaper Outlined="true" Class="pa-2 mb-2 d-flex align-center gap-1" Style="@(item.Hidden ? "opacity:.6" : null)">
                            <MudText Typo="Typo.subtitle2" Style="flex:1">@item.Widget.Title@(item.Hidden ? " (hidden)" : "")@(item.Pinned ? " · pinned" : "")</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" aria-label="@($"Move {item.Widget.Title} up")" Disabled="position == 0" OnClick="() => Move(position, -1)" />
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" aria-label="@($"Move {item.Widget.Title} down")" Disabled="position == _order.Count - 1" OnClick="() => Move(position, 1)" />
                            @if (!item.Pinned)
                            {
                                <MudIconButton Icon="@(item.Hidden ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)" Size="Size.Small"
                                               aria-label="@($"{(item.Hidden ? "Show" : "Hide")} {item.Widget.Title}")" OnClick="() => ToggleHidden(position)" />
                            }
                        </MudPaper>
                    }
                    @if (!item.Hidden)
                    {
                        <HomeWidget Widget="item.Widget" Todo="_todo" ApprovalsCardShown="@(_order.Any(o => !o.Hidden && o.Widget.Type == WidgetType.WaitingOnYou))" OnChanged="LoadAsync" />
                    }
                </MudItem>
            }
        </MudGrid>
    }
    else
    {
        <MudGrid Spacing="4" Class="mb-2">
            <MudItem xs="12" md="7" lg="8">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-1">To do</MudText>
                <TodoList Items="TodoFormat.ItemsBesideApprovalsCard(_todo, true)" Today="_todo.Today" OnChanged="LoadAsync" />
            </MudItem>
            <MudItem xs="12" md="5" lg="4">
                @if (_todo.Week is { } week)
                {
                    <ThisWeekStrip Week="week" />
                }
                @if (_todo.Approvals is { Count: > 0 } approvals)
                {
                    <WaitingOnYou Approvals="approvals" OnChanged="LoadAsync" />
                }
            </MudItem>
        </MudGrid>
    }
}

@if (!UsesWidgets)
{
    <MySheetItems OnChanged="LoadAsync" />
}

@code {
    private MyTodoDto? _todo;
    private HomePageDto? _home;
    private List<HomeWidgetDto> _order = [];
    private bool _customizing;
    private bool _loading = true;

    // The page as built shows until a role has a home page or the person changes theirs.
    private bool UsesWidgets => _home is { } home && (!home.IsBuiltIn || home.Personalized || _customizing);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _todo = await MyTodo.GetAsync();
            await LoadHomeAsync();
        }
        catch (Exception ex) when (TodoFormat.IsExpected(ex))
        {
            Snackbar.Add($"Couldn't reach the Workbench server: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadHomeAsync()
    {
        if (Services.GetService<IHomePageService>() is not { } homes)
        {
            return;
        }

        try
        {
            Apply(await homes.GetMineAsync());
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _home = null; // Without a home page service answer, the built-in page still works.
        }
    }

    private void Apply(HomePageDto home)
    {
        _home = home;
        _order = home.Widgets.ToList();
    }

    private void StartCustomizing() => _customizing = true;

    private void Move(int index, int by)
    {
        var target = Math.Clamp(index + by, 0, _order.Count - 1);
        var item = _order[index];
        _order.RemoveAt(index);
        _order.Insert(target, item);
    }

    private void ToggleHidden(int index) => _order[index] = _order[index] with { Hidden = !_order[index].Hidden };

    private async Task SaveLayoutAsync()
    {
        _customizing = false;
        if (Services.GetService<IHomePageService>() is not { } homes)
        {
            return;
        }

        try
        {
            Apply(await homes.SavePreferencesAsync(new SaveHomePreferencesRequest(
                _order.Select(w => w.Widget.Id).ToList(),
                _order.Where(w => w.Hidden).Select(w => w.Widget.Id).ToList())));
            Snackbar.Add("Your home page is saved.", Severity.Success);
        }
        catch (Exception ex) when (ex is ArgumentException or HttpRequestException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ResetAsync()
    {
        _customizing = false;
        if (Services.GetService<IHomePageService>() is { } homes)
        {
            Apply(await homes.ResetPreferencesAsync());
        }
    }

    private DateTime Now() => (Services.GetService<TimeProvider>() ?? TimeProvider.System).GetLocalNow().DateTime;

    private string Greeting() => _todo is null ? TodoFormat.Greeting(Now().Hour) : $"{TodoFormat.Greeting(Now().Hour)}, {_todo.FirstName}";
}
