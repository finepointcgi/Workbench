@page "/sheets/{SheetId:guid}"
@using Workbench.Ui.Views
@using Workbench.Ui.Collaboration
@inject ISheetService SheetService
@inject IItemService ItemService
@inject ISnackbar Snackbar

<PageTitle>@(_sheet?.Summary.Name ?? "Sheet") · Workbench</PageTitle>

@if (_loading && _sheet is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_sheet is null)
{
    <MudText Typo="Typo.h4" HtmlTag="h1">Sheet not found</MudText>
    <MudButton Href="sheets" Variant="Variant.Text" Color="Color.Primary" Class="mt-4">Back to Sheets</MudButton>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudIconButton Href="sheets" Icon="@Icons.Material.Filled.ArrowBack" aria-label="Back to Sheets" />
        <MudText Typo="Typo.h4" HtmlTag="h1">@_sheet.Summary.Name</MudText>
        @if (_sheet.Summary.CostpointProjectId is { } project)
        {
            <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Link">Costpoint @project</MudChip>
        }
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" aria-label="Reload" />
    </MudStack>
    @if (!string.IsNullOrWhiteSpace(_sheet.Summary.Description))
    {
        <MudText Class="mud-text-secondary mb-4">@_sheet.Summary.Description</MudText>
    }

    <MudTabs Elevation="0" Outlined="true" Rounded="true" TabPanelsClass="pa-4" KeepPanelsAlive="false">
        <MudTabPanel Text="Grid" Icon="@Icons.Material.Filled.GridOn">
            <SheetGridView Sheet="_sheet" Items="_items" Changed="LoadAsync" />
        </MudTabPanel>
        <MudTabPanel Text="Board" Icon="@Icons.Material.Filled.ViewKanban">
            <SheetBoardView Sheet="_sheet" Items="_items" Changed="LoadAsync" />
        </MudTabPanel>
        <MudTabPanel Text="Calendar" Icon="@Icons.Material.Filled.CalendarMonth">
            <SheetCalendarView Sheet="_sheet" Items="_items" Changed="LoadAsync" />
        </MudTabPanel>
        @if (_sheet.Summary.SchedulingEnabled)
        {
            <MudTabPanel Text="Gantt" Icon="@Icons.Material.Filled.ViewTimeline">
                <SheetGanttView Sheet="_sheet" Items="_items" Changed="LoadAsync" />
            </MudTabPanel>
        }
        <MudTabPanel Text="Activity" Icon="@Icons.Material.Filled.History">
            <ActivityFeed SheetId="SheetId" Items="_items" Version="_liveVersion" />
        </MudTabPanel>
        <MudTabPanel Text="Automation" Icon="@Icons.Material.Filled.Bolt">
            <Workbench.Ui.Automation.AutomationPanel Sheet="_sheet" Items="_items" Version="_liveVersion" />
        </MudTabPanel>
        @if (_sheet.Summary.CostpointProjectId is not null)
        {
            <MudTabPanel Text="Plan vs actual" Icon="@Icons.Material.Filled.QueryStats">
                <Workbench.Ui.Costpoint.PlanVsActualPanel SheetId="SheetId" Items="_items" />
            </MudTabPanel>
        }
    </MudTabs>

    @* Collaboration: item details panel (?item={id}) and live reload when others change the sheet. *@
    <ItemDetailsDrawer Sheet="_sheet" Items="_items" Version="_liveVersion" />
}
<SheetLiveRefresher SheetId="SheetId" Changed="OnLiveChangeAsync" />

@code {
    [Parameter]
    public Guid SheetId { get; set; }

    private SheetDetail? _sheet;
    private IReadOnlyList<ItemDto> _items = [];
    private bool _loading = true;
    private int _liveVersion;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _sheet = await SheetService.GetAsync(SheetId);
            _items = _sheet is null ? [] : await ItemService.ListAsync(SheetId);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Snackbar.Add($"Couldn't load the sheet: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnLiveChangeAsync()
    {
        await LoadAsync();
        _liveVersion++;
    }
}
