@page "/sheets/{SheetId:guid}"
@using Workbench.Ui.Views
@using Workbench.Ui.Collaboration
@inject ISheetService SheetService
@inject IItemService ItemService
@inject ISheetPermissions Permissions
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject Workbench.Contracts.ProjectAccounting.IProjectService ProjectService
@inject Workbench.Contracts.Financials.IFinancialAccessService FinancialAccess
@inject IServiceProvider Services
@using Microsoft.JSInterop
@inject IJSRuntime JS

@if (!Embedded)
{
    <PageTitle>@(_sheet?.Summary.Name ?? "Sheet") · Workbench</PageTitle>
}

@if (_loading && _sheet is null)
{
    <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" />
}
else if (_sheet is null)
{
    <MudText Typo="Typo.h4" HtmlTag="h1">Sheet not found</MudText>
    <MudButton Href="sheets" Variant="Variant.Text" Color="Color.Primary" Class="mt-4">Back to Sheets</MudButton>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
        @if (Embedded)
        {
            <MudButton Href="@($"sheets/{SheetId}")" Variant="Variant.Text" Size="Size.Small" EndIcon="@Icons.Material.Filled.OpenInNew">Open the plan sheet</MudButton>
        }
        else
        {
            <MudIconButton Href="sheets" Icon="@Icons.Material.Filled.ArrowBack" aria-label="Back to Sheets" />
            <MudText Typo="Typo.h4" HtmlTag="h1">@_sheet.Summary.Name</MudText>
        }
        <MudSpacer />
        @if (!_access.CanEdit)
        {
            <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Outlined.Visibility">@(_access.CanComment ? "Can comment" : "View only")</MudChip>
        }
        @if (_planService is not null && _sheet.Summary.SchedulingEnabled)
        {
            @* Excel round trip for PMs who plan in MS Project or Excel. *@
            <MudMenu Label="Excel" StartIcon="@Icons.Material.Filled.TableView" EndIcon="@Icons.Material.Filled.ArrowDropDown" Variant="Variant.Outlined"
                     Size="Size.Small" AriaLabel="Excel import and export" data-testid="plan-excel-menu">
                <MudMenuItem Icon="@Icons.Material.Filled.Download" OnClick="ExportPlanAsync" data-testid="plan-export">Export plan to Excel</MudMenuItem>
                @if (_access.CanEdit)
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.Upload" OnClick="ImportPlanAsync" data-testid="plan-import">Import plan from Excel…</MudMenuItem>
                }
                <MudMenuItem Icon="@Icons.Material.Filled.Description" OnClick="DownloadTemplateAsync" data-testid="plan-template">Download blank template</MudMenuItem>
            </MudMenu>
        }
        @* One automation builder: recipes and the sheet's automations (Workbench.Ui.Automation). *@
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Bolt" OnClick="AutomateAsync" data-testid="sheet-automate">Automate</MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="ShareAsync">Share</MudButton>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" aria-label="Reload" />
    </MudStack>
    @if (!string.IsNullOrWhiteSpace(_sheet.Summary.Description))
    {
        <MudText Class="mud-text-secondary mb-4">@_sheet.Summary.Description</MudText>
    }

    @* Views hide edit affordances from Viewers and Commenters; the server enforces the same rules. *@
    <CascadingValue Value="_access">
    @* Task assignment (Assignees, "My tasks"): null where the service isn't registered, which hides those affordances. *@
    <CascadingValue Value="_tasks">
    @* The plan editor's outline (task IDs, durations, predecessors) on scheduled sheets; null hides those columns. *@
    <CascadingValue Value="_plan">
    <MudTabs Elevation="0" Outlined="true" Rounded="true" TabPanelsClass="pa-4" KeepPanelsAlive="false">
        <MudTabPanel Text="Grid" Icon="@Icons.Material.Filled.GridOn">
            <SheetGridView Sheet="_sheet" Items="_items" Changed="LoadAsync" />
        </MudTabPanel>
        <MudTabPanel Text="Board" Icon="@Icons.Material.Filled.ViewKanban">
            <SheetBoardView Sheet="_sheet" Items="_items" Changed="LoadAsync" />
        </MudTabPanel>
        <MudTabPanel Text="Calendar" Icon="@Icons.Material.Filled.CalendarMonth">
            <SheetCalendarView Sheet="_sheet" Items="_items" Changed="LoadAsync" />
        </MudTabPanel>
        @if (_sheet.Summary.SchedulingEnabled)
        {
            <MudTabPanel Text="Gantt" Icon="@Icons.Material.Filled.ViewTimeline">
                <SheetGanttView Sheet="_sheet" Items="_items" Changed="LoadAsync" />
            </MudTabPanel>
        }
        @if (_project is not null && !Embedded)
        {
            <MudTabPanel Text="Financials" Icon="@Icons.Material.Filled.AttachMoney">
                <Workbench.Ui.Financials.ProjectFinancialsCompact ProjectId="_project.Id" />
            </MudTabPanel>
        }
        <MudTabPanel Text="Activity" Icon="@Icons.Material.Filled.History">
            <ActivityFeed SheetId="SheetId" Items="_items" Version="_liveVersion" />
        </MudTabPanel>
        <MudTabPanel Text="Automation" Icon="@Icons.Material.Filled.Bolt">
            <Workbench.Ui.Automation.AutomationPanel Sheet="_sheet" Items="_items" Version="_liveVersion" />
        </MudTabPanel>
    </MudTabs>

    @* Collaboration: item details panel (?item={id}) and live reload when others change the sheet. *@
    <ItemDetailsDrawer Sheet="_sheet" Items="_items" Version="_liveVersion" Changed="LoadAsync" />
    </CascadingValue>
    </CascadingValue>
    </CascadingValue>
}
<SheetLiveRefresher SheetId="SheetId" Changed="OnLiveChangeAsync" />

@code {
    [Parameter]
    public Guid SheetId { get; set; }

    /// <summary>Rendered as the Plan tab of the project page, which has its own title and Financials tab.</summary>
    [Parameter]
    public bool Embedded { get; set; }

    private SheetDetail? _sheet;
    private IReadOnlyList<ItemDto> _items = [];
    private bool _loading = true;
    private int _liveVersion;
    private SheetAccess _access = new(null);
    private Workbench.Contracts.ProjectAccounting.ProjectDto? _project;
    private SheetTasksDto? _tasks;
    private Workbench.Contracts.Scheduling.PlanScheduleDto? _plan;

    private Workbench.Contracts.Scheduling.IPlanScheduleService? _planService =>
        Services.GetService(typeof(Workbench.Contracts.Scheduling.IPlanScheduleService)) as Workbench.Contracts.Scheduling.IPlanScheduleService;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _sheet = await SheetService.GetAsync(SheetId);
            _items = _sheet is null ? [] : await ItemService.ListAsync(SheetId);
            _access = new SheetAccess(_sheet is null ? null : await Permissions.GetMyRoleAsync(SheetId));
            _tasks = _sheet is not null && Services.GetService(typeof(ITaskAssignmentService)) is ITaskAssignmentService tasks
                ? await tasks.GetSheetAsync(SheetId) : null;
            _plan = _sheet is { Summary.SchedulingEnabled: true } && _planService is { } plans ? await plans.GetAsync(SheetId) : null;
            var project = _sheet is null ? null : await ProjectService.GetProjectForSheetAsync(SheetId);

            // The Financials tab only for those who may read the project's financials (Finance, Admin, its manager).
            _project = project is not null && await FinancialAccess.CanReadProjectFinancialsAsync(project.Id) ? project : null;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or UnauthorizedAccessException)
        {
            Snackbar.Add($"Couldn't load the sheet: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ExportPlanAsync()
    {
        if (_planService is { } plans)
        {
            await DownloadAsync(() => plans.ExportAsync(SheetId));
        }
    }

    private async Task DownloadTemplateAsync()
    {
        if (_planService is { } plans)
        {
            await DownloadAsync(() => plans.TemplateAsync());
        }
    }

    private async Task DownloadAsync(Func<Task<Workbench.Contracts.Scheduling.PlanFile>> load)
    {
        try
        {
            var file = await load();
            await using var module = await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("import", "./_content/Workbench.Ui/plan.js");
            await module.InvokeVoidAsync("downloadBase64", file.FileName, file.ContentType, Convert.ToBase64String(file.Content));
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or UnauthorizedAccessException or Microsoft.JSInterop.JSException)
        {
            Snackbar.Add($"Couldn't download the file: {ex.Message}", Severity.Error);
        }
    }

    private async Task ImportPlanAsync()
    {
        var parameters = new DialogParameters<Workbench.Ui.Plan.PlanImportDialog> { { d => d.SheetId, SheetId } };
        var dialog = await DialogService.ShowAsync<Workbench.Ui.Plan.PlanImportDialog>("Import plan from Excel", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private Task AutomateAsync() => Workbench.Ui.Automation.AutomateDialog.ShowAsync(DialogService, SheetId, _sheet?.Summary.Name ?? "this sheet", _access.CanEdit);

    private async Task ShareAsync()
    {
        var parameters = new DialogParameters<ShareDialog> { { d => d.SheetId, SheetId } };
        var dialog = await DialogService.ShowAsync<ShareDialog>("Share", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        await dialog.Result;
        await LoadAsync();
    }

    private async Task OnLiveChangeAsync()
    {
        await LoadAsync();
        _liveVersion++;
    }
}
