@page "/expenses/{ReportId:guid}"
@using Workbench.Contracts.Odcs
@using Workbench.Ui.Odcs
@inject IServiceProvider Services
@inject IExpenseReportService Reports
@inject IOdcService Odcs
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IServiceProvider Services

<PageTitle>@(_detail?.Report.Title ?? "Expense report") · Workbench</PageTitle>

<AccessibleBreadcrumbs Items="_crumbs" Class="px-0 pt-0" />

@if (_detail is null)
{
    <MudProgressLinear aria-label="Loading" Indeterminate="@_loading" />
}
else
{
    var report = _detail.Report;
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h4" HtmlTag="h1">@report.Title</MudText>
        <OdcStatusChip Status="report.Status" />
        <MudSpacer />
        @if (report.IsEditable)
        {
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditReportAsync">Edit details</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteReportAsync">Delete</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" OnClick="SubmitAsync"
                       Disabled="@(_detail.Lines.Count == 0 || _busy)">Submit for approval</MudButton>
        }
    </MudStack>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        @report.EmployeeName
        @if (Expenses.TripText(report) is { Length: > 0 } trip)
        {
            <text> · @trip</text>
        }
        @if (report.Purpose is { } purpose)
        {
            <text> · @purpose</text>
        }
    </MudText>

    @if (report.Status == OdcApprovalState.Rejected && report.RejectionReason is { } reason)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">Rejected: @reason. Fix the lines and submit again.</MudAlert>
    }
    else if (report.Status == OdcApprovalState.Submitted)
    {
        <MudAlert Severity="Severity.Info" Class="mb-3">Submitted @report.SubmittedAtUtc?.ToString("yyyy-MM-dd HH:mm") UTC; waiting for your supervisor.</MudAlert>
    }
    else if (report.Status == OdcApprovalState.Approved)
    {
        <MudAlert Severity="Severity.Success" Class="mb-3">Approved by @report.ApprovedBy. The report is locked; your approver can reopen it for corrections.</MudAlert>
    }

    <MudPaper Outlined="true" Class="pa-2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="px-2">
            <MudText Typo="Typo.h6">Lines</MudText>
            <MudSpacer />
            @if (report.IsEditable)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddLineAsync">Add line</MudButton>
            }
        </MudStack>
        <MudTable T="OdcEntryDto" Items="_detail.Lines" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>Date</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Charge code</MudTh>
                <MudTh>Description</MudTh>
                <MudTh Style="text-align:right">Amount</MudTh>
                <MudTh>Receipt</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Date">@context.IncurredOn.ToString("yyyy-MM-dd")</MudTd>
                <MudTd DataLabel="Type">@_labels.Label("expense-category", context.Type, context.Type.ToString())</MudTd>
                <MudTd DataLabel="Charge code">@ChargeCodeText.Label(context.WbsCode, context.WbsName)</MudTd>
                <MudTd DataLabel="Description">
                    @context.Description
                    @if (context.Vendor is { } vendor)
                    {
                        <span class="mud-text-secondary"> · @vendor</span>
                    }
                    @if (context.IsUnallowable)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" title="@context.UnallowableReason">Unallowable</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Amount" Style="text-align:right">
                    @OdcFormat.Money(context.Amount)
                    @if (context.CurrencyCode is { } paid && context.TransactionAmount is { } tx)
                    {
                        <div class="mud-text-secondary" style="font-size:0.8rem">@Workbench.Ui.Currencies.CurrencyFormat.Amount(tx, paid) at @Workbench.Ui.Currencies.CurrencyFormat.Rate(context.ExchangeRate ?? 1)</div>
                    }
                </MudTd>
                <MudTd DataLabel="Receipt">
                    @if (context.ReceiptFileId is { } fileId)
                    {
                        <MudLink Href="@Odcs.GetReceiptUrl(context.Id)" Typo="Typo.body2" download="@context.ReceiptFileName">@context.ReceiptFileName</MudLink>
                        @if (SharedWith(context) is > 0 and var others)
                        {
                            <div class="mud-text-secondary" style="font-size:0.8rem">Also backs @others other line@(others == 1 ? "" : "s")</div>
                        }
                    }
                    else if (context.Amount >= _threshold)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Error">Required</MudText>
                    }
                    @if (report.IsEditable)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.AttachFile"
                                   OnClick="() => EditLineAsync(context)" data-testid="line-attach-receipt">@(context.ReceiptFileId is null ? "Attach receipt" : "Replace")</MudButton>
                    }
                </MudTd>
                <MudTd Style="white-space:nowrap">
                    @if (report.IsEditable)
                    {
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="() => EditLineAsync(context)" aria-label="Edit line" />
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="() => RemoveLineAsync(context)" aria-label="Remove line" />
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">No lines yet. Add airfare, lodging, meals and other trip costs.</MudText>
            </NoRecordsContent>
            <FooterContent>
                <MudTd colspan="4" Style="text-align:right"><b>Total</b> (allowable @OdcFormat.Money(report.AllowableTotal))</MudTd>
                <MudTd Style="text-align:right"><b>@OdcFormat.Money(report.Total)</b></MudTd>
                <MudTd colspan="2"></MudTd>
            </FooterContent>
        </MudTable>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block px-2 pb-1">Receipts are required for lines of @OdcFormat.Money(_threshold) or more.</MudText>
    </MudPaper>
    <Workbench.Ui.PerDiem.PerDiemPanel ReportId="ReportId" EmployeeId="report.EmployeeId" Editable="report.IsEditable" TripStart="report.TripStart" TripEnd="report.TripEnd" Changed="LoadAsync" />
    <Workbench.Ui.Travel.TravelReportPanel ReportId="ReportId" Editable="report.IsEditable" Version="_version" />
    <CustomFieldsSection EntityType="@CustomizableEntityTypes.ExpenseReport" RecordId="ReportId" Class="mt-3" />
}

@code {
    [Parameter] public Guid ReportId { get; set; }

    private ExpenseReportDetailDto? _detail;
    private decimal _threshold = 75m;
    private bool _loading = true;
    private bool _busy;
    private int _version;
    private List<BreadcrumbItem> _crumbs = [new("Expenses", "expenses")];

    private StatusLabels _labels = StatusLabels.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(_labels, StatusLabels.Empty))
        {
            _labels = await StatusLabels.LoadAsync(Services);
        }

        try
        {
            _threshold = (await Odcs.GetPolicyAsync()).ReceiptThreshold;
        }
        catch (Exception ex) when (OdcFormat.IsExpected(ex))
        {
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _detail = await Reports.GetReportAsync(ReportId);
            _version++;
            _crumbs = [new("Expenses", "expenses"), new(_detail.Report.Title, null, disabled: true)];
        }
        catch (Exception ex) when (OdcFormat.IsExpected(ex))
        {
            Snackbar.Add($"Couldn't load the report: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<bool> RunAsync(Func<Task> action, string? success = null)
    {
        _busy = true;
        try
        {
            await action();
            if (success is not null)
            {
                Snackbar.Add(success, Severity.Success);
            }

            return true;
        }
        catch (Exception ex) when (OdcFormat.IsExpected(ex))
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return false;
        }
        finally
        {
            _busy = false;
            await LoadAsync();
        }
    }

    private async Task<ExpenseLineDialogResult?> AskLineAsync(OdcEntryDto? existing)
    {
        var parameters = new DialogParameters<ExpenseLineDialog>
        {
            { d => d.EmployeeId, _detail!.Report.EmployeeId },
            { d => d.Existing, existing },
            { d => d.DefaultDate, _detail.Report.TripStart },
            { d => d.ReceiptThreshold, _threshold },
            { d => d.ReportId, ReportId },
        };
        var dialog = await DialogService.ShowAsync<ExpenseLineDialog>(existing is null ? "Add expense line" : "Edit expense line", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        return await dialog.Result is { Canceled: false, Data: ExpenseLineDialogResult result } ? result : null;
    }

    private async Task AddLineAsync()
    {
        if (await AskLineAsync(null) is { } result)
        {
            await RunAsync(async () =>
            {
                await Reports.AddLineAsync(ReportId, result.Line);
                await AddExtraLinesAsync(result);
            }, Added(result));
        }
    }

    private async Task EditLineAsync(OdcEntryDto line)
    {
        if (await AskLineAsync(line) is { } result)
        {
            await RunAsync(async () =>
            {
                await Reports.UpdateLineAsync(ReportId, line.Id, result.Line);
                await AddExtraLinesAsync(result);
            }, result.ExtraLines.Count > 0 ? Added(result) : null);
        }
    }

    // Other charges from the same folio (parking, ...) become their own lines, backed by the same receipt.
    private async Task AddExtraLinesAsync(ExpenseLineDialogResult result)
    {
        foreach (var extra in result.ExtraLines)
        {
            await Reports.AddLineAsync(ReportId, extra);
        }
    }

    private static string? Added(ExpenseLineDialogResult result) =>
        result.ExtraLines.Count == 0 ? null : $"Added {result.ExtraLines.Count + 1} lines from the same receipt.";

    private int SharedWith(OdcEntryDto line) => _detail!.Lines.Count(l => l.Id != line.Id && l.ReceiptFileId == line.ReceiptFileId);

    private Task RemoveLineAsync(OdcEntryDto line) => RunAsync(() => Reports.RemoveLineAsync(ReportId, line.Id));

    private async Task EditReportAsync()
    {
        var custom = new FormCustomValues();
        var parameters = new DialogParameters<ExpenseReportDialog> { { d => d.Existing, _detail!.Report }, { d => d.CustomValues, custom } };
        var dialog = await DialogService.ShowAsync<ExpenseReportDialog>("Edit expense report", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: SaveExpenseReportRequest request })
        {
            await RunAsync(async () =>
            {
                await Reports.UpdateReportAsync(ReportId, request);
                await ConfigurableForm.SaveCustomFieldsAsync(Services, CustomizableEntities.ExpenseReport, ReportId, custom);
            });
        }
    }

    private async Task DeleteReportAsync()
    {
        if (await DialogService.ShowMessageBoxAsync("Delete expense report", $"Delete \"{_detail!.Report.Title}\" and its lines?", yesText: "Delete", cancelText: "Cancel") == true)
        {
            try
            {
                await Reports.DeleteReportAsync(ReportId);
                Navigation.NavigateTo("expenses");
            }
            catch (Exception ex) when (OdcFormat.IsExpected(ex))
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private Task SubmitAsync() => RunAsync(() => Reports.SubmitAsync(ReportId), "Submitted to your supervisor for approval.");
}
