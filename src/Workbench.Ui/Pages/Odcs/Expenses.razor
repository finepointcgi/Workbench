@page "/expenses"
@using Workbench.Contracts.Odcs
@using Workbench.Ui.Odcs
@inject IServiceProvider Services
@inject IExpenseReportService Reports
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Expenses · Workbench</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
    <MudText Typo="Typo.h4" HtmlTag="h1">My expense reports</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">New report</MudButton>
</MudStack>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Put what you spent on a trip or for a project in one report, add the receipts and submit it. Your supervisor approves it, then you're reimbursed.
    Corporate card charges wait under Card charges until you add them to a report.
</MudText>

<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-3" @bind-ActivePanelIndex="_tab">
    <MudTabPanel Text="Reports">
        <ConfigurableList T="ExpenseReportDto" Definition="_definition" Items="_reports" Loading="_loading" SearchLabel="Search expense reports" RowClick="Open" TestId="expense-reports">
            <NoRecordsContent>
                <MudText data-testid="expenses-empty">No expense reports yet. Start one for your next trip, or for anything you bought for a project.</MudText>
                <MudButton Class="mt-2" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">Start an expense report</MudButton>
            </NoRecordsContent>
        </ConfigurableList>
    </MudTabPanel>
    <MudTabPanel Text="Card charges" data-testid="tab-card-charges">
        <Workbench.Ui.Travel.CardChargesTab />
    </MudTabPanel>
</MudTabs>

@code {
    private IReadOnlyList<ExpenseReportDto> _reports = [];
    private bool _loading = true;
    private int _tab;

    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _tab = Tab == "cards" ? 1 : 0;
        try
        {
            _reports = await Reports.ListMyReportsAsync();
        }
        catch (Exception ex) when (OdcFormat.IsExpected(ex))
        {
            Snackbar.Add($"Couldn't load expense reports: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    internal static readonly ListDefinition<ExpenseReportDto> _definition = new()
    {
        ListKey = CustomizableLists.ExpenseReports,
        EntityType = CustomizableEntities.ExpenseReport,
        Title = "Expense reports",
        Id = r => r.Id,
        Columns =
        [
            new() { Key = "title", Title = "Title", Value = r => r.Title, Groupable = false, Cell = r => @<MudLink Href="@($"expenses/{r.Id}")">@r.Title</MudLink> },
            new() { Key = "trip", Title = "Trip", Value = r => r.TripStart, Kind = ListColumnKind.Date, Groupable = false, Display = TripText },
            new() { Key = "purpose", Title = "Purpose", Value = r => r.Purpose, Standard = false, Groupable = false },
            new() { Key = "lines", Title = "Lines", Value = r => r.LineCount, Kind = ListColumnKind.Number, Groupable = false },
            new() { Key = "total", Title = "Total", Value = r => r.Total, Kind = ListColumnKind.Money, Groupable = false, Cell = r => @<text>@OdcFormat.Money(r.Total)</text> },
            new() { Key = "allowable", Title = "Allowable", Value = r => r.AllowableTotal, Kind = ListColumnKind.Money, Groupable = false, Cell = r => @<text>@OdcFormat.Money(r.AllowableTotal)</text> },
            new() { Key = "status", Title = "Status", Value = r => r.Status, Cell = r => @<OdcStatusChip Status="r.Status" /> },
        ],
    };

    internal static string TripText(ExpenseReportDto r) => (r.TripStart, r.TripEnd) switch
    {
        ({ } s, { } e) => $"{s:MMM d} – {e:MMM d, yyyy}",
        ({ } s, null) => $"{s:MMM d, yyyy}",
        _ => "",
    };

    private void Open(ExpenseReportDto report) => Navigation.NavigateTo($"expenses/{report.Id}");

    private async Task CreateAsync()
    {
        var custom = new FormCustomValues();
        var dialog = await DialogService.ShowAsync<ExpenseReportDialog>("New expense report", new DialogParameters<ExpenseReportDialog> { { d => d.CustomValues, custom } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: SaveExpenseReportRequest request })
        {
            try
            {
                var report = await Reports.CreateReportAsync(request);
                await ConfigurableForm.SaveCustomFieldsAsync(Services, CustomizableEntities.ExpenseReport, report.Id, custom);
                Open(report);
            }
            catch (Exception ex) when (OdcFormat.IsExpected(ex))
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}
