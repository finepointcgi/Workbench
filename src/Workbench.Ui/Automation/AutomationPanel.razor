@using Workbench.Contracts.Automation
@using Workbench.Ui.Collaboration
@inject IRuleService Rules
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@* The sheet's automations (with on/off switches) and their recent runs. The Automate button in the sheet's header opens the recipes. *@
<MudStack Spacing="4">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h6" HtmlTag="h2">Automations</MudText>
        <MudSpacer />
        @if (CanEdit)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Bolt" OnClick="AutomateAsync" data-testid="panel-automate">Automate</MudButton>
        }
    </MudStack>
    <SheetAutomationList @ref="_list" SheetId="Sheet.Summary.Id" CanEdit="CanEdit" Version="Version" />

    <MudText Typo="Typo.h6" HtmlTag="h2">Recent runs</MudText>
    @if (_runs is { Count: 0 })
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Nothing has run yet.</MudText>
    }
    else if (_runs is not null)
    {
        <MudSimpleTable Dense="true" Hover="true" Outlined="true">
            <thead>
                <tr><th>When</th><th>Automation</th><th>Item</th><th>Result</th></tr>
            </thead>
            <tbody>
                @foreach (var run in _runs)
                {
                    <tr @key="run.Id">
                        <td title="@run.FiredAtUtc.ToLocalTime().ToString("f")" style="white-space:nowrap">@CollaborationFormat.Ago(run.FiredAtUtc, DateTime.UtcNow)</td>
                        <td>@run.RuleName</td>
                        <td>
                            @if (run.ItemId is { } itemId && run.ItemTitle is not null)
                            {
                                <MudLink Href="@($"sheets/{Sheet.Summary.Id}?item={itemId}")">@run.ItemTitle</MudLink>
                            }
                            else
                            {
                                <span class="mud-text-secondary">(deleted)</span>
                            }
                        </td>
                        <td>
                            <MudChip T="string" Size="Size.Small" Color="@OutcomeColor(run.Outcome)" Variant="Variant.Text">@run.Outcome</MudChip>
                            <span style="overflow-wrap:anywhere">@(run.Error ?? run.Detail)</span>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</MudStack>

@code {
    [Parameter, EditorRequired]
    public SheetDetail Sheet { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<ItemDto> Items { get; set; } = [];

    /// <summary>Bumped by the page on live changes, so new runs show up.</summary>
    [Parameter]
    public int Version { get; set; }

    [CascadingParameter]
    public SheetAccess? Access { get; set; }

    private bool CanEdit => Access?.CanEdit ?? false;

    private SheetAutomationList? _list;
    private IReadOnlyList<RuleRunDto>? _runs;
    private (Guid, int)? _loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded != (Sheet.Summary.Id, Version))
        {
            _loaded = (Sheet.Summary.Id, Version);
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _runs = await Rules.ListRunsAsync(Sheet.Summary.Id, limit: 25);
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException)
        {
            _runs ??= [];
            Snackbar.Add($"Couldn't load the runs: {ex.Message}", Severity.Error);
        }
    }

    private async Task AutomateAsync()
    {
        await AutomateDialog.ShowAsync(DialogService, Sheet.Summary.Id, Sheet.Summary.Name, CanEdit);
        if (_list is not null)
        {
            await _list.LoadAsync();
        }
    }

    private static Color OutcomeColor(RuleRunOutcome outcome) => outcome switch
    {
        RuleRunOutcome.Succeeded => Color.Success,
        RuleRunOutcome.Failed => Color.Error,
        _ => Color.Warning,
    };
}
