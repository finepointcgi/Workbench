@page "/approvals"
@inject IApprovalInboxService Inbox
@inject IApprovalDelegationService Delegations
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IServiceProvider Services

<PageTitle>Approvals · Workbench</PageTitle>

@* Focus returns here after a decision removes the row whose button had it (WCAG 2.4.3). *@
<h1 class="mud-typography mud-typography-h4 mb-1" tabindex="-1" @ref="_heading">Approvals</h1>
<MudText Class="mud-text-secondary mb-4">
    Everything waiting for your decision, in one place: timesheets, expenses, purchases, bills, invoices, journal entries
    and leave, including anything for someone you're standing in for. Open an item to look at it: you can approve it right there
    and go on to the next.
</MudText>

<MudTabs Elevation="0" ApplyEffectsToContainer="true" TabPanelsClass="pt-4">
    <MudTabPanel Text="@($"Waiting on me ({_items?.Count ?? 0})")">
        @if (_result is not null)
        {
            <MudAlert Severity="@(_result.Failed == 0 ? Severity.Success : Severity.Warning)" Dense="true" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _result = null"
                      data-testid="bulk-result" role="status">
                <div>@_result.Summary</div>
                @if (_result.Failed > 0)
                {
                    <ul class="mt-1 mb-0 pl-4">
                        @foreach (var failed in _result.Items.Where(r => !r.Succeeded))
                        {
                            <li data-testid="bulk-failure">@failed.Title: @failed.Problem</li>
                        }
                    </ul>
                }
            </MudAlert>
        }

        @if (_items is null)
        {
            <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" />
        }
        else if (_items.Count == 0)
        {
            <MudText Class="mud-text-secondary" data-testid="inbox-empty">
                Nothing is waiting on you. Timesheets, expenses, purchases and invoices you need to approve will show up here.
            </MudText>
        }
        else
        {
            @* Filters: one document type (then the header checkbox selects all of that type), or time charged to projects I manage. *@
            <MudChipSet T="string" SelectedValue="_filter" SelectedValueChanged="SetFilter" SelectionMode="SelectionMode.SingleSelection" CheckMark="true"
                        Size="Size.Small" Class="mb-2" data-testid="inbox-filters" aria-label="Show">
                <MudChip T="string" Value="@All" Text="@($"All ({_items.Count})")" />
                @foreach (var group in _items.GroupBy(i => i.DocumentType).OrderBy(g => g.First().DocumentLabel))
                {
                    <MudChip T="string" Value="@($"type:{group.Key}")" Text="@($"{group.First().DocumentLabel} ({group.Count()})")" data-testid="@($"filter-{group.Key}")" />
                }
                @if (_items.Any(IsMyProjectTime) || _filter == MyProjects)
                {
                    <MudChip T="string" Value="@MyProjects" Text="@($"Time on my projects ({_items.Count(IsMyProjectTime)})")" data-testid="filter-my-projects"
                             title="Timesheet hours charged to projects you manage" />
                }
            </MudChipSet>

            @if (_selected.Count > 0)
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3 d-flex flex-wrap align-center gap-2" data-testid="bulk-bar">
                    <MudText Typo="Typo.subtitle2" Class="mr-2" data-testid="bulk-count">@_selected.Count selected</MudText>
                    <MudTextField @bind-Value="_bulkComment" Immediate="true" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width:260px; flex:1"
                                  Label="Comment (optional; required to reject)" data-testid="bulk-comment" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="() => BulkAsync(ApprovalDecisionKind.Approve)" data-testid="bulk-approve">
                        Approve @_selected.Count
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_busy || string.IsNullOrWhiteSpace(_bulkComment)" OnClick="() => BulkAsync(ApprovalDecisionKind.Reject)"
                               data-testid="bulk-reject" title="Say why in the comment to reject">
                        Reject @_selected.Count
                    </MudButton>
                    <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="() => _selected = []">Clear</MudButton>
                </MudPaper>
            }

            @if (Visible.Count == 0)
            {
                <MudText Class="mud-text-secondary" data-testid="inbox-filter-empty">
                    @(_filter == MyProjects
                        ? "No time on your projects is waiting on you. Project managers approve hours charged to their projects when the timesheet workflow has a project manager step (Setup › Approval workflows)."
                        : "Nothing here.")
                </MudText>
            }
            else
            {
            @* Wide windows: a compact table whose action column never scrolls away. Below 960px (Sm and smaller) each row becomes
               a card (MudTable's DataLabel layout), with the actions full width at the bottom. *@
            <div class="wb-inbox-host">
            <MudTable T="ApprovalInboxItemDto" Items="Visible" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm" Class="wb-inbox" data-testid="inbox" aria-label="Approvals waiting on me"
                      MultiSelection="true" SelectOnRowClick="false" @bind-SelectedItems="_selected">
                <HeaderContent>
                    <MudTh>What</MudTh>
                    <MudTh>From</MudTh>
                    <MudTh Style="text-align:right">Amount</MudTh>
                    <MudTh>Waiting</MudTh>
                    <MudTh Style="text-align:right">Decide</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="What" data-testid="inbox-item">
                        <MudChip T="string" Size="Size.Small" Class="ml-0">@context.DocumentLabel</MudChip>
                        <MudLink Href="@context.Link">@context.Title</MudLink>
                        @if (context.DocumentType == ApprovalDocumentTypes.Timesheet)
                        {
                            <Workbench.Ui.Assistant.TimesheetFlagsButton Flags="@_flags.GetValueOrDefault(context.DocumentId)" />
                        }
                        @if (context.Summary is not null)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@context.Summary</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="From">
                        <div class="wb-inbox-wrap" title="@context.SubmitterEmail">@context.Submitter</div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                            @context.StepName @(context.ScopeLabel is null ? "" : $"({context.ScopeLabel})")@(context.OnBehalfOf is null ? "" : $" · for {context.OnBehalfOf}")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Amount" Style="text-align:right; white-space:nowrap">@(ApprovalDocumentTypes.AmountIsHours(context.DocumentType) ? $"{context.Amount:0.0} h" : context.Amount?.ToString("C"))</MudTd>
                    <MudTd DataLabel="Waiting" Style="white-space:nowrap">@(context.BusinessDaysWaiting == 0 ? "Today" : context.BusinessDaysWaiting == 1 ? "1 business day" : $"{context.BusinessDaysWaiting} business days")</MudTd>
                    <MudTd DataLabel="Decide" Class="wb-inbox-actions">
                        <div class="d-flex flex-wrap gap-1 justify-end">
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="() => ApproveAsync(context)" data-testid="approve" aria-label="@($"Approve {context.Title}")">Approve</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="_busy" OnClick="() => DecideWithReasonAsync(context, ApprovalDecisionKind.Return)" data-testid="return"
                                       title="Send it back so the submitter can fix it" aria-label="@($"Return {context.Title}")">Return</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Disabled="_busy" OnClick="() => DecideWithReasonAsync(context, ApprovalDecisionKind.Reject)" data-testid="reject" aria-label="@($"Reject {context.Title}")">Reject</MudButton>
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.History" title="Approval history" aria-label="@($"Approval history, {context.Title}")" OnClick="() => HistoryAsync(context)" />
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
            </div>
            }
        }
    </MudTabPanel>
    <MudTabPanel Text="Delegations">
        <MudText Class="mud-text-secondary mb-3">
            Out of office? Let someone decide your approvals between two dates. Each decision records that it was made on your behalf.
        </MudText>
        <MudGrid>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_delegate" Label="Delegate's email" autocomplete="off" data-testid="delegate-email" /></MudItem>
            <MudItem xs="6" sm="2"><MudDatePicker DateFormat="yyyy-MM-dd" @bind-Date="_from" Label="From" /></MudItem>
            <MudItem xs="6" sm="2"><MudDatePicker DateFormat="yyyy-MM-dd" @bind-Date="_to" Label="To" /></MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="string" @bind-Value="_type" Label="Documents" Clearable="true" Placeholder="All approvals">
                    @foreach (var type in ApprovalDocumentTypes.All)
                    {
                        <MudSelectItem Value="type">@ApprovalDocumentTypes.Label(type)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="8"><MudTextField @bind-Value="_reason" Label="Reason (optional)" /></MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy || string.IsNullOrWhiteSpace(_delegate) || _from is null || _to is null"
                           OnClick="DelegateAsync" data-testid="add-delegation">Delegate</MudButton>
            </MudItem>
        </MudGrid>
        <MudSimpleTable Dense="true" Elevation="0" Class="mt-4">
            <thead><tr><th>From</th><th>To</th><th>Dates</th><th>Documents</th><th>Reason</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var d in _delegations ?? [])
                {
                    <tr>
                        <td>@d.DelegatorEmail</td>
                        <td>@d.DelegateEmail</td>
                        <td>@d.StartsOn.ToString("MMM d") – @d.EndsOn.ToString("MMM d, yyyy")</td>
                        <td>@(d.DocumentType is null ? "All" : ApprovalDocumentTypes.Label(d.DocumentType))</td>
                        <td>@d.Reason</td>
                        <td>@(d.RevokedAtUtc is not null ? "Ended" : d.IsActive ? "Active" : d.EndsOn < DateOnly.FromDateTime(DateTime.Today) ? "Over" : "Scheduled")</td>
                        <td>
                            @if (d.RevokedAtUtc is null)
                            {
                                <MudButton Size="Size.Small" Disabled="_busy" OnClick="() => RevokeAsync(d)">End</MudButton>
                            }
                        </td>
                    </tr>
                }
                @if (_delegations is { Count: 0 })
                {
                    <tr><td colspan="7" class="mud-text-secondary">No delegations. Going on leave? Pick someone above to approve for you while you're away.</td></tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudTabPanel>
</MudTabs>

@code {
    private const string All = "all";
    private const string MyProjects = "my-projects";

    private IReadOnlyList<ApprovalInboxItemDto>? _items;
    private HashSet<ApprovalInboxItemDto> _selected = [];
    private string _filter = All;
    private string? _bulkComment;
    private BulkApprovalResultDto? _result;

    [SupplyParameterFromQuery(Name = "show")]
    public string? Show { get; set; }

    private static bool IsMyProjectTime(ApprovalInboxItemDto item) => item.DocumentType == ApprovalDocumentTypes.Timesheet && item.ProjectId is not null;

    // Kept in a field: the table keeps its selection only while its Items stay the same list.
    private IReadOnlyList<ApprovalInboxItemDto> Visible { get; set; } = [];

    private void Refilter() => Visible = (_items ?? []).Where(i => _filter switch
    {
        All => true,
        MyProjects => IsMyProjectTime(i),
        _ => _filter == $"type:{i.DocumentType}",
    }).ToList();

    private void SetFilter(string? filter)
    {
        _filter = filter ?? All;
        Refilter();
        // Selection follows the filter, so "select all" never reaches rows you can't see.
        _selected = _selected.Where(Visible.Contains).ToHashSet();
    }

    private async Task BulkAsync(ApprovalDecisionKind kind)
    {
        var picked = _selected.Where(Visible.Contains).ToList();
        if (picked.Count == 0)
        {
            return;
        }

        _busy = true;
        try
        {
            _result = await Inbox.DecideManyAsync(new BulkApprovalRequest(picked.Select(i => new ApprovalItemRef(i.DocumentType, i.DocumentId)).ToList(), kind, _bulkComment));
            _selected = [];
            _bulkComment = null;
            await LoadAsync();
            if (Visible.Count == 0)
            {
                _filter = All;
                Refilter();
            }

            _refocus = true;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException or WorkbenchNotFoundException or HttpRequestException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
    private IReadOnlyList<ApprovalDelegationDto>? _delegations;
    private IReadOnlyDictionary<Guid, Workbench.Contracts.Assistant.TimesheetFlagsDto> _flags = new Dictionary<Guid, Workbench.Contracts.Assistant.TimesheetFlagsDto>();
    private bool _busy;
    private string? _delegate;
    private DateTime? _from = DateTime.Today;
    private DateTime? _to = DateTime.Today.AddDays(7);
    private string? _type;
    private string? _reason;

    protected override async Task OnInitializedAsync()
    {
        if (Show == MyProjects)
        {
            _filter = MyProjects;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _items = await Inbox.ListMineAsync();
        Refilter();
        _delegations = await Delegations.ListAsync();
        _flags = await Workbench.Ui.Assistant.TimesheetFlagLoader.LoadAsync(Services, _items.Where(i => i.DocumentType == ApprovalDocumentTypes.Timesheet).Select(i => i.DocumentId));
    }

    private Task ApproveAsync(ApprovalInboxItemDto item) => RunAsync(item, new ApprovalDecisionRequest(ApprovalDecisionKind.Approve), "Approved");

    private async Task DecideWithReasonAsync(ApprovalInboxItemDto item, ApprovalDecisionKind kind)
    {
        var parameters = new DialogParameters<ApprovalReasonDialog>
        {
            { d => d.Message, $"{item.DocumentLabel}: {item.Title}" },
            { d => d.Label, kind == ApprovalDecisionKind.Return ? "What needs to change?" : "Reason" },
            { d => d.ConfirmText, kind == ApprovalDecisionKind.Return ? "Return" : "Reject" },
        };
        var dialog = await DialogService.ShowAsync<ApprovalReasonDialog>(kind == ApprovalDecisionKind.Return ? "Return for changes" : "Reject", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string reason })
        {
            await RunAsync(item, new ApprovalDecisionRequest(kind, reason), kind == ApprovalDecisionKind.Return ? "Returned for changes" : "Rejected");
        }
    }

    private ElementReference _heading;
    private bool _refocus;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_refocus)
        {
            _refocus = false;
            await _heading.FocusAsync();
        }
    }

    private async Task RunAsync(ApprovalInboxItemDto item, ApprovalDecisionRequest request, string done)
    {
        _busy = true;
        try
        {
            await Inbox.DecideAsync(item.DocumentType, item.DocumentId, request);
            Snackbar.Add($"{done}: {item.Title}", Severity.Success);
            _selected.Remove(item);
            await LoadAsync();
            _refocus = true;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException or WorkbenchNotFoundException or HttpRequestException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task HistoryAsync(ApprovalInboxItemDto item)
    {
        var parameters = new DialogParameters<ApprovalHistoryDialog> { { d => d.DocumentType, item.DocumentType }, { d => d.DocumentId, item.DocumentId } };
        await DialogService.ShowAsync<ApprovalHistoryDialog>($"Approval history: {item.Title}", parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
    }

    private async Task DelegateAsync()
    {
        _busy = true;
        try
        {
            await Delegations.CreateAsync(new SaveApprovalDelegationRequest(_delegate!, DateOnly.FromDateTime(_from!.Value), DateOnly.FromDateTime(_to!.Value), _type, _reason));
            Snackbar.Add($"Delegated to {_delegate}", Severity.Success);
            _delegate = null;
            _reason = null;
            _delegations = await Delegations.ListAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException or HttpRequestException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RevokeAsync(ApprovalDelegationDto d)
    {
        try
        {
            await Delegations.RevokeAsync(d.Id);
            _delegations = await Delegations.ListAsync();
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or WorkbenchNotFoundException or HttpRequestException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
