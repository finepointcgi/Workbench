@* Names a view of the grid, shares it with the sheet (editors) and makes it a default. *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="Name" Label="View name" Required="true" AutoFocus="true" Immediate="true" MaxLength="120" data-testid="view-name" />
            @if (CanShare)
            {
                <MudSwitch T="bool" @bind-Value="IsShared" Color="Color.Primary" Label="Share with everyone on this sheet" data-testid="view-shared" />
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Only you see this view. People who edit the sheet can share views.</MudText>
            }
            <MudCheckBox T="bool" @bind-Value="IsMyDefault" Label="Open the sheet with this view for me" Dense="true" data-testid="view-my-default" />
            @if (CanShare && IsShared)
            {
                <MudCheckBox T="bool" @bind-Value="IsSheetDefault" Label="Open the sheet with this view for everyone" Dense="true" data-testid="view-sheet-default" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="string.IsNullOrWhiteSpace(Name)" OnClick="Submit" data-testid="view-save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public bool IsShared { get; set; }

    [Parameter]
    public bool CanShare { get; set; }

    [Parameter]
    public bool IsMyDefault { get; set; }

    [Parameter]
    public bool IsSheetDefault { get; set; }

    private void Submit() =>
        MudDialog.Close(DialogResult.Ok(new SaveViewResult(Name.Trim(), CanShare && IsShared, IsMyDefault, CanShare && IsShared && IsSheetDefault)));
}
