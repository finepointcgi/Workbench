@* Names a view of the grid, shares it with the sheet (editors) and makes it a default. *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="_name" Label="View name" Required="true" AutoFocus="true" Immediate="true" MaxLength="120" data-testid="view-name"
                          Error="_blank" ErrorText="Give the view a name." OnKeyDown="NameKeyAsync" />
            @if (CanShare)
            {
                <MudSwitch T="bool" @bind-Value="_shared" Color="Color.Primary" Label="Share with everyone on this sheet" data-testid="view-shared" />
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Only you see this view. People who edit the sheet can share views.</MudText>
            }
            <MudCheckBox T="bool" @bind-Value="_myDefault" Label="Open the sheet with this view for me" Dense="true" data-testid="view-my-default" />
            @if (CanShare && _shared)
            {
                <MudCheckBox T="bool" @bind-Value="_sheetDefault" Label="Open the sheet with this view for everyone" Dense="true" data-testid="view-sheet-default" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" data-testid="view-save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public bool IsShared { get; set; }

    [Parameter]
    public bool CanShare { get; set; }

    [Parameter]
    public bool IsMyDefault { get; set; }

    [Parameter]
    public bool IsSheetDefault { get; set; }

    // The dialog's own copies: parameters are set again whenever the dialog re-renders.
    private string _name = string.Empty;
    private bool _shared;
    private bool _myDefault;
    private bool _sheetDefault;

    protected override void OnInitialized() => (_name, _shared, _myDefault, _sheetDefault) = (Name, IsShared, IsMyDefault, IsSheetDefault);

    private bool _blank;

    private void Submit()
    {
        _blank = string.IsNullOrWhiteSpace(_name);
        if (!_blank)
        {
            MudDialog.Close(DialogResult.Ok(new SaveViewResult(_name.Trim(), CanShare && _shared, _myDefault, CanShare && _shared && _sheetDefault)));
        }
    }

    private async Task NameKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Task.Yield(); // let the typed name bind first
            Submit();
        }
    }
}
