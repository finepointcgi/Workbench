@* Adds a column, or edits the name and options of an existing one (the type can't change). *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_name" Label="Name" Required="true" AutoFocus="true" Immediate="true" />
            @if (Column is null)
            {
                <MudSelect T="ColumnKind" Value="_type" ValueChanged="SetType" Label="Type" data-testid="column-type">
                    @foreach (var kind in Enum.GetValues<ColumnKind>())
                    {
                        <MudSelectItem T="ColumnKind" Value="kind">@CellFormat.KindName(kind)</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Type: @CellFormat.KindName(_type)</MudText>
            }
            @if (_type == ColumnKind.Symbol)
            {
                <MudSelect T="string" @bind-Value="_symbols" Label="Symbols" data-testid="symbol-set">
                    @foreach (var set in SymbolSets.All)
                    {
                        <MudSelectItem T="string" Value="set">
                            @foreach (var option in SymbolSets.Options(set).Take(4))
                            {
                                <span style="color:@option.Color.Background" aria-hidden="true">@option.Glyph </span>
                            }
                            @SymbolSets.Name(set)
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-n2">Each symbol shows its name too (Red, High, 3 stars), so it never relies on color.</MudText>
            }
            else if (_type == ColumnKind.AutoNumber)
            {
                <MudStack Row="true" Spacing="2">
                    <MudTextField T="string" @bind-Value="_prefix" Label="Prefix" Placeholder="REQ-" MaxLength="20" Immediate="true" data-testid="autonumber-prefix" />
                    <MudNumericField T="int" @bind-Value="_digits" Label="Digits" Min="0" Max="10" data-testid="autonumber-digits" />
                    @if (Column is null)
                    {
                        <MudNumericField T="int" @bind-Value="_start" Label="Start at" Min="0" data-testid="autonumber-start" />
                    }
                </MudStack>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-n2">
                    Every row gets the next number when it's added, like @ColumnValues.AutoNumber([_prefix ?? string.Empty, _digits.ToString(), _start.ToString()], _start). Numbers are never reused@(Column is null ? "; rows already on the sheet are numbered in order" : "").
                </MudText>
            }
            else if (ColumnValues.IsSystem(_type))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Filled in by Workbench for every row and can't be edited.</MudText>
            }
            else if (_type == ColumnKind.Progress)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Percent complete from 0 to 100, shown as a bar with the number.</MudText>
            }
            else if (_type == ColumnKind.Hyperlink)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">A web address, with optional text to show instead of it.</MudText>
            }
            @if (_type is ColumnKind.Dropdown or ColumnKind.MultiSelect)
            {
                @* Status labels: each option has a color from an accessible palette (its text stays readable) and always shows its name. *@
                <MudText Typo="Typo.subtitle2">Labels</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-n2">@(_type == ColumnKind.MultiSelect ? "People pick any number of these." : "People pick a label with one click.") The order here is the order labels sort in.</MudText>
                @for (var i = 0; i < _labels.Count; i++)
                {
                    var index = i;
                    var label = _labels[index];
                    var color = StatusColors.Find(label.Color) ?? StatusColors.Suggest(label.Name);
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" data-testid="status-label">
                        <span class="wb-pill" style="background:@color.Background;color:@color.Text;min-width:96px" aria-hidden="true">@(string.IsNullOrWhiteSpace(label.Name) ? "Label" : label.Name)</span>
                        <MudTextField T="string" @bind-Value="label.Name" Label="@($"Label {index + 1}")" Margin="Margin.Dense" Immediate="true" MaxLength="100"
                                      data-testid="status-label-name" />
                        <MudSelect T="string" Value="color.Key" ValueChanged="key => label.Color = key" Label="Color" Dense="true" Margin="Margin.Dense" Style="max-width:150px"
                                   data-testid="status-label-color">
                            @foreach (var option in StatusColors.All)
                            {
                                <MudSelectItem T="string" Value="option.Key">
                                    <span class="wb-swatch" style="background:@option.Background" aria-hidden="true"></span> @option.Name
                                </MudSelectItem>
                            }
                        </MudSelect>
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="index == 0" aria-label="@($"Move {label.Name} up")" OnClick="() => MoveLabel(index, -1)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="@($"Remove {label.Name}")" OnClick="() => _labels.RemoveAt(index)" />
                    </MudStack>
                }
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Style="align-self:flex-start"
                           OnClick="AddLabel" data-testid="status-label-add">Add label</MudButton>
            }
            @* Wave E: formula, link-to-row and lookup settings. *@
            <Workbench.Ui.Sheets.ColumnExtras SheetId="SheetId" Type="_type" Column="Column" State="_extras" Changed="@(() => { })" />
            @if (CanRestrict)
            {
                @if (Column?.ReadsRestricted == true)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Icon="@Icons.Material.Filled.Lock">
                        This formula reads a restricted column, so it's restricted too.
                    </MudAlert>
                }
                else
                {
                    <MudSwitch T="bool" @bind-Value="_restricted" Color="Color.Primary" data-testid="restrict-column"
                               Label="Finance and owners only" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-n2">
                        Only Finance, administrators and this workspace's owners see the column, its values and any formula that reads it.
                    </MudText>
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="string.IsNullOrWhiteSpace(_name) || !_extras.IsComplete(_type)" OnClick="Submit">@(Column is null ? "Add" : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>The column to edit, or null to add a new one.</summary>
    [Parameter]
    public ColumnDto? Column { get; set; }

    /// <summary>Whether to offer "Finance and owners only" (the user may see and set restricted columns).</summary>
    [Parameter]
    public bool CanRestrict { get; set; }

    /// <summary>The sheet, for formula help and link settings (Guid.Empty hides them).</summary>
    [Parameter]
    public Guid SheetId { get; set; }

    private readonly Workbench.Ui.Sheets.ColumnExtrasState _extras = new();

    private string _name = string.Empty;
    private ColumnKind _type = ColumnKind.Text;
    private sealed class Label
    {
        public string Name { get; set; } = string.Empty;
        public string Color { get; set; } = string.Empty;
    }

    private readonly List<Label> _labels = [];
    private bool _restricted;
    private string _symbols = SymbolSets.Rag;
    private string? _prefix;
    private int _digits = 3;
    private int _start = 1;

    protected override void OnInitialized()
    {
        if (Column is not null)
        {
            _name = Column.Name;
            _type = Column.Type;
            _labels.AddRange(Column.Options.Select(o => new Label { Name = o, Color = Column.ColorOf(o).Key }));
            _restricted = Column.IsRestricted;
            _symbols = Column.Type == ColumnKind.Symbol ? SymbolSets.Of(Column) : SymbolSets.Rag;
            if (Column.Type == ColumnKind.AutoNumber)
            {
                (_prefix, _digits, _start) = ColumnValues.AutoNumberSettings(Column.Options);
            }
        }
        else
        {
            // A new status column starts with the usual labels; they're easy to rename or remove.
            _labels.AddRange(StatusColors.Defaults.Select(d => new Label { Name = d.Label, Color = d.Color.Key }));
        }
    }

    private void SetType(ColumnKind type)
    {
        // A multi-select starts with no choices (the status defaults suit a status column); switching back restores them.
        if (Column is null && (type == ColumnKind.MultiSelect) != (_type == ColumnKind.MultiSelect))
        {
            _labels.Clear();
            if (type != ColumnKind.MultiSelect)
            {
                _labels.AddRange(StatusColors.Defaults.Select(d => new Label { Name = d.Label, Color = d.Color.Key }));
            }
        }

        _type = type;
    }

    private void AddLabel() => _labels.Add(new Label { Color = StatusColors.Gray.Key });

    private void MoveLabel(int index, int by)
    {
        var label = _labels[index];
        _labels.RemoveAt(index);
        _labels.Insert(Math.Clamp(index + by, 0, _labels.Count), label);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        var labels = _type is ColumnKind.Dropdown or ColumnKind.MultiSelect
            ? _labels.Where(l => !string.IsNullOrWhiteSpace(l.Name)).DistinctBy(l => l.Name.Trim(), StringComparer.OrdinalIgnoreCase).ToList()
            : [];
        var options = _type switch
        {
            ColumnKind.Symbol => [_symbols],
            ColumnKind.AutoNumber => [(_prefix ?? string.Empty).Trim(), Math.Clamp(_digits, 0, 10).ToString(System.Globalization.CultureInfo.InvariantCulture),
                Math.Max(0, _start).ToString(System.Globalization.CultureInfo.InvariantCulture)],
            _ => _extras.OptionsFor(_type)?.ToList() ?? labels.Select(l => l.Name.Trim()).ToList(),
        };
        MudDialog.Close(DialogResult.Ok(new ColumnDialogResult(_name.Trim(), _type, options, _restricted,
            OptionColors: _type is ColumnKind.Dropdown or ColumnKind.MultiSelect ? labels.Select(l => l.Color).ToList() : null,
            Formula: ColumnValues.IsAutomatic(_type) ? null : _extras.FormulaFor(_type, Column))));
    }
}
