@* Spreadsheet-style grid: virtualized rows, hierarchy, inline editing, keyboard navigation, row and column actions. *@
@inherits SheetViewBase
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using Microsoft.Extensions.DependencyInjection
@using Workbench.Contracts.Scheduling
@inject IItemService ItemService
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject IColumnService ColumnService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

@* ARIA grid: focus stays on the container and aria-activedescendant points screen readers at the active cell, so
   moving with the arrow keys announces the cell (its column header and value). The table is presentational; the rows
   and cells carry the grid roles. *@
<div class="wb-grid-toolbar" role="toolbar" aria-label="Grid tools">
    @if (ViewService is not null)
    {
        <MudMenu Label="@ViewName" StartIcon="@Icons.Material.Filled.ViewList" EndIcon="@Icons.Material.Filled.ArrowDropDown" Variant="Variant.Text"
                 Size="Size.Small" Dense="true" AriaLabel="@($"Views: {ViewName}")" data-testid="grid-views">
            <MudMenuItem Icon="@(_savedView is null ? Icons.Material.Filled.Check : Icons.Material.Filled.TableRows)" OnClick="() => UseView(null)">Standard view</MudMenuItem>
            @foreach (var view in _views?.Views ?? [])
            {
                var isDefault = _views!.DefaultView?.Id == view.Id;
                <MudMenuItem Icon="@(_savedView?.Id == view.Id ? Icons.Material.Filled.Check : view.IsShared ? Icons.Material.Filled.Group : Icons.Material.Filled.Person)"
                             OnClick="() => UseView(view)" data-testid="grid-view-option">
                    @view.Name<span class="mud-text-secondary">@(view.IsShared ? " · shared" : " · just you")@(isDefault ? " · opens first" : "")</span>
                </MudMenuItem>
            }
            <MudDivider />
            @if (_savedView is { CanEdit: true } changedView && ViewChanged)
            {
                <MudMenuItem Icon="@Icons.Material.Filled.Save" OnClick="() => SaveViewAsync(false)" data-testid="grid-update-view">Save changes to "@changedView.Name"</MudMenuItem>
            }
            <MudMenuItem Icon="@Icons.Material.Filled.SaveAs" OnClick="() => SaveViewAsync(true)" data-testid="grid-save-view">Save as a new view…</MudMenuItem>
            @if (_savedView is { } current)
            {
                <MudMenuItem Icon="@Icons.Material.Filled.Star" OnClick="() => SetMyDefaultAsync(_views?.MyDefaultViewId == current.Id ? null : current)">
                    @(_views?.MyDefaultViewId == current.Id ? "Stop opening with this view" : "Open the sheet with this view")
                </MudMenuItem>
                @if (_views?.CanShare == true && current.IsShared)
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.Groups" OnClick="() => SetSheetDefaultAsync(_views.SheetDefaultViewId == current.Id ? null : current)">
                        @(_views.SheetDefaultViewId == current.Id ? "Stop being everyone's default" : "Make it everyone's default")
                    </MudMenuItem>
                }
                @if (current.CanEdit)
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="() => SaveViewAsync(false)">Rename or share…</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="() => DeleteViewAsync(current)">Delete view</MudMenuItem>
                }
            }
        </MudMenu>
    }
    <MudButton StartIcon="@Icons.Material.Filled.Sort" Size="Size.Small" Variant="Variant.Text" OnClick="SortDialogAsync" data-testid="grid-sort"
               Color="@(_view.HasSort ? Color.Primary : Color.Default)">Sort@(_view.HasSort ? $" ({_view.Sort!.Count})" : "")</MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.FilterList" Size="Size.Small" Variant="Variant.Text" OnClick="() => FilterDialogAsync()" data-testid="grid-filter"
               Color="@(_view.HasFilters ? Color.Primary : Color.Default)">Filter@(_view.HasFilters ? $" ({_view.Filters!.Count})" : "")</MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.ViewColumn" Size="Size.Small" Variant="Variant.Text" OnClick="ColumnsDialogAsync" data-testid="grid-columns"
               Color="@(_view.HiddenColumns is { Count: > 0 } ? Color.Primary : Color.Default)">Columns@(_view.HiddenColumns is { Count: > 0 } hiddenCols ? $" ({hiddenCols.Count} hidden)" : "")</MudButton>
    @if (CanCompareBaselines && (_baselines.Count > 0 || CanEdit))
    {
        <MudMenu Label="@(ComparedBaseline is { } compared ? $"Baseline: {compared.Name}" : "Baseline")" StartIcon="@Icons.Material.Filled.Compare"
                 EndIcon="@Icons.Material.Filled.ArrowDropDown" Variant="Variant.Text" Size="Size.Small" Dense="true"
                 Color="@(_view.BaselineId is null ? Color.Default : Color.Primary)" AriaLabel="Compare to a baseline" data-testid="grid-baseline">
            <MudMenuItem Icon="@(_view.BaselineId is null ? Icons.Material.Filled.Check : null)" OnClick="() => CompareTo(null)">Don't compare</MudMenuItem>
            @foreach (var baseline in _baselines)
            {
                <MudMenuItem Icon="@(_view.BaselineId == baseline.Id ? Icons.Material.Filled.Check : Icons.Material.Filled.History)" OnClick="() => CompareTo(baseline)"
                             data-testid="grid-baseline-option">
                    @baseline.Name<span class="mud-text-secondary"> · @baseline.CapturedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</span>
                </MudMenuItem>
            }
            @if (CanEdit)
            {
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.AddTask" OnClick="SaveBaselineAsync" data-testid="grid-save-baseline">Save a baseline of the plan now</MudMenuItem>
            }
        </MudMenu>
    }
    @if (RuleService is not null && (CanEdit || _rules.Rules.Count > 0))
    {
        <MudButton StartIcon="@Icons.Material.Filled.FormatColorFill" Size="Size.Small" Variant="Variant.Text" OnClick="FormatRulesDialogAsync" data-testid="grid-formatting"
                   Color="@(_rules.Rules.Count > 0 ? Color.Primary : Color.Default)">Formatting@(_rules.Rules.Count > 0 ? $" ({_rules.Rules.Count})" : "")</MudButton>
    }
    @if (CanShowFloat)
    {
        <MudMenu Label="@(_view.CriticalOnly ? "Critical only" : "Float")" StartIcon="@Icons.Material.Filled.Timeline" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                 Variant="Variant.Text" Size="Size.Small" Dense="true" Color="@(_view.ShowFloat || _view.CriticalOnly ? Color.Primary : Color.Default)"
                 AriaLabel="Float and critical path" data-testid="grid-float">
            <MudMenuItem Icon="@(_view.ShowFloat ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)" OnClick="ToggleFloatColumns"
                         data-testid="grid-float-columns">Show total and free float</MudMenuItem>
            <MudMenuItem Icon="@(_view.CriticalOnly ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)" OnClick="ToggleCriticalOnly"
                         data-testid="grid-critical-only">Critical tasks only</MudMenuItem>
        </MudMenu>
    }
    @if (CanEdit)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" Disabled="!_history.CanUndo" OnClick="UndoAsync" data-testid="grid-undo"
                       aria-label="@(_history.UndoLabel is { } u ? $"Undo {u.ToLowerInvariant()} (Ctrl+Z)" : "Undo (Ctrl+Z)")" title="@(_history.UndoLabel is { } ut ? $"Undo {ut.ToLowerInvariant()} (Ctrl+Z)" : "Undo (Ctrl+Z)")" />
        <MudIconButton Icon="@Icons.Material.Filled.Redo" Size="Size.Small" Disabled="!_history.CanRedo" OnClick="RedoAsync" data-testid="grid-redo"
                       aria-label="@(_history.RedoLabel is { } r ? $"Redo {r.ToLowerInvariant()} (Ctrl+Y)" : "Redo (Ctrl+Y)")" title="@(_history.RedoLabel is { } rt ? $"Redo {rt.ToLowerInvariant()} (Ctrl+Y)" : "Redo (Ctrl+Y)")" />
    }
    @if (ViewService is not null)
    {
        <MudMenu Label="Export" StartIcon="@Icons.Material.Filled.Download" EndIcon="@Icons.Material.Filled.ArrowDropDown" Variant="Variant.Text" Size="Size.Small"
                 Dense="true" AriaLabel="Export the sheet" data-testid="grid-export">
            <MudMenuItem Icon="@Icons.Material.Filled.TableView" OnClick="() => ExportAsync(SheetExportFormat.Xlsx, true)" data-testid="export-xlsx">@(_view.IsStandard ? "Excel (.xlsx)" : "This view to Excel (.xlsx)")</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf" OnClick="() => ExportAsync(SheetExportFormat.Pdf, true)" data-testid="export-pdf">@(_view.IsStandard ? "PDF" : "This view to PDF")</MudMenuItem>
            @if (!_view.IsStandard)
            {
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.TableView" OnClick="() => ExportAsync(SheetExportFormat.Xlsx, false)">Whole sheet to Excel</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf" OnClick="() => ExportAsync(SheetExportFormat.Pdf, false)">Whole sheet to PDF</MudMenuItem>
            }
        </MudMenu>
    }
    <MudSpacer />
    @if (Tasks is not null)
    {
        <MudSwitch T="bool" Value="_myTasks" ValueChanged="SetMyTasks" Color="Color.Primary" Size="Size.Small" Label="My tasks" data-testid="grid-my-tasks" />
    }
</div>
@if (_myTasks || _view.HasSort || _view.HasFilters || ViewChanged || (_view.CriticalOnly && CanShowFloat))
{
    <div class="wb-view-chips" data-testid="grid-view-summary">
        @if (_view.CriticalOnly && CanShowFloat)
        {
            <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Timeline" OnClose="_ => ToggleCriticalOnly()" data-testid="critical-chip">Critical tasks only</MudChip>
        }
        @foreach (var sort in _view.Sort ?? [])
        {
            <MudChip T="string" Size="Size.Small" Icon="@(sort.Descending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)"
                     OnClose="_ => ClearSort()">Sorted by @FieldName(sort.Field)@(sort.Descending ? " (descending)" : "")</MudChip>
        }
        @foreach (var filter in _view.Filters ?? [])
        {
            <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.FilterList" OnClick="() => FilterDialogAsync()"
                     OnClose="_ => RemoveFilter(filter)" data-testid="filter-chip">@Describe(filter)</MudChip>
        }
        <MudText Typo="Typo.caption" Class="mud-text-secondary" role="status">
            @if (_myTasks)
            {
                @($"Showing {_rows.Count} {(_rows.Count == 1 ? "row" : "rows")} assigned to you (and their parents).")
            }
            else if (_view.HasFilters || (_view.CriticalOnly && CanShowFloat))
            {
                @($"Showing {_rows.Count} of {Items.Count} rows.")
            }
            @if (Rearranged && CanEdit)
            {
                @(" Clear the sort and filter to indent or insert rows.")
            }
        </MudText>
        @if (_view.HasSort || _view.HasFilters)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => SetView(_view with { Sort = [], Filters = [] })" data-testid="grid-clear-view">Clear sort and filter</MudButton>
        }
        @if (ViewChanged && ViewService is not null)
        {
            @if (_savedView is not null)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ResetView">Reset to "@_savedView.Name"</MudButton>
            }
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="() => SaveViewAsync(_savedView is not { CanEdit: true })" data-testid="grid-save-view-button">Save view</MudButton>
        }
    </div>
}
<div class="wb-grid" @ref="_container" tabindex="0" role="grid" aria-label="@Sheet.Summary.Name"
     aria-rowcount="@(_rows.Count + 1)" aria-colcount="@(_columns.Count + 2)" style="max-height:@Height"
     aria-activedescendant="@(ActiveRow is not null && ActiveColumn is not null ? ActiveCellId : null)"
     aria-describedby="@($"{_gridId}-help")"
     @onkeydown="OnKeyDownAsync">
    <span id="@($"{_gridId}-help")" class="wb-sr-only">Arrow keys move between cells. Enter or F2 edits a cell, Enter saves, Escape cancels. Space toggles a checkbox. Shift with the arrow keys selects a range; Control+C copies it.@(CanEdit ? " Control+V pastes, Control+D fills down, Delete clears, Control+Z undoes and Control+Y redoes. Enter on a status cell opens its labels. In the Title column, Tab indents a row and Shift+Tab outdents it; Insert adds a row above." : "")</span>
    <table class="wb-table" style="width:@(TableWidth)px" role="presentation">
        <colgroup>
            <col style="width:@(GutterWidth)px" />
            @foreach (var column in _columns)
            {
                <col data-key="@column.Key" style="width:@(WidthOf(column))px" />
            }
            <col style="width:@(AddColumnWidth)px" />
        </colgroup>
        <thead role="rowgroup">
            <tr role="row" aria-rowindex="1">
                <th class="wb-gutter wb-sticky" role="columnheader" aria-colindex="1">
                    <span class="wb-sr-only">Row</span>
                    <MudMenu Icon="@Icons.Material.Filled.UnfoldMore" Size="Size.Small" Dense="true" AriaLabel="Rows">
                        <MudMenuItem Icon="@Icons.Material.Filled.UnfoldMore" OnClick="ExpandAll">Expand all</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.UnfoldLess" OnClick="CollapseAll">Collapse all</MudMenuItem>
                    </MudMenu>
                </th>
                @for (var c = 0; c < _columns.Count; c++)
                {
                    var column = _columns[c];
                    <th data-col="@c" class="@(column.Kind == GridColumnKind.Title ? "wb-title wb-sticky" : null)" title="@HeaderTooltip(column)"
                        role="columnheader" aria-colindex="@(c + 2)">
                        <div class="wb-th">
                            @if (column.IsFormula)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Functions" Size="Size.Small" Class="wb-fx" aria-hidden="true" /><span class="wb-sr-only">Formula column:</span>
                            }
                            @if (column.IsRestricted)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="wb-fx" aria-label="Restricted column" data-testid="restricted-icon" />
                            }
                            <span class="wb-th-name">@column.Name</span>
                            @if (_view.Sort?.FirstOrDefault(s => s.Field == column.Key) is { } sorted)
                            {
                                <MudIcon Icon="@(sorted.Descending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)" Size="Size.Small" Class="wb-fx"
                                         aria-label="@(sorted.Descending ? "Sorted descending" : "Sorted ascending")" />
                            }
                            @if (_view.Filters?.Any(f => f.Field == column.Key) == true)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" Class="wb-fx" aria-label="Filtered" />
                            }
                            <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" Dense="true" Class="wb-th-menu"
                                     AriaLabel="@($"{column.Name} column actions")">
                                @if (column.Column is { } custom && CanEdit)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="() => EditColumnAsync(custom)">Rename</MudMenuItem>
                                    @if (Sheet.CanSeeRestricted && !custom.ReadsRestricted)
                                    {
                                        <MudMenuItem Icon="@(custom.IsRestricted ? Icons.Material.Filled.LockOpen : Icons.Material.Filled.Lock)"
                                                     OnClick="() => EditColumnAsync(custom)">@(custom.IsRestricted ? "Lift restriction" : "Restrict to Finance and owners")</MudMenuItem>
                                    }
                                    @if (custom.Type is ColumnKind.Dropdown or ColumnKind.MultiSelect)
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Filled.Palette" OnClick="() => EditColumnAsync(custom)">Edit labels and colors</MudMenuItem>
                                    }
                                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="() => DeleteColumnAsync(custom)">Delete column</MudMenuItem>
                                    <MudDivider />
                                }
                                @if (column.Kind is not (GridColumnKind.Assignees or GridColumnKind.Duration or GridColumnKind.Predecessors or GridColumnKind.Extra) && !column.IsBaseline && !column.IsFloat)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Filled.ArrowUpward" OnClick="() => SortBy(column, false)" data-testid="sort-asc">Sort ascending</MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.ArrowDownward" OnClick="() => SortBy(column, true)" data-testid="sort-desc">Sort descending</MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.FilterList" OnClick="() => FilterDialogAsync(column)">Filter by @column.Name…</MudMenuItem>
                                }
                                @if (column.Kind != GridColumnKind.Title)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Filled.VisibilityOff" OnClick="() => HideColumn(column)" data-testid="hide-column">Hide column</MudMenuItem>
                                }
                                <MudDivider />
                                <MudMenuItem Icon="@Icons.Material.Filled.SwapHoriz" OnClick="() => ResizeColumnAsync(column)">Column width</MudMenuItem>
                                @if (CanEdit)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Filled.ViewColumn" OnClick="AddColumnAsync">Add column</MudMenuItem>
                                }
                                @if (column.Kind == GridColumnKind.Title)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Filled.UnfoldMore" OnClick="ExpandAll">Expand all</MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.UnfoldLess" OnClick="CollapseAll">Collapse all</MudMenuItem>
                                }
                            </MudMenu>
                        </div>
                        <span class="wb-resize" data-key="@column.Key" aria-hidden="true"></span>
                    </th>
                }
                <th class="wb-add-col" role="columnheader" aria-colindex="@(_columns.Count + 2)">
                    @if (CanEdit)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddColumnAsync" aria-label="Add column" />
                    }
                </th>
            </tr>
        </thead>
        <tbody role="rowgroup">
            <Virtualize Items="_rows" ItemSize="RowHeight" OverscanCount="10" SpacerElement="tr" Context="row">
                @{ var rowIndex = IndexOf(row); }
                <tr class="@RowClass(row)" role="row" aria-rowindex="@(rowIndex + 2)" data-row="@rowIndex">
                    <td class="wb-gutter wb-sticky" role="rowheader" aria-colindex="1" title="@FormatReasons(row)">
                        <div class="wb-gutter-cell">
                        <span class="wb-rownum" title="@(_plan.ContainsKey(row.Item.Id) ? "Task ID (for Predecessors)" : null)">@RowNumber(row)</span>
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" Class="wb-row-menu" AriaLabel="Row actions">
                            <MudMenuItem Icon="@Icons.Material.Filled.OpenInNew" Href="@DetailsHref(row.Item)">Open details</MudMenuItem>
                            @if (CanAssign)
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.PersonAdd" OnClick="() => AssignAsync(row.Item)">Assign…</MudMenuItem>
                            }
                            @if (CanEdit)
                            {
                                <MudDivider />
                                <MudMenuItem Icon="@Icons.Material.Filled.VerticalAlignTop" OnClick="() => InsertRowAboveAsync(row.Item)">Insert row above</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.Add" OnClick="() => AddRowBelowAsync(row.Item)">Add row below</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.SubdirectoryArrowRight" OnClick="() => AddChildAsync(row.Item)">Add child row</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.Flag" OnClick="() => ToggleMilestoneAsync(row.Item)" data-testid="toggle-milestone">@(row.Item.IsMilestone ? "Not a milestone" : "Mark as milestone")</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.FormatIndentIncrease" Disabled="!row.HasPreviousSibling" OnClick="() => IndentAsync(row)">Indent</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.FormatIndentDecrease" Disabled="row.Item.ParentId is null" OnClick="() => OutdentAsync(row)">Outdent</MudMenuItem>
                                <MudDivider />
                                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="() => DeleteRowAsync(row)">Delete row</MudMenuItem>
                            }
                        </MudMenu>
                        </div>
                    </td>
                    @for (var c = 0; c < _columns.Count; c++)
                    {
                        var colIndex = c;
                        var column = _columns[c];
                        var active = IsActive(row, colIndex);
                        var editing = active && _editing;
                        var raw = Raw(row.Item, column);
                        var locked = IsRolledUp(row, column);
                        var inRange = InRange(rowIndex, colIndex);
                        var cellStyle = CellStyle(row, column);
                        <td class="@(CellClass(column, active, editing, locked, inRange) + (cellStyle?.Contains("background", StringComparison.Ordinal) == true ? " wb-formatted" : ""))" data-col="@colIndex" role="gridcell"
                            id="@(active ? ActiveCellId : null)" aria-colindex="@(colIndex + 2)" title="@(locked ? "Summary task: rolled up from its subtasks" : FormulaErrorText.Explain(raw))"
                            aria-selected="@(active || inRange ? "true" : "false")" aria-readonly="@(!column.ReadOnly && !locked && CanEdit ? null : "true")" style="@cellStyle"
                            @onclick="e => OnCellClickAsync(row, colIndex, e)" @ondblclick="() => OnCellDoubleClick(row, colIndex)">
                            @if (editing)
                            {
                                @Editor(column)
                            }
                            else if (column.Kind == GridColumnKind.Title)
                            {
                                <div class="wb-title-cell" style="padding-left:@(row.Depth * IndentWidth)px">
                                    @if (row.HasChildren)
                                    {
                                        var expanded = !_collapsed.Contains(row.Item.Id);
                                        <span class="wb-toggle" role="button" aria-expanded="@(expanded ? "true" : "false")"
                                              aria-label="@(expanded ? "Collapse" : "Expand")"
                                              @onclick="() => ToggleExpanded(row.Item.Id)" @onclick:stopPropagation="true">
                                            <MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small" />
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="wb-toggle-spacer"></span>
                                    }
                                    @if (_plan.TryGetValue(row.Item.Id, out var task))
                                    {
                                        <span class="wb-outline" data-testid="outline-number">@task.OutlineNumber</span>
                                    }
                                    @if (row.Item.IsMilestone && !row.HasChildren)
                                    {
                                        <span class="wb-milestone" title="Milestone" aria-label="Milestone" data-testid="milestone-mark">◆</span>
                                    }
                                    @* The title selects the cell (so Tab indents); the icon opens the details panel on this page. *@
                                    <span class="@(row.HasChildren && _plan.Count > 0 ? "wb-title-link wb-summary" : "wb-title-link")">@row.Item.Title</span>
                                    <a class="wb-details-link" href="@DetailsHref(row.Item)" title="Open details" aria-label="@($"Open details of {row.Item.Title}")"
                                       @onclick:stopPropagation="true" data-testid="open-details">
                                        <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                                    </a>
                                </div>
                            }
                            else if (column.Extra is { } extra)
                            {
                                @extra.Cell(row.Item)
                            }
                            else if (column.Kind == GridColumnKind.Assignees)
                            {
                                <AssigneeChips Assignees="@(Tasks?.For(row.Item.Id) ?? [])" Max="4" Empty="@(CanAssign ? "Assign…" : "—")" />
                            }
                            else if (IsStatus(column))
                            {
                                @if (!string.IsNullOrEmpty(raw))
                                {
                                    <span class="wb-pill" style="@PillStyle(column.Column!.ColorOf(raw))" data-testid="status-pill">@raw</span>
                                }
                            }
                            else if (column.ValueKind == ColumnKind.Checkbox)
                            {
                                var isChecked = raw == "true";
                                <span class="wb-check" role="checkbox" aria-checked="@(isChecked ? "true" : "false")" aria-label="@column.Name"
                                      @onclick="() => ToggleCheckboxAsync(row, colIndex)" @onclick:stopPropagation="true">
                                    <MudIcon Icon="@(isChecked ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)"
                                             Size="Size.Small" Color="@(isChecked ? Color.Primary : Color.Default)" />
                                </span>
                            }
                            else if (column.Kind == GridColumnKind.Duration)
                            {
                                @(int.TryParse(raw, out var days) ? PlanDuration.Format(days) : "")
                            }
                            else if (column.Kind == GridColumnKind.FinishVariance)
                            {
                                var (varianceText, varianceCss, varianceTitle) = Variance(raw);
                                <span class="@($"wb-variance {varianceCss}")" title="@varianceTitle" data-testid="finish-variance">@varianceText</span>
                            }
                            else if (column.IsFloat)
                            {
                                var (floatText, critical) = FloatText(raw, column);
                                <span data-testid="float-cell">@floatText</span>
                                @if (critical)
                                {
                                    <span class="wb-critical" data-testid="critical-mark">Critical</span>
                                }
                            }
                            else if (column.ValueKind == ColumnKind.MultiSelect && column.Column is { } multi)
                            {
                                @foreach (var picked in ColumnValues.Selected(raw))
                                {
                                    <span class="wb-pill wb-pill-small" style="@PillStyle(multi.ColorOf(picked))" data-testid="multi-pill">@picked</span>
                                }
                            }
                            else if (column.ValueKind == ColumnKind.Hyperlink)
                            {
                                @if (ColumnValues.Link(raw) is { } link)
                                {
                                    <a class="wb-link" href="@link.Url" target="_blank" rel="noopener noreferrer" title="@link.Url" @onclick:stopPropagation="true"
                                       data-testid="link-cell">@link.Text</a>
                                }
                            }
                            else if (column.ValueKind == ColumnKind.Symbol)
                            {
                                @if (SymbolOf(raw) is { } symbol)
                                {
                                    <span class="wb-symbol" data-testid="symbol-cell"><span class="wb-symbol-glyph" style="color:@symbol.Color.Background" aria-hidden="true">@symbol.Glyph</span>@symbol.Label</span>
                                }
                            }
                            else if (column.ValueKind == ColumnKind.Progress)
                            {
                                @if (ColumnValues.Percent(raw) is { } percent)
                                {
                                    <span class="wb-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ProgressWidth(raw).TrimEnd('%')"
                                          aria-label="@column.Name" data-testid="progress-cell">
                                        <span class="wb-progress-track"><span class="wb-progress-fill" style="width:@ProgressWidth(raw)"></span></span>
                                        <span class="wb-progress-text">@CellFormat.Display(raw, ColumnKind.Progress)</span>
                                    </span>
                                }
                            }
                            else if (column.ValueKind == ColumnKind.LinkedRow)
                            {
                                @* Wave E: titles of the linked rows the viewer can see. *@
                                <Workbench.Ui.Sheets.LinkedRowsCell ColumnId="column.Column!.Id" Raw="@raw" />
                            }
                            else
                            {
                                @CellFormat.Display(raw, column.ValueKind)
                            }
                            @if (IsFillCorner(rowIndex, colIndex))
                            {
                                <span class="wb-fill-handle" title="Drag down to fill (or Ctrl+D)" aria-hidden="true" data-testid="fill-handle"></span>
                            }
                        </td>
                    }
                    <td class="wb-filler" role="presentation"></td>
                </tr>
            </Virtualize>
        </tbody>
    </table>
    @if (_rows.Count == 0)
    {
        <div class="wb-empty mud-text-secondary">No rows yet.</div>
    }
</div>

<div class="wb-grid-footer">
    @if (CanEdit)
    {
        <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                   OnClick="AddRowAtEndAsync">Add row</MudButton>
        @if (ActiveRow is { } selected)
        {
            <MudButton StartIcon="@Icons.Material.Filled.SubdirectoryArrowRight" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                       OnClick="() => AddChildAsync(selected.Item)" data-testid="grid-add-child"
                       title="@($"Add a row under \"{selected.Item.Title}\"")">Add subtask</MudButton>
        }
        <input class="wb-quick-add" placeholder="Type a task and press Enter" aria-label="Add a task: type its name and press Enter"
               value="@_quickTitle" @oninput="e => _quickTitle = e.Value?.ToString() ?? string.Empty" @onkeydown="QuickAddKeyAsync"
               data-testid="grid-quick-add" />
    }
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        @Items.Count @(Items.Count == 1 ? "row" : "rows") · @(CanEdit ? "Enter or F2 to edit · Shift+arrows or drag to select · Ctrl+C / Ctrl+V copy and paste (from Excel too) · Ctrl+D fills down · Ctrl+Z undoes · Tab / Shift+Tab in Title to indent or outdent · Insert adds a row above" : "View only · Shift+arrows or drag to select · Ctrl+C copies")
    </MudText>
</div>

@if (_statusPop is { } pop && StatusColumn is { Column: { } statusColumn } statusGridColumn && StatusItem is { } statusItem)
{
    var current = Raw(statusItem, statusGridColumn);
    <div class="wb-pop-backdrop" @onclick="CloseStatus"></div>
    <div class="wb-status-pop" @ref="_statusRef" role="menu" aria-label="@($"{statusColumn.Name} of {statusItem.Title}")" data-testid="status-popover"
         style="left:@Px(pop.Left);top:@Px(pop.Top)" @onkeydown="OnStatusKeyAsync">
        @for (var i = 0; i < statusColumn.Options.Count; i++)
        {
            var option = statusColumn.Options[i];
            var index = i;
            var selected = string.Equals(option, current, StringComparison.OrdinalIgnoreCase);
            <button type="button" class="wb-pill wb-pill-option" role="menuitemradio" aria-checked="@(selected ? "true" : "false")" data-index="@index"
                    tabindex="@(index == _statusFocus ? 0 : -1)" style="@PillStyle(statusColumn.ColorOf(option))" @onclick="() => PickStatusAsync(option)"
                    data-testid="status-option">
                @if (selected)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="wb-pill-check" aria-hidden="true" />
                }
                @option
            </button>
        }
        <button type="button" class="wb-pop-link" role="menuitem" data-index="@statusColumn.Options.Count" tabindex="@(_statusFocus == statusColumn.Options.Count ? 0 : -1)"
                @onclick="() => PickStatusAsync(null)" data-testid="status-clear">Clear</button>
        <button type="button" class="wb-pop-link" role="menuitem" tabindex="-1" @onclick="EditLabelsAsync" data-testid="status-edit-labels">Edit labels…</button>
    </div>
}

@code {
    private const int GutterWidth = 56;
    private const int AddColumnWidth = 48;
    private const int IndentWidth = 20;
    private const float RowHeight = 34;
    private const int PageRows = 20;

    /// <summary>Maximum height of the scrolling area. Rows beyond it are virtualized.</summary>
    [Parameter]
    public string Height { get; set; } = "calc(100vh - 300px)";

    /// <summary>Columns the page around the grid adds (the Plan tab's people, hours and cost); null adds none.</summary>
    [CascadingParameter]
    public GridExtraColumns? Extras { get; set; }

    private GridExtraColumns? _lastExtras;

    private ElementReference _container;
    private ElementReference _editorRef;
    private MudDatePicker? _datePicker;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<SheetGrid>? _dotNet;

    private IReadOnlyList<ItemDto>? _lastItems;
    private SheetDetail? _lastSheet;
    private IReadOnlyList<GridColumn> _columns = [];
    private List<GridRow> _rows = [];
    private Dictionary<Guid, int> _rowIndex = [];
    private ILookup<Guid?, ItemDto> _children = Array.Empty<ItemDto>().ToLookup(i => i.ParentId);
    private readonly HashSet<Guid> _collapsed = [];
    private readonly Dictionary<string, int> _widths = [];

    private Guid? _activeId;
    private readonly string _gridId = $"wb-grid-{Guid.NewGuid():N}";
    private string ActiveCellId => $"{_gridId}-active";
    private int _activeRow = -1;
    private int _activeCol;
    private bool _editing;
    private int _editSession;
    private string _editText = string.Empty;
    private DateTime? _editDate;

    private Guid? _editWhenLoaded;
    private bool _focusEditor;
    private bool _selectAllOnFocus;
    private bool _focusGrid;
    private bool _scrollToActive;
    private bool _myTasks;
    private IReadOnlySet<Guid> _mine = new HashSet<Guid>();
    private SheetTasksDto? _lastTasks;
    private PlanScheduleDto? _lastPlan;
    private Dictionary<Guid, PlanTaskDto> _plan = [];

    /// <summary>The plan editor's service where it's registered (null in hosts and tests without it).</summary>
    private IPlanScheduleService? PlanService => Services.GetService<IPlanScheduleService>();

    private bool Scheduling => Sheet.Summary.SchedulingEnabled;

    private int TableWidth => GutterWidth + AddColumnWidth + _columns.Sum(WidthOf);

    private int WidthOf(GridColumn column) => _widths.TryGetValue(column.Key, out var width) ? width : column.DefaultWidth;

    private GridRow? ActiveRow => _activeRow >= 0 && _activeRow < _rows.Count ? _rows[_activeRow] : null;

    private GridColumn? ActiveColumn => _activeCol >= 0 && _activeCol < _columns.Count ? _columns[_activeCol] : null;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Items, _lastItems) && ReferenceEquals(Sheet, _lastSheet) && ReferenceEquals(Tasks, _lastTasks) && ReferenceEquals(Plan, _lastPlan)
            && ReferenceEquals(Extras, _lastExtras))
        {
            return;
        }

        if (!ReferenceEquals(Extras, _lastExtras) && ReferenceEquals(Items, _lastItems) && ReferenceEquals(Sheet, _lastSheet) && ReferenceEquals(Tasks, _lastTasks) && ReferenceEquals(Plan, _lastPlan))
        {
            // Only the page's extra columns changed (e.g. the people on the plan): redraw them, keep everything else.
            _lastExtras = Extras;
            RebuildColumns();
            return;
        }

        _lastExtras = Extras;

        var rowsChanged = !ReferenceEquals(Items, _lastItems) || !ReferenceEquals(Sheet, _lastSheet);
        _lastItems = Items;
        _lastSheet = Sheet;
        _lastTasks = Tasks;
        _lastPlan = Plan;
        _plan = Scheduling && Plan is not null ? Plan.Tasks.ToDictionary(t => t.ItemId) : [];
        RebuildColumns();
        if (rowsChanged && _view.BaselineId is not null)
        {
            _ = RefreshComparisonAsync(); // the plan moved: the variance did too
        }

        if (rowsChanged && (_view.ShowFloat || _view.CriticalOnly) && _viewsFor == SheetId)
        {
            _ = RefreshFloatAsync(); // and so did the float
        }

        if (rowsChanged)
        {
            RecomputeFormats();
        }

        _mine = TaskView.MineWithAncestors(Tasks, Sheet, Items);
        _children = Items.ToLookup(i => i.ParentId);
        // A reload (our own save echoed back by live refresh, or someone else's change) keeps an open edit while its row is
        // still there; the typed text is kept separately.
        if (rowsChanged && _editing && (_activeId is not { } editingId || Items.All(i => i.Id != editingId)))
        {
            _editing = false;
        }

        RebuildRows();

        if (_editWhenLoaded is { } newId && _rowIndex.ContainsKey(newId))
        {
            _editWhenLoaded = null;
            _activeId = newId;
            _activeRow = _rowIndex[newId];
            _activeCol = 0;
            _scrollToActive = true;
            BeginEdit(selectAll: true);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // A sheet's saved views (and the one it opens with) load once; undo history belongs to one sheet.
        if (_viewsFor != SheetId)
        {
            _viewsFor = SheetId;
            _history.Clear();
            await LoadBaselinesAsync();
            await LoadRulesAsync();
            await LoadViewsAsync(openDefault: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Workbench.Ui/sheetGrid.js");
                if (_module is not null)
                {
                    _dotNet = DotNetObjectReference.Create(this);
                    _handle = await _module.InvokeAsync<IJSObjectReference>("init", _container, _dotNet);
                }
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
            {
                // Prerendering or a closed circuit: the grid still works, minus the browser niceties.
            }
        }

        if (_module is null)
        {
            _focusEditor = _focusGrid = _scrollToActive = false;
            return;
        }

        try
        {
            if (_scrollToActive && _activeRow >= 0)
            {
                _scrollToActive = false;
                await _module.InvokeVoidAsync("ensureVisible", _container, _activeRow, _activeCol);
            }

            if (_focusEditor && _editing)
            {
                _focusEditor = false;
                if (ActiveColumn?.ValueKind == ColumnKind.Date && _datePicker is not null)
                {
                    await _datePicker.FocusAsync();
                    await _datePicker.OpenAsync();
                }
                else
                {
                    await _module.InvokeVoidAsync("focusEditor", _editorRef, _selectAllOnFocus);
                }
            }
            else if (_focusStatus)
            {
                await FocusStatusAsync();
            }
            else if (_focusGrid && _statusPop is null)
            {
                _focusGrid = false;
                await _module.InvokeVoidAsync("focusGrid", _container);
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
        }
    }

    [JSInvokable]
    public void SetColumnWidth(string key, int width)
    {
        _widths[key] = Math.Max(60, width);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }

        _dotNet?.Dispose();
    }

    // ---- Rows and hierarchy ----

    private void RebuildRows()
    {
        var rows = new List<GridRow>(Items.Count);
        var visible = SheetViewEngine.Visible(Items, Sheet.Columns, _view, CriticalOnly);
        var order = SheetViewEngine.Comparer(_view.Sort, Sheet.Columns);
        AddRows(null, 0);
        _rows = rows;
        _rowIndex = new Dictionary<Guid, int>(rows.Count);
        for (var i = 0; i < rows.Count; i++)
        {
            _rowIndex[rows[i].Item.Id] = i;
        }

        if (_activeId is { } id && _rowIndex.TryGetValue(id, out var index))
        {
            _activeRow = index;
        }
        else if (_rows.Count == 0)
        {
            _activeRow = -1;
            _activeId = null;
        }
        else if (_activeRow >= 0)
        {
            _activeRow = Math.Min(_activeRow, _rows.Count - 1);
            _activeId = _rows[_activeRow].Item.Id;
        }

        RestoreAnchor();

        void AddRows(Guid? parentId, int depth)
        {
            var first = true;
            foreach (var item in _children[parentId].Where(i => (!_myTasks || _mine.Contains(i.Id)) && (visible is null || visible.Contains(i.Id))).Order(order))
            {
                var hasChildren = _children.Contains(item.Id);
                rows.Add(new GridRow(item, depth, hasChildren, !first));
                first = false;
                if (hasChildren && !_collapsed.Contains(item.Id))
                {
                    AddRows(item.Id, depth + 1);
                }
            }
        }
    }

    private int IndexOf(GridRow row) => _rowIndex.TryGetValue(row.Item.Id, out var index) ? index : 0;

    private void ToggleExpanded(Guid itemId)
    {
        if (!_collapsed.Remove(itemId))
        {
            _collapsed.Add(itemId);
        }

        RebuildRows();
    }

    private void ExpandAll()
    {
        _collapsed.Clear();
        RebuildRows();
    }

    private void CollapseAll()
    {
        foreach (var group in _children)
        {
            if (group.Key is { } parentId)
            {
                _collapsed.Add(parentId);
            }
        }

        RebuildRows();
    }

    /// <summary>Swaps in the saved item so the grid shows it before the page finishes reloading.</summary>
    private void ReplaceItem(ItemDto updated)
    {
        if (_rowIndex.TryGetValue(updated.Id, out var index))
        {
            _rows[index] = _rows[index] with { Item = updated };
        }
    }

    private string DetailsHref(ItemDto item) => ItemLinks.Details(Navigation, item.Id);

    // ---- Selection and keyboard ----

    private bool IsActive(GridRow row, int colIndex) => _activeId == row.Item.Id && _activeCol == colIndex;

    private void Select(int rowIndex, int colIndex, bool keepRange = false)
    {
        if (_rows.Count == 0 || _columns.Count == 0)
        {
            return;
        }

        if (!keepRange)
        {
            CollapseRange();
        }

        _activeRow = Math.Clamp(rowIndex, 0, _rows.Count - 1);
        _activeCol = Math.Clamp(colIndex, 0, _columns.Count - 1);
        _activeId = _rows[_activeRow].Item.Id;
        _scrollToActive = true;
    }

    private void Move(int rows, int cols) => Select(Math.Max(_activeRow, 0) + rows, _activeCol + cols);

    private void MoveNext(int direction)
    {
        var col = _activeCol + direction;
        var row = Math.Max(_activeRow, 0);
        if (col >= _columns.Count && row < _rows.Count - 1)
        {
            (row, col) = (row + 1, 0);
        }
        else if (col < 0 && row > 0)
        {
            (row, col) = (row - 1, _columns.Count - 1);
        }

        Select(row, col);
    }

    private async Task OnCellClickAsync(GridRow row, int colIndex, MouseEventArgs? e = null)
    {
        if (IsActive(row, colIndex) && _editing)
        {
            return;
        }

        if (_editing && !await CommitEditAsync())
        {
            return;
        }

        if (e?.ShiftKey == true)
        {
            SelectTo(IndexOf(row), colIndex, extend: true);
            _scrollToActive = false;
            _focusGrid = true;
            return;
        }

        Select(IndexOf(row), colIndex);
        _scrollToActive = false;
        _focusGrid = true;

        // One click changes a status: the labels open right away.
        if (IsStatus(_columns[colIndex]) && CanEdit)
        {
            await OpenStatusAsync(row, colIndex, e);
        }
    }

    private void OnCellDoubleClick(GridRow row, int colIndex)
    {
        if (IsActive(row, colIndex) && _editing)
        {
            return;
        }

        Select(IndexOf(row), colIndex);
        _scrollToActive = false;
        BeginEdit();
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (_rows.Count == 0 || _columns.Count == 0)
        {
            return;
        }

        if (_activeRow < 0)
        {
            Select(0, 0);
            return;
        }

        if (_editing)
        {
            switch (e.Key)
            {
                case "Escape":
                    CancelEdit();
                    break;
                case "Enter":
                    var wasTitle = ActiveColumn?.Kind == GridColumnKind.Title;
                    var atEnd = _activeRow == _rows.Count - 1 && ActiveRow is { } last ? last.Item : null;
                    if (await CommitEditAsync())
                    {
                        // Typing a list of tasks: Enter on the last title starts the next row, like a new line in a list.
                        if (wasTitle && atEnd is not null && CanEdit)
                        {
                            await AddRowBelowAsync(atEnd);
                        }
                        else
                        {
                            Move(1, 0);
                        }
                    }

                    break;
                case "Tab":
                    if (await CommitEditAsync())
                    {
                        MoveNext(e.ShiftKey ? -1 : 1);
                    }

                    break;
            }

            return;
        }

        if (await OnRangeKeyAsync(e))
        {
            return;
        }

        var row = ActiveRow!;
        var column = ActiveColumn!;
        if (e.AltKey && e.ShiftKey && e.Key is "ArrowRight" or "ArrowLeft")
        {
            await (e.Key == "ArrowRight" ? IndentAsync(row) : OutdentAsync(row));
            return;
        }

        // MS Project and Smartsheet habits: Tab indents the row (Shift+Tab outdents) from the Title column; Insert adds a row above.
        if (CanEdit && e.Key == "Tab" && column.Kind == GridColumnKind.Title && !e.AltKey && !e.CtrlKey && !e.MetaKey)
        {
            await (e.ShiftKey ? OutdentAsync(row) : IndentAsync(row));
            return;
        }

        if (CanEdit && e.Key == "Insert")
        {
            await InsertRowAboveAsync(row.Item);
            return;
        }

        switch (e.Key)
        {
            case "ArrowUp":
                Move(-1, 0);
                break;
            case "ArrowDown":
                Move(1, 0);
                break;
            case "ArrowLeft":
                Move(0, -1);
                break;
            case "ArrowRight":
                Move(0, 1);
                break;
            case "PageUp":
                Move(-PageRows, 0);
                break;
            case "PageDown":
                Move(PageRows, 0);
                break;
            case "Home":
                Select(e.CtrlKey || e.MetaKey ? 0 : _activeRow, 0);
                break;
            case "End":
                Select(e.CtrlKey || e.MetaKey ? _rows.Count - 1 : _activeRow, _columns.Count - 1);
                break;
            case "Tab":
                MoveNext(e.ShiftKey ? -1 : 1);
                break;
            case "Enter" or "F2" or " " when column.ValueKind == ColumnKind.Checkbox:
                await ToggleCheckboxAsync(row, _activeCol);
                break;
            case "Enter" or "F2":
                BeginEdit();
                break;
            case "Delete" or "Backspace":
                await ClearCellAsync(row, column);
                break;
            default:
                if (e.Key.Length == 1 && !e.CtrlKey && !e.MetaKey && !e.AltKey && e.Key != " ")
                {
                    BeginEdit(initialText: e.Key);
                }

                break;
        }
    }

    // ---- Editing ----

    private void BeginEdit(string? initialText = null, bool selectAll = false)
    {
        if (!CanEdit)
        {
            return;
        }

        if (ActiveRow is not { } row || ActiveColumn is not { } column)
        {
            return;
        }

        if (column.Kind == GridColumnKind.Assignees)
        {
            _ = AssignAsync(row.Item);
            return;
        }

        if (column.ValueKind == ColumnKind.LinkedRow)
        {
            _ = PickLinkedRowsAsync(row.Item, column); // Wave E: link cells are picked in a dialog.
            return;
        }

        if (column.ReadOnly)
        {
            Snackbar.Add(column.IsFloat || column.Column is { } auto && ColumnValues.IsAutomatic(auto.Type)
                ? $"{column.Name} is filled in automatically."
                : $"{column.Name} is {(column.IsFormula ? "a formula" : "a lookup")} column and can't be edited.", Severity.Info);
            return;
        }

        if (IsRolledUp(row, column))
        {
            Snackbar.Add($"\"{row.Item.Title}\" is a summary task: its {column.Name.ToLowerInvariant()} comes from its subtasks.", Severity.Info);
            return;
        }

        if (column.ValueKind == ColumnKind.Checkbox)
        {
            return;
        }

        if (IsStatus(column))
        {
            _ = OpenStatusAndRenderAsync(row, _activeCol);
            return;
        }

        // Enter, F2 or a double-click picks choices (or a link's address and text) in a dialog; typing goes straight into the cell.
        if (initialText is null && column.ValueKind is ColumnKind.MultiSelect or ColumnKind.Hyperlink && column.Column is not null)
        {
            _ = EditInDialogAsync(row.Item, column);
            return;
        }

        var raw = Raw(row.Item, column);
        var useInitial = initialText is not null && column.ValueKind is not (ColumnKind.Date or ColumnKind.Dropdown or ColumnKind.Symbol);
        _editText = useInitial ? initialText! : CellFormat.EditText(raw, column.ValueKind);
        _editDate = CellFormat.ToDateTime(raw);
        _datePicker = null;
        _editSession++;
        _editing = true;
        _focusEditor = true;
        _selectAllOnFocus = selectAll;
    }

    private async Task OpenStatusAndRenderAsync(GridRow row, int colIndex)
    {
        await OpenStatusAsync(row, colIndex);
        await InvokeAsync(StateHasChanged);
    }

    private void CancelEdit()
    {
        _editing = false;
        _focusGrid = true;
    }

    /// <summary>Saves the open editor. Returns false (and keeps editing) when the text isn't valid for the column.</summary>
    private async Task<bool> CommitEditAsync()
    {
        if (!_editing || ActiveRow is not { } row || ActiveColumn is not { } column)
        {
            _editing = false;
            return true;
        }

        var text = column.ValueKind == ColumnKind.Date && _datePicker is not null ? _datePicker.Text : _editText;
        if (column.Kind == GridColumnKind.Duration && !PlanDuration.TryParse(text, out _))
        {
            Snackbar.Add("Duration is a number of working days, like 5 or 5d (0 for a milestone).", Severity.Warning);
            return false;
        }

        if (!CellFormat.TryNormalize(text, column, out var value, out var error))
        {
            Snackbar.Add(error!, Severity.Warning);
            return false;
        }

        if (column.Kind == GridColumnKind.Title && value is null)
        {
            Snackbar.Add("Title can't be empty.", Severity.Warning);
            return false;
        }

        _editing = false;
        _focusGrid = true;
        await SaveAsync(row.Item, column, value);
        return true;
    }

    private async Task OnSelectChangedAsync(ChangeEventArgs e)
    {
        _editText = e.Value?.ToString() ?? string.Empty;
        await CommitEditAsync();
    }

    private async Task OnDatePickedAsync(DateTime? date)
    {
        if (!_editing || ActiveRow is not { } row || ActiveColumn is not { } column)
        {
            return;
        }

        _editing = false;
        _focusGrid = true;
        await SaveAsync(row.Item, column, CellFormat.FromDateTime(date));
    }

    private void OnDatePickerClosed()
    {
        // Clicking away from the picker without choosing a date ends the edit.
        if (_editing && ActiveColumn?.ValueKind == ColumnKind.Date)
        {
            CancelEdit();
        }
    }

    private async Task ToggleCheckboxAsync(GridRow row, int colIndex)
    {
        Select(IndexOf(row), colIndex);
        _scrollToActive = false;
        _focusGrid = true;
        var column = _columns[colIndex];
        if (column.ReadOnly || !CanEdit)
        {
            return;
        }

        var current = Raw(row.Item, column) == "true";
        await SaveAsync(row.Item, column, current ? "false" : "true");
    }

    private async Task ClearCellAsync(GridRow row, GridColumn column)
    {
        if (column.ReadOnly || column.Kind is GridColumnKind.Title or GridColumnKind.Assignees or GridColumnKind.Duration || IsRolledUp(row, column))
        {
            return;
        }

        await SaveAsync(row.Item, column, null);
    }

    /// <summary>Marks or unmarks a milestone. A milestone keeps one date: its finish (or start).</summary>
    private async Task ToggleMilestoneAsync(ItemDto item)
    {
        try
        {
            var milestone = !item.IsMilestone;
            await SetMilestoneAsync(item.Id, milestone);
            _history.Record(milestone ? "Mark as milestone" : "Unmark milestone",
                () => SetMilestoneAsync(_history.Resolve(item.Id), !milestone), () => SetMilestoneAsync(_history.Resolve(item.Id), milestone));
            await Changed.InvokeAsync();
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            Snackbar.Add($"Couldn't change the milestone: {ex.Message}", Severity.Error);
        }
    }

    private async Task SetMilestoneAsync(Guid itemId, bool milestone)
    {
        if (FindItem(itemId) is { } item)
        {
            ReplaceItem(await ItemService.UpdateAsync(SheetId, item.Id,
                new UpdateItemRequest(item.Title, item.Start, item.Finish, item.CostpointWbsId, item.Values, milestone)));
        }
    }

    /// <summary>Wave E: picks the rows a link cell points at, from the linked sheet's rows the user can see.</summary>
    private async Task PickLinkedRowsAsync(ItemDto item, GridColumn column)
    {
        if (await Workbench.Ui.Sheets.LinkRowsDialog.PickAsync(DialogService, SheetId, column.Column!, Raw(item, column)) is { } value)
        {
            await SaveAsync(item, column, value.Length == 0 ? null : value);
        }
    }

    private async Task SaveAsync(ItemDto item, GridColumn column, string? value)
    {
        var before = Raw(item, column);
        if (column.ReadOnly || !CanEdit || before == value)
        {
            return;
        }

        try
        {
            if (column.Kind is GridColumnKind.Duration or GridColumnKind.Predecessors && PlanService is { } plan)
            {
                if (column.Kind == GridColumnKind.Duration && PlanDuration.TryParse(value, out var days))
                {
                    await plan.SetDurationAsync(SheetId, item.Id, days);
                }
                else if (column.Kind == GridColumnKind.Predecessors)
                {
                    await plan.SetPredecessorsAsync(SheetId, item.Id, value);
                }

                RecordCell(item, column, before, value);
                await Changed.InvokeAsync();
                return;
            }

            if (BulkService is not null && column.ValueKind != ColumnKind.LinkedRow)
            {
                // Through the bulk save: undo then also puts back the dates the plan moved because of this edit.
                var saved = await SaveCellsAsync([new CellEdit(item.Id, column, value)], null, null, $"Edit {column.Name}");
                if (saved.Changes.Count > 0)
                {
                    RecordCells($"Edit {column.Name}", saved.Changes);
                    await Changed.InvokeAsync();
                }
                else if (saved.Reasons.Count > 0)
                {
                    Snackbar.Add($"Couldn't save {column.Name}: {saved.Reasons[0]}", Severity.Warning);
                }

                return;
            }

            var updated = await ItemService.UpdateAsync(SheetId, item.Id, CellFormat.WithValue(item, column, value));
            ReplaceItem(updated);
            RecordCell(item, column, before, value);
            await Changed.InvokeAsync();
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            Snackbar.Add($"Couldn't save {column.Name}: {ex.Message}", Severity.Error);
        }
    }

    private RenderFragment Editor(GridColumn column) => column.ValueKind switch
    {
        ColumnKind.Dropdown => @<select class="wb-editor" @ref="_editorRef" value="@_editText" @onchange="OnSelectChangedAsync">
                                    <option value=""></option>
                                    @foreach (var option in column.Column?.Options ?? [])
                                    {
                                        <option value="@option">@option</option>
                                    }
                                    @if (_editText.Length > 0 && !(column.Column?.Options ?? []).Contains(_editText))
                                    {
                                        <option value="@_editText">@_editText</option>
                                    }
                                </select>,
        ColumnKind.Symbol => @<select class="wb-editor" @ref="_editorRef" value="@_editText" @onchange="OnSelectChangedAsync" aria-label="@column.Name">
                                  <option value=""></option>
                                  @foreach (var option in ColumnValues.Choices(column.Column!))
                                  {
                                      <option value="@option">@(SymbolSets.Find(option) is { } symbol ? $"{symbol.Glyph} {symbol.Label}" : option)</option>
                                  }
                              </select>,
        ColumnKind.Date => @<MudDatePicker @ref="_datePicker" Date="_editDate" DateChanged="OnDatePickedAsync"
                                           PickerClosed="OnDatePickerClosed" PickerVariant="PickerVariant.Inline" ShowToolbar="false"
                                           Editable="true" DateFormat="MM/dd/yyyy" Margin="Margin.Dense"
                                           Underline="false" AutoClose="true" Class="wb-date-editor" />,
        _ => @<input class="wb-editor" @ref="_editorRef" type="@InputType(column.ValueKind)"
                     inputmode="@(column.ValueKind is ColumnKind.Number or ColumnKind.Currency or ColumnKind.Progress ? "decimal" : null)"
                     value="@_editText" @oninput="EditorInputHandler()" aria-label="@column.Name" />,
    };

    /// <summary>
    /// Ignores input from an editor that belongs to an earlier edit (keys typed right after Esc or Enter
    /// can reach the old input before it is removed).
    /// </summary>
    private Action<ChangeEventArgs> EditorInputHandler()
    {
        var session = _editSession;
        return e =>
        {
            if (_editing && session == _editSession)
            {
                _editText = e.Value?.ToString() ?? string.Empty;
            }
        };
    }

    private static string InputType(ColumnKind kind) => kind == ColumnKind.Person ? "email" : "text";

    // ---- Task assignment ----

    private void SetMyTasks(bool on)
    {
        _myTasks = on;
        RebuildRows();
    }

    private async Task AssignAsync(ItemDto item)
    {
        if (!CanAssign)
        {
            Snackbar.Add("You need edit access to this sheet to assign tasks.", Severity.Info);
            return;
        }

        if (await TaskView.AssignAsync(DialogService, SheetId, item, Tasks?.For(item.Id) ?? []))
        {
            _focusGrid = true;
            await Changed.InvokeAsync();
        }
    }

    // ---- Row actions ----

    private Task AddRowAtEndAsync() => CreateRowAsync(new CreateItemRequest("New row"));

    private string _quickTitle = string.Empty;

    /// <summary>The quick-add box: each Enter adds a top-level task with that name and keeps the box ready for the next.</summary>
    private async Task QuickAddKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_quickTitle))
        {
            return;
        }

        var title = _quickTitle.Trim();
        _quickTitle = string.Empty;

        // A project plan with a single top row (the CLIN, a WBS element) takes new tasks under it, so they aren't siblings of their own CLIN.
        var top = _children[null].ToList();
        var parent = top.Count == 1 && top[0].CostpointWbsId is not null ? top[0] : null;
        var last = (parent is null ? top : _children[parent.Id].ToList()).OrderBy(i => i.Order).LastOrDefault();
        try
        {
            var request = new CreateItemRequest(title, parent?.Id);
            request = last is null ? request : WithStart(request, last);
            RecordCreate("Add task", await ItemService.CreateAsync(SheetId, request), request);
            await Changed.InvokeAsync();
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            _quickTitle = title;
            Snackbar.Add($"Couldn't add the task: {ex.Message}", Severity.Error);
        }
    }

    private Task AddRowBelowAsync(ItemDto item) => CreateRowAsync(WithStart(new CreateItemRequest("New row", item.ParentId, item.Order + 1), item));

    /// <summary>A new row where this one is, pushing it (and the rows after it) down, like Insert in MS Project.</summary>
    private Task InsertRowAboveAsync(ItemDto item)
    {
        if (Rearranged)
        {
            Snackbar.Add(RearrangedMessage, Severity.Info);
            return Task.CompletedTask;
        }

        return CreateRowAsync(WithStart(new CreateItemRequest("New row", item.ParentId, item.Order), item));
    }

    private const string RearrangedMessage = "The rows are sorted or filtered, so they aren't in their real order. Clear the sort and filter to indent, outdent or insert rows.";

    private Task AddChildAsync(ItemDto item)
    {
        _collapsed.Remove(item.Id);
        return CreateRowAsync(WithStart(new CreateItemRequest("New row", item.Id), item));
    }

    /// <summary>On a plan, a new task starts with the task it was added next to (or under), as a one-day task.</summary>
    private CreateItemRequest WithStart(CreateItemRequest request, ItemDto near) =>
        _plan.Count > 0 && (near.Start ?? near.Finish) is { } start ? request with { Start = start, Finish = start } : request;

    private async Task CreateRowAsync(CreateItemRequest request)
    {
        try
        {
            var created = await ItemService.CreateAsync(SheetId, request);
            _editWhenLoaded = created.Id;
            RecordCreate("Add row", created, request);
            await Changed.InvokeAsync();
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            Snackbar.Add($"Couldn't add the row: {ex.Message}", Severity.Error);
        }
    }

    private async Task IndentAsync(GridRow row)
    {
        if (!CanEdit)
        {
            return;
        }

        if (Rearranged)
        {
            Snackbar.Add(RearrangedMessage, Severity.Info);
            return;
        }

        var undo = (Label: "Indent", Before: Structure(), Redo: (Func<Task>)(() => RepeatAsync(row.Item.Id, IndentAsync)));
        if (PlanService is { } plan)
        {
            await RestructureAsync(row, () => plan.IndentAsync(SheetId, row.Item.Id), expand: row.HasPreviousSibling, undo);
            return;
        }

        var previous = _children[row.Item.ParentId]
            .Where(i => i.Order < row.Item.Order)
            .OrderByDescending(i => i.Order)
            .FirstOrDefault();
        if (previous is null)
        {
            return;
        }

        _collapsed.Remove(previous.Id);
        await MoveAsync(row.Item, new MoveItemRequest(previous.Id, _children[previous.Id].Count()), undo);
    }

    private async Task OutdentAsync(GridRow row)
    {
        if (!CanEdit)
        {
            return;
        }

        if (Rearranged)
        {
            Snackbar.Add(RearrangedMessage, Severity.Info);
            return;
        }

        var undo = (Label: "Outdent", Before: Structure(), Redo: (Func<Task>)(() => RepeatAsync(row.Item.Id, OutdentAsync)));
        if (PlanService is { } plan && row.Item.ParentId is not null)
        {
            await RestructureAsync(row, () => plan.OutdentAsync(SheetId, row.Item.Id), expand: false, undo);
            return;
        }

        if (row.Item.ParentId is not { } parentId || !_rowIndex.TryGetValue(parentId, out var parentIndex))
        {
            return;
        }

        var parent = _rows[parentIndex].Item;
        await MoveAsync(row.Item, new MoveItemRequest(parent.ParentId, parent.Order + 1), undo);
    }

    /// <summary>Redo of an indent or outdent: the same action on the row (by its current id).</summary>
    private async Task RepeatAsync(Guid itemId, Func<GridRow, Task> action)
    {
        if (_rowIndex.TryGetValue(_history.Resolve(itemId), out var index))
        {
            await action(_rows[index]);
        }
    }

    /// <summary>Indent or outdent through the plan service, which also applies the date rules (see <see cref="IPlanScheduleService"/>).</summary>
    private async Task RestructureAsync(GridRow row, Func<Task> action, bool expand, (string Label, Dictionary<Guid, (Guid? ParentId, int Order)> Before, Func<Task> Redo) undo)
    {
        if (expand && _children[row.Item.ParentId].Where(i => i.Order < row.Item.Order).OrderByDescending(i => i.Order).FirstOrDefault() is { } previous)
        {
            _collapsed.Remove(previous.Id);
        }

        try
        {
            await action();
            RecordStructure(undo.Label, undo.Before, undo.Redo);
            _activeId = row.Item.Id;
            _scrollToActive = true;
            _focusGrid = true;
            await Changed.InvokeAsync();
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            Snackbar.Add(ex is ArgumentException ? ex.Message : $"Couldn't move the row: {ex.Message}", ex is ArgumentException ? Severity.Info : Severity.Error);
        }
    }

    private async Task MoveAsync(ItemDto item, MoveItemRequest request, (string Label, Dictionary<Guid, (Guid? ParentId, int Order)> Before, Func<Task> Redo) undo)
    {
        try
        {
            await ItemService.MoveAsync(SheetId, item.Id, request);
            RecordStructure(undo.Label, undo.Before, undo.Redo);
            _activeId = item.Id;
            _scrollToActive = true;
            _focusGrid = true;
            await Changed.InvokeAsync();
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            Snackbar.Add($"Couldn't move the row: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteRowAsync(GridRow row)
    {
        if (row.HasChildren)
        {
            var descendants = CountDescendants(row.Item.Id);
            var parameters = new DialogParameters<ConfirmDialog>
            {
                { d => d.Message, $"Delete \"{row.Item.Title}\" and its {descendants} sub-{(descendants == 1 ? "row" : "rows")}? Ctrl+Z brings the rows back, but not their comments or files." },
            };
            var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete row", parameters);
            var result = await dialog.Result;
            if (result is null || result.Canceled)
            {
                return;
            }
        }

        try
        {
            var snapshot = Snapshot(row.Item);
            await ItemService.DeleteAsync(SheetId, row.Item.Id);
            RecordDelete(snapshot);
            _focusGrid = true;
            await Changed.InvokeAsync();
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            Snackbar.Add($"Couldn't delete the row: {ex.Message}", Severity.Error);
        }
    }

    private int CountDescendants(Guid itemId) =>
        _children[itemId].Sum(child => 1 + CountDescendants(child.Id));

    // ---- Column actions ----

    private async Task AddColumnAsync()
    {
        var dialog = await DialogService.ShowAsync<ColumnDialog>("Add column",
            new DialogParameters<ColumnDialog> { { d => d.CanRestrict, Sheet.CanSeeRestricted }, { d => d.SheetId, SheetId } });
        if (await dialog.Result is not { Canceled: false, Data: ColumnDialogResult result })
        {
            return;
        }

        try
        {
            await ColumnService.CreateAsync(SheetId, new CreateColumnRequest(result.Name, result.Type, result.Options, result.Formula, IsRestricted: result.IsRestricted, OptionColors: result.OptionColors));
            await Changed.InvokeAsync();
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            Snackbar.Add($"Couldn't add the column: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>The keyboard way to resize a column; the drag handle on the header edge does the same with a mouse.</summary>
    private async Task ResizeColumnAsync(GridColumn column)
    {
        var parameters = new DialogParameters<ColumnWidthDialog> { { d => d.Width, WidthOf(column) }, { d => d.DefaultWidth, column.DefaultWidth } };
        var dialog = await DialogService.ShowAsync<ColumnWidthDialog>($"{column.Name} column width", parameters);
        if (await dialog.Result is { Canceled: false, Data: int width })
        {
            SetColumnWidth(column.Key, width);
        }
    }

    private async Task EditColumnAsync(ColumnDto column)
    {
        var parameters = new DialogParameters<ColumnDialog> { { d => d.Column, column }, { d => d.CanRestrict, Sheet.CanSeeRestricted }, { d => d.SheetId, SheetId } };
        var dialog = await DialogService.ShowAsync<ColumnDialog>($"Edit {column.Name}", parameters);
        if (await dialog.Result is not { Canceled: false, Data: ColumnDialogResult result })
        {
            return;
        }

        try
        {
            await ColumnService.UpdateAsync(SheetId, column.Id, new UpdateColumnRequest(result.Name, result.Options, result.Formula, column.Order,
                Sheet.CanSeeRestricted && result.IsRestricted != column.IsRestricted ? result.IsRestricted : null, result.OptionColors));
            await Changed.InvokeAsync();
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            Snackbar.Add($"Couldn't update the column: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteColumnAsync(ColumnDto column)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { d => d.Message, $"Delete the \"{column.Name}\" column and its values in every row? This can't be undone." },
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete column", parameters);
        var confirmed = await dialog.Result;
        if (confirmed is null || confirmed.Canceled)
        {
            return;
        }

        try
        {
            await ColumnService.DeleteAsync(SheetId, column.Id);
            _widths.Remove(column.Id.ToString());
            await Changed.InvokeAsync();
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            Snackbar.Add($"Couldn't delete the column: {ex.Message}", Severity.Error);
        }
    }

    // ---- Helpers ----

    private static bool IsExpected(Exception ex) =>
        ex is ArgumentException or InvalidOperationException or HttpRequestException or TaskCanceledException
            or Workbench.Contracts.WorkbenchNotFoundException or UnauthorizedAccessException;

    private static string? HeaderTooltip(GridColumn column) => column.Column switch
    {
        { } custom when custom.IsEffectivelyRestricted =>
            (custom.Formula is { } f ? $"Formula: {f}" : CellFormat.KindName(custom.Type))
            + (custom.IsRestricted ? " · Finance and owners only" : " · Restricted: reads a restricted column"),
        { Formula: { } formula } => $"Formula: {formula}",
        { } custom => CellFormat.KindName(custom.Type),
        _ => null,
    };

    private string RowClass(GridRow row) => row.HasChildren ? "wb-row wb-parent" : "wb-row";

    /// <summary>MS Project's task ID on a plan (what Predecessors refer to); otherwise the visible row number.</summary>
    private int RowNumber(GridRow row) => _plan.TryGetValue(row.Item.Id, out var task) ? task.TaskNumber : IndexOf(row) + 1;

    /// <summary>The stored value of a cell; Duration and Predecessors come from the plan.</summary>
    private string? Raw(ItemDto item, GridColumn column) => column.Kind switch
    {
        GridColumnKind.Duration => _plan.TryGetValue(item.Id, out var t) && t.DurationDays is { } d ? d.ToString(System.Globalization.CultureInfo.InvariantCulture) : null,
        GridColumnKind.Predecessors => _plan.TryGetValue(item.Id, out var t) && t.Predecessors.Length > 0 ? t.Predecessors : null,
        GridColumnKind.BaselineStart or GridColumnKind.BaselineFinish or GridColumnKind.FinishVariance => BaselineRaw(item, column),
        GridColumnKind.TotalFloat or GridColumnKind.FreeFloat => FloatRaw(item, column),
        GridColumnKind.Extra => column.Extra!.Text(item),
        _ => CellFormat.GetRaw(item, column),
    };

    /// <summary>A summary task's dates, duration and % complete come from its subtasks on a plan, so they aren't edited.</summary>
    private bool IsRolledUp(GridRow row, GridColumn column) =>
        _plan.Count > 0 && row.HasChildren
        && (column.Kind is GridColumnKind.Start or GridColumnKind.Finish or GridColumnKind.Duration
            || (column.Column is { } custom && Tasks?.PercentColumn?.Id == custom.Id));

    private static string Px(double value) => value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "px";

    private static string CellClass(GridColumn column, bool active, bool editing, bool locked = false, bool inRange = false)
    {
        var css = column.Kind == GridColumnKind.Title ? "wb-cell wb-title wb-sticky" : "wb-cell";
        if (column.ValueKind is ColumnKind.Number or ColumnKind.Currency || column.Kind is GridColumnKind.Duration or GridColumnKind.TotalFloat or GridColumnKind.FreeFloat
            || column.Extra is { AlignRight: true })
        {
            css += " wb-num";
        }

        if (column.ValueKind == ColumnKind.Checkbox)
        {
            css += " wb-center";
        }

        if (column.ReadOnly || locked)
        {
            css += " wb-readonly";
        }

        if (active)
        {
            css += " wb-active";
        }

        if (inRange)
        {
            css += " wb-in-range";
        }

        if (column.ValueKind == ColumnKind.Dropdown)
        {
            css += " wb-status";
        }

        if (editing)
        {
            css += " wb-editing";
        }

        return css;
    }
}
