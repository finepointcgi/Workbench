@* On the Notifications page: which kinds of notification also go to the Teams channel. Hidden until an administrator connects a channel. *@
@using Workbench.Contracts.Notifications
@inject ITeamsNotificationService Teams
@inject ISnackbar Snackbar

@if (_choices is { Available: true })
{
    <MudPaper Outlined="true" Class="pa-4 mt-4" data-testid="teams-choices">
        <MudText Typo="Typo.h6" HtmlTag="h2" id="teams-heading">Also post to Teams</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
            Your team's Teams channel can show these too, with your name on them and a link to open the item. Everyone in the channel sees them.
        </MudText>
        @foreach (var group in _choices.Groups)
        {
            <MudSwitch T="bool" Value="group.Enabled" ValueChanged="v => ToggleAsync(group.Group, v)" Color="Color.Primary" Disabled="_busy"
                       Label="@group.Label" data-testid="@($"teams-{group.Group}")" />
        }
    </MudPaper>
}

@code {
    private ChatChoicesDto? _choices;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _choices = await Teams.GetMineAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException)
        {
            _choices = null; // Teams is optional: the page works without it.
        }
    }

    private async Task ToggleAsync(string key, bool on)
    {
        if (_choices is null)
        {
            return;
        }

        var groups = _choices.Groups.Where(g => g.Group == key ? on : g.Enabled).Select(g => g.Group).ToList();
        _busy = true;
        try
        {
            _choices = await Teams.SetMineAsync(new SaveChatChoicesRequest(groups));
            Snackbar.Add("Saved", Severity.Success);
        }
        catch (Exception ex) when (ex is HttpRequestException or ArgumentException or UnauthorizedAccessException)
        {
            Snackbar.Add($"Couldn't save: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
