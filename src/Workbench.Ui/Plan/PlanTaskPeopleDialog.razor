@* One task's dates and people on the Plan tab: change the dates, each person's hours, take someone off, add someone, and
   fix anyone booked past their hours. Returns the changes (a PlanTaskPeopleResult); the Plan tab makes them, or adds them to
   what it's trying. People are the same assignments as on Budget & staffing. *@
@using Workbench.Contracts
@using Workbench.Contracts.Resourcing
@using Workbench.Ui.Resourcing
@inject IServiceProvider Services

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Row.OutlineNumber @Row.Title</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @(Row.Start is null ? "No dates yet" : PlanPeopleFormat.Range(Row.Start, Row.Finish))@(Row.WbsCode is { } code ? $" · charge code {code}" : "")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (Trying)
            {
                <MudAlert Severity="Severity.Info" Dense="true">You're trying changes: these are added to the list, and nothing is saved until you apply them.</MudAlert>
            }

            @if (CanMoveTasks && !Row.IsSummary)
            {
                <section aria-labelledby="task-dates">
                    <MudText Typo="Typo.subtitle2" HtmlTag="h3" id="task-dates">Dates</MudText>
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        <MudDatePicker Label="Start" @bind-Date="_start" DateFormat="MMM d, yyyy" Editable="true" Style="max-width: 170px" data-testid="plan-task-start" />
                        <MudDatePicker Label="Finish" @bind-Date="_finish" DateFormat="MMM d, yyyy" Editable="true" Style="max-width: 170px" data-testid="plan-task-finish" />
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @(_finish == Row.Finish?.ToDateTime(TimeOnly.MinValue) && _start != Row.Start?.ToDateTime(TimeOnly.MinValue)
                            ? "A new start keeps the task's working days, so its finish moves too. "
                            : "")Moving the task moves the tasks after it and the people on them.
                    </MudText>
                </section>
            }

            <section aria-labelledby="task-people">
                <MudText Typo="Typo.subtitle2" HtmlTag="h3" id="task-people">People</MudText>
                @if (_people.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Nobody is on this task yet.</MudText>
                }
                @foreach (var p in _people)
                {
                    var person = p;
                    <MudPaper Outlined="true" Class="pa-2 mb-2" data-testid="plan-task-person">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                            <div style="min-width: 180px; flex: 1">
                                <MudText Typo="Typo.body1" Style="@(person.Removed ? "text-decoration: line-through" : null)">@person.Dto.Name</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @(person.Dto.LaborCategory ?? "No labor category") · @PlanPeopleFormat.Range(person.Dto.From, person.Dto.To)
                                    @if (ShowsCost && person.Dto.Cost is { } cost)
                                    {
                                        <span> · @PlanPeopleFormat.Money(cost)</span>
                                    }
                                </MudText>
                            </div>
                            @if (person.Dto.AssignmentId is not null && CanChange && !person.Removed)
                            {
                                <MudNumericField T="decimal" Label="Hours" @bind-Value="person.Hours" Min="0.25m" Max="99999m" Style="max-width: 110px"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" data-testid="plan-task-hours" />
                                <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" aria-label="@($"Take {person.Dto.Name} off this task")" Size="Size.Small"
                                               OnClick="() => person.Removed = true" data-testid="plan-task-remove" />
                            }
                            else if (person.Removed)
                            {
                                <MudButton Size="Size.Small" OnClick="() => person.Removed = false">Keep</MudButton>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2">@PlanPeopleFormat.Hours(person.Dto.Hours) h</MudText>
                            }
                        </MudStack>
                        @if (person.Dto.AssignmentId is null)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Staffed week by week; change these hours on Budget &amp; staffing.</MudText>
                        }
                        @if (person.Dto.IsOverbooked && !person.Removed)
                        {
                            var first = person.Dto.Overbooked[0];
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2" data-testid="plan-task-overbooked">
                                @person.Dto.Name is @PlanPeopleFormat.Overbooked(first)@(person.Dto.Overbooked.Count > 1 ? $", and {person.Dto.Overbooked.Count - 1} more {(person.Dto.Overbooked.Count == 2 ? "week" : "weeks")}" : "").
                            </MudAlert>
                            @if (person.Dto.AssignmentId is { } assignmentId && CanChange && !Trying)
                            {
                                @if (person.Fixes is null)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Build" Class="mt-1"
                                               OnClick="() => LoadFixesAsync(person, assignmentId)" Disabled="person.Loading" data-testid="plan-task-show-fixes">Fix it</MudButton>
                                }
                                else if (person.Fixes.Count == 0)
                                {
                                    <MudText Typo="Typo.body2" Class="mt-1">No quick fix fits within a year. Lower their hours, or pick someone else above.</MudText>
                                }
                                else
                                {
                                    <MudStack Spacing="1" Class="mt-2" data-testid="plan-task-fixes">
                                        @foreach (var fix in person.Fixes)
                                        {
                                            <div class="d-flex flex-wrap align-center gap-2">
                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="() => Done(fix.Changes, tryFirst: false)"
                                                           data-testid="plan-task-fix">@fix.Label</MudButton>
                                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => Done(fix.Changes, tryFirst: true)">Try it first</MudButton>
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="flex: 1 1 100%">@fix.Explanation</MudText>
                                            </div>
                                        }
                                    </MudStack>
                                }
                            }
                        }
                    </MudPaper>
                }

                @if (CanChange && Row.CanAssign)
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Class="mt-2" data-testid="plan-task-add">
                        <MudAutocomplete T="StaffingCandidateDto" Label="Add a person" @bind-Value="_newPerson" SearchFunc="SearchPeople" ToStringFunc="@(c => c?.Name ?? "")"
                                         ResetValueOnEmptyText="true" CoerceText="true" MaxItems="50" Style="min-width: 220px" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         data-testid="plan-task-add-person">
                            <ItemTemplate Context="c">
                                <span>@c.Name</span>
                                <span class="mud-text-secondary"> · @(c.LaborCategory ?? "no labor category") · @ResourcingFormat.Hours(c.BookedHoursPerWeek) of @ResourcingFormat.Hours(c.StandardHoursPerWeek) h a week booked</span>
                            </ItemTemplate>
                        </MudAutocomplete>
                        <MudNumericField T="decimal?" Label="Hours" @bind-Value="_newHours" Min="0.25m" Max="99999m" Style="max-width: 110px" Variant="Variant.Outlined"
                                         Margin="Margin.Dense" HelperText="In total, over the task's dates" Immediate="true" data-testid="plan-task-add-hours" />
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PersonAdd" Disabled="@(_newPerson is null || _newHours is not > 0)"
                                   OnClick="AddPerson" Class="mt-1" data-testid="plan-task-add-button">Add</MudButton>
                    </MudStack>
                    @foreach (var added in _added)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" OnClose="() => _added.Remove(added)">
                            Adding @added.Name · @PlanPeopleFormat.Hours(added.Hours) h
                        </MudChip>
                    }
                }
                else if (!Row.CanAssign && !Row.IsSummary)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">This task isn't a charge code yet, so nobody can be assigned to it. Make the plan's tasks charge codes first.</MudText>
                }
            </section>
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        @if (CanChange || CanMoveTasks)
        {
            @if (!Trying)
            {
                <MudButton Variant="Variant.Text" OnClick="() => Done(Changes(), tryFirst: true)" Disabled="@(Changes().Count == 0)" data-testid="plan-task-try">Try it first</MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => Done(Changes(), tryFirst: Trying)" Disabled="@(Changes().Count == 0)" data-testid="plan-task-save">
                @(Trying ? "Add to the changes" : "Save")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    [Parameter, EditorRequired] public PlanTaskRowDto Row { get; set; } = default!;
    [Parameter] public bool CanChange { get; set; }
    [Parameter] public bool CanMoveTasks { get; set; }
    [Parameter] public bool ShowsCost { get; set; }

    /// <summary>The Plan tab is trying changes: the dialog adds to them, and fixes (worked out on the saved plan) aren't offered.</summary>
    [Parameter] public bool Trying { get; set; }

    private sealed class PersonEdit(PlanPersonDto dto)
    {
        public PlanPersonDto Dto { get; } = dto;
        public decimal Hours { get; set; } = dto.Hours;
        public bool Removed { get; set; }
        public bool Loading { get; set; }
        public IReadOnlyList<OverbookingFixDto>? Fixes { get; set; }
    }

    private sealed record Added(Guid EmployeeId, string Name, decimal Hours);

    private List<PersonEdit> _people = [];
    private readonly List<Added> _added = [];
    private IReadOnlyList<StaffingCandidateDto> _candidates = [];
    private StaffingCandidateDto? _newPerson;
    private decimal? _newHours;
    private DateTime? _start;
    private DateTime? _finish;
    private string? _error;

    private IResourcePlanService? PlanPeople => Services.GetService(typeof(IResourcePlanService)) as IResourcePlanService;

    protected override async Task OnInitializedAsync()
    {
        _people = Row.People.Select(p => new PersonEdit(p)).ToList();
        (_start, _finish) = (Row.Start?.ToDateTime(TimeOnly.MinValue), Row.Finish?.ToDateTime(TimeOnly.MinValue));
        if (CanChange && Row.CanAssign && Services.GetService(typeof(IProjectStaffingService)) is IProjectStaffingService staffing)
        {
            try
            {
                var category = Row.People.Select(p => p.LaborCategoryId).FirstOrDefault(c => c is not null);
                _candidates = await staffing.ListCandidatesAsync(ProjectId, category);
            }
            catch (Exception ex) when (ResourcingFormat.IsExpected(ex) || ex is WorkbenchForbiddenException)
            {
                _error = ex.Message;
            }
        }
    }

    private Task<IEnumerable<StaffingCandidateDto>> SearchPeople(string? text, CancellationToken _) =>
        Task.FromResult(string.IsNullOrWhiteSpace(text)
            ? _candidates.AsEnumerable()
            : _candidates.Where(c => c.Name.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase)));

    private void AddPerson()
    {
        if (_newPerson is { } person && _newHours is { } hours && hours > 0)
        {
            _added.Add(new Added(person.EmployeeId, person.Name, hours));
            (_newPerson, _newHours) = (null, null);
        }
    }

    private async Task LoadFixesAsync(PersonEdit person, Guid assignmentId)
    {
        if (PlanPeople is not { } plans)
        {
            return;
        }

        person.Loading = true;
        try
        {
            person.Fixes = await plans.ListFixesAsync(ProjectId, assignmentId);
        }
        catch (Exception ex) when (ResourcingFormat.IsExpected(ex) || ex is WorkbenchForbiddenException)
        {
            _error = ex.Message;
        }
        finally
        {
            person.Loading = false;
        }
    }

    private List<PlanChange> Changes()
    {
        var changes = new List<PlanChange>();
        var start = _start is { } s ? DateOnly.FromDateTime(s) : (DateOnly?)null;
        var finish = _finish is { } f ? DateOnly.FromDateTime(f) : (DateOnly?)null;
        if (CanMoveTasks && !Row.IsSummary && (start != Row.Start || finish != Row.Finish) && (start ?? finish) is not null)
        {
            // A new start alone keeps the task's working days; a new finish changes them.
            changes.Add(finish == Row.Finish
                ? new PlanChange(PlanChangeKind.MoveTask, ItemId: Row.ItemId, Start: start)
                : new PlanChange(PlanChangeKind.MoveTask, ItemId: Row.ItemId, Start: start, Finish: finish));
        }

        foreach (var p in _people.Where(p => p.Dto.AssignmentId is not null))
        {
            if (p.Removed)
            {
                changes.Add(new PlanChange(PlanChangeKind.RemovePerson, AssignmentId: p.Dto.AssignmentId));
            }
            else if (p.Hours != p.Dto.Hours && p.Hours > 0)
            {
                changes.Add(new PlanChange(PlanChangeKind.SetPerson, AssignmentId: p.Dto.AssignmentId, Hours: p.Hours));
            }
        }

        changes.AddRange(_added.Select(a => new PlanChange(PlanChangeKind.SetPerson, ItemId: Row.ItemId, EmployeeId: a.EmployeeId, Hours: a.Hours)));
        return changes;
    }

    private void Done(IReadOnlyList<PlanChange> changes, bool tryFirst)
    {
        if (changes.Count > 0)
        {
            var names = _candidates.ToDictionary(c => c.EmployeeId, c => c.Name);
            foreach (var a in _added)
            {
                names[a.EmployeeId] = a.Name;
            }

            MudDialog.Close(DialogResult.Ok(new PlanTaskPeopleResult(changes, tryFirst, names)));
        }
    }
}
