@* The plan with Finance, on the Plan tab: the project's terms (ceiling, funding, type, fee: Finance changes them here),
   where approval stands, and the one next step: the PM submits; Finance approves or returns it with comments. Once
   approved, changes are the working version and show against the baseline until they're submitted and approved too.
   Hidden for people who can't see the project's financials. *@
@using Workbench.Contracts
@using Workbench.Contracts.ProjectAccounting
@using Workbench.Contracts.Resourcing
@inject IServiceProvider Services
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (_plan is { } plan)
{
    @if (Part == PlanApprovalPart.Bar)
    {
    <div class="wb-approval" data-testid="plan-approval">
        <div class="wb-approval-row">
            <MudChip T="string" Size="Size.Small" Color="@StatusColor(plan)" Variant="Variant.Filled" data-testid="plan-approval-status">@StatusText(plan)</MudChip>
            <span class="wb-approval-text">@Explain(plan)</span>
            <span class="wb-approval-actions">
            @if (plan.CanSubmit && !_reviewing)
            {
                @if (plan.ApprovesItself)
                {
                    @* Nothing for Finance to review: no note to write. *@
                }
                else if (_noteOpen || !string.IsNullOrEmpty(_note))
                {
                    <input class="wb-approval-note" placeholder="Note for Finance (optional)" aria-label="Note for Finance" @bind="_note" />
                }
                else
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => _noteOpen = true" data-testid="plan-note-add">Add a note</MudButton>
                }
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" OnClick="SubmitAsync" Disabled="@(_busy || !plan.SetupDone)"
                           data-testid="plan-submit">@SubmitLabel(plan)</MudButton>
            }
            @if (plan.CanReview)
            {
                <input class="wb-approval-note" placeholder="Comments (needed to return it)" aria-label="Comments for the project manager" @bind="_comment" @bind:event="oninput" />
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ReturnAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_comment))" data-testid="plan-return">Return to PM</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check" OnClick="ApproveAsync" Disabled="_busy"
                           data-testid="plan-approve">Approve</MudButton>
            }
            </span>
        </div>

        @if (plan.Status == PlanApprovalStatus.Returned && plan.ReviewComment is { } why)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1" data-testid="plan-returned">@(plan.ReviewedByName ?? plan.ReviewedBy) returned it: "@why"</MudAlert>
        }
        @if (plan.Status == PlanApprovalStatus.Submitted && plan.SubmitNote is { } note)
        {
            <span class="wb-approval-text d-block mt-1">Note from @(plan.SubmittedByName ?? plan.SubmittedBy): "@note"</span>
        }
        @if (plan.SinceBaseline.Count > 0 && (plan.ChangedSinceApproval || plan.CanReview))
        {
            <table class="wb-approval-table" data-testid="plan-since-baseline" aria-label="The plan against the approved baseline">
                <thead>
                    <tr><th>Labor category</th><th class="wb-num">Baseline</th><th class="wb-num">Plan now</th><th class="wb-num">Change</th></tr>
                </thead>
                <tbody>
                    @foreach (var line in plan.SinceBaseline)
                    {
                        <tr>
                            <td>@line.LaborCategory</td>
                            <td class="wb-num">@PlanPeopleFormat.Hours(line.BaselineHours) h</td>
                            <td class="wb-num">@PlanPeopleFormat.Hours(line.PlanHours) h</td>
                            <td class="wb-num">@(line.HoursChange > 0 ? "+" : "")@PlanPeopleFormat.Hours(line.HoursChange) h</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

    </div>
    }
    else
    {
    <div class="wb-approval wb-approval-details" data-testid="plan-details">
        <div class="wb-approval-row">
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@(_detailsOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                       OnClick="() => _detailsOpen = !_detailsOpen" aria-expanded="@(_detailsOpen ? "true" : "false")" data-testid="plan-details-toggle">Plan details</MudButton>
            <span class="wb-approval-text">@DetailsHint(plan)</span>
        </div>
        @if (_detailsOpen)
        {
        @if (plan.Steps is { Count: > 0 } steps && steps.Any(s => !s.Done))
        {
            @* Where the project is in its life, and the one step that's next. *@
            <ol class="wb-approval-steps" data-testid="plan-steps" aria-label="Project steps">
                @foreach (var step in steps)
                {
                    <li class="@(step.Done ? "wb-step-done" : step.Current ? "wb-step-current" : "wb-step-todo")" aria-current="@(step.Current ? "step" : null)">
                        <MudIcon Icon="@(step.Done ? Icons.Material.Filled.CheckCircle : step.Current ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Outlined.RadioButtonUnchecked)"
                                 Size="Size.Small" Color="@(step.Done ? Color.Success : step.Current ? Color.Primary : Color.Default)" />
                        <span><strong>@step.Label</strong>@(step.Detail is { } d ? $" · {d}" : "")</span>
                    </li>
                }
            </ol>
        }

        <div class="wb-approval-terms" data-testid="plan-terms">
                <span>
                    @plan.Terms.PricingLabel@(plan.Terms.ContractNumber is { } c ? $" · contract {c}" : "")@(plan.Terms.FeeRate > 0 ? $" · {Percent(plan.Terms.FeeRate)} fee" : "")
                    @(plan.Terms.Start is { } s && plan.Terms.Finish is { } f ? $" · {PlanPeopleFormat.Range(s, f)}" : "")
                </span>
                @if (plan.CanEditTerms)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => _editing = !_editing" data-testid="plan-terms-edit">@(_editing ? "Close" : "Change the ceiling or funding")</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => _editingCategories = !_editingCategories" data-testid="plan-categories-edit">@(_editingCategories ? "Close" : "Labor categories")</MudButton>
                }
            </div>
            @if (plan.Categories?.Where(c => c.Selected).ToList() is { Count: > 0 } picked)
            {
                <div class="wb-approval-terms" data-testid="plan-categories">
                    <span>Plan with: @string.Join(", ", picked.Select(c => c.Label))</span>
                </div>
            }
            @if (_editingCategories && plan.Categories is { } all)
            {
                <div class="wb-approval-row mt-1" data-testid="plan-categories-form">
                    <MudSelect T="Guid" SelectedValues="_categoryIds" SelectedValuesChanged="values => _categoryIds = values.ToHashSet()" MultiSelection="true"
                               Label="Labor categories" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:420px">
                        @foreach (var c in all)
                        {
                            <MudSelectItem T="Guid" Value="c.Id">@c.Label@(c.OnContract ? " · on the contract" : "")</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveCategoriesAsync" Disabled="_busy" data-testid="plan-categories-save">Save</MudButton>
                    <span class="wb-approval-text">The project manager plans with these. Leave it empty to allow any.</span>
                </div>
            }
            @if (_editing)
            {
                <div class="wb-approval-row mt-1" data-testid="plan-terms-form">
                    <MudNumericField T="decimal?" @bind-Value="_ceiling" Label="Ceiling ($)" Format="N0" Min="0" Style="max-width:170px" Margin="Margin.Dense" Variant="Variant.Outlined" />
                    <MudNumericField T="decimal?" @bind-Value="_funded" Label="Funded ($)" Format="N0" Min="0" Style="max-width:170px" Margin="Margin.Dense" Variant="Variant.Outlined" />
                    <MudNumericField T="decimal?" @bind-Value="_fee" Label="Fee (%)" Min="0" Max="99" Style="max-width:110px" Margin="Margin.Dense" Variant="Variant.Outlined" />
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveTermsAsync" Disabled="_busy">Save</MudButton>
                    <span class="wb-approval-text">Leave a box as the contract says to keep following it.</span>
                </div>
            }
        }
    </div>
    }
}

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }

    /// <summary>The bar (status, next step, Submit or Approve) sits above the WBS grid; the details (steps, terms) below it.</summary>
    [Parameter] public PlanApprovalPart Part { get; set; } = PlanApprovalPart.Bar;

    /// <summary>Changes when the plan changes, so "changed since approval" is fresh.</summary>
    [Parameter] public int Version { get; set; }

    /// <summary>Raised after a submit, approval, return or terms change, so the page around the bar can refresh.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private ProjectPlanDto? _plan;
    private int _loadedVersion = -1;
    private int _autoTriedVersion = -1;
    private string? _note;
    private string? _comment;
    private bool _busy;
    private bool _editing;
    private bool _detailsOpen;
    private bool _noteOpen;
    private bool _editingCategories;
    private IReadOnlyCollection<Guid> _categoryIds = new HashSet<Guid>();
    private bool _reviewing;
    private decimal? _ceiling;
    private decimal? _funded;
    private decimal? _fee;

    private IProjectPlanService? Plans => Services.GetService(typeof(IProjectPlanService)) as IProjectPlanService;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedVersion != Version)
        {
            _loadedVersion = Version;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        if (Plans is not { } plans)
        {
            return;
        }

        try
        {
            Set(await plans.GetAsync(ProjectId));
        }
        catch (Exception ex) when (ex is WorkbenchForbiddenException or WorkbenchNotFoundException or HttpRequestException or TaskCanceledException or UnauthorizedAccessException)
        {
            _plan = null;
            return;
        }

        await MakeLiveAsync();
    }

    /// <summary>
    /// A plan within the contract's money has nothing for Finance to review, so it goes live as the project manager builds
    /// it: no Submit step. Only the bar does this (the details part shares the plan), and not while something is still wrong
    /// (an overbooked person, someone with no hours, money past what's funded), which keeps the button and its question.
    /// </summary>
    private async Task MakeLiveAsync()
    {
        if (Part != PlanApprovalPart.Bar || _busy || _plan is not { CanSubmit: true, ApprovesItself: true, SetupDone: true } || _autoTriedVersion == Version)
        {
            return;
        }

        _autoTriedVersion = Version;
        // Schedule checks are advice; people and money that don't add up are what hold it back.
        if ((await OpenProblemsAsync(includeSchedule: false)).Count > 0)
        {
            return;
        }

        await RunAsync(p => p.SubmitAsync(ProjectId, null), plan => plan.Status == PlanApprovalStatus.Approved
            ? "Saved and live. It's within the contract's budget, so Finance doesn't need to review it."
            : "Sent to Finance for review.");
    }

    private void Set(ProjectPlanDto plan)
    {
        // Open the first time only, and only for a plan that still has steps to do; after that it stays as the person left it.
        _detailsOpen = _plan is null ? plan.Status is PlanApprovalStatus.Draft or PlanApprovalStatus.Returned && plan.Steps?.Any(x => !x.Done) == true : _detailsOpen;
        _plan = plan;
        (_ceiling, _funded, _fee) = (plan.Terms.Ceiling, plan.Terms.Funded, Math.Round(plan.Terms.FeeRate * 100, 2));
        _categoryIds = (plan.Categories ?? []).Where(c => c.Selected).Select(c => c.Id).ToHashSet();
    }

    private async Task SubmitAsync()
    {
        if (await ConfirmOpenProblemsAsync(_plan?.ApprovesItself == true ? "Make the plan live with these open?" : "Send the plan to Finance with these open?", _plan?.ApprovesItself == true ? "Make it live" : "Send anyway"))
        {
            await RunAsync(p => p.SubmitAsync(ProjectId, _note), plan => plan.Status == PlanApprovalStatus.Approved
                ? "Live. It's within the contract's budget, so Finance didn't need to review it."
                : "Sent to Finance. It goes past the contract's budget, so they review it. You'll be notified when they approve it or send it back.");
        }
    }

    private async Task ApproveAsync()
    {
        if (await ConfirmOpenProblemsAsync("Approve the plan with these open?", "Approve anyway", "Approving makes it the baseline, so these are locked in."))
        {
            await RunAsync(p => p.ApproveAsync(ProjectId, _comment), "Approved. The plan is the project's budget now.");
        }
    }

    /// <summary>
    /// Submitting and approving are the points of no return (approval sets the baseline), so what's still wrong with the plan is
    /// said first: overbooked people, hours that don't fit, failing schedule checks, a plan past its funding. Nothing open, no question.
    /// </summary>
    private async Task<bool> ConfirmOpenProblemsAsync(string title, string yes, string? footer = null)
    {
        var problems = await OpenProblemsAsync();
        if (problems.Count == 0)
        {
            return true;
        }

        var items = string.Concat(problems.Take(6).Select(p => $"<li>{System.Net.WebUtility.HtmlEncode(p)}</li>"));
        var more = problems.Count > 6 ? $"<p>and {problems.Count - 6} more.</p>" : "";
        var message = new MarkupString($"<ul>{items}</ul>{more}{(footer is null ? "" : $"<p>{System.Net.WebUtility.HtmlEncode(footer)}</p>")}");
        return await DialogService.ShowMessageBoxAsync(title, message, yesText: yes, cancelText: "Go back") == true;
    }

    private async Task<List<string>> OpenProblemsAsync(bool includeSchedule = true)
    {
        var problems = new List<string>();
        if (Services.GetService(typeof(IResourcePlanService)) is not IResourcePlanService resourcePlan)
        {
            return problems;
        }

        try
        {
            var model = await resourcePlan.GetAsync(ProjectId);
            if (model.Totals.OverbookedPeople.Count > 0)
            {
                problems.Add($"{string.Join(", ", model.Totals.OverbookedPeople)} {(model.Totals.OverbookedPeople.Count == 1 ? "is" : "are")} booked past their hours.");
            }

            problems.AddRange(model.Tasks.SelectMany(t => t.People.SelectMany(p => p.Issues.Select(i => $"{t.Title}: {p.Name}. {i}"))));
            if (includeSchedule && model.Health is { Failed: > 0 } health && model.Totals.Hours > 0)
            {
                problems.Add($"{health.Failed} schedule check{(health.Failed == 1 ? "" : "s")} fail.");
            }

            if (model.Totals.Money is { } money)
            {
                if (money.Project.Status == PlanMoneyStatus.OverCeiling)
                {
                    problems.Add("The plan costs more than the contract's ceiling.");
                }
                else if (money.Project.Status == PlanMoneyStatus.OverFunding)
                {
                    problems.Add("The plan costs more than is funded so far.");
                }
            }
        }
        catch (Exception ex) when (ex is WorkbenchForbiddenException or WorkbenchNotFoundException or HttpRequestException or TaskCanceledException or UnauthorizedAccessException)
        {
            // Not able to see the plan's people: nothing to warn about from here.
        }

        return problems;
    }

    private Task ReturnAsync() => RunAsync(p => p.ReturnAsync(ProjectId, _comment ?? ""), "Returned to the project manager with your comments.");

    private Task SaveTermsAsync() =>
        RunAsync(p => p.SaveTermsAsync(ProjectId, new SaveProjectTermsRequest(_ceiling, _funded, _plan?.Terms.Pricing, _fee is { } f ? f / 100m : null)), "Saved the project's ceiling and funding.");

    private Task SaveCategoriesAsync() => RunAsync(p => p.SaveCategoriesAsync(ProjectId, _categoryIds.ToList()), "Saved the project's labor categories.");

    private Task RunAsync(Func<IProjectPlanService, Task<ProjectPlanDto>> action, string done) => RunAsync(action, _ => done);

    private async Task RunAsync(Func<IProjectPlanService, Task<ProjectPlanDto>> action, Func<ProjectPlanDto, string> done)
    {
        if (Plans is not { } plans)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await action(plans);
            Set(result);
            (_note, _comment, _editing, _editingCategories, _noteOpen) = (null, null, false, false, false);
            Snackbar.Add(done(result), Severity.Success);
            await Changed.InvokeAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or WorkbenchForbiddenException or WorkbenchNotFoundException or HttpRequestException or TaskCanceledException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string SubmitLabel(ProjectPlanDto plan) =>
        plan.ApprovesItself ? "Make it live" : plan.Status == PlanApprovalStatus.Approved ? "Send the changes to Finance" : "Send to Finance for approval";

    private static string StatusText(ProjectPlanDto plan) => plan.Status switch
    {
        PlanApprovalStatus.Submitted => "With Finance",
        PlanApprovalStatus.Approved when plan.ChangedSinceApproval => "Changed since approval",
        PlanApprovalStatus.Approved => "Approved",
        PlanApprovalStatus.Returned => "Returned",
        _ => "Draft",
    };

    private static Color StatusColor(ProjectPlanDto plan) => plan.Status switch
    {
        PlanApprovalStatus.Submitted => Color.Info,
        PlanApprovalStatus.Approved when plan.ChangedSinceApproval => Color.Warning,
        PlanApprovalStatus.Approved => Color.Success,
        PlanApprovalStatus.Returned => Color.Warning,
        _ => Color.Default,
    };

    private static string Explain(ProjectPlanDto plan) => plan.Status switch
    {
        PlanApprovalStatus.Submitted => $"Submitted by {plan.SubmittedByName ?? plan.SubmittedBy}{When(plan.SubmittedAtUtc)}. Finance approves it or sends it back.",
        PlanApprovalStatus.Approved when plan.ChangedSinceApproval && plan.ApprovesItself =>
            $"Since the approved baseline: {Signed(plan.HoursChange)} h. Fix what's open below, then make it live: it's within the contract's budget, so Finance isn't needed.",
        PlanApprovalStatus.Approved when plan.ChangedSinceApproval =>
            $"Since the approved baseline: {Signed(plan.HoursChange)} h. This goes past the contract's budget, so send it to Finance.",
        PlanApprovalStatus.Approved when plan.ReviewedBy == "Workbench" => $"Live{When(plan.ReviewedAtUtc)}: it's within the contract's budget. Changes inside it go live as you make them.",
        PlanApprovalStatus.Approved => $"Approved by {plan.ReviewedByName ?? plan.ReviewedBy}{When(plan.ReviewedAtUtc)}. It's the project's baseline budget.",
        PlanApprovalStatus.Returned => "Make the changes Finance asked for, then send it again.",
        _ when !plan.SetupDone => "Plan it now. It can go live once Finance has added the project's funding and labor categories.",
        _ when plan.ApprovesItself => "Fix what's open below, then make it live: it's within the contract's budget, so Finance isn't needed.",
        _ => "Build the WBS and assign people. Within the contract's budget it goes live as you work; if it goes past, you send it to Finance.",
    };

    private static string DetailsHint(ProjectPlanDto plan) =>
        plan.Steps?.Count(x => !x.Done) is > 0 and var todo
            ? $"{todo} step{(todo == 1 ? "" : "s")} to go, and the contract's terms"
            : "The contract's terms and where the project is in its life";

    private static string When(DateTime? utc) => utc is { } t ? $" on {t:MMM d}" : "";

    private static string Signed(decimal hours) => (hours > 0 ? "+" : "") + PlanPeopleFormat.Hours(hours);

    private static string Percent(decimal rate) => (rate * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
}
