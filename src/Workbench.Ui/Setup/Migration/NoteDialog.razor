@* Asks for a note (required or optional) before a sign-off or a "not applicable" mark. *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (!string.IsNullOrEmpty(Message))
            {
                <MudText>@Message</MudText>
            }
            <MudTextField @bind-Value="_note" Label="@Label" AutoFocus="true" Immediate="true" Lines="3" MaxLength="2000"
                          HelperText="@(Required ? "Required. Kept with the evidence." : "Optional. Kept with the evidence.")" data-testid="note-field" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(Required && string.IsNullOrWhiteSpace(_note))"
                   OnClick="() => MudDialog.Close(DialogResult.Ok(_note?.Trim() ?? string.Empty))" data-testid="note-confirm">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public string Label { get; set; } = "Note";

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public string ConfirmText { get; set; } = "Save";

    private string? _note;
}
