@page "/setup/approval-workflows"
@inject IApprovalWorkflowService Workflows
@inject IPeopleService People
@inject ICurrentUserContext CurrentUser
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Approval workflows · Setup · Workbench</PageTitle>

<SetupHeader Title="Approval workflows"
             Subtitle="Who approves each kind of document, in what order and when. Saving publishes a new version; documents already submitted keep the version they started with." />

@if (_workflows is null)
{
    <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (_pmTime is { } pmTime)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-4" data-testid="pm-time-approval">
            <MudSwitch T="bool" Value="pmTime" ValueChanged="SetPmTimeAsync" Disabled="!_isAdmin || _busy" Color="Color.Primary" data-testid="pm-time-switch"
                       Label="Project managers approve time charged to their projects" />
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                When this is on, a submitted timesheet also goes to the manager of each project it charges, at the same time as the
                supervisor. Each manager approves only the hours on their own projects, from Approvals › Time on my projects. The
                timesheet is approved once everyone has approved. Projects without a manager, and a manager's own hours on their
                project, skip this step. Off by default; timesheets already submitted keep the rules they started with.
            </MudText>
        </MudPaper>
    }

    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudSimpleTable Dense="true" Elevation="0" data-testid="workflows">
            <thead><tr><th>Document</th><th>Workflow</th><th>Version</th><th>Steps</th><th>In flight</th><th>Updated</th><th></th></tr></thead>
            <tbody>
                @foreach (var w in _workflows)
                {
                    <tr>
                        <td>@w.DocumentLabel</td>
                        <td>@w.Name</td>
                        <td>v@(w.Version)</td>
                        <td>@w.StepCount</td>
                        <td>@w.InFlight</td>
                        <td>@w.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
                        <td><MudButton Size="Size.Small" Href="@($"setup/approval-workflows/{w.DocumentType}")">@(_isAdmin ? "Edit" : "View")</MudButton></td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
        @if (_isAdmin)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-4" Wrap="Wrap.Wrap">
                <MudTextField @bind-Value="_newName" Label="New record approval workflow" Placeholder="e.g. Large requisition review" Margin="Margin.Dense" Style="max-width:340px"
                              HelperText="For automations' &quot;Require an approval&quot; action, on any record type." data-testid="new-record-workflow" />
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Disabled="string.IsNullOrWhiteSpace(_newName)" OnClick="CreateRecordWorkflowAsync">Create</MudButton>
            </MudStack>
        }
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-4">
        <MudText Typo="Typo.h6" HtmlTag="h2">Org-unit approvers</MudText>
        <MudText Class="mud-text-secondary mb-3">Used by steps whose approver is "the org unit's manager".</MudText>
        <MudSimpleTable Dense="true" Elevation="0">
            <thead><tr><th>Org unit</th><th>Approver</th></tr></thead>
            <tbody>
                @foreach (var unit in _units ?? [])
                {
                    <tr>
                        <td>@unit.OrgUnitCode @unit.OrgUnitName</td>
                        <td style="min-width:280px">
                            @if (_isAdmin)
                            {
                                <MudSelect T="Guid?" Value="unit.EmployeeId" aria-label="@($"Approver for {unit.OrgUnitCode} {unit.OrgUnitName}")" ValueChanged="v => SetApproverAsync(unit, v)" Dense="true" Clearable="true" Placeholder="Nobody">
                                    @foreach (var e in _employees)
                                    {
                                        <MudSelectItem T="Guid?" Value="e.Id">@e.DisplayName</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else
                            {
                                @(unit.EmployeeName ?? "Nobody")
                            }
                        </td>
                    </tr>
                }
                @if (_units is { Count: 0 })
                {
                    <tr><td colspan="2" class="mud-text-secondary">No org units yet.</td></tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}

@code {
    private IReadOnlyList<ApprovalWorkflowSummaryDto>? _workflows;
    private IReadOnlyList<OrgUnitApproverDto>? _units;
    private IReadOnlyList<EmployeeDto> _employees = [];
    private bool _isAdmin;
    private string? _newName;
    private bool? _pmTime;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = (await CurrentUser.GetAsync()).Can(Permission.ApprovalWorkflowsManage);
        _workflows = await Workflows.ListAsync();
        _pmTime = ProjectManagerTimeApproval.IsOn((await Workflows.GetAsync(ApprovalDocumentTypes.Timesheet)).Definition);
        _units = await Workflows.ListOrgUnitApproversAsync();
        _employees = (await People.ListEmployeesAsync()).OrderBy(e => e.DisplayName).ToList();
    }

    private async Task CreateRecordWorkflowAsync()
    {
        try
        {
            var created = await Workflows.CreateRecordWorkflowAsync(new CreateRecordApprovalWorkflowRequest(_newName ?? ""));
            Navigation.NavigateTo($"setup/approval-workflows/{created.DocumentType}");
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException or WorkbenchNotFoundException or HttpRequestException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SetPmTimeAsync(bool on)
    {
        _busy = true;
        try
        {
            var current = await Workflows.GetAsync(ApprovalDocumentTypes.Timesheet);
            var saved = await Workflows.SaveAsync(ApprovalDocumentTypes.Timesheet, new SaveApprovalWorkflowRequest(current.Name,
                ProjectManagerTimeApproval.With(current.Definition, on),
                on ? "Project managers approve time charged to their projects" : "Project managers no longer approve time"));
            _pmTime = ProjectManagerTimeApproval.IsOn(saved.Definition);
            _workflows = await Workflows.ListAsync();
            Snackbar.Add(on ? "Project managers now approve time charged to their projects" : "Timesheets no longer go to project managers", Severity.Success);
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException or WorkbenchNotFoundException or HttpRequestException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetApproverAsync(OrgUnitApproverDto unit, Guid? employeeId)
    {
        try
        {
            await Workflows.SetOrgUnitApproverAsync(unit.OrgUnitId, employeeId);
            _units = await Workflows.ListOrgUnitApproversAsync();
            Snackbar.Add($"Approver for {unit.OrgUnitCode} saved", Severity.Success);
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException or WorkbenchNotFoundException or HttpRequestException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
