@* The extra input an approver rule needs: the role (a built-in org role, or a custom role from Admin › Roles), or the people. *@
@inject IServiceProvider Services
@switch (Rule.Kind)
{
    case ApproverRuleKind.OrgRole:
        <div class="d-flex flex-wrap gap-2">
            <MudSelect T="ApprovalOrgRole?" @bind-Value="Rule.Role" Label="Org role" ReadOnly="@(ReadOnly || Rule.CustomRoleId is not null)" Style="min-width:200px">
                @foreach (var role in Enum.GetValues<ApprovalOrgRole>())
                {
                    <MudSelectItem T="ApprovalOrgRole?" Value="role">@role</MudSelectItem>
                }
            </MudSelect>
            @if (_custom.Count > 0 || Rule.CustomRoleId is not null)
            {
                <MudSelect T="Guid?" @bind-Value="Rule.CustomRoleId" Label="Or a custom role" ReadOnly="ReadOnly" Clearable="true" Style="min-width:200px"
                           ToStringFunc="@(id => id is { } v ? _custom.FirstOrDefault(r => r.Id == v)?.Name ?? "A deleted role" : "")" data-testid="rule-custom-role">
                    @foreach (var role in _custom)
                    {
                        <MudSelectItem T="Guid?" Value="role.Id">@role.Name</MudSelectItem>
                    }
                </MudSelect>
            }
        </div>
        break;
    case ApproverRuleKind.SpecificPeople or ApproverRuleKind.AnyOf:
        <MudTextField @bind-Value="Rule.People" Label="Emails (comma-separated)" ReadOnly="ReadOnly" />
        break;
}

@code {
    [Parameter, EditorRequired]
    public ApprovalWorkflowPage.RuleModel Rule { get; set; } = default!;

    [Parameter]
    public bool ReadOnly { get; set; }

    private IReadOnlyList<RoleRef> _custom = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _custom = Services.GetService(typeof(IRoleService)) is IRoleService roles ? (await roles.ListNamesAsync()).Where(r => !r.IsBuiltIn).ToList() : [];
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException or TaskCanceledException or InvalidOperationException)
        {
            _custom = [];
        }
    }
}
