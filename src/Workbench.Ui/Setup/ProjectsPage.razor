@page "/setup/projects"
@inject IProjectService Projects
@inject IPeopleService People
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Projects · Setup · Workbench</PageTitle>

<SetupHeader Title="Projects" Subtitle="Every project. Open one to set it up on its own page: details, plan and charge codes, budget and staffing.">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NewProjectAsync">New project</MudButton>
</SetupHeader>

<MudDataGrid T="ProjectDto" Items="_projects" Loading="_loading" Dense="true" Hover="true" QuickFilter="Matches"
             RowClick="@(a => Navigation.NavigateTo($"projects/{a.Item.Id}/setup"))" Style="cursor:pointer">
    <ToolBarContent>
        <MudTextField aria-label="Search projects" @bind-Value="_search" Placeholder="Search code or name" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true" />
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="p => p.Code">
            <CellTemplate><MudLink Href="@($"projects/{context.Item.Id}/setup")" Typo="Typo.body2">@context.Item.Code</MudLink></CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="p => p.Name" />
        <PropertyColumn Property="p => p.ContractNumber" Title="Contract" />
        <TemplateColumn Title="PM" SortBy="@(p => PmName(p.ProjectManagerId))">
            <CellTemplate>@PmName(context.Item.ProjectManagerId)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Status" SortBy="@(p => p.Status)">
            <CellTemplate><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0">@SetupFormat.Label(context.Item.Status)</MudChip></CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Dates" SortBy="@(p => p.Start)">
            <CellTemplate>@SetupFormat.Date(context.Item.Start) – @SetupFormat.Date(context.Item.Finish)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Plan" Sortable="false">
            <CellTemplate>
                @if (context.Item.SheetId is { } sheetId)
                {
                    <MudLink Href="@($"sheets/{sheetId}")" Typo="Typo.body2">Plan sheet</MudLink>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent><MudText>No projects yet. Create a project and its tasks so people have something to charge time to.</MudText></NoRecordsContent>
</MudDataGrid>

@code {
    private IReadOnlyList<ProjectDto> _projects = [];
    private IReadOnlyList<EmployeeDto> _employees = [];
    private bool _loading = true;
    private string? _search;

    protected override async Task OnInitializedAsync()
    {
        _employees = await People.ListEmployeesAsync(includeInactive: true);
        _projects = await Projects.ListProjectsAsync();
        _loading = false;
    }

    private string PmName(Guid? id) => _employees.FirstOrDefault(e => e.Id == id)?.DisplayName ?? "";

    private bool Matches(ProjectDto p) =>
        string.IsNullOrWhiteSpace(_search)
        || p.Code.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase);

    private Task NewProjectAsync() =>
        DialogService.ShowAsync<Workbench.Ui.Projects.NewProjectDialog>("New project", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
}
