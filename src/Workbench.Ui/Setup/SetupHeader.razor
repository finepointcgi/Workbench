@* Page heading for the setup screens: breadcrumb back to /setup, title, subtitle and actions. *@
<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-1">
    <MudStack Spacing="0">
        <MudLink Href="setup" Typo="Typo.caption">Setup</MudLink>
        <MudText Typo="Typo.h4" HtmlTag="h1">@Title</MudText>
    </MudStack>
    <MudSpacer />
    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">@ChildContent</MudStack>
</MudStack>
@if (Subtitle is not null)
{
    <MudText Class="mud-text-secondary mb-4">@Subtitle</MudText>
}

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
