@* Page heading for the setup screens: title, subtitle and actions (the page's breadcrumbs say where it sits, so no second "Setup" link). *@
<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-1">
    <MudText Typo="Typo.h4" HtmlTag="h1">@Title</MudText>
    <MudSpacer />
    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">@ChildContent</MudStack>
</MudStack>
@if (Subtitle is not null)
{
    <MudText Class="mud-text-secondary mb-4">@Subtitle</MudText>
}

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
