@page "/setup/projects/new"
@page "/setup/projects/{ProjectId:guid}"
@* Starting a project (the short form), and the old address of a project's setup, which now lives on the project page. *@
@inject NavigationManager Navigation
@inject ICurrentUserContext CurrentUser
@* Not SetupLayout: project managers (the org role) start the projects they manage here too. The server checks the same rules. *@
@layout Workbench.Ui.Layout.MainLayout

<PageTitle>New project · Workbench</PageTitle>

@if (ProjectId is null)
{
    <SetupHeader Title="New project" Subtitle="Only a name is needed. You'll manage it; Finance activates a project on a contract before anyone charges it.">
        <MudButton Variant="Variant.Outlined" Href="projects" StartIcon="@Icons.Material.Filled.ArrowBack">All projects</MudButton>
    </SetupHeader>
    @if (_allowed is null)
    {
        <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" />
    }
    else if (_allowed == false)
    {
        <ForbiddenNotice Title="You can't start projects"
                         Message="Starting a project is for Finance, administrators and project managers. Ask Finance if you need one." />
    }
    else
    {
        <MudPaper Outlined="true" Class="pa-4" Style="max-width:640px">
            <Workbench.Ui.Projects.NewProjectForm />
        </MudPaper>
    }
}

@code {
    [Parameter]
    public Guid? ProjectId { get; set; }

    [SupplyParameterFromQuery(Name = "section")]
    public string? Section { get; set; }

    private bool? _allowed;

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId is { } id)
        {
            // A project's setup is its page's Setup tab now.
            Navigation.NavigateTo($"projects/{id}/setup{(string.IsNullOrEmpty(Section) ? "" : $"/{Uri.EscapeDataString(Section)}")}", replace: true);
            return;
        }

        var me = await CurrentUser.GetAsync();
        _allowed = me.Can(Workbench.Contracts.Identity.Permission.SetupProjects) || me.Can(Workbench.Contracts.Identity.Permission.ProjectsCreate);
    }
}
