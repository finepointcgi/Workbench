@page "/setup/contracts"
@inject IContractService Contracts
@inject NavigationManager Navigation

<PageTitle>Contracts · Setup · Workbench</PageTitle>

<SetupHeader Title="Contracts" Subtitle="Contract type, period of performance, ceiling and funding, and bill rates by labor category.">
    <MudButton Variant="Variant.Outlined" Href="setup/customers" StartIcon="@Icons.Material.Filled.Business">Customers</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="setup/contracts/new">New contract</MudButton>
</SetupHeader>

<ConfigurableList T="ContractDto" Definition="_definition" Items="_contracts" Loading="_loading" SearchLabel="Search number, name or customer"
                  RowClick="@(c => Navigation.NavigateTo($"setup/contracts/{c.Id}"))" TestId="contracts-list">
    <NoRecordsContent><MudText>No contracts yet. Add your first contract with its value, funding and bill rates.</MudText></NoRecordsContent>
</ConfigurableList>

@code {
    private IReadOnlyList<ContractDto> _contracts = [];
    private bool _loading = true;

    internal static readonly ListDefinition<ContractDto> _definition = new()
    {
        ListKey = CustomizableLists.Contracts,
        EntityType = CustomizableEntities.Contract,
        Title = "Contracts",
        Id = c => c.Id,
        Columns =
        [
            new() { Key = "number", Title = "Number", Value = c => c.ContractNumber, Cell = c => @<MudLink Href="@($"setup/contracts/{c.Id}")" Typo="Typo.body2">@c.ContractNumber</MudLink> },
            new() { Key = "name", Title = "Name", Value = c => c.Name },
            new() { Key = "customer", Title = "Customer", Value = c => c.CustomerName },
            new() { Key = "type", Title = "Type", Value = c => c.Type, Display = c => SetupFormat.Label(c.Type), Cell = c => @<span title="@c.Type">@SetupFormat.Label(c.Type)</span> },
            new() { Key = "period", Title = "Period of performance", Value = c => c.PeriodStart, Kind = ListColumnKind.Date, Groupable = false,
                    Display = c => $"{SetupFormat.Date(c.PeriodStart)} – {SetupFormat.Date(c.PeriodEnd)}" },
            new() { Key = "periodEnd", Title = "Period end", Value = c => c.PeriodEnd, Kind = ListColumnKind.Date, Standard = false, Groupable = false },
            new() { Key = "ceiling", Title = "Ceiling", Value = c => c.CeilingValue, Kind = ListColumnKind.Money, Groupable = false, PermissionKey = "setup.contracts",
                    Cell = c => @<text>@SetupFormat.Money(c.CeilingValue)</text> },
            new() { Key = "funded", Title = "Funded", Value = c => c.FundedValue, Kind = ListColumnKind.Money, Groupable = false, PermissionKey = "setup.contracts",
                    Cell = c => @<text>
                        @SetupFormat.Money(c.FundedValue)
                        @if (c.CeilingValue > 0)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@((c.FundedValue / c.CeilingValue).ToString("P0")) of ceiling</MudText>
                        }
                    </text> },
            new() { Key = "fundedShare", Title = "Funded share", Value = c => c.CeilingValue > 0 ? c.FundedValue / c.CeilingValue : null, Kind = ListColumnKind.Percent,
                    Standard = false, Groupable = false, PermissionKey = "setup.contracts" },
            new() { Key = "prime", Title = "Prime", Value = c => c.IsPrime, Kind = ListColumnKind.Bool, Standard = false },
            new() { Key = "status", Title = "Status", Value = c => c.Status, Cell = c => @<ContractStatusChip Status="c.Status" /> },
        ],
    };

    protected override async Task OnInitializedAsync()
    {
        _contracts = await Contracts.ListContractsAsync();
        _loading = false;
    }
}
