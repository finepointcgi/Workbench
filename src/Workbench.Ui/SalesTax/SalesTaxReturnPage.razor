@page "/accounting/sales-tax"
@layout Workbench.Ui.Layout.AccountingLayout
@inject ISalesTaxService Tax
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Sales and use tax return · Workbench</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-1">
    <MudStack Spacing="0">
        <MudLink Href="setup/sales-tax" Typo="Typo.caption">Sales tax setup</MudLink>
        <MudText Typo="Typo.h4" HtmlTag="h1">Sales and use tax return</MudText>
    </MudStack>
</MudStack>
<MudText Class="mud-text-secondary mb-4">
    What to file for each jurisdiction: sales tax billed on approved invoices dated in the period, and use tax accrued on posted bills where the vendor didn't charge tax.
    Vendor-charged tax is shown for reference; it's already paid.
</MudText>

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Wrap="Wrap.Wrap" Class="mb-3">
    <MudDatePicker @bind-Date="_from" Label="From" DateFormat="yyyy-MM-dd" Editable="true" AutoClose="true" Style="max-width:170px" />
    <MudDatePicker @bind-Date="_to" Label="To" DateFormat="yyyy-MM-dd" Editable="true" AutoClose="true" Style="max-width:170px" />
    <MudTextField T="string" @bind-Value="_state" Label="State (optional)" MaxLength="2" Style="max-width:140px" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync" Disabled="@(_busy || _from is null || _to is null)" data-testid="run-tax-return">Show</MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportAsync" Disabled="@(_busy || _report is null)">CSV</MudButton>
</MudStack>

@if (_error is not null)
{
    <MudAlert Severity="@(_forbidden ? Severity.Info : Severity.Error)">@(_forbidden ? "The sales and use tax return is for Finance and administrators." : _error)</MudAlert>
}
else if (_report is { } r)
{
    @if (r.Rows.Count == 0)
    {
        <MudText Class="mud-text-secondary">No taxable sales or use tax in this period.</MudText>
    }
    else
    {
        <MudPaper Outlined="true" Class="pa-2" Style="overflow-x:auto">
            <MudSimpleTable Dense="true" Elevation="0" aria-label="Sales and use tax by jurisdiction" data-testid="tax-return">
<caption class="wb-sr-only">Sales and use tax by jurisdiction</caption>
                <thead>
                    <tr>
                        <th scope="col">Jurisdiction</th><th scope="col">State</th>
                        <th scope="col" style="text-align:right">Gross sales</th><th scope="col" style="text-align:right">Exempt</th><th scope="col" style="text-align:right">Taxable sales</th>
                        <th scope="col" style="text-align:right">State tax</th><th scope="col" style="text-align:right">County</th><th scope="col" style="text-align:right">City</th><th scope="col" style="text-align:right">District</th>
                        <th scope="col" style="text-align:right">Sales tax</th><th scope="col" style="text-align:right">Taxable purchases</th><th scope="col" style="text-align:right">Use tax</th>
                        <th scope="col" style="text-align:right">Total due</th><th scope="col" style="text-align:right">Vendor-charged</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in r.Rows)
                    {
                        <tr>
                            <th scope="row" style="font-weight:normal">@row.Code · @row.Name</th><td>@row.State</td>
                            <td style="text-align:right">@TaxFormat.Money(row.GrossSales)</td><td style="text-align:right">@TaxFormat.Money(row.ExemptSales)</td><td style="text-align:right">@TaxFormat.Money(row.TaxableSales)</td>
                            <td style="text-align:right">@TaxFormat.Money(row.StateTax)</td><td style="text-align:right">@TaxFormat.Money(row.CountyTax)</td><td style="text-align:right">@TaxFormat.Money(row.CityTax)</td><td style="text-align:right">@TaxFormat.Money(row.SpecialTax)</td>
                            <td style="text-align:right">@TaxFormat.Money(row.SalesTax)</td><td style="text-align:right">@TaxFormat.Money(row.TaxablePurchases)</td><td style="text-align:right">@TaxFormat.Money(row.UseTax)</td>
                            <td style="text-align:right"><strong>@TaxFormat.Money(row.TotalDue)</strong></td><td style="text-align:right">@TaxFormat.Money(row.VendorChargedTax)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th scope="row">Total</th><td></td>
                        <td style="text-align:right">@TaxFormat.Money(r.Rows.Sum(x => x.GrossSales))</td><td style="text-align:right">@TaxFormat.Money(r.Rows.Sum(x => x.ExemptSales))</td><td style="text-align:right">@TaxFormat.Money(r.Rows.Sum(x => x.TaxableSales))</td>
                        <td colspan="4"></td>
                        <td style="text-align:right">@TaxFormat.Money(r.TotalSalesTax)</td><td style="text-align:right">@TaxFormat.Money(r.Rows.Sum(x => x.TaxablePurchases))</td><td style="text-align:right">@TaxFormat.Money(r.TotalUseTax)</td>
                        <td style="text-align:right" data-testid="tax-return-total"><strong>@TaxFormat.Money(r.TotalDue)</strong></td><td style="text-align:right">@TaxFormat.Money(r.Rows.Sum(x => x.VendorChargedTax))</td>
                    </tr>
                </tfoot>
            </MudSimpleTable>
        </MudPaper>
    }
}

@code {
    private DateTime? _from = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _to = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1);
    private string? _state;
    private SalesTaxReturnDto? _report;
    private string? _error;
    private bool _forbidden;
    private bool _busy;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            _report = await Tax.GetReturnAsync(DateOnly.FromDateTime(_from!.Value), DateOnly.FromDateTime(_to!.Value), string.IsNullOrWhiteSpace(_state) ? null : _state);
            _error = null;
        }
        catch (Exception ex) when (TaxFormat.IsExpected(ex))
        {
            (_error, _forbidden) = (TaxFormat.Error(ex), TaxFormat.IsForbidden(ex));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportAsync()
    {
        try
        {
            var file = await Tax.ExportReturnCsvAsync(DateOnly.FromDateTime(_from!.Value), DateOnly.FromDateTime(_to!.Value), string.IsNullOrWhiteSpace(_state) ? null : _state);
            await AccountingFormat.DownloadAsync(JS, new Workbench.Contracts.Accounting.AccountingExportFile(file.FileName, file.ContentType, file.Content));
        }
        catch (Exception ex) when (TaxFormat.IsExpected(ex) || ex is JSException)
        {
            Snackbar.Add(TaxFormat.Error(ex), Severity.Error);
        }
    }
}
