@* On a project's Plan tab, for people who set up the project: tasks added in the plan become charge codes (WBS elements
   people charge time to) in one click, instead of a trip to Setup › Plan sheet. *@
@using Workbench.Ui.Collaboration
@inject IPlanSyncService PlanSync
@inject ISnackbar Snackbar

@if (_waiting.Count > 0)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2" data-testid="plan-charge-codes">
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
            <span>
                @(_waiting.Count == 1 ? "1 task isn't" : $"{_waiting.Count} tasks aren't") a charge code yet, so nobody can charge time to
                @(_waiting.Count == 1 ? "it" : "them"). Make @(_waiting.Count == 1 ? "it one" : "them charge codes") when the plan is ready.
            </span>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyAsync" Disabled="_busy"
                       data-testid="plan-make-charge-codes">Make charge codes</MudButton>
        </MudStack>
    </MudAlert>
}
<SheetLiveRefresher SheetId="SheetId" Changed="LoadAsync" />

@code {
    [Parameter, EditorRequired]
    public Guid ProjectId { get; set; }

    [Parameter, EditorRequired]
    public Guid SheetId { get; set; }

    private IReadOnlyList<PlanDifferenceDto> _waiting = [];
    private bool _busy;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _waiting = (await PlanSync.DiffAsync(ProjectId)).Differences.Where(d => d.Kind == PlanDifferenceKind.TaskWithoutWbs).ToList();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or UnauthorizedAccessException or WorkbenchNotFoundException)
        {
            _waiting = [];
        }
    }

    private async Task ApplyAsync()
    {
        _busy = true;
        try
        {
            var count = _waiting.Count;
            await PlanSync.ApplyAsync(ProjectId, new ApplyPlanSyncRequest(PlanSyncDirection.PlanToWbs, _waiting.Select(d => d.Key).ToList()));
            Snackbar.Add($"{count} charge code{(count == 1 ? "" : "s")} added. Their WBS codes stay as they are in the plan.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or HttpRequestException or TaskCanceledException or UnauthorizedAccessException or WorkbenchNotFoundException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
