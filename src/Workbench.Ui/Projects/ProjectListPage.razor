@page "/projects"
@* The Projects list: Finance and administrators see every project; others the projects they manage (with money) or charge to. *@
@inject IProjectHubService Hub
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IServiceProvider Services
@inject IDialogService DialogService

<PageTitle>Projects · Workbench</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4" HtmlTag="h1">@(_list is { ShowsMoney: false } ? "My projects" : "Projects")</MudText>
    <MudSpacer />
    @if (_canCreate)
    {
        <MudButton OnClick="NewProjectAsync" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" data-testid="new-project">New project</MudButton>
    }
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" aria-label="Reload" />
</MudStack>

@if (_list is null)
{
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else
    {
        <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" />
    }
}
else
{
    @if (_list.Projects.Count == 0)
    {
        <MudPaper Outlined="true" Class="pa-6">
            <MudText Class="mud-text-secondary">
                You aren't on any projects yet. Projects show here once you manage one, are assigned to it, charge to it, belong to its plan's workspace or approve its timesheets and expenses.
            </MudText>
        </MudPaper>
    }
    else
    {
        <ConfigurableList T="ProjectHubRowDto" Definition="@(_list.ShowsMoney ? MoneyDefinition : PlainDefinition)" Items="Visible.ToList()" TestId="project-table"
                          SearchLabel="Search by code, name, manager or contract" SearchTestId="project-search" AriaLabel="Projects" Elevation="0" Outlined="true"
                          RowClick="@(p => Navigation.NavigateTo($"projects/{p.Id}"))">
            <ToolBarContent>
            @if (_list.SeesAll)
            {
                <MudToggleGroup T="bool" @bind-Value="_mineOnly" Color="Color.Primary" Size="Size.Small" Style="max-width: 220px" data-testid="mine-toggle">
                    <MudToggleItem Value="true" Text="Mine" />
                    <MudToggleItem Value="false" Text="All" />
                </MudToggleGroup>
            }
            <MudSelect T="string" @bind-Value="_status" Label="Status" Dense="true" Style="max-width: 180px" data-testid="status-filter">
                <MudSelectItem T="string" Value="@OpenStatus">Open (not closed)</MudSelectItem>
                <MudSelectItem T="string" Value="@AnyStatus">Any status</MudSelectItem>
                @foreach (var state in Enum.GetValues<ProjectState>())
                {
                    <MudSelectItem T="string" Value="@state.ToString()">@_labels.Label("project-status", state, ProjectsFormat.Status(state))</MudSelectItem>
                }
            </MudSelect>
            @if (_list.ShowsMoney)
            {
                <MudTooltip Arrow="true">
                    <ChildContent>
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Info">How health is judged</MudButton>
                    </ChildContent>
                    <TooltipContent>
                        <div style="max-width: 340px; text-align: left">
                            @foreach (var line in ProjectHealthRules.Explanation)
                            {
                                <MudText Typo="Typo.caption" Class="d-block">@line</MudText>
                            }
                        </div>
                    </TooltipContent>
                </MudTooltip>
            }
            </ToolBarContent>
            <NoRecordsContent>
                <MudText Class="mud-text-secondary">No projects match these filters.</MudText>
            </NoRecordsContent>
        </ConfigurableList>
        @if (!_list.ShowsMoney)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">These are the projects you're on: you manage them, are assigned to them, charge to them, belong to their plan's workspace or approve their timesheets and expenses.</MudText>
        }
    }
}

@code {
    private const string OpenStatus = "open";
    private const string AnyStatus = "any";

    private ProjectHubListDto? _list;
    private string? _error;
    private bool _mineOnly; // Finance sees every project by default; "Mine" narrows to what they manage or charge to.
    private string _status = OpenStatus;
    private bool _canCreate; // Finance, administrators and project managers (a project on a contract is then a request).

    private StatusLabels _labels = StatusLabels.Empty;

    protected override async Task OnInitializedAsync()
    {
        _labels = await StatusLabels.LoadAsync(Services);
        try
        {
            // Optional so the page renders where no user context is registered (tests).
            _canCreate = Services.GetService(typeof(ICurrentUserContext)) is ICurrentUserContext context && (await context.GetAsync()).Can(Workbench.Contracts.Identity.Permission.ProjectsCreate);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or UnauthorizedAccessException)
        {
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _list = await Hub.ListProjectsAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or ArgumentException or UnauthorizedAccessException)
        {
            _error = $"Couldn't load projects: {ex.Message}";
            Snackbar.Add(_error, Severity.Error);
        }
    }

    private IEnumerable<ProjectHubRowDto> Visible => (_list?.Projects ?? []).Where(Matches);

    private bool Matches(ProjectHubRowDto p)
    {
        if (_mineOnly && !p.IsMine)
        {
            return false;
        }

        var statusOk = _status switch
        {
            OpenStatus => p.Status != ProjectState.Closed,
            AnyStatus => true,
            var s => p.Status.ToString() == s,
        };
        if (!statusOk)
        {
            return false;
        }

        return true;
    }

    private static ListColumn<ProjectHubRowDto> ProjectColumn(bool money) => new()
    {
        Key = "project",
        Title = "Project",
        Value = p => p.Code,
        Display = p => $"{p.Code} · {p.Name}",
        Groupable = false,
        Cell = p => @<text>
            <MudLink Href="@($"projects/{p.Id}")" Typo="Typo.body2"><b>@p.Code</b> · @p.Name</MudLink>
            @if (p.IsManager)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">You manage</MudChip>
            }
            @if (money)
            {
                @* Status and period ride under the name here, so the money columns fit a laptop screen. *@
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@ProjectsFormat.Status(p.Status) · @ProjectsFormat.Period(p.Start, p.Finish)</MudText>
            }
        </text>,
    };

    private static ListColumn<ProjectHubRowDto> Manager => new() { Key = "manager", Title = "Manager", Value = p => p.ProjectManagerName, Display = p => p.ProjectManagerName ?? "—" };

    private static ListColumn<ProjectHubRowDto> Contract => new() { Key = "contract", Title = "Contract", Value = p => p.ContractNumber, Display = p => p.ContractNumber ?? "No contract" };

    private static ListColumn<ProjectHubRowDto> Status(bool standard) => new()
    {
        Key = "status", Title = "Status", Value = p => p.Status, Display = p => ProjectsFormat.Status(p.Status), Standard = standard,
        Cell = p => @<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="ProjectsFormat.StatusColor(p.Status)">@ProjectsFormat.Status(p.Status)</MudChip>,
    };

    private static ListColumn<ProjectHubRowDto> Period(bool standard) => new()
    {
        Key = "period", Title = "Period", Value = p => p.Finish, Kind = ListColumnKind.Date, Groupable = false, Standard = standard,
        Display = p => ProjectsFormat.Period(p.Start, p.Finish),
    };

    private static ListColumn<ProjectHubRowDto> Mine => new()
    {
        Key = "mine", Title = "Mine", Value = p => p.IsMine, Kind = ListColumnKind.Bool, Standard = false,
    };

    /// <summary>The list for people who see project money (Finance, administrators, managers of these projects).</summary>
    internal static readonly ListDefinition<ProjectHubRowDto> MoneyDefinition = new()
    {
        ListKey = CustomizableLists.Projects,
        EntityType = CustomizableEntities.Project,
        Title = "Projects",
        Id = p => p.Id,
        StandardSort = [new ListSort("project")],
        Columns =
        [
            ProjectColumn(true),
            new() { Key = "health", Title = "Health", Value = p => p.Money is null ? null : (int)p.Money.Health,
                    Display = p => p.Money is { } m ? ProjectHealthRules.Label(m.Health) : null, Cell = p => @<text>@if (p.Money is { } health) { <ProjectHealthChip Money="health" /> }</text> },
            Manager,
            Contract,
            Status(false),
            Period(false),
            new() { Key = "fundingUsed", Title = "Funding used", Value = p => p.Money?.PercentFundingUsed, Kind = ListColumnKind.Percent, Groupable = false,
                    Cell = p => @<text>
                        @if (p.Money is { PercentFundingUsed: { } used } m)
                        {
                            <MudTooltip Text="@($"{FinancialFormat.Percent(m.PercentFunded)} of the contract is funded; {FinancialFormat.Money(m.FundingLeft ?? 0)} funding left")">
                                <span>@FinancialFormat.Percent(used)</span>
                            </MudTooltip>
                            <MudProgressLinear Value="ProjectsFormat.Bar(used)" Color="ProjectsFormat.BurnColor(used)" Size="Size.Small" Rounded="true" aria-label="@($"Funding used, {p.Name}")" />
                        }
                        else if (p.Money is not null)
                        {
                            <span class="mud-text-secondary">—</span>
                        }
                    </text> },
            new() { Key = "spent", Title = "Spent of budget", Value = p => p.Money?.PercentSpent, Kind = ListColumnKind.Percent, Groupable = false,
                    Cell = p => @<text>
                        @if (p.Money is { } m)
                        {
                            <span>@FinancialFormat.Money(m.Spent) of @FinancialFormat.Money(m.Budget)</span>
                            @if (m.PercentSpent is { } spent)
                            {
                                <MudProgressLinear Value="ProjectsFormat.Bar(spent)" Color="ProjectsFormat.BurnColor(spent)" Size="Size.Small" Rounded="true" aria-label="@($"Spent of budget, {p.Name}")" />
                            }
                        }
                    </text> },
            new() { Key = "forecast", Title = "Forecast vs budget", Value = p => p.Money?.ForecastVsBudget, Kind = ListColumnKind.Percent, Groupable = false,
                    Cell = p => @<text>
                        @if (p.Money is { } m)
                        {
                            <span class="@(m.ForecastAtCompletion > m.Budget && m.Budget > 0 ? "mud-error-text" : "")">@FinancialFormat.Money(m.ForecastAtCompletion)</span>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@(m.ForecastVsBudget is { } r ? $"{FinancialFormat.Percent(r)} of budget" : "no budget")</MudText>
                        }
                    </text> },
            new() { Key = "openTasks", Title = "Open tasks", Value = p => p.OpenItems, Kind = ListColumnKind.Number, Groupable = false, Display = p => p.Money is null ? null : p.OpenItems?.ToString() ?? "—" },
            new() { Key = "budget", Title = "Budget", Value = p => p.Money?.Budget, Kind = ListColumnKind.Money, Standard = false, Groupable = false },
            new() { Key = "actual", Title = "Spent", Value = p => p.Money?.Spent, Kind = ListColumnKind.Money, Standard = false, Groupable = false },
            new() { Key = "eac", Title = "Forecast at completion", Value = p => p.Money?.ForecastAtCompletion, Kind = ListColumnKind.Money, Standard = false, Groupable = false },
            new() { Key = "fundingLeft", Title = "Funding left", Value = p => p.Money?.FundingLeft, Kind = ListColumnKind.Money, Standard = false, Groupable = false },
            Mine,
        ],
    };

    /// <summary>The list for everyone else: no money columns are offered at all.</summary>
    internal static readonly ListDefinition<ProjectHubRowDto> PlainDefinition = new()
    {
        ListKey = CustomizableLists.Projects,
        EntityType = CustomizableEntities.Project,
        Title = "Projects",
        Id = p => p.Id,
        StandardSort = [new ListSort("project")],
        Columns = [ProjectColumn(false), Manager, Contract, Status(true), Period(true), Mine],
    };

    /// <summary>The quick start: code, name and where the plan comes from; it opens the new project's plan.</summary>
    private Task NewProjectAsync() =>
        DialogService.ShowAsync<NewProjectDialog>("New project", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
}
