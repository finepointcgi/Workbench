@* The New project dialog: the short start form (name first) from the Projects page and Setup › Projects. *@
<MudDialog>
    <DialogContent>
        <NewProjectForm OnCancel="() => MudDialog.Cancel()" OnCreated="p => MudDialog.Close(DialogResult.Ok(p))" />
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;
}
