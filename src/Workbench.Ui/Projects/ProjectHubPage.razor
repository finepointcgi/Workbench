@page "/projects/{ProjectId:guid}"
@page "/projects/{ProjectId:guid}/{Tab}"
@page "/projects/{ProjectId:guid}/{Tab}/{Section}"
@* One project's page. Tabs reuse the feature pages (rendered Embedded); each shows only when the server would allow it.
   The older routes (/projects/{id}/financials, /budgets, /revenue, /evm) land here with that tab selected. *@
@inject IProjectHubService Hub
@inject NavigationManager Navigation
@inject IServiceProvider Services

<PageTitle>@(_hub is { } h ? $"{h.Project.Code} {TabLabel}" : "Project") · Workbench</PageTitle>

@if (_notFound)
{
    <MudText Typo="Typo.h4" HtmlTag="h1">Project not found</MudText>
    <MudText Class="mud-text-secondary mt-2">It doesn't exist, or you aren't on it. You're on a project when you manage it, are assigned to it, charge to it, belong to its plan's workspace or approve its timesheets and expenses.</MudText>
    <MudButton Href="projects" Variant="Variant.Text" Color="Color.Primary" Class="mt-4">Back to Projects</MudButton>
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_hub is null)
{
    <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" />
}
else
{
    var p = _hub.Project;
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1" Wrap="Wrap.Wrap">
        <MudIconButton Href="projects" Icon="@Icons.Material.Filled.ArrowBack" aria-label="Back to Projects" />
        <MudText Typo="Typo.h4" HtmlTag="h1">@p.Code · @p.Name</MudText>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="ProjectsFormat.StatusColor(p.Status)">@_labels.Label("project-status", p.Status, ProjectsFormat.Status(p.Status))</MudChip>
        @if (p.Money is { } money)
        {
            <ProjectHealthChip Money="money" />
        }
    </MudStack>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3" Style="padding-left: 52px">
        @(p.ContractNumber is { } cn ? $"{cn}{(_hub.ContractName is { } name ? $" · {name}" : "")}{(_hub.CustomerName is { } cust ? $" · {cust}" : "")}" : "No contract")
        · Manager: @(p.ProjectManagerName ?? "none")
        · @ProjectsFormat.Period(p.Start, p.Finish)
    </MudText>

    @* The everyday tabs, then "More" for the occasional ones (revenue, earned value, narrative, ceilings and closeout). *@
    @if (_more.Count > 0)
    {
        <div class="d-flex justify-end mb-n2">
            <MudMenu Label="More" EndIcon="@Icons.Material.Filled.ArrowDropDown" Variant="Variant.Text" Size="Size.Small" Dense="true"
                     AriaLabel="More project pages" data-testid="project-more">
                @foreach (var slug in _more)
                {
                    <MudMenuItem Href="@($"projects/{ProjectId}/{slug}")" data-testid="@($"more-{slug}")">@ProjectsFormat.Tabs.First(t => t.Slug == slug).Label</MudMenuItem>
                }
            </MudMenu>
        </div>
    }
    <MudTabs Elevation="0" Outlined="true" Rounded="true" TabPanelsClass="pa-4" KeepPanelsAlive="false"
             ActivePanelIndex="_tabs.IndexOf(_tab)" ActivePanelIndexChanged="OnTabChanged" data-testid="project-tabs">
        @foreach (var slug in _tabs)
        {
            <MudTabPanel Text="@ProjectsFormat.Tabs.First(t => t.Slug == slug).Label" @key="slug" data-testid="@($"tab-{slug}")">
                @if (slug == _tab)
                {
                    @TabContent(slug)
                }
            </MudTabPanel>
        }
    </MudTabs>
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [Parameter]
    public string? Tab { get; set; }

    /// <summary>A section within the tab, e.g. <c>/projects/{id}/setup/charge-codes</c>.</summary>
    [Parameter]
    public string? Section { get; set; }

    private List<string> _allowed = [];
    private List<string> _more = [];

    private ProjectHubDto? _hub;
    private Guid _loadedProject;
    private List<string> _tabs = [];
    private string _tab = "overview";
    private bool _notFound;
    private int _reloads;
    private string? _error;

    private string TabLabel => ProjectsFormat.Tabs.FirstOrDefault(t => t.Slug == _tab).Label ?? "";

    private StatusLabels _labels = StatusLabels.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(_labels, StatusLabels.Empty))
        {
            _labels = await StatusLabels.LoadAsync(Services);
        }

        if (_hub is null || _loadedProject != ProjectId)
        {
            await LoadAsync();
        }

        var requested = ProjectsFormat.Normalize(Tab);
        _tab = _allowed.Contains(requested) ? requested : "overview";

        // An occasional tab shows in the bar while it's open; otherwise it's under More.
        _tabs = _allowed.Where(s => !ProjectsFormat.IsOccasional(s) || s == _tab).ToList();
        _more = _allowed.Where(s => ProjectsFormat.IsOccasional(s) && s != _tab).ToList();
    }

    private async Task LoadAsync()
    {
        _notFound = false;
        _error = null;
        try
        {
            _hub = await Hub.GetProjectAsync(ProjectId);
            _loadedProject = ProjectId;
            _allowed = ProjectsFormat.Tabs.Select(t => t.Slug).Where(s => ProjectsFormat.Allows(_hub.Tabs, s)).ToList();
            _tabs = _allowed.Where(s => !ProjectsFormat.IsOccasional(s)).ToList();
        }
        catch (WorkbenchNotFoundException)
        {
            (_hub, _notFound) = (null, true);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or ArgumentException or UnauthorizedAccessException)
        {
            (_hub, _error) = (null, $"Couldn't load the project: {ex.Message}");
        }
    }

    private void OnTabChanged(int index)
    {
        if (index >= 0 && index < _tabs.Count && _tabs[index] != _tab)
        {
            var slug = _tabs[index];
            Navigation.NavigateTo(slug == "overview" ? $"projects/{ProjectId}" : $"projects/{ProjectId}/{slug}");
        }
    }

    private async Task ReloadAsync()
    {
        _reloads++;
        await LoadAsync();
        StateHasChanged();
    }

    private RenderFragment TabContent(string slug) => slug switch
    {
        "overview" => @<ProjectOverviewTab Hub="_hub!" />,
        "plan" => @<div>
            @* One WBS grid: its rows are the charge codes (made as they're added), with the money, approval, people, hours
               and cost around it, and "Try changes". *@
            <Workbench.Ui.Plan.PlanPeoplePanel ProjectId="ProjectId" SheetId="_hub!.Project.SheetId!.Value" Changed="ReloadAsync">
                <Workbench.Ui.Pages.SheetPage SheetId="_hub!.Project.SheetId!.Value" Embedded="true" />
            </Workbench.Ui.Plan.PlanPeoplePanel>
        </div>,
        "financials" => @<Workbench.Ui.Pages.Projects.ProjectFinancialsPage ProjectId="ProjectId" Embedded="true" />,
        "budgets" => @<Workbench.Ui.Pages.Projects.ProjectBudgetsPage ProjectId="ProjectId" Embedded="true" />,
        "revenue" => @<Workbench.Ui.Revenue.ProjectRevenueView ProjectId="ProjectId" Embedded="true" />,
        "evm" => @<Workbench.Ui.Pages.Projects.ProjectEvmPage ProjectId="ProjectId" Embedded="true" />,
        "schedule-health" => @<Workbench.Ui.Gantt.ScheduleHealthPanel SheetId="_hub!.Project.SheetId!.Value" PlanHref="@($"projects/{ProjectId}/plan")" />,
        "narrative" => @<Workbench.Ui.Assistant.ProjectNarrativeTab ProjectId="ProjectId" />,
        "ceilings" => @<div>
            <Workbench.Ui.Ceilings.CeilingsPanel ProjectId="ProjectId" />
            <MudDivider Class="my-4" />
            <Workbench.Ui.Ceilings.CloseoutPanel Scope="Workbench.Contracts.Closeout.CloseoutScope.Project" TargetId="ProjectId" Changed="ReloadAsync" />
        </div>,
        "costs" => @<Workbench.Ui.Pages.Odcs.ProjectOdcs ProjectId="ProjectId" Embedded="true" />,
        // Assign people first (who, which task, how many hours, when); then Finance's budget and who charges to the project.
        "staffing" => @<div>
            @if (_hub!.Tabs.Team)
            {
                <div data-testid="staffing-section">
                    <Workbench.Ui.Resourcing.AssignPeoplePanel ProjectId="ProjectId" Changed="ReloadAsync" />
                </div>
            }
            @if (_hub!.Tabs.Budgets)
            {
                <MudDivider Class="my-6" />
                <section aria-labelledby="budget-heading" data-testid="budget-section">
                    <MudText Typo="Typo.h6" HtmlTag="h2" id="budget-heading" Class="mb-2">Budget</MudText>
                    <Workbench.Ui.Pages.Projects.ProjectBudgetsPage ProjectId="ProjectId" Embedded="true" />
                </section>
            }
            @if (_hub!.Tabs.Team)
            {
                <MudDivider Class="my-6" />
                <ProjectTeamTab ProjectId="ProjectId" @key="_reloads" />
            }
        </div>,
        "setup" => @<ProjectSetupTab Hub="_hub!" Section="@Section" Changed="ReloadAsync" />,
        _ => @<span />,
    };
}
