@* Shows its content only to holders of Permission (the cascaded FinanceAccess); everyone else sees NotAllowed, if given.
   With no FinanceAccess cascaded it shows nothing: actions that need a permission fail closed. *@
@if (Access?.Can(Permission) == true)
{
    @ChildContent
}
else
{
    @NotAllowed
}

@code {
    [CascadingParameter]
    public FinanceAccess? Access { get; set; }

    /// <summary>The permission (a <c>Permission</c> constant) the content needs.</summary>
    [Parameter, EditorRequired]
    public string Permission { get; set; } = "";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>What to show instead, e.g. the page's "Billing is for Finance" note.</summary>
    [Parameter]
    public RenderFragment? NotAllowed { get; set; }
}
