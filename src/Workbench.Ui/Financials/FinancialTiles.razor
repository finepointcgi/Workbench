@* Headline figures for a project: budget, actual, EAC, VAC, % spent and funded value remaining. *@

<MudGrid Spacing="2" Class="mb-2">
    @foreach (var tile in Tiles)
    {
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Outlined="true" Class="pa-3" Style="height: 100%">
                <MudText Typo="Typo.caption" Class="mud-text-secondary" HtmlTag="div"><Term Key="@(tile.TermKey ?? "")">@tile.Label</Term></MudText>
                <MudText Typo="Typo.h6" Class="@tile.Class">@tile.Value</MudText>
                @if (tile.Detail is not null)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@tile.Detail</MudText>
                }
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@code {
    [Parameter, EditorRequired]
    public ProjectFinancialSummaryDto Summary { get; set; } = default!;

    /// <summary>Open purchase order amounts (procure-to-pay commitments); the tile shows only when set.</summary>
    [Parameter]
    public decimal? Committed { get; set; }

    private sealed record Tile(string Label, string Value, string? Detail = null, string Class = "", string? TermKey = null);

    private IEnumerable<Tile> Tiles
    {
        get
        {
            var t = Summary.Totals;
            yield return new Tile("Budget", FinancialFormat.Money(t.BudgetAmount), $"{FinancialFormat.Hours(t.BudgetHours)} hrs");
            yield return new Tile("Actual", FinancialFormat.Money(t.ActualCost), $"{FinancialFormat.Hours(t.ActualHours)} hrs");
            yield return new Tile("EAC", FinancialFormat.Money(t.EacAmount), Summary.ForecastVersionName is { } f ? $"ETC from {f}" : "ETC = remaining budget", TermKey: "eac");
            yield return new Tile("VAC", FinancialFormat.Money(t.VacAmount), $"{FinancialFormat.Hours(t.VacHours)} hrs", FinancialFormat.VarianceClass(t.VacAmount), "vac");
            yield return new Tile("% spent", FinancialFormat.Percent(t.PercentSpent), $"{FinancialFormat.Money(t.RemainingBudget)} remaining", FinancialFormat.SpentClass(t.PercentSpent));
            if (Summary.Funding is { } funding)
            {
                yield return new Tile("Funded remaining", FinancialFormat.Money(funding.FundedRemaining), $"of {FinancialFormat.Money(funding.FundedValue)} funded",
                    funding.FundedRemaining < 0 ? "mud-error-text" : "", "funded");
            }

            if (Committed is { } committed)
            {
                yield return new Tile("Committed", FinancialFormat.Money(committed), "Open purchase orders", TermKey: "committed");
            }

            if (Summary.ShowsBillableValue)
            {
                yield return new Tile("Billable value", FinancialFormat.Money(t.BillableValue), "Approved hours × bill rates");
            }
        }
    }
}
