@page "/time/team"
@using System.Globalization
@inject ITimesheetApprovalService Approvals
@inject ISnackbar Snackbar

<PageTitle>Team time · Workbench</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4" HtmlTag="h1">Team time</MudText>
    <MudSpacer />
    @if (_status is not null)
    {
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" aria-label="Previous period" OnClick="() => LoadAsync(_status.PeriodStart.AddDays(-1))" />
        <MudText Typo="Typo.subtitle1">
            @_status.PeriodStart.ToString("MMM d", CultureInfo.InvariantCulture) – @_status.PeriodEnd.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
        </MudText>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="Next period"
                       Disabled="@(_status.PeriodEnd >= DateOnly.FromDateTime(DateTime.Now))"
                       OnClick="() => LoadAsync(_status.PeriodEnd.AddDays(1))" />
    }
    <MudButton Variant="Variant.Text" Href="time/approvals" StartIcon="@Icons.Material.Filled.FactCheck">Approvals</MudButton>
</MudStack>

<ConfigurableList T="TeamMemberStatusDto" Definition="_definition" Items="_status?.Members" Loading="_status is null" SearchLabel="Search people" TestId="team">
    <NoRecordsContent>
        <MudText Class="mud-text-secondary">You don't approve anyone's timesheets.</MudText>
    </NoRecordsContent>
</ConfigurableList>

@code {
    private TeamStatusDto? _status;

    private static string StatusLabel(TeamMemberStatusDto m) => (m.IsMissing ? "Missing · " : "") + (m.Status?.ToString() ?? "Not started");

    internal static readonly ListDefinition<TeamMemberStatusDto> _definition = new()
    {
        ListKey = CustomizableLists.Timesheets,
        EntityType = CustomizableEntities.Timesheet,
        Title = "Team time",
        Id = m => m.TimesheetId ?? m.EmployeeId,
        Columns =
        [
            new() { Key = "employee", Title = "Employee", Value = m => m.EmployeeName, Groupable = false },
            new() { Key = "status", Title = "Status", Value = m => m.Status?.ToString() ?? "Not started", Display = StatusLabel,
                    Cell = m => @<text>
                        @if (m.IsMissing)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">Missing</MudChip>
                        }
                        <MudChip T="string" Size="Size.Small" Color="@ChipColor(m.Status)">@(m.Status?.ToString() ?? "Not started")</MudChip>
                    </text> },
            new() { Key = "hours", Title = "Hours", Value = m => m.Hours, Kind = ListColumnKind.Number, Groupable = false, Display = m => m.Hours.ToString("0.##", CultureInfo.InvariantCulture) },
            new() { Key = "standard", Title = "Standard", Value = m => m.StandardHours, Kind = ListColumnKind.Number, Groupable = false,
                    Display = m => m.StandardHours.ToString("0.##", CultureInfo.InvariantCulture) },
            new() { Key = "missing", Title = "Missing", Value = m => m.IsMissing, Kind = ListColumnKind.Bool, Standard = false },
            new() { Key = "history", Title = "History", Value = m => m.TimesheetId is null ? null : "History", Groupable = false,
                    Cell = m => @<text>@if (m.TimesheetId is { } id) { <MudLink Href="@($"time/history/{id}")">History</MudLink> }</text> },
        ],
    };

    protected override Task OnInitializedAsync() => LoadAsync(DateOnly.FromDateTime(DateTime.Now));

    private async Task LoadAsync(DateOnly date)
    {
        try
        {
            _status = await Approvals.GetTeamStatusAsync(date);
        }
        catch (Exception ex) when (ex is ArgumentException or HttpRequestException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static Color ChipColor(TimesheetState? state) => state switch
    {
        TimesheetState.Approved => Color.Success,
        TimesheetState.Submitted => Color.Info,
        TimesheetState.Rejected => Color.Error,
        _ => Color.Default,
    };
}
