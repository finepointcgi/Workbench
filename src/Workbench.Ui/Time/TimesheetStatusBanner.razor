@* Where the timesheet stands, in plain words: Draft, Submitted (waiting on someone), Approved or Sent back. *@
<MudAlert Severity="Severity" Dense="true" Class="mb-3" data-testid="status-banner">
    <b data-testid="status-text">@Headline</b>
    @if (Timesheet.Revision > 0)
    {
        <span> · correction @Timesheet.Revision</span>
    }
    <span> · @Describe()</span>
</MudAlert>

@code {
    [Parameter, EditorRequired] public TimesheetDto Timesheet { get; set; } = default!;

    /// <summary>Who a submitted timesheet is waiting on (names or emails), when known.</summary>
    [Parameter] public string? WaitingOn { get; set; }

    private Severity Severity => Timesheet.Status switch
    {
        TimesheetState.Approved => Severity.Success,
        TimesheetState.Submitted => Severity.Info,
        TimesheetState.Rejected => Severity.Error,
        _ => Severity.Normal,
    };

    private string Headline => Timesheet.Status switch
    {
        TimesheetState.Submitted => string.IsNullOrWhiteSpace(WaitingOn) ? "Submitted, waiting for approval" : $"Submitted, waiting on {WaitingOn}",
        TimesheetState.Approved => "Approved",
        TimesheetState.Rejected => "Sent back for changes",
        _ when Timesheet.ChangesNeedReason => "Draft (being corrected)",
        _ => "Draft",
    };

    private string Describe() => Timesheet.Status switch
    {
        TimesheetState.Submitted => $"Certified and submitted {Local(Timesheet.SubmittedAtUtc)}. It's locked until it's approved or recalled.",
        TimesheetState.Approved => $"Approved by {Timesheet.ReviewedBy} {Local(Timesheet.ApprovedAtUtc)}. It's locked; a correction needs a reason.",
        TimesheetState.Rejected => $"{Timesheet.ReviewedBy} says: {Timesheet.RejectionReason}. Fix it, then submit again.",
        _ when Timesheet.ChangesNeedReason => "Each change needs a reason. Certify and submit again when you're done.",
        _ => "Not submitted yet. Enter hours every day you work, then certify and submit at the end of the period.",
    };

    private static string Local(DateTime? utc) => utc is { } v ? $"on {v.ToLocalTime():MMM d, h:mm tt}" : "";
}
