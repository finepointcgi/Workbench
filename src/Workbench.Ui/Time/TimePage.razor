@page "/time"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject ITimesheetService Timesheets
@inject Workbench.Contracts.Leave.ILeaveTimesheetService LeaveTimesheets
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IServiceProvider Services

<PageTitle>Time · Workbench</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4" HtmlTag="h1">My time</MudText>
    <MudSpacer />
    @if (_detail is not null)
    {
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" aria-label="Previous period" OnClick="() => GoAsync(_detail.Timesheet.PeriodStart.AddDays(-1))" />
        <MudText Typo="Typo.subtitle1" data-testid="period">@PeriodLabel(_detail.Timesheet)</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="Next period" Disabled="NextDisabled"
                       OnClick="() => GoAsync(_detail.Timesheet.PeriodEnd.AddDays(1))" />
        <MudButton Variant="Variant.Text" OnClick="() => GoAsync(null)">This week</MudButton>
    }
</MudStack>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Warning">@_error</MudAlert>
}
else if (_detail is null)
{
    <MudProgressLinear aria-label="Loading" Indeterminate="true" />
}
else
{
    <TimesheetStatusBanner Timesheet="_detail.Timesheet" WaitingOn="@_waitingOn" />
    <Workbench.Ui.TotalTime.TimesheetTotalTime Timesheet="_detail.Timesheet" />
    @if (_leave is not null)
    {
        @if (_leave.Prefill.Count > 0 && !_detail.Timesheet.IsLocked)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2" data-testid="leave-prefill">
                Pre-filled from approved leave and holidays: @string.Join(", ", _leave.Prefill.Select(p => $"{PrefillName(p)} {p.Date:ddd M/d} {p.Hours:0.##} h ({p.Source})")). They're kept when you save.
            </MudAlert>
        }
        @foreach (var warning in _leave.Warnings)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2" data-testid="leave-warning">@warning</MudAlert>
        }
    }

    <NavigationLock OnBeforeInternalNavigation="SaveBeforeLeavingAsync" />
    <TimerWidget BeforeStop="SaveBeforeTimerAsync" Stopped="OnTimerStoppedAsync" />
    @if (!_detail.Timesheet.IsLocked)
    {
        @* Head starts: fill empty cells from what you're staffed on, or from last period. Nothing you typed is replaced. *@
        <MudStack Row="true" Spacing="2" Class="mb-2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
            @if (_allocations.Count > 0)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="FillFromStaffingAsync"
                           Disabled="_busy" data-testid="fill-staffing">Fill from my staffing</MudButton>
            }
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyLastPeriodAsync"
                       Disabled="_busy" data-testid="copy-last">Copy last @(IsWeekly ? "week" : "period")</MudButton>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Fills empty days you can charge; nothing you typed changes.</MudText>
        </MudStack>
    }

    <MudPaper Outlined="true" Class="pa-3">
        <TimesheetGrid @ref="_grid" Detail="_detail" Prefill="_leave?.Prefill" StaffedWbs="_staffed" HoursLeft="_hoursLeft" OnLockedEdit="UnlockAsync" OnChanged="OnGridChangedAsync" />
    </MudPaper>

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-4" Wrap="Wrap.Wrap" Spacing="2">
        <MudButton Variant="Variant.Text" Href="@($"time/history/{_detail.Timesheet.Id}")" StartIcon="@Icons.Material.Filled.History">History</MudButton>
        <MudSpacer />
        @if (!_detail.Timesheet.IsLocked)
        {
            @if (CanAutoSave || _saveState is not null)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary" data-testid="save-state" aria-live="polite">@(_saveState ?? "")</MudText>
            }
            @if (!AutoSaves || _grid?.IsDirty == true && !CanAutoSave)
            {
                @* Saving needs a reason after submitting (or keeps pre-filled leave): one deliberate Save. *@
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_busy || _grid?.IsDirty != true)" OnClick="SaveAsync"
                           StartIcon="@Icons.Material.Filled.Save" data-testid="save">Save</MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Disabled="_busy" OnClick="SubmitAsync"
                       StartIcon="@Icons.Material.Filled.Send" data-testid="submit">Certify and submit</MudButton>
        }
    </MudStack>
    @if (!_detail.Timesheet.IsLocked)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1" Align="Align.End">
            Submitting asks you to certify that these hours are complete and accurate. Your supervisor approves them next.
        </MudText>
    }
}

@code {
    private TimesheetDetailDto? _detail;
    private Workbench.Contracts.Leave.TimesheetLeaveDto? _leave;
    private TimesheetGrid? _grid;
    private string? _error;
    private bool _busy;
    private string? _waitingOn;

    /// <summary>The correction reason given when reopening, offered again when saving.</summary>
    private string? _correctionReason;

    [SupplyParameterFromQuery(Name = "date")]
    public string? Date { get; set; }

    private IReadOnlyCollection<Guid> _staffed = [];
    private IReadOnlyList<Workbench.Contracts.Resourcing.AllocationDto> _allocations = [];
    private IReadOnlyList<Workbench.Contracts.Resourcing.AssignmentHoursLeftDto> _hoursLeft = [];
    private CancellationTokenSource? _autoSave;
    private string? _saveState;

    /// <summary>Drafts save themselves; after submitting, each change needs a reason, so saving is deliberate.</summary>
    private bool AutoSaves => _detail is { Timesheet: { IsLocked: false, ChangesNeedReason: false } };

    private bool CanAutoSave => AutoSaves && _grid?.IsDirty == true;

    private bool IsWeekly => _detail is not null && _detail.Timesheet.PeriodEnd.DayNumber - _detail.Timesheet.PeriodStart.DayNumber == 6;

    private bool NextDisabled => _detail is null || _detail.Timesheet.PeriodEnd >= DateOnly.FromDateTime(DateTime.Now);

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var date = DateOnly.TryParseExact(Date, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) ? d : DateOnly.FromDateTime(DateTime.Now);
        try
        {
            _error = null;
            var detail = await Timesheets.GetOrCreateMyTimesheetAsync(date);
            _leave = await LeaveFor(detail);
            _staffed = await StaffedWbsFor(detail);
            _hoursLeft = await HoursLeftFor(detail);
            if (_hoursLeft.Any(a => a.WbsElementIds.Count == 1))
            {
                _staffed = _staffed.Concat(_hoursLeft.Where(a => a.WbsElementIds.Count == 1).Select(a => a.WbsElementIds[0])).ToHashSet();
            }
            _detail = detail;
            _waitingOn = await WaitingOnAsync(detail.Timesheet);
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException or HttpRequestException)
        {
            _error = ex.Message;
        }
    }

    private async Task GoAsync(DateOnly? date)
    {
        if (CanAutoSave)
        {
            await AutoSaveAsync();
        }

        if (_grid?.IsDirty == true && !await ConfirmDiscardAsync())
        {
            return;
        }

        _correctionReason = null;
        Navigation.NavigateTo(date is { } d ? $"time?date={d:yyyy-MM-dd}" : "time");
    }

    private async Task<bool> ConfirmDiscardAsync()
    {
        var parameters = new DialogParameters<Workbench.Ui.Grid.ConfirmDialog>
        {
            { x => x.Message, "You have unsaved hours. Leave this period without saving?" },
            { x => x.ConfirmText, "Discard" },
        };
        var dialog = await DialogService.ShowAsync<Workbench.Ui.Grid.ConfirmDialog>("Unsaved changes", parameters);
        return await dialog.Result is { Canceled: false };
    }

    /// <summary>Editing a locked timesheet: recall it (submitted) or reopen it for correction (approved), with a reason.</summary>
    private async Task UnlockAsync()
    {
        if (_detail is null || _busy)
        {
            return;
        }

        var approved = _detail.Timesheet.Status == TimesheetState.Approved;
        var parameters = new DialogParameters<ReasonDialog>
        {
            { x => x.Message, approved
                ? "This timesheet is approved and locked. Reopening it starts a new revision; every change is recorded with your reason, and you'll need to certify and get approval again."
                : "This timesheet is submitted and waiting for approval. Recall it to make changes; you'll need to certify and submit again." },
            { x => x.Label, "Reason for the change" },
            { x => x.ConfirmText, approved ? "Reopen for correction" : "Recall" },
        };
        var dialog = await DialogService.ShowAsync<ReasonDialog>(approved ? "Correct an approved timesheet" : "Recall timesheet", parameters);
        if (await dialog.Result is not { Canceled: false, Data: string reason })
        {
            return;
        }

        await RunAsync(async () =>
        {
            _detail = await Timesheets.ReopenAsync(_detail.Timesheet.Id, reason);
            _correctionReason = reason;
            Snackbar.Add(approved ? "Reopened for correction." : "Recalled. You can edit your hours.", Severity.Info);
        });
    }

    private async Task<bool> SaveAsync()
    {
        if (_detail is null || _grid is null)
        {
            return false;
        }

        string? reason = null;
        if (_detail.Timesheet.ChangesNeedReason)
        {
            var parameters = new DialogParameters<ReasonDialog>
            {
                { x => x.Message, "This timesheet was already submitted, so each change is recorded with who, when and why." },
                { x => x.Label, "Reason for the change" },
                { x => x.InitialValue, _correctionReason },
                { x => x.ConfirmText, "Save changes" },
            };
            var dialog = await DialogService.ShowAsync<ReasonDialog>("Reason for change", parameters);
            if (await dialog.Result is not { Canceled: false, Data: string r })
            {
                return false;
            }

            reason = r;
        }

        var entries = _grid.BuildEntries();
        return await RunAsync(async () =>
        {
            _detail = await Timesheets.SaveEntriesAsync(_detail.Timesheet.Id, new SaveTimeEntriesRequest(entries, Reason: reason));
            Snackbar.Add("Hours saved.", Severity.Success);
        });
    }

    private async Task SubmitAsync()
    {
        if (_detail is null || _grid is null)
        {
            return;
        }

        if (_grid.IsDirty && !await SaveAsync())
        {
            return;
        }

        var parameters = new DialogParameters<CertifyDialog>
        {
            { x => x.TotalHours, _detail.Timesheet.TotalHours },
            { x => x.StandardHours, _detail.Timesheet.StandardHours },
            { x => x.Period, PeriodLabel(_detail.Timesheet) },
        };
        var dialog = await DialogService.ShowAsync<CertifyDialog>("Certify and submit", parameters);
        if (await dialog.Result is not { Canceled: false })
        {
            return;
        }

        await RunAsync(async () =>
        {
            var result = await Timesheets.SubmitAsync(_detail.Timesheet.Id, new SubmitTimesheetRequest(true));
            _detail = result.Detail;
            _correctionReason = null;
            Snackbar.Add("Timesheet submitted for approval.", Severity.Success);
            foreach (var warning in result.Warnings)
            {
                Snackbar.Add(warning, Severity.Warning);
            }
        });
    }

    private async Task OnGridChangedAsync()
    {
        if (CanAutoSave)
        {
            _saveState = "Unsaved changes";
            ScheduleAutoSave();
        }

        await InvokeAsync(StateHasChanged);
    }

    // Save a moment after the last edit, so typing a week of hours is one save, not forty.
    private void ScheduleAutoSave()
    {
        _autoSave?.Cancel();
        var pending = _autoSave = new CancellationTokenSource();
        _ = Task.Delay(TimeSpan.FromSeconds(1.5), pending.Token).ContinueWith(
            t => t.IsCanceled ? Task.CompletedTask : InvokeAsync(AutoSaveAsync), TaskScheduler.Default);
    }

    private async Task AutoSaveAsync()
    {
        if (!CanAutoSave || _detail is null || _grid is null)
        {
            return;
        }

        if (_busy)
        {
            ScheduleAutoSave();
            return;
        }

        _autoSave?.Cancel();
        var version = _grid.Version;
        var entries = _grid.BuildEntries();
        _busy = true;
        _saveState = "Saving…";
        StateHasChanged();
        try
        {
            var saved = await Timesheets.SaveEntriesAsync(_detail.Timesheet.Id, new SaveTimeEntriesRequest(entries));
            if (_grid.Version == version)
            {
                _detail = saved; // nothing changed meanwhile: show what the server kept
                _saveState = "All changes saved";
            }
            else
            {
                ScheduleAutoSave(); // edited while saving: save again (entries match by charge code and day)
            }
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException or HttpRequestException or Workbench.Contracts.WorkbenchNotFoundException)
        {
            _saveState = $"Couldn't save: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }

        StateHasChanged();
    }

    private async Task SaveBeforeLeavingAsync(LocationChangingContext context)
    {
        if (CanAutoSave)
        {
            await AutoSaveAsync();
        }
    }

    /// <summary>
    /// Before the timer adds its hours on the server, pending edits are saved (a draft saves itself; after a submission
    /// saving asks for the reason), so nothing typed is lost when the page reloads with the timer's hours.
    /// </summary>
    private async Task<bool> SaveBeforeTimerAsync()
    {
        if (CanAutoSave)
        {
            await AutoSaveAsync();
            return _saveState?.StartsWith("Couldn't", StringComparison.Ordinal) != true;
        }

        return _grid?.IsDirty != true || await SaveAsync();
    }

    private async Task OnTimerStoppedAsync(StopTimerResult result)
    {
        await LoadAsync();
        _saveState = null;
    }

    /// <summary>Spreads each staffed week's hours over that week's working days, into empty cells only.</summary>
    private async Task FillFromStaffingAsync()
    {
        if (_detail is null || _grid is null)
        {
            return;
        }

        var hours = new List<(Guid, DateOnly, decimal)>();
        foreach (var allocation in _allocations)
        {
            var workdays = Enumerable.Range(0, 7).Select(i => allocation.WeekStart.AddDays(i)).Where(_grid.IsWorkday).ToList();
            var inPeriod = workdays.Where(d => _detail.Days.Any(day => day.Date == d)).ToList();
            if (workdays.Count == 0 || inPeriod.Count == 0)
            {
                continue;
            }

            // Quarter hours per day; the remainder goes on the first day so the week adds up.
            var perDay = Math.Floor(allocation.Hours / workdays.Count * 4) / 4;
            var remainder = allocation.Hours - perDay * workdays.Count;
            foreach (var day in inPeriod)
            {
                hours.Add((allocation.WbsElementId!.Value, day, day == workdays[0] ? perDay + remainder : perDay));
            }
        }

        // Stop at an hours ceiling: what's left there already counts everything entered, so adding more would be refused at submit.
        var stopped = new List<string>();
        hours = TimeFill.CapAtCeilings(hours, _detail.CeilingRoom ?? [], stopped, wbs => _detail.ChargeCodes.FirstOrDefault(c => c.ChargeCode.WbsElementId == wbs)?.ChargeCode.Code ?? "that code");
        var filled = await _grid.FillEmptyAsync(hours);
        var ceilingNote = stopped.Count == 0 ? "" : $" Stopped at the hours ceiling on {string.Join(", ", stopped)}.";
        Snackbar.Add(filled == 0 ? $"Nothing to fill: those days already have hours, or can't be entered yet.{ceilingNote}" : $"Filled {filled} day{(filled == 1 ? "" : "s")} from your staffing.{ceilingNote}",
            filled == 0 ? Severity.Info : stopped.Count == 0 ? Severity.Success : Severity.Warning);
    }

    /// <summary>Copies the previous period's hours to the same weekdays, into empty cells only (comments aren't copied).</summary>
    private async Task CopyLastPeriodAsync()
    {
        if (_detail is null || _grid is null)
        {
            return;
        }

        try
        {
            var start = _detail.Timesheet.PeriodStart;
            var previous = (await Timesheets.ListMyTimesheetsAsync()).Where(t => t.PeriodEnd < start).OrderByDescending(t => t.PeriodEnd).FirstOrDefault();
            if (previous is null)
            {
                Snackbar.Add("There's no earlier timesheet to copy.", Severity.Info);
                return;
            }

            var shift = start.DayNumber - previous.PeriodStart.DayNumber;
            var last = await Timesheets.GetAsync(previous.Id);
            var filled = await _grid.FillEmptyAsync(last.Entries.Select(e => (e.WbsElementId, e.WorkDate.AddDays(shift), e.Hours)));
            Snackbar.Add(filled == 0 ? "Nothing to copy into: those days already have hours, can't be entered yet, or the codes are closed." : $"Copied {filled} day{(filled == 1 ? "" : "s")} from {PeriodLabel(previous)}.",
                filled == 0 ? Severity.Info : Severity.Success);
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException or HttpRequestException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task<bool> RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
            if (_detail is not null)
            {
                _leave = await LeaveFor(_detail);
                _waitingOn = await WaitingOnAsync(_detail.Timesheet);
            }

            return true;
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException or HttpRequestException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return false;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>WBS elements the employee is staffed on in the period, so the week starts with those rows (empty). Fails soft.</summary>
    private async Task<IReadOnlyCollection<Guid>> StaffedWbsFor(TimesheetDetailDto detail)
    {
        if (Services.GetService(typeof(Workbench.Contracts.Resourcing.IResourceAllocationService)) is not Workbench.Contracts.Resourcing.IResourceAllocationService allocations)
        {
            return [];
        }

        try
        {
            var mine = await allocations.ListMineAsync(detail.Timesheet.PeriodStart, detail.Timesheet.PeriodEnd);
            _allocations = mine.Where(a => a.WbsElementId is not null && a.Hours > 0).ToList();
            return _allocations.Select(a => a.WbsElementId!.Value).ToHashSet();
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException or HttpRequestException or TaskCanceledException)
        {
            return [];
        }
    }

    /// <summary>The employee's assignments this period with their hours left ("312 of 400 h left"). Fails soft.</summary>
    private async Task<IReadOnlyList<Workbench.Contracts.Resourcing.AssignmentHoursLeftDto>> HoursLeftFor(TimesheetDetailDto detail)
    {
        if (Services.GetService(typeof(Workbench.Contracts.Resourcing.IStaffingAssignmentService)) is not Workbench.Contracts.Resourcing.IStaffingAssignmentService assignments)
        {
            return [];
        }

        try
        {
            return await assignments.ListMyHoursLeftAsync(detail.Timesheet.PeriodStart, detail.Timesheet.PeriodEnd, detail.Timesheet.Id);
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException or HttpRequestException or TaskCanceledException)
        {
            return [];
        }
    }

    /// <summary>Leave pre-fill and balance checks; the timesheet works without them if leave can't be loaded.</summary>
    private async Task<Workbench.Contracts.Leave.TimesheetLeaveDto?> LeaveFor(TimesheetDetailDto detail)
    {
        try
        {
            return await LeaveTimesheets.GetForTimesheetAsync(detail.Timesheet.Id);
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException or HttpRequestException)
        {
            return null;
        }
    }

    private string PrefillName(Workbench.Contracts.Leave.LeavePrefillDto p) =>
        _detail?.ChargeCodes.FirstOrDefault(c => c.ChargeCode.WbsElementId == p.WbsElementId) is { } code ? ChargeCodeText.Label(code.ChargeCode) : p.WbsCode;

    /// <summary>
    /// Who a submitted timesheet waits on: the open approval step's people, by name where the employee list knows them.
    /// Best effort; the banner just says "waiting for approval" without it.
    /// </summary>
    private async Task<string?> WaitingOnAsync(TimesheetDto sheet)
    {
        if (sheet.Status != TimesheetState.Submitted
            || Services.GetService(typeof(Workbench.Contracts.Approvals.IApprovalInboxService)) is not Workbench.Contracts.Approvals.IApprovalInboxService inbox)
        {
            return null;
        }

        try
        {
            var history = await inbox.GetHistoryAsync(Workbench.Contracts.Approvals.ApprovalDocumentTypes.Timesheet, sheet.Id);
            var emails = history.FirstOrDefault()?.Tasks.FirstOrDefault(t => t.Status == Workbench.Contracts.Approvals.ApprovalTaskState.Pending)?.Assignees ?? [];
            if (emails.Count == 0)
            {
                return null;
            }

            var names = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            if (Services.GetService(typeof(IPeopleService)) is IPeopleService people)
            {
                try
                {
                    foreach (var e in await people.ListEmployeesAsync())
                    {
                        names[e.Email] = e.DisplayName;
                    }
                }
                catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException or HttpRequestException)
                {
                }
            }

            var shown = emails.Take(2).Select(e => names.GetValueOrDefault(e) ?? e).ToList();
            return string.Join(" or ", shown) + (emails.Count > 2 ? $" (+{emails.Count - 2})" : "");
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException or HttpRequestException or Workbench.Contracts.WorkbenchNotFoundException)
        {
            return null;
        }
    }

    internal static string PeriodLabel(TimesheetDto t) =>
        $"{t.PeriodStart.ToString("MMM d", CultureInfo.InvariantCulture)} – {t.PeriodEnd.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)}";

    public void Dispose() => _autoSave?.Cancel();
}
