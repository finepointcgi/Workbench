@inject ITimesheetApprovalService Approvals
@inject ICurrentUserContext CurrentUser

<MudNavLink Href="time" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AccessTime">Time</MudNavLink>
@if (_showApprovals)
{
    <MudNavLink Href="time/approvals" Icon="@Icons.Material.Filled.FactCheck">Approvals</MudNavLink>
}

@code {
    private bool _showApprovals;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Supervisors (anyone with timesheets to approve), administrators and timekeepers.
            var me = await CurrentUser.GetAsync();
            _showApprovals = me.IsAdmin || me.Roles.HasFlag(OrgRoles.Timekeeper) || await Approvals.IsApproverAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException or TaskCanceledException)
        {
            // Server unreachable or not signed in: leave the approvals link hidden.
        }
    }
}
