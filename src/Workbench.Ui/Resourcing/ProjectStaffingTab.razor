@* Resourcing's Project staffing tab: pick a project and see the same budget-against-staffing panel as the project's own Staffing tab. *@

<MudStack Row="true" Spacing="3" AlignItems="AlignItems.End" Wrap="Wrap.Wrap" Class="mb-3">
    <MudSelect T="Guid?" Label="Project" Value="_projectId" ValueChanged="v => _projectId = v" Style="min-width:280px" data-testid="staffing-project">
        @foreach (var p in Lookups.Projects)
        {
            <MudSelectItem T="Guid?" Value="p.Id">@p.Code · @p.Name</MudSelectItem>
        }
    </MudSelect>
    @if (_projectId is { } id)
    {
        <MudButton Href="@($"projects/{id}/staffing")" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.OpenInNew">Open the project</MudButton>
    }
</MudStack>

@if (_projectId is { } projectId)
{
    <ProjectStaffingPanel ProjectId="projectId" @key="projectId" />
}
else
{
    <MudText Class="mud-text-secondary">Pick a project to compare its labor budget with the people staffed on it.</MudText>
}

@code {
    [Parameter, EditorRequired] public ResourcingContext Lookups { get; set; } = default!;

    private Guid? _projectId;

    protected override void OnInitialized() =>
        _projectId = (Lookups.ManageableProjects.FirstOrDefault() ?? Lookups.Projects.FirstOrDefault())?.Id;
}
