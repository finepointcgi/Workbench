@page "/resourcing"
@inject IPeopleService People
@inject IProjectService ProjectService
@inject IResourceAllocationService Allocations
@inject ISnackbar Snackbar

<PageTitle>Resourcing · Workbench</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
    <MudText Typo="Typo.h4" HtmlTag="h1">Resourcing</MudText>
</MudStack>
<MudText Class="mud-text-secondary mb-3">
    Who is planned where, week by week: capacity is standard hours less holidays, approved leave and a non-billable allowance.
</MudText>

@if (_context is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudTabs Elevation="0" Outlined="true" Rounded="true" TabPanelsClass="pa-3" @bind-ActivePanelIndex="_tab" data-testid="resourcing-tabs">
        <MudTabPanel Text="Heat map">
            <HeatMapTab Lookups="_context" />
        </MudTabPanel>
        <MudTabPanel Text="Project staffing">
            <ProjectStaffingTab Lookups="_context" />
        </MudTabPanel>
        <MudTabPanel Text="Utilization">
            <UtilizationTab />
        </MudTabPanel>
        <MudTabPanel Text="Open demand & find people">
            <DemandTab Lookups="_context" />
        </MudTabPanel>
    </MudTabs>
}

@code {
    private ResourcingContext? _context;
    private int _tab;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var employees = await People.ListEmployeesAsync();
            var projects = (await ProjectService.ListProjectsAsync()).Where(p => p.Status != ProjectState.Closed).OrderBy(p => p.Code, StringComparer.Ordinal).ToList();
            var manageable = new List<ProjectDto>();
            foreach (var project in projects)
            {
                if (await Allocations.CanManageAsync(project.Id))
                {
                    manageable.Add(project);
                }
            }

            var categories = await People.ListLaborCategoriesAsync();
            _context = new ResourcingContext(employees.OrderBy(e => e.DisplayName, StringComparer.OrdinalIgnoreCase).ToList(), projects, manageable, categories);
        }
        catch (Exception ex) when (ResourcingFormat.IsExpected(ex))
        {
            Snackbar.Add($"Couldn't load resourcing: {ex.Message}", Severity.Error);
            _context = new ResourcingContext([], [], [], []);
        }
    }
}
