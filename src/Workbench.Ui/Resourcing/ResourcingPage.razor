@page "/resourcing"
@inject IPeopleService People
@inject IProjectService ProjectService
@inject IResourceAllocationService Allocations
@inject ICurrentUserContext CurrentUser
@inject ISnackbar Snackbar

<PageTitle>Resourcing · Workbench</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
    <MudText Typo="Typo.h4" HtmlTag="h1">Resourcing</MudText>
</MudStack>
@if (_context is null)
{
    <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" />
}
else if (!_staffing)
{
    @* Employees: just their own plan. Staffing tabs are for project managers, resource managers and Finance. *@
    <MudText Class="mud-text-secondary mb-3">The projects you're staffed on, and how many hours a week.</MudText>
    <MyAllocationsCard Weeks="8" ShowWhenEmpty="true" ShowLink="false" />
}
else
{
    <MudText Class="mud-text-secondary mb-3" HtmlTag="div">
        Who is staffed where, week by week. Staff people from each project's Staffing tab, against its budget. <Term Key="capacity">Capacity</Term> is a person's standard hours less holidays, approved leave and time for non-project work.
    </MudText>
    <MudTabs Elevation="0" Outlined="true" Rounded="true" TabPanelsClass="pa-3" @bind-ActivePanelIndex="_tab" data-testid="resourcing-tabs">
        <MudTabPanel Text="My staffing">
            <MyAllocationsCard Weeks="8" ShowWhenEmpty="true" ShowLink="false" />
        </MudTabPanel>
        <MudTabPanel Text="Heat map">
            <HeatMapTab Lookups="_context" />
        </MudTabPanel>
        <MudTabPanel Text="Project staffing">
            <ProjectStaffingTab Lookups="_context" />
        </MudTabPanel>
        <MudTabPanel Text="Utilization">
            <UtilizationTab />
        </MudTabPanel>
        <MudTabPanel Text="Unstaffed budget & find people">
            <DemandTab Lookups="_context" />
        </MudTabPanel>
    </MudTabs>
}

@code {
    private ResourcingContext? _context;
    private int _tab = 1;

    /// <summary>Project managers, resource managers and Finance see the staffing tabs (cosmetic; the server limits the data).</summary>
    private bool _staffing;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var employees = await People.ListEmployeesAsync();
            var projects = (await ProjectService.ListProjectsAsync()).Where(p => p.Status != ProjectState.Closed).OrderBy(p => p.Code, StringComparer.Ordinal).ToList();
            var manageable = new List<ProjectDto>();
            foreach (var project in projects)
            {
                if (await Allocations.CanManageAsync(project.Id))
                {
                    manageable.Add(project);
                }
            }

            var categories = await People.ListLaborCategoriesAsync();
            _context = new ResourcingContext(employees.OrderBy(e => e.DisplayName, StringComparer.OrdinalIgnoreCase).ToList(), projects, manageable, categories);
            var me = await CurrentUser.GetAsync();
            _staffing = me.IsFinance || me.Roles.IsResourceManager() || manageable.Count > 0
                || (me.EmployeeId is { } id && projects.Any(p => p.ProjectManagerId == id));
        }
        catch (Exception ex) when (ResourcingFormat.IsExpected(ex))
        {
            Snackbar.Add($"Couldn't load resourcing: {ex.Message}", Severity.Error);
            _context = new ResourcingContext([], [], [], []);
        }
    }
}
