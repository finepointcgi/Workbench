@* People × weeks: staffed hours against capacity. Click a cell to see, change or add that week's staffing. *@
@inject IResourcePlanningService Planning
@inject IResourceAllocationService Allocations
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudStack Row="true" Spacing="3" AlignItems="AlignItems.End" Wrap="Wrap.Wrap" Class="mb-2">
    <MudDatePicker Label="From week" Date="_from.ToDateTime(TimeOnly.MinValue)" DateChanged="async d => { _from = ResourcingFormat.WeekStart(DateOnly.FromDateTime(d ?? DateTime.Today)); await LoadAsync(); }"
                   DateFormat="yyyy-MM-dd" Style="max-width:160px" />
    <MudSelect T="int" Label="Weeks" Value="_weeks" ValueChanged="async v => { _weeks = v; await LoadAsync(); }" Style="max-width:110px">
        <MudSelectItem T="int" Value="8">8</MudSelectItem>
        <MudSelectItem T="int" Value="12">12</MudSelectItem>
        <MudSelectItem T="int" Value="26">26</MudSelectItem>
    </MudSelect>
    <MudSelect T="Guid?" Label="Project" Value="_projectId" ValueChanged="async v => { _projectId = v; await LoadAsync(); }" Style="min-width:240px" Clearable="true">
        <MudSelectItem T="Guid?" Value="null">Everyone</MudSelectItem>
        @foreach (var p in Lookups.Projects)
        {
            <MudSelectItem T="Guid?" Value="p.Id">@p.Code · @p.Name</MudSelectItem>
        }
    </MudSelect>
    <MudSpacer />
    @if (Lookups.ManageableProjects.Count > 0)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => AddAsync(null, null)" data-testid="add-allocation">Staff a person</MudButton>
    }
</MudStack>

<MudStack Row="true" Spacing="2" Class="mb-2" AlignItems="AlignItems.Center">
    @foreach (var status in new[] { LoadStatus.Under, LoadStatus.Full, LoadStatus.Over })
    {
        <span style="@ResourcingFormat.CellStyle(status) padding:2px 10px; border-radius:4px; font-size:0.8rem">@StatusMarker(status)@ResourcingFormat.Label(status)</span>
    }
    <MudText Typo="Typo.caption" Class="mud-text-secondary" data-testid="heat-legend" HtmlTag="div">
        Each cell reads "staffed of available" hours for that week: <b>34 of 29 h</b> means 34 hours staffed against 29 the person can work
        (<Term Key="capacity">capacity</Term>). Full from @(_map?.FullThresholdPercent ?? 90)% of capacity.
    </MudText>
</MudStack>

@if (_map is null)
{
    <MudProgressLinear aria-label="Loading" Indeterminate="true" />
}
else if (_map.Rows.Count == 0)
{
    <MudText Class="mud-text-secondary">Nobody to show for these weeks.</MudText>
}
else
{
    <div style="overflow-x:auto">
        <MudSimpleTable Dense="true" Bordered="true" data-testid="heat-map" aria-label="Resource heat map: staffed of available hours per person and week">
            <thead>
                <tr>
                    <th scope="col" style="min-width:180px">Person</th>
                    @foreach (var week in _map.Weeks)
                    {
                        <th scope="col" style="text-align:center; white-space:nowrap">@week.ToString("MMM d")</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _map.Rows)
                {
                    <tr data-person="@row.EmployeeName">
                        <th scope="row" style="text-align:left; font-weight:normal">
                            <div>@row.EmployeeName</div>
                            <div class="mud-text-secondary" style="font-size:0.75rem">@string.Join(" · ", new[] { row.LaborCategory, row.OrgUnit }.OfType<string>())</div>
                        </th>
                        @foreach (var cell in row.Weeks)
                        {
                            @* The status is a shape as well as a color (1.4.1), and each cell is a button so the keyboard can open it. *@
                            <td style="@ResourcingFormat.CellStyle(cell.Status) text-align:center; white-space:nowrap; padding:0"
                                data-status="@cell.Status" data-week="@cell.WeekStart.ToString("yyyy-MM-dd")">
                                <button type="button" class="wb-heat-cell" @onclick="() => OpenCellAsync(row, cell)"
                                        title="@($"{ResourcingFormat.Label(cell.Status)}: {cell.Allocated:0.#} h planned of {cell.Capacity:0.#} h available" + (cell.HolidayHours + cell.LeaveHours > 0 ? $" ({cell.HolidayHours + cell.LeaveHours:0.#} h holidays/leave)" : ""))">
                                    @StatusMarker(cell.Status)@ResourcingFormat.Hours(cell.Allocated)<span class="wb-heat-of"> of @ResourcingFormat.Hours(cell.Capacity) h</span>
                                    <span class="wb-sr-only">, @ResourcingFormat.Label(cell.Status), week of @cell.WeekStart.ToString("MMM d") for @row.EmployeeName</span>
                                </button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </div>
}

@code {
    [Parameter, EditorRequired] public ResourcingContext Lookups { get; set; } = default!;

    private HeatMapDto? _map;
    private DateOnly _from = ResourcingFormat.ThisWeek;
    private int _weeks = 8;
    private Guid? _projectId;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _map = await Planning.GetHeatMapAsync(new HeatMapQuery(_from, _weeks, null, _projectId));
        }
        catch (Exception ex) when (ResourcingFormat.IsExpected(ex))
        {
            Snackbar.Add($"Couldn't load the heat map: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenCellAsync(HeatMapRowDto row, HeatMapCellDto cell)
    {
        var parameters = new DialogParameters<AllocationWeekDialog>
        {
            { d => d.EmployeeId, row.EmployeeId },
            { d => d.EmployeeName, row.EmployeeName },
            { d => d.Week, cell.WeekStart },
            { d => d.Capacity, cell.Capacity },
            { d => d.Lookups, Lookups },
        };
        var dialog = await DialogService.ShowAsync<AllocationWeekDialog>($"{row.EmployeeName} · week of {cell.WeekStart:MMM d}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        await dialog.Result;
        await LoadAsync();
    }

    private async Task AddAsync(Guid? employeeId, DateOnly? week)
    {
        var parameters = new DialogParameters<AllocationDialog>
        {
            { d => d.Employees, Lookups.Employees },
            { d => d.Projects, Lookups.ManageableProjects },
            { d => d.DefaultEmployeeId, employeeId },
            { d => d.DefaultProjectId, _projectId },
            { d => d.DefaultWeek, week ?? _from },
        };
        var dialog = await DialogService.ShowAsync<AllocationDialog>("Staff a person", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: SaveAllocationRequest request })
        {
            try
            {
                await Allocations.CreateAsync(request);
                Snackbar.Add("Staffing saved.", Severity.Success);
            }
            catch (Exception ex) when (ResourcingFormat.IsExpected(ex))
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }

            await LoadAsync();
        }
    }

    // Over/Full get a symbol beside the hours so the status doesn't rely on the cell color (WCAG 1.4.1).
    private static RenderFragment StatusMarker(LoadStatus status) => status switch
    {
        LoadStatus.Over => @<span class="wb-heat-marker" aria-hidden="true">▲ </span>,
        LoadStatus.Full => @<span class="wb-heat-marker" aria-hidden="true">● </span>,
        _ => @<span class="wb-heat-marker" aria-hidden="true">○ </span>,
    };
}
