@page "/purchasing/vendors"
@inject IVendorService Vendors
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>Vendors · Purchasing · Workbench</PageTitle>

<PurchasingHeader Title="Vendors" Subtitle="Suppliers and subcontractors. On hold blocks new bills and payments; TINs are stored encrypted and shown masked.">
    <FinanceOnly>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync" Disabled="_error is not null" data-testid="new-vendor">New vendor</MudButton>
    </FinanceOnly>
</PurchasingHeader>

@if (_error is not null)
{
    <PurchasingError Message="@_error" Forbidden="_forbidden" />
}
else
{
    <ConfigurableList T="VendorDto" Definition="_definition" Items="Visible" Loading="_loading" SearchLabel="Search code, name or UEI"
                      RowClick="@(v => Navigation.NavigateTo($"purchasing/vendors/{v.Id}"))" TestId="vendors">
        <ToolBarContent>
            <MudSwitch T="bool" @bind-Value="_showInactive" Label="Show inactive" Color="Color.Primary" />
        </ToolBarContent>
        <NoRecordsContent><MudText Class="mud-text-secondary">No vendors match. Vendors are the companies you buy from; add one before entering its bills or purchase orders.</MudText></NoRecordsContent>
    </ConfigurableList>
}

@code {
    private IReadOnlyList<VendorDto> _vendors = [];
    private bool _showInactive;
    private bool _loading = true;
    private string? _error;
    private bool _forbidden;

    private IReadOnlyList<VendorDto> Visible => _vendors.Where(v => _showInactive || v.Status != VendorState.Inactive).ToList();

    private static string StatusLabel(VendorState status) => status == VendorState.OnHold ? "On hold" : status.ToString();

    internal static readonly ListDefinition<VendorDto> _definition = new()
    {
        ListKey = CustomizableLists.Vendors,
        EntityType = CustomizableEntities.Vendor,
        Title = "Vendors",
        Id = v => v.Id,
        Columns =
        [
            new() { Key = "code", Title = "Code", Value = v => v.Code, Groupable = false, Cell = v => @<MudLink Href="@($"purchasing/vendors/{v.Id}")">@v.Code</MudLink> },
            new() { Key = "name", Title = "Name", Value = v => v.Name, Groupable = false },
            new() { Key = "status", Title = "Status", Value = v => v.Status, Display = v => StatusLabel(v.Status),
                    Cell = v => @<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@PurchasingFormat.Color(v.Status)" Class="ma-0">@StatusLabel(v.Status)</MudChip> },
            new() { Key = "size", Title = "Size", Value = v => v.BusinessSize },
            new() { Key = "categories", Title = "Categories", Value = v => string.Join(", ", v.SocioEconomicCategories) },
            new() { Key = "uei", Title = "UEI", Value = v => v.Uei, Groupable = false },
            new() { Key = "tin", Title = "TIN", Value = v => v.TaxIdMasked, Groupable = false, Cell = v => @<span style="font-family:monospace">@v.TaxIdMasked</span> },
            new() { Key = "terms", Title = "Terms", Value = v => v.PaymentTermsDays, Kind = ListColumnKind.Number, Display = v => $"Net {v.PaymentTermsDays}" },
            new() { Key = "form1099", Title = "1099", Value = v => v.Is1099 ? v.Form1099Box : null },
            new() { Key = "w9", Title = "W-9", Value = v => v.W9FileId is null ? null : "On file" },
            new() { Key = "contact", Title = "Contact", Value = v => v.ContactName, Standard = false, Groupable = false },
            new() { Key = "contactEmail", Title = "Contact email", Value = v => v.ContactEmail, Standard = false, Groupable = false },
        ],
    };

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _vendors = await Vendors.ListAsync();
        }
        catch (Exception ex) when (PurchasingFormat.IsExpected(ex))
        {
            (_error, _forbidden) = (PurchasingFormat.Error(ex), PurchasingFormat.IsForbidden(ex));
        }

        _loading = false;
    }

    private async Task CreateAsync()
    {
        var dialog = await DialogService.ShowAsync<VendorDialog>("New vendor", new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: VendorDto vendor })
        {
            Navigation.NavigateTo($"purchasing/vendors/{vendor.Id}");
        }
    }
}
