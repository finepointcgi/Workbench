@* A bill's lines: what each charges, where it's routed and whether it's decided. *@
<MudSimpleTable Dense="true" Elevation="0" data-testid="bill-lines" Style="overflow-x:auto">
    <thead><tr><th>#</th><th>Type</th><th>Charge to</th><th>Description</th><th style="text-align:right">Amount</th><th style="text-align:right"><Term Key="retainage">Retainage</Term></th><th>Routed to</th><th>Status</th>@if (CanCapitalize is not null) { <th></th> }</tr></thead>
    <tbody>
        @foreach (var l in Lines)
        {
            <tr>
                <td>@l.LineNumber</td>
                <td>@PurchasingFormat.Label(l.Kind)</td>
                <td>
                    @if (l.Kind == BillLineKind.Account)
                    {
                        <span>@l.AccountNumber @l.AccountName · @l.OrgUnitCode</span>
                    }
                    else
                    {
                        <span>
                            @if (l.SubcontractId is { } sub) { <MudLink Href="@($"purchasing/subcontracts/{sub}")">@l.SubcontractNumber</MudLink><span> · </span> }
                            @if (l.ProjectId is { } p) { <MudLink Href="@($"projects/{p}/odcs")">@l.ProjectCode</MudLink> }
                            <span>@($" {l.WbsCode}{(l.OdcType is { } t ? $" · {t}" : "")}")</span>
                            @if (l.OdcEntryId is not null) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">ODC</MudChip> }
                        </span>
                    }
                </td>
                <td>
                    @l.Description
                    @if (l.PurchaseOrderLineId is not null)
                    {
                        <div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@l.PurchaseOrderNumber: @Q(l.Quantity) × @Q(l.UnitPrice)</MudText>
                            @if (l.MatchProblem is null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="ma-0" data-testid="match-ok">Matched</MudChip>
                            }
                            else if (l.MatchOverrideBy is not null)
                            {
                                <MudTooltip Text="@($"{l.MatchProblem} Overridden by {l.MatchOverrideBy}: {l.MatchOverrideReason}")">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text" Class="ma-0">Match overridden</MudChip>
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="@l.MatchProblem">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text" Class="ma-0" data-testid="match-failed">Match failed</MudChip>
                                </MudTooltip>
                            }
                        </div>
                    }
                </td>
                <td style="text-align:right">@PurchasingFormat.Amount(l.Amount)</td>
                <td style="text-align:right">@(l.RetainageAmount == 0 ? "" : PurchasingFormat.Amount(l.RetainageAmount))</td>
                <td>@l.RoutedTo</td>
                <td>@l.Status@(l.DecidedBy is null ? "" : $" by {l.DecidedBy}")</td>
                @if (CanCapitalize is not null)
                {
                    <td>
                        @if (CanCapitalize(l))
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Inventory2" OnClick="@(() => OnCapitalize.InvokeAsync(l))" data-testid="capitalize" title="Capitalize: record this purchase as a fixed asset and depreciate it">Add to fixed assets</MudButton>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</MudSimpleTable>

@code {
    [Parameter] public IReadOnlyList<BillLineDto> Lines { get; set; } = [];

    /// <summary>Fixed assets: which lines show a Capitalize action (null: no action column).</summary>
    [Parameter] public Func<BillLineDto, bool>? CanCapitalize { get; set; }

    [Parameter] public EventCallback<BillLineDto> OnCapitalize { get; set; }

    private static string Q(decimal? value) => value is { } v ? v.ToString("#,##0.####", System.Globalization.CultureInfo.InvariantCulture) : "";
}
