@* Page heading for the purchasing screens: breadcrumb, title, subtitle and actions. *@
<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-1">
    <MudStack Spacing="0">
        <MudLink Href="@(BackHref ?? "purchasing/bills")" Typo="Typo.caption">@(BackLabel ?? "Purchasing")</MudLink>
        <MudText Typo="Typo.h4" HtmlTag="h1">
            @if (TitleTerm is not null)
            {
                <Term Key="@TitleTerm">@Title</Term>
            }
            else
            {
                @Title
            }
        </MudText>
    </MudStack>
    <MudSpacer />
    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">@ChildContent</MudStack>
</MudStack>
@if (Subtitle is not null)
{
    <MudText Class="mud-text-secondary mb-4">@Subtitle</MudText>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>A glossary key: the title gets that term's explanation as a tooltip (e.g. the technical name).</summary>
    [Parameter] public string? TitleTerm { get; set; }
    [Parameter] public string? BackHref { get; set; }
    [Parameter] public string? BackLabel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
