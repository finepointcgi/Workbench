@page "/purchasing/bills/{BillId:guid}"
@inject IApBillService Bills
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject Workbench.Contracts.Assets.IAssetService AssetService

<PageTitle>@(_bill?.Bill.Number ?? "Bill") · Purchasing · Workbench</PageTitle>

@if (_error is not null)
{
    <PurchasingHeader Title="Bill" BackHref="@BackHref" BackLabel="@BackLabel" />
    <PurchasingError Message="@_error" Forbidden="_forbidden" />
}
else if (_bill is not { } bill)
{
    <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" />
}
else
{
    var b = bill.Bill;
    <PurchasingHeader Title="@($"{b.Number} · {b.VendorName} {DocWord(b.Kind)} {b.InvoiceNumber}")" BackHref="@BackHref" BackLabel="@BackLabel">
        <BillStatusChip Status="b.Status" />
        @if (b.Kind != BillKind.Bill)
        {
            <MudChip T="string" Size="Size.Small" Class="ma-0" data-testid="bill-kind">@PurchasingFormat.Label(b.Kind)</MudChip>
        }
        <FinanceOnly Permission="@Workbench.Contracts.Identity.Permission.ApBillsManage">
            @if (bill.CanEdit)
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" Href="@($"purchasing/bills/{b.Id}/edit")" data-testid="edit-bill">Edit</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" data-testid="submit">Submit</MudButton>
            }
        </FinanceOnly>
        @if (bill.CanApprove)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RejectAsync" data-testid="reject">Reject</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => RunAsync(() => Bills.ApproveAsync(b.Id), "Approved."))" data-testid="approve">Approve</MudButton>
        }
        <FinanceOnly Permission="@Workbench.Contracts.Identity.Permission.ApBillsManage">
            @if (b.Status == BillState.Approved)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => RunAsync(() => Bills.PostAsync(b.Id), "Posted."))" data-testid="retry-post">Retry posting</MudButton>
            }
            @if (b.Status == BillState.Posted && b.Kind == BillKind.Bill && !b.IsForeignCurrency)
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Undo" OnClick="CreditThisBillAsync" data-testid="credit-bill">Credit this bill</MudButton>
            }
            @if (b.Status == BillState.Posted && b.IsCredit && b.Balance > 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyCreditAsync" data-testid="apply-credit">Apply to bills</MudButton>
            }
            @if (b.Status != BillState.Void)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="VoidAsync" data-testid="void">Void</MudButton>
            }
        </FinanceOnly>
        <FinanceOnly Permission="@Workbench.Contracts.Identity.Permission.ApPaymentsManage">
            @if (b.Status == BillState.Posted && b.IsCredit && b.Balance > 0)
            {
                <MudButton Variant="Variant.Outlined" OnClick="RefundAsync" data-testid="record-refund">Record refund</MudButton>
            }
        </FinanceOnly>
    </PurchasingHeader>

    @if (b.Status == BillState.Void && bill.VoidReason is not null)
    {
        <MudAlert Severity="Severity.Info" Class="mb-3" data-testid="void-info">
            Voided by @bill.VoidedBy: @bill.VoidReason.
            @if (bill.VoidReversalDate is { } reversed) { <span> Every posting was reversed on @PurchasingFormat.Date(reversed); see the trail below.</span> }
        </MudAlert>
    }
    @if (b.CreditsBillId is { } credited)
    {
        <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-3">
            Credits bill <MudLink Href="@($"purchasing/bills/{credited}")">@(bill.CreditsBillNumber ?? "the original")</MudLink>.
            @(b.Status == BillState.Posted ? "" : "When it posts, it's applied to that bill's open balance; anything left stays an open credit for the next payment run.")
        </MudAlert>
    }
    @if (b.PostingProblem is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">Approved but not posted: @b.PostingProblem</MudAlert>
    }
    @if (bill.RejectionReason is not null && b.Status == BillState.Rejected)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">Rejected: @bill.RejectionReason</MudAlert>
    }
    @if (bill.PossibleDuplicates.Count > 0 && b.Status is not BillState.Void)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3" data-testid="duplicate-warning">
            Possible duplicate of
            @foreach (var d in bill.PossibleDuplicates)
            {
                <span> <MudLink Href="@($"purchasing/bills/{d.BillId}")">@d.Number</MudLink> (@d.Reason.ToLowerInvariant())</span>
            }
        </MudAlert>
    }
    @if (bill.FundingOverrideReason is not null)
    {
        <MudAlert Severity="Severity.Info" Class="mb-3">Over the subcontract's funded value; overridden by @bill.FundingOverrideBy: @bill.FundingOverrideReason</MudAlert>
    }

    @if (b.CurrencyCode is { } currency)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" data-testid="bill-currency">
            Invoiced in @currency: <b>@Workbench.Ui.Currencies.CurrencyFormat.Amount(b.TransactionAmount, currency)</b> at @Workbench.Ui.Currencies.CurrencyFormat.Rate(b.ExchangeRate)
            (@PurchasingFormat.Amount(b.Amount) in dollars). @(b.Status == BillState.Posted ? $"Left to pay: {Workbench.Ui.Currencies.CurrencyFormat.Amount(b.TransactionBalance, currency)}." : "")
            Amounts below are in dollars at the bill's rate; a payment at another rate posts a realized gain or loss.
        </MudAlert>
    }
    <MudGrid Spacing="2" Class="mb-3">
        @foreach (var (label, value) in Tiles(b))
        {
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@label</MudText>
                    <MudText Typo="Typo.h6">@value</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudPaper Outlined="true" Class="pa-4 mb-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.h6">Lines</MudText>
            <MudSpacer />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                <MudLink Href="@($"purchasing/vendors/{b.VendorId}")" Typo="Typo.caption">@b.VendorCode</MudLink> · entered by @b.EnteredBy
                @if (bill.JournalEntryId is { } je) { <span> · <MudLink Href="@($"accounting/journal/{je}")" Typo="Typo.caption">AP journal entry</MudLink></span> }
            </MudText>
        </MudStack>
        @if (bill.Description is not null)
        {
            <MudText Class="mb-2">@bill.Description</MudText>
        }
        <BillLinesTable Lines="bill.Lines" CanCapitalize="@(_capitalizable.Count > 0 ? l => _capitalizable.Contains(l.Id) : null)" OnCapitalize="CapitalizeAsync" />
    </MudPaper>

    @if (Access?.Can(Workbench.Contracts.Identity.Permission.ApBillsManage) == true && bill.Bill.Status is not (BillState.Void or BillState.Rejected) && bill.Bill.Kind == BillKind.Bill)
    {
        <Workbench.Ui.SalesTax.BillTaxCard BillId="BillId" Status="bill.Bill.Status" />
    }

    @if (bill.Payments.Count > 0)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-3">
            <MudText Typo="Typo.h6" Class="mb-2">Payments</MudText>
            <MudSimpleTable Dense="true" Elevation="0">
                <thead><tr><th>Run</th><th>Paid on</th><th>Method</th><th>Reference</th><th style="text-align:right">Amount</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var p in bill.Payments)
                    {
                        <tr>
                            <td><MudLink Href="@($"purchasing/payments/{p.RunId}")">@p.RunNumber</MudLink></td>
                            <td>@PurchasingFormat.Date(p.PaidOn)</td><td>@p.Method</td><td>@p.Reference</td>
                            <td style="text-align:right">
                                @PurchasingFormat.Amount(p.Amount)
                                @if (b.CurrencyCode is { } pc && p.TransactionAmount != 0)
                                {
                                    <div class="mud-text-secondary" style="font-size:0.8rem">@Workbench.Ui.Currencies.CurrencyFormat.Amount(p.TransactionAmount, pc)@(p.PaidOn is null ? "" : $" at {Workbench.Ui.Currencies.CurrencyFormat.Rate(p.ExchangeRate)} · {Workbench.Ui.Currencies.CurrencyFormat.GainLoss(p.RealizedGainLoss)}")</div>
                                }
                            </td><td>@p.Status</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
    <FinanceOnly Permission="@Workbench.Contracts.Identity.Permission.ApBillsManage">
        <BillTrailPanel @key="_trailVersion" Bill="bill" OnChanged="ReloadAsync" />
    </FinanceOnly>
    <CustomFieldsSection EntityType="@CustomizableEntityTypes.ApBill" RecordId="BillId" Class="mt-3" />
}

@code {
    [CascadingParameter]
    public FinanceAccess? Access { get; set; }

    // Someone outside Finance gets here from Bill approvals; the bill list is Finance's.
    private string BackHref => Access?.Can(Workbench.Contracts.Identity.Permission.ApBillsManage) == true ? "purchasing/bills" : "purchasing/approvals";
    private string BackLabel => Access?.Can(Workbench.Contracts.Identity.Permission.ApBillsManage) == true ? "Bills" : "Bill approvals";

    [Parameter] public Guid BillId { get; set; }

    private BillDto? _bill;
    private string? _error;
    private bool _forbidden;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _bill = await Bills.GetAsync(BillId);
            await LoadCapitalizableAsync();
        }
        catch (Exception ex) when (PurchasingFormat.IsExpected(ex))
        {
            (_error, _forbidden) = (PurchasingFormat.Error(ex), PurchasingFormat.IsForbidden(ex));
        }
    }

    private async Task RunAsync(Func<Task<BillDto>> action, string success)
    {
        try
        {
            _bill = await action();
            await LoadCapitalizableAsync();
            Snackbar.Add(_bill.Bill.PostingProblem is { } problem ? $"Saved, but posting failed: {problem}" : success,
                _bill.Bill.PostingProblem is null ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex) when (PurchasingFormat.IsExpected(ex))
        {
            Snackbar.Add(PurchasingFormat.Error(ex), Severity.Error);
        }
    }

    private async Task SubmitAsync()
    {
        var confirm = _bill!.PossibleDuplicates.Count > 0;
        if (confirm && await DialogService.ShowMessageBoxAsync("Possible duplicate", "This looks like an invoice that's already entered. Submit it anyway?", yesText: "Submit", cancelText: "Cancel") != true)
        {
            return;
        }

        try
        {
            _bill = await Bills.SubmitAsync(BillId, new SubmitBillRequest(confirm));
            Snackbar.Add("Submitted for approval.", Severity.Success);
        }
        catch (ArgumentException ex) when (ex.Message.Contains("funded value", StringComparison.OrdinalIgnoreCase))
        {
            var reason = await ReasonDialog.AskAsync(DialogService, "Over funded value", "Override and submit", ex.Message, label: "Override reason (Finance)");
            if (reason is not null)
            {
                await RunAsync(() => Bills.SubmitAsync(BillId, new SubmitBillRequest(confirm, reason)), "Submitted with a funding override.");
            }
        }
        catch (Exception ex) when (PurchasingFormat.IsExpected(ex))
        {
            Snackbar.Add(PurchasingFormat.Error(ex), Severity.Error);
        }
    }

    /// <summary>Posted GL-account lines over the capitalization threshold not yet capitalized (Finance only; others see no action).</summary>
    private HashSet<Guid> _capitalizable = [];

    private async Task LoadCapitalizableAsync()
    {
        try
        {
            _capitalizable = _bill?.Bill.Status == BillState.Posted
                ? (await AssetService.ListCapitalizableBillLinesAsync()).Where(l => l.BillId == BillId).Select(l => l.BillLineId).ToHashSet()
                : [];
        }
        catch (Exception ex) when (PurchasingFormat.IsExpected(ex))
        {
            _capitalizable = [];
        }
    }

    private async Task CapitalizeAsync(BillLineDto line)
    {
        var dialog = await DialogService.ShowAsync<Workbench.Ui.Assets.CapitalizeDialog>($"Add {_bill!.Bill.Number} line {line.LineNumber} to fixed assets",
            new DialogParameters<Workbench.Ui.Assets.CapitalizeDialog> { { d => d.BillLineId, line.Id }, { d => d.Description, line.Description }, { d => d.Amount, line.Amount } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: Workbench.Contracts.Assets.CapitalizeBillLineRequest request })
        {
            try
            {
                var asset = await AssetService.CapitalizeAsync(request);
                Snackbar.Add($"Added to fixed assets as {asset.Asset.TagNumber}.", Severity.Success);
                Navigation.NavigateTo($"assets/{asset.Asset.Id}");
            }
            catch (Exception ex) when (PurchasingFormat.IsExpected(ex))
            {
                Snackbar.Add(PurchasingFormat.Error(ex), Severity.Error);
            }
        }
    }

    private async Task RejectAsync()
    {
        if (await ReasonDialog.AskAsync(DialogService, "Reject bill", "Reject", "The person who entered it is notified.", color: Color.Error) is { } reason)
        {
            await RunAsync(() => Bills.RejectAsync(BillId, new BillReasonRequest(reason)), "Rejected.");
        }
    }

    private async Task VoidAsync()
    {
        var b = _bill!.Bill;
        var posted = b.Status is BillState.Approved or BillState.Posted;
        var what = PurchasingFormat.Label(b.Kind).ToLowerInvariant();
        if (await ReasonDialog.AskAsync(DialogService, $"Void {what}", "Void",
                posted ? $"Every posting of this {what} is reversed (its project costs too), in its own period when that's open, otherwise today. Payments and applied credits have to be undone first." : null,
                color: Color.Error) is { } reason)
        {
            await RunAsync(() => Bills.VoidAsync(BillId, new BillReasonRequest(reason)), "Voided.");
            _trailVersion++;
        }
    }

    private int _trailVersion;

    private async Task ReloadAsync()
    {
        _bill = await Bills.GetAsync(BillId);
        _trailVersion++;
    }

    private static string DocWord(BillKind kind) => kind switch
    {
        BillKind.CreditMemo => "credit",
        BillKind.DebitMemo => "debit memo",
        BillKind.RetainageRelease => "retainage release",
        _ => "invoice",
    };

    private static IEnumerable<(string Label, string Value)> Tiles(BillSummaryDto b)
    {
        string Posted(decimal v) => b.Status == BillState.Posted ? PurchasingFormat.Amount(v) : "—";
        if (b.IsCredit)
        {
            return [("Credit date", PurchasingFormat.Date(b.InvoiceDate)), ("Amount", PurchasingFormat.Amount(b.Amount)), ("Applied to bills", PurchasingFormat.Amount(b.AppliedAmount)),
                ("Refunded", PurchasingFormat.Amount(b.PaidAmount)), ("Credit left", Posted(b.Balance))];
        }

        var tiles = new List<(string, string)> { ("Invoice date", PurchasingFormat.Date(b.InvoiceDate)), ("Due", PurchasingFormat.Date(b.DueDate)), ("Amount", PurchasingFormat.Amount(b.Amount)) };
        if (b.Kind == BillKind.Bill)
        {
            tiles.Add(("Retainage held", PurchasingFormat.Amount(b.RetainageAmount)));
        }

        tiles.Add(("Paid", PurchasingFormat.Amount(b.PaidAmount)));
        if (b.AppliedAmount != 0)
        {
            tiles.Add(("Credits applied", PurchasingFormat.Amount(b.AppliedAmount)));
        }

        tiles.Add(("Balance", Posted(b.Balance)));
        return tiles;
    }

    private async Task CreditThisBillAsync()
    {
        var dialog = await DialogService.ShowAsync<CreditBillDialog>($"Credit {_bill!.Bill.Number}", new DialogParameters<CreditBillDialog> { { d => d.Bill, _bill } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: BillDto memo })
        {
            Snackbar.Add($"{memo.Bill.Number} drafted. Check it and submit it for approval.", Severity.Success);
            Navigation.NavigateTo($"purchasing/bills/{memo.Bill.Id}");
        }
    }

    private async Task ApplyCreditAsync()
    {
        var dialog = await DialogService.ShowAsync<ApplyCreditDialog>($"Apply {_bill!.Bill.Number}", new DialogParameters<ApplyCreditDialog> { { d => d.Credit, _bill } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: BillDto updated })
        {
            _bill = updated;
            _trailVersion++;
            Snackbar.Add("Credit applied.", Severity.Success);
        }
    }

    private async Task RefundAsync()
    {
        var dialog = await DialogService.ShowAsync<RefundDialog>("Record a vendor refund", new DialogParameters<RefundDialog> { { d => d.Credit, _bill! } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: BillDto updated })
        {
            _bill = updated;
            _trailVersion++;
            Snackbar.Add("Refund recorded.", Severity.Success);
        }
    }
}
