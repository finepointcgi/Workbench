@page "/purchasing/match-exceptions"
@inject IThreeWayMatchService Match
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Match exceptions · Purchasing · Workbench</PageTitle>

<PurchasingHeader Title="Three-way match exceptions" BackHref="purchasing/bills" BackLabel="Bills"
                  Subtitle="Bill lines that bill a PO line for more than has been received, or at a price outside the tolerance. They can't be approved until the goods are received, the bill is corrected, or Finance overrides with a reason." />

@if (_error is not null)
{
    <PurchasingError Message="@_error" Forbidden="_forbidden" />
}
else
{
    <MudSwitch T="bool" Value="_includeOverridden" ValueChanged="v => SetAsync(v)" Label="Include overridden" Color="Color.Primary" Class="mb-2" />
    @if (_rows.Count == 0)
    {
        <MudAlert Severity="Severity.Success" Dense="true">No match exceptions.</MudAlert>
    }
    else
    {
        <MudPaper Outlined="true" Class="pa-2" Style="overflow-x:auto">
            <MudSimpleTable Dense="true" Elevation="0" data-testid="match-exceptions">
                <thead><tr><th>Bill</th><th>Vendor</th><th>Line</th><th>PO</th><th style="text-align:right">Billed</th><th style="text-align:right">Received</th><th style="text-align:right">Ordered</th><th style="text-align:right">Price</th><th style="text-align:right">PO price</th><th>Problem</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in _rows)
                    {
                        <tr>
                            <td><MudLink Href="@($"purchasing/bills/{r.BillId}")">@r.BillNumber</MudLink> <BillStatusChip Status="r.BillStatus" /></td>
                            <td>@r.VendorName</td>
                            <td>@r.LineNumber · @r.Description</td>
                            <td><MudLink Href="@($"purchasing/orders/{r.PurchaseOrderId}")">@r.PurchaseOrderNumber</MudLink> line @r.PurchaseOrderLineNumber</td>
                            <td style="text-align:right">@ProcurementFormat.Quantity(r.QuantityBilled)</td>
                            <td style="text-align:right">@ProcurementFormat.Quantity(r.QuantityReceived)</td>
                            <td style="text-align:right">@ProcurementFormat.Quantity(r.QuantityOrdered)</td>
                            <td style="text-align:right">@ProcurementFormat.Price(r.UnitPrice)</td>
                            <td style="text-align:right">@ProcurementFormat.Price(r.PoUnitPrice)</td>
                            <td>@r.Problem</td>
                            <td>
                                @if (r.OverrideBy is null)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => OverrideAsync(r))" data-testid="match-override">Override</MudButton>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption">Overridden by @r.OverrideBy: @r.OverrideReason</MudText>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
}

@code {
    private IReadOnlyList<MatchExceptionDto> _rows = [];
    private bool _includeOverridden;
    private string? _error;
    private bool _forbidden;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task SetAsync(bool includeOverridden)
    {
        _includeOverridden = includeOverridden;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _rows = await Match.ListExceptionsAsync(_includeOverridden);
        }
        catch (Exception ex) when (PurchasingFormat.IsExpected(ex))
        {
            (_error, _forbidden) = (PurchasingFormat.Error(ex), PurchasingFormat.IsForbidden(ex));
        }
    }

    private async Task OverrideAsync(MatchExceptionDto row)
    {
        if (await ReasonDialog.AskAsync(DialogService, $"Override {row.BillNumber} line {row.LineNumber}", "Override", row.Problem, label: "Reason (recorded on the bill and audited)", color: Color.Warning) is not { } reason)
        {
            return;
        }

        try
        {
            await Match.OverrideAsync(row.BillLineId, new MatchOverrideRequest(reason));
            Snackbar.Add("Overridden; the line can be approved now.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) when (PurchasingFormat.IsExpected(ex))
        {
            Snackbar.Add(PurchasingFormat.Error(ex), Severity.Error);
        }
    }
}
