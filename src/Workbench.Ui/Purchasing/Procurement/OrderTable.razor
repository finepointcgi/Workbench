@* A list of purchase orders with received, billed and committed amounts. *@
@if (Orders.Count == 0)
{
    <MudText Class="mud-text-secondary">No purchase orders.</MudText>
}
else
{
    <MudPaper Elevation="0" Style="overflow-x:auto">
        <MudSimpleTable Dense="true" Hover="true" Elevation="0" data-testid="orders">
            <thead><tr><th>PO</th><th>Vendor</th><th>Date</th><th>Rev</th><th style="text-align:right">Total</th><th style="text-align:right">Received</th><th style="text-align:right">Billed</th><th style="text-align:right">Committed</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var o in Orders)
                {
                    <tr>
                        <td style="white-space:nowrap"><MudLink Href="@($"{LinkPrefix}{o.Id}")">@o.Number</MudLink></td>
                        <td>@o.VendorCode · @o.VendorName</td>
                        <td style="white-space:nowrap">@PurchasingFormat.Date(o.OrderDate)</td>
                        <td>@o.Revision</td>
                        <td style="text-align:right">@PurchasingFormat.Amount(o.Total)</td>
                        <td style="text-align:right">@PurchasingFormat.Amount(o.Received)</td>
                        <td style="text-align:right">@PurchasingFormat.Amount(o.Billed)</td>
                        <td style="text-align:right">@PurchasingFormat.Amount(o.Committed)</td>
                        <td><OrderStatusChip Status="o.Status" /></td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}

@code {
    [Parameter] public IReadOnlyList<PurchaseOrderSummaryDto> Orders { get; set; } = [];
    [Parameter] public string LinkPrefix { get; set; } = "purchasing/orders/";
}
