@page "/purchasing/requisitions/new"
@page "/purchasing/requisitions/{RequisitionId:guid}/edit"
@inject IRequisitionService Requisitions
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@(RequisitionId is null ? "New requisition" : "Edit requisition") · Purchasing · Workbench</PageTitle>

<PurchasingHeader Title="@(RequisitionId is null ? "New requisition" : $"Edit {_number}")" BackHref="purchasing/requisitions" BackLabel="Requisitions"
                  Subtitle="@($"Charge a project you're assigned to, or a GL account for your organization. Over {PurchasingFormat.Amount(_options?.FinanceThreshold ?? 0)}, Finance approves after the project manager.")" />

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else if (_options is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudPaper Outlined="true" Class="pa-4 mb-3">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="8">
                <MudTextField T="string" @bind-Value="_justification" Label="Justification" Required="true" Lines="2" data-testid="req-justification"
                              HelperText="Why it's needed and what it's for" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="Guid?" @bind-Value="_orgId" Label="Organization (for account lines)" Clearable="true">
                    @foreach (var o in _options.Orgs)
                    {
                        <MudSelectItem T="Guid?" Value="o.OrgUnitId">@o.Code · @o.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-4 mb-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.h6">Lines</MudText>
            <MudSpacer />
            <MudText Class="mr-4">Total <b>@PurchasingFormat.Amount(_lines.Sum(l => Extended(l)))</b></MudText>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _lines.Add(new LineModel { IsProject = _options.ChargeCodes.Count > 0 }))" data-testid="req-add-line">Add line</MudButton>
        </MudStack>
        @foreach (var line in _lines)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-2" data-testid="req-line">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" @bind-Value="line.Description" Label="Description" Margin="Margin.Dense" data-testid="req-line-description" />
                    </MudItem>
                    <MudItem xs="4" md="1">
                        <MudNumericField T="decimal" @bind-Value="line.Quantity" Label="Qty" Min="0" Margin="Margin.Dense" data-testid="req-line-qty" />
                    </MudItem>
                    <MudItem xs="4" md="2">
                        <MudNumericField T="decimal" @bind-Value="line.UnitCost" Label="Unit cost" Format="N2" Min="0" Margin="Margin.Dense" data-testid="req-line-cost" />
                    </MudItem>
                    <MudItem xs="4" md="2">
                        <MudDatePicker @bind-Date="line.NeededBy" Label="Needed by" DateFormat="yyyy-MM-dd" Editable="true" AutoClose="true" Clearable="true" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="10" md="2" Class="d-flex align-center">
                        <MudText>@PurchasingFormat.Amount(Extended(line))</MudText>
                    </MudItem>
                    <MudItem xs="2" md="1" Class="d-flex align-center">
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" aria-label="Remove line" OnClick="@(() => _lines.Remove(line))" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudSelect T="bool" @bind-Value="line.IsProject" Label="Charge to" Dense="true">
                            <MudSelectItem Value="true">Project</MudSelectItem>
                            <MudSelectItem Value="false">GL account</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    @if (line.IsProject)
                    {
                        <MudItem xs="12" md="4">
                            <MudSelect T="Guid?" @bind-Value="line.WbsElementId" Label="Project task (charge code)" Dense="true" data-testid="req-line-wbs">
                                @foreach (var c in _options.ChargeCodes)
                                {
                                    <MudSelectItem T="Guid?" Value="c.WbsElementId">@ChargeCodeText.Label(c.WbsCode, c.Name)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudSelect T="OdcCostType" @bind-Value="line.OdcType" Label="Cost type" Dense="true">
                                @foreach (var t in Enum.GetValues<OdcCostType>())
                                {
                                    <MudSelectItem Value="t">@t</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="12" md="6">
                            <MudSelect T="Guid?" @bind-Value="line.AccountId" Label="GL account" Dense="true" data-testid="req-line-account">
                                @foreach (var a in _options.Accounts)
                                {
                                    <MudSelectItem T="Guid?" Value="a.AccountId">@a.Number @a.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                    <MudItem xs="12" md="4">
                        <MudSelect T="Guid?" @bind-Value="line.SuggestedVendorId" Label="Suggested vendor" Dense="true" Clearable="true">
                            @foreach (var v in _options.Vendors)
                            {
                                <MudSelectItem T="Guid?" Value="v.VendorId">@v.Code · @v.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
        @if (_lines.Count == 0)
        {
            <MudText Class="mud-text-secondary">Add a line.</MudText>
        }
    </MudPaper>

    <MudStack Row="true" Spacing="2">
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" OnClick="@(() => SaveAsync(false))" Disabled="@(!CanSave)" data-testid="save-requisition">Save draft</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SaveAsync(true))" Disabled="@(!CanSave)" data-testid="submit-requisition">Save and submit</MudButton>
    </MudStack>
    @if (_saveError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-3" data-testid="requisition-error">@_saveError</MudAlert>
    }
}

@code {
    [Parameter] public Guid? RequisitionId { get; set; }

    private sealed class LineModel
    {
        public string? Description { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal UnitCost { get; set; }
        public bool IsProject { get; set; } = true;
        public Guid? WbsElementId { get; set; }
        public OdcCostType OdcType { get; set; } = OdcCostType.Materials;
        public Guid? AccountId { get; set; }
        public DateTime? NeededBy { get; set; }
        public Guid? SuggestedVendorId { get; set; }
    }

    private RequisitionOptionsDto? _options;
    private readonly List<LineModel> _lines = [];
    private string? _number;
    private string? _justification;
    private Guid? _orgId;
    private bool _saving;
    private string? _error;
    private string? _saveError;

    private bool CanSave => !_saving && !string.IsNullOrWhiteSpace(_justification) && _lines.Count > 0;

    private static decimal Extended(LineModel l) => Math.Round(l.Quantity * l.UnitCost, 2, MidpointRounding.AwayFromZero);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _options = await Requisitions.GetOptionsAsync();
            _orgId = _options.DefaultOrgUnitId;
            if (RequisitionId is { } id)
            {
                var req = await Requisitions.GetAsync(id);
                if (!req.CanEdit)
                {
                    Navigation.NavigateTo($"purchasing/requisitions/{id}", replace: true);
                    return;
                }

                (_number, _justification, _orgId) = (req.Requisition.Number, req.Requisition.Justification, req.OrgUnitId);
                _lines.AddRange(req.Lines.Select(l => new LineModel
                {
                    Description = l.Description, Quantity = l.Quantity, UnitCost = l.UnitCost, IsProject = l.WbsElementId is not null, WbsElementId = l.WbsElementId,
                    OdcType = l.OdcType ?? OdcCostType.Materials, AccountId = l.AccountId, NeededBy = l.NeededBy?.ToDateTime(TimeOnly.MinValue), SuggestedVendorId = l.SuggestedVendorId,
                }));
            }
            else
            {
                _lines.Add(new LineModel { IsProject = _options.ChargeCodes.Count > 0 });
            }
        }
        catch (Exception ex) when (PurchasingFormat.IsExpected(ex))
        {
            _error = PurchasingFormat.Error(ex);
        }
    }

    private async Task SaveAsync(bool submit)
    {
        _saving = true;
        _saveError = null;
        var request = new SaveRequisitionRequest(_justification ?? "", _lines.Select(l => new SaveRequisitionLineRequest(
            l.Description ?? "", l.Quantity, l.UnitCost,
            l.IsProject ? l.WbsElementId : null, l.IsProject ? l.OdcType : null,
            l.IsProject ? null : l.AccountId, null,
            PurchasingFormat.ToDateOnly(l.NeededBy), l.SuggestedVendorId)).ToList(), _orgId);
        try
        {
            var saved = RequisitionId is { } id ? await Requisitions.UpdateAsync(id, request) : await Requisitions.CreateAsync(request);
            RequisitionId ??= saved.Requisition.Id;
            _number = saved.Requisition.Number;
            if (submit)
            {
                saved = await Requisitions.SubmitAsync(saved.Requisition.Id);
                Snackbar.Add($"{saved.Requisition.Number} submitted for approval.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"{saved.Requisition.Number} saved as a draft.", Severity.Success);
            }

            Navigation.NavigateTo($"purchasing/requisitions/{saved.Requisition.Id}");
        }
        catch (Exception ex) when (PurchasingFormat.IsExpected(ex))
        {
            _saveError = PurchasingFormat.Error(ex);
        }
        finally
        {
            _saving = false;
        }
    }
}
