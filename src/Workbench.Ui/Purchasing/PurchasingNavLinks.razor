@* The Purchasing menu: everything for Finance and administrators; others see Bill approvals when bills wait on them. *@
@inject ICurrentUserContext UserContext
@inject IApBillService Bills
@inject IRequisitionService Requisitions
@inject IPurchaseOrderService Orders

@if (_finance)
{
    <MudNavGroup Title="Purchasing" Icon="@Icons.Material.Filled.ShoppingCart" data-testid="purchasing-nav">
        <MudNavLink Href="purchasing/bills" Icon="@Icons.Material.Filled.ReceiptLong">Bills</MudNavLink>
        <MudNavLink Href="purchasing/approvals" Icon="@Icons.Material.Filled.FactCheck">Bill approvals</MudNavLink>
        <MudNavLink Href="purchasing/payments" Icon="@Icons.Material.Filled.Payments">Payment runs</MudNavLink>
        <MudNavLink Href="purchasing/vendors" Icon="@Icons.Material.Filled.Storefront">Vendors</MudNavLink>
        <MudNavLink Href="purchasing/subcontracts" Icon="@Icons.Material.Filled.Handshake">Subcontracts</MudNavLink>
        <MudNavLink Href="purchasing/reports" Icon="@Icons.Material.Filled.Assessment">AP reports</MudNavLink>
        <MudNavLink Href="purchasing/requisitions" Icon="@Icons.Material.Filled.PostAdd">Requisitions@(_requisitionApprovals > 0 ? $" ({_requisitionApprovals})" : "")</MudNavLink>
        <MudNavLink Href="purchasing/orders" Icon="@Icons.Material.Filled.ShoppingBasket">Purchase orders</MudNavLink>
        <MudNavLink Href="purchasing/receiving" Icon="@Icons.Material.Filled.Inventory">Receiving</MudNavLink>
        <MudNavLink Href="purchasing/match-exceptions" Icon="@Icons.Material.Filled.CompareArrows">Match exceptions</MudNavLink>
    </MudNavGroup>
}
else
{
    @* Everyone can requisition; receivers named on an order can receive. *@
    <MudNavLink Href="purchasing/requisitions" Icon="@Icons.Material.Filled.PostAdd" data-testid="requisitions-nav">Requisitions@(_requisitionApprovals > 0 ? $" ({_requisitionApprovals})" : "")</MudNavLink>
    @if (_receivable > 0)
    {
        <MudNavLink Href="purchasing/receiving" Icon="@Icons.Material.Filled.Inventory">Receiving (@_receivable)</MudNavLink>
    }
}
@if (!_finance && _approvals > 0)
{
    <MudNavLink Href="purchasing/approvals" Icon="@Icons.Material.Filled.FactCheck">Bill approvals (@_approvals)</MudNavLink>
}

@code {
    private bool _finance;
    private int _approvals;
    private int _requisitionApprovals;
    private int _receivable;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _finance = (await UserContext.GetAsync()).IsFinance;
            if (!_finance)
            {
                _approvals = (await Bills.ListApprovalQueueAsync()).Count;
                _receivable = (await Orders.ListReceivableAsync()).Count;
            }

            _requisitionApprovals = (await Requisitions.ListApprovalQueueAsync()).Count;
        }
        catch (Exception ex) when (PurchasingFormat.IsExpected(ex))
        {
            _finance = false;
        }
    }
}
