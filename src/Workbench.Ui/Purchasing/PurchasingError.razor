@* Shown when a purchasing page can't load: explains who may use it when access is refused. *@
<MudAlert Severity="@(Forbidden ? Severity.Info : Severity.Error)" Class="mb-4" data-testid="load-error">
    @(Forbidden ? "Purchasing is for Finance and administrators. Project managers approve their bills under Purchasing › Bill approvals." : Message)
</MudAlert>

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool Forbidden { get; set; }
}
