<MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-1">@Title</MudText>
<MudSimpleTable Dense="true" Outlined="true" aria-label="@($"Headcount {Title.ToLowerInvariant()}")">
    <thead><tr><th scope="col">Group</th><th scope="col">Headcount</th><th scope="col">Full-time</th><th scope="col">Part-time</th><th scope="col">Other</th></tr></thead>
    <tbody>
        @foreach (var r in Rows)
        {
            <tr><th scope="row">@r.Group</th><td>@r.Headcount</td><td>@r.FullTime</td><td>@r.PartTime</td><td>@r.Other</td></tr>
        }
    </tbody>
</MudSimpleTable>

@code {
    [Parameter] public string Title { get; set; } = "";

    [Parameter] public IReadOnlyList<HeadcountRowDto> Rows { get; set; } = [];
}
