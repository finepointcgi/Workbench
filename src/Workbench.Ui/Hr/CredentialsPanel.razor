@inject IHrPersonnelService Personnel

<MudTable T="CredentialDto" Items="Credentials" Dense="true" aria-label="Education, certifications and clearances" Class="mb-3" data-testid="credentials">
    <HeaderContent>
        <MudTh>Kind</MudTh><MudTh>Name</MudTh><MudTh>Issuer</MudTh><MudTh>Issued</MudTh><MudTh>Expires</MudTh>@if (CanEdit) { <MudTh><span class="wb-sr-only">Actions</span></MudTh> }
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Kind">@HrLabels.Label(context.Kind)</MudTd>
        <MudTd DataLabel="Name">@context.Name@(context.ClearanceLevel is { } l ? $" ({HrLabels.Label(l)})" : "")</MudTd>
        <MudTd DataLabel="Issuer">@context.Issuer</MudTd>
        <MudTd DataLabel="Issued">@HrFormat.Date(context.IssuedOn)</MudTd>
        <MudTd DataLabel="Expires">
            @if (context.DaysToExpiry is <= 60)
            {
                <MudChip T="string" Size="Size.Small" Color="@(context.DaysToExpiry < 0 ? Color.Error : Color.Warning)" Icon="@Icons.Material.Filled.Warning" Class="ma-0">@HrFormat.Expiry(context.DaysToExpiry, context.ExpiresOn)</MudChip>
            }
            else
            {
                @HrFormat.Expiry(context.DaysToExpiry, context.ExpiresOn)
            }
        </MudTd>
        @if (CanEdit)
        {
            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@($"Remove {context.Name}")" OnClick="() => DeleteAsync(context)" /></MudTd>
        }
    </RowTemplate>
    <NoRecordsContent><MudText Class="mud-text-secondary">Nothing on file.</MudText></NoRecordsContent>
</MudTable>

@if (CanEdit)
{
    <MudPaper Outlined="true" Class="pa-4" Style="max-width:960px">
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Add education, a certification or a clearance</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                <MudSelect T="CredentialKind" @bind-Value="_kind" Label="Kind" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var k in Enum.GetValues<CredentialKind>())
                    {
                        <MudSelectItem T="CredentialKind" Value="k">@HrLabels.Label(k)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" autocomplete="off" data-testid="credential-name" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField @bind-Value="_issuer" Label="Issuer" Variant="Variant.Outlined" Margin="Margin.Dense" autocomplete="off" /></MudItem>
            @if (_kind == CredentialKind.SecurityClearance)
            {
                <MudItem xs="12" sm="4">
                    <MudSelect T="ClearanceLevel?" @bind-Value="_level" Label="Clearance level" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var l in Enum.GetValues<ClearanceLevel>())
                        {
                            <MudSelectItem T="ClearanceLevel?" Value="l">@HrLabels.Label(l)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="6" sm="4"><MudDatePicker @bind-Date="_issued" Editable="true" Label="Issued" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" sm="4"><MudDatePicker @bind-Date="_expires" Editable="true" Label="@(_kind == CredentialKind.SecurityClearance ? "Reinvestigation due" : "Expires")" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        </MudGrid>
        <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" Disabled="Busy" OnClick="AddAsync" data-testid="add-credential">Add</MudButton>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public Guid EmployeeId { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<CredentialDto> Credentials { get; set; } = [];

    [Parameter] public bool CanEdit { get; set; }

    [Parameter] public EventCallback Changed { get; set; }

    private CredentialKind _kind = CredentialKind.Certification;
    private string? _name;
    private string? _issuer;
    private ClearanceLevel? _level;
    private DateTime? _issued;
    private DateTime? _expires;

    private Task AddAsync() => RunAsync(async () =>
    {
        await Personnel.SaveCredentialAsync(EmployeeId, null, new SaveCredentialRequest(_kind, _name ?? "", _issuer, null,
            _kind == CredentialKind.SecurityClearance ? _level : null, HrFormat.ToDate(_issued), HrFormat.ToDate(_expires), null));
        (_name, _issuer, _level, _issued, _expires) = (null, null, null, null, null);
        await Changed.InvokeAsync();
    }, "Added");

    private Task DeleteAsync(CredentialDto c) => RunAsync(async () =>
    {
        await Personnel.DeleteCredentialAsync(c.Id);
        await Changed.InvokeAsync();
    }, $"Removed {c.Name}");
}
