@page "/hr"
@inject IHrPersonnelService Personnel
@inject IHrAccessService HrAccess
@inject NavigationManager Navigation

<PageTitle>People · Workbench</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4" HtmlTag="h1">People</MudText>
    <MudSpacer />
    <MudButton Href="hr/org-chart" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.AccountTree">Org chart</MudButton>
    <MudButton Href="hr/me" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Badge">My profile</MudButton>
</MudStack>
<MudText Class="mud-text-secondary mb-4">
    @(_access?.IsHr == true ? "Everyone's personnel record. Open a person to change their job, personal details, credentials and documents."
        : "The company directory. You see the job details of the people who report to you.")
</MudText>

@if (Error is not null)
{
    <MudAlert Severity="Severity.Warning">@Error</MudAlert>
}
else if (Loading)
{
    <MudProgressLinear aria-label="Loading" Indeterminate="true" />
}
else
{
    <ConfigurableList T="EmployeeSummaryDto" Definition="_definition" Items="_people" ShowSearch="false" TestId="people" AriaLabel="People" Elevation="0" Outlined="true"
                      RowClick="@(p => Navigation.NavigateTo($"hr/employees/{p.EmployeeId}"))">
        <ToolBarContent>
            <MudTextField T="string" Value="_search" ValueChanged="SearchAsync" Immediate="true" DebounceInterval="300" Label="Search name, number, title or email"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width:360px"
                          autocomplete="off" data-testid="people-search" />
            @if (_access?.IsHr == true)
            {
                <MudSwitch T="bool" Value="_includeTerminated" ValueChanged="TerminatedChangedAsync" Color="Color.Primary" Label="Include former employees" />
            }
        </ToolBarContent>
        <NoRecordsContent><MudText Class="mud-text-secondary">No one matches.</MudText></NoRecordsContent>
    </ConfigurableList>
}

@code {
    private IReadOnlyList<EmployeeSummaryDto> _people = [];

    internal static readonly ListDefinition<EmployeeSummaryDto> _definition = new()
    {
        ListKey = CustomizableLists.People,
        EntityType = CustomizableEntities.Employee,
        Title = "People",
        Id = p => p.EmployeeId,
        Columns =
        [
            new() { Key = "name", Title = "Name", Value = p => p.DisplayName, Groupable = false, Cell = p => @<a href="@($"hr/employees/{p.EmployeeId}")">@p.DisplayName</a> },
            new() { Key = "number", Title = "Number", Value = p => p.EmployeeNumber, Groupable = false },
            new() { Key = "title", Title = "Title", Value = p => p.JobTitle },
            new() { Key = "orgUnit", Title = "Org unit", Value = p => p.OrgUnitName },
            new() { Key = "supervisor", Title = "Supervisor", Value = p => p.SupervisorName },
            new() { Key = "status", Title = "Status", Value = p => p.Status, Display = p => HrLabels.Label(p.Status),
                    Cell = p => @<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@HrFormat.Color(p.Status)" Class="ma-0">@HrLabels.Label(p.Status)</MudChip> },
            new() { Key = "hired", Title = "Hired", Value = p => p.HireDate, Kind = ListColumnKind.Date, Groupable = false, Display = p => HrFormat.Date(p.HireDate) },
            new() { Key = "email", Title = "Email", Value = p => p.Email, Standard = false, Groupable = false },
            new() { Key = "terminated", Title = "Left", Value = p => p.TerminationDate, Kind = ListColumnKind.Date, Standard = false, Groupable = false, PermissionKey = "hr.records.manage" },
        ],
    };
    private HrAccessDto? _access;
    private string _search = "";
    private bool _includeTerminated;

    protected override Task OnInitializedAsync() => LoadAsync(async () =>
    {
        _access = await HrAccess.GetAsync();
        await ReloadAsync();
    });

    private async Task ReloadAsync() => _people = await Personnel.ListAsync(new EmployeeQuery(_search, _includeTerminated));

    private async Task SearchAsync(string value)
    {
        _search = value;
        await RunAsync(ReloadAsync);
    }

    private async Task TerminatedChangedAsync(bool value)
    {
        _includeTerminated = value;
        await RunAsync(ReloadAsync);
    }
}
