@* Admin: connect a Teams or Slack channel so people can have their notifications posted there. The address is a secret: it is never shown again, only its host. *@
@using Workbench.Contracts.Notifications
@inject IServiceProvider Services
@inject ISnackbar Snackbar

<MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-1">@Name notifications</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
    Post people's Workbench notifications (approvals waiting, decisions, assignments) to a @Name channel. Each person chooses what they want
    on their Notifications page. This is separate from the event connector under Connectors.
</MudText>

@if (_channel is null)
{
    <MudProgressLinear aria-label="Loading" Indeterminate="true" />
}
else
{
    @if (_channel.Connected)
    {
        <MudAlert Severity="@(_channel.LastError is null ? Severity.Success : Severity.Warning)" Variant="Variant.Outlined" Class="mb-3" data-testid="@($"{Kind}-status")">
            Connected to <strong>@_channel.Host</strong>.
            @if (_channel.LastError is not null)
            {
                <span> The last message didn't go through: @_channel.LastError</span>
            }
            else if (_channel.LastPostedAtUtc is { } at)
            {
                <span> Last message sent @at.ToString("MMM d, HH:mm") UTC.</span>
            }
        </MudAlert>
    }

    <MudStack Spacing="2" Style="max-width:700px">
        <MudTextField T="string" @bind-Value="_url" Label="@(_channel.Connected ? "Replace the channel address" : "Channel address")" Variant="Variant.Outlined" Margin="Margin.Dense"
                      InputType="InputType.Password" Placeholder="https://…" AutoComplete="off"
                      HelperText="@Help" data-testid="@($"{Kind}-url")" />
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy || string.IsNullOrWhiteSpace(_url)" OnClick="ConnectAsync" data-testid="@($"{Kind}-connect")">
                @(_channel.Connected ? "Save address" : "Connect")
            </MudButton>
            @if (_channel.Connected)
            {
                <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="TestAsync" data-testid="@($"{Kind}-test")">Post a test message</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="_busy" OnClick="DisconnectAsync" data-testid="@($"{Kind}-disconnect")">Disconnect</MudButton>
            }
        </MudStack>
    </MudStack>
}

@code {
    /// <summary>The chat product to connect: <see cref="ChatChannelKinds.Teams"/> or <see cref="ChatChannelKinds.Slack"/>.</summary>
    [Parameter, EditorRequired]
    public string Kind { get; set; } = ChatChannelKinds.Teams;

    private IChatNotificationService Chat => (IChatNotificationService)Services.GetService(Kind == ChatChannelKinds.Slack ? typeof(ISlackNotificationService) : typeof(ITeamsNotificationService))!;

    private string Name => Kind == ChatChannelKinds.Slack ? "Slack" : "Teams";

    private string Help => Kind == ChatChannelKinds.Slack
        ? "In Slack, create an app at api.slack.com/apps, turn on Incoming Webhooks, add a webhook for the channel and paste its address (it starts with https://hooks.slack.com/)."
        : "In Teams, open the channel, choose Workflows and add \"Post to a channel when a webhook request is received\". Paste the web address it gives you.";

    private ChatChannelDto? _channel;
    private string? _url;
    private bool _busy;

    protected override Task OnInitializedAsync() => RunAsync(async () => _channel = await Chat.GetChannelAsync());

    private Task ConnectAsync() => RunAsync(async () =>
    {
        _channel = await Chat.ConnectAsync(new ConnectChatChannelRequest(_url ?? ""));
        _url = null;
        Snackbar.Add($"{Name} channel connected. Post a test message to check it.", Severity.Success);
    });

    private Task TestAsync() => RunAsync(async () =>
    {
        _channel = await Chat.SendTestAsync();
        Snackbar.Add(_channel.LastError is null ? "Test message sent. Check the channel." : "The test message didn't go through.", _channel.LastError is null ? Severity.Success : Severity.Warning);
    });

    private Task DisconnectAsync() => RunAsync(async () =>
    {
        await Chat.DisconnectAsync();
        _channel = await Chat.GetChannelAsync();
        Snackbar.Add($"{Name} channel disconnected.", Severity.Info);
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is HttpRequestException or ArgumentException or UnauthorizedAccessException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
