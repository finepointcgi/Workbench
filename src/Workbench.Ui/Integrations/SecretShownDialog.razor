@* Shows a webhook signing secret or an API key once, with a copy button. It can't be shown again. *@
@inject IJSRuntime JS

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6" HtmlTag="h2">@Title</MudText></TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            Copy it now and keep it somewhere safe, such as a password vault. Workbench won't show it again.
        </MudAlert>
        <MudText Class="mb-2">@Explanation</MudText>
        <MudTextField T="string" Value="Secret" ReadOnly="true" Label="@Label" Variant="Variant.Outlined" data-testid="secret-value"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy" OnAdornmentClick="CopyAsync" AdornmentAriaLabel="@($"Copy {Label.ToLowerInvariant()}")" />
        <div role="status" class="wb-sr-only">@_status</div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => MudDialog.Close()" data-testid="secret-done">I've copied it</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Label { get; set; } = "Secret";
    [Parameter] public string Explanation { get; set; } = "";
    [Parameter] public string Secret { get; set; } = "";

    private string? _status;

    private async Task CopyAsync()
    {
        try
        {
            _status = await IntegrationFormat.CopyAsync(JS, Secret) ? "Copied." : "Couldn't copy; select the text and copy it yourself.";
        }
        catch (JSException)
        {
            _status = "Couldn't copy; select the text and copy it yourself.";
        }
    }
}
