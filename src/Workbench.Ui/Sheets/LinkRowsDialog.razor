@* Picks the rows of the linked sheet a link cell points at. *@
@inject ISheetLinkService Links
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_column is null)
        {
            <MudProgressLinear Indeterminate="true" aria-label="Loading" />
        }
        else if (!_column.CanSee)
        {
            <MudAlert Severity="Severity.Info">This column links to a sheet you don't have access to, so you can't change its links.</MudAlert>
        }
        else
        {
            <MudStack Spacing="2">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Rows of <strong>@_column.TargetSheetName</strong></MudText>
                <MudTextField T="string" @bind-Value="_search" Placeholder="Search rows" Immediate="true" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" aria-label="Search rows" AutoFocus="true" data-testid="link-search" />
                <div style="max-height: 360px; overflow: auto" role="group" aria-label="Rows to link">
                    @foreach (var row in Visible)
                    {
                        <MudCheckBox T="bool" Value="_picked.Contains(row.Id)" ValueChanged="(bool on) => Toggle(row.Id, on)" Label="@row.Title" Dense="true" />
                    }
                    @if (!Visible.Any())
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-2">No rows match.</MudText>
                    }
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@_picked.Count selected</MudText>
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        @if (_column?.CanSee == true)
        {
            <MudButton OnClick="Clear" Disabled="_picked.Count == 0">Clear</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" data-testid="save-links">Save</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public Guid SheetId { get; set; }
    [Parameter, EditorRequired] public Guid ColumnId { get; set; }
    [Parameter] public string? Raw { get; set; }

    private LinkColumnDto? _column;
    private readonly List<Guid> _picked = [];
    private string? _search;

    private IEnumerable<LinkableRowDto> Visible => (_column?.Rows ?? [])
        .Where(r => string.IsNullOrWhiteSpace(_search) || r.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) || _picked.Contains(r.Id))
        .Take(300);

    /// <summary>Opens the picker; returns the new cell value ("" to clear), or null when cancelled.</summary>
    public static async Task<string?> PickAsync(IDialogService dialogs, Guid sheetId, ColumnDto column, string? raw)
    {
        var dialog = await dialogs.ShowAsync<LinkRowsDialog>($"Link {column.Name}",
            new DialogParameters<LinkRowsDialog> { { d => d.SheetId, sheetId }, { d => d.ColumnId, column.Id }, { d => d.Raw, raw } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        return await dialog.Result is { Canceled: false, Data: string value } ? value : null;
    }

    protected override async Task OnInitializedAsync()
    {
        _picked.AddRange((Raw ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(p => Guid.TryParse(p, out var id) ? id : Guid.Empty).Where(id => id != Guid.Empty));
        try
        {
            _column = (await Links.GetAsync(SheetId)).For(ColumnId) ?? new LinkColumnDto(ColumnId, Guid.Empty, null, false, []);
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException or Workbench.Contracts.WorkbenchNotFoundException)
        {
            Snackbar.Add($"Couldn't load the linked sheet: {ex.Message}", Severity.Error);
            _column = new LinkColumnDto(ColumnId, Guid.Empty, null, false, []);
        }
    }

    private void Toggle(Guid id, bool on)
    {
        _picked.Remove(id);
        if (on)
        {
            _picked.Add(id);
        }
    }

    private void Clear() => MudDialog.Close(DialogResult.Ok(""));

    private void Save() => MudDialog.Close(DialogResult.Ok(string.Join(",", _picked)));
}
