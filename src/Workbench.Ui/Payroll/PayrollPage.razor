@page "/payroll"
@inject IPayGroupService PayGroups
@inject IPayrollProfileService Profiles
@inject IPayrollProviderService Providers
@inject IPayrollRunService Runs
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Payroll · Workbench</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h4" HtmlTag="h1">Payroll</MudText>
</MudStack>
<MudText Class="mud-text-secondary mb-4">
    Hours go to the payroll provider from approved timesheets only; the provider calculates taxes. Import its register to
    reconcile and post the payroll journal.
</MudText>

@if (_forbidden)
{
    <Workbench.Ui.Identity.ForbiddenNotice Title="Payroll is for Finance and administrators" Message="@_error" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Warning">@_error</MudAlert>
}
else if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4" @bind-ActivePanelIndex="_tab">
        <MudTabPanel Text="Runs" data-testid="tab-runs">
            <MudPaper Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Run payroll</MudText>
                <MudStack Row="true" Spacing="3" AlignItems="AlignItems.End" Wrap="Wrap.Wrap">
                    <MudSelect T="Guid?" Value="_groupId" ValueChanged="GroupChangedAsync" Label="Pay group" Dense="true" Variant="Variant.Outlined" Style="min-width:240px" data-testid="run-group">
                        @foreach (var g in _groups.Where(g => g.IsActive))
                        {
                            <MudSelectItem T="Guid?" Value="g.Id">@g.Code · @g.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="Guid?" @bind-Value="_periodId" Label="Pay period" Dense="true" Variant="Variant.Outlined" Style="min-width:320px" data-testid="run-period">
                        @foreach (var p in _periods)
                        {
                            <MudSelectItem T="Guid?" Value="p.Id">@PayrollFormat.Range(p.Start, p.End) · check @p.CheckDate.ToString("MMM d", CultureInfo.InvariantCulture)@(p.RunState is { } s ? $" · {PayrollFormat.Label(s)}" : "")</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_groupId is null || _periodId is null || _busy)" OnClick="StartAsync"
                               StartIcon="@Icons.Material.Filled.PlayArrow" data-testid="start-run">Open run</MudButton>
                </MudStack>
            </MudPaper>
            <MudTable T="PayrollRunDto" Items="_runs" Dense="true" Hover="true" RowStyle="cursor:pointer" OnRowClick="@(e => Navigation.NavigateTo($"payroll/runs/{e.Item!.Id}"))" data-testid="runs">
                <HeaderContent>
                    <MudTh>Pay group</MudTh><MudTh>Period</MudTh><MudTh>Check date</MudTh><MudTh>Status</MudTh><MudTh Style="text-align:right">Register gross</MudTh><MudTh>Journal</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.PayGroupCode</MudTd>
                    <MudTd><MudLink Href="@($"payroll/runs/{context.Id}")">@PayrollFormat.Range(context.PeriodStart, context.PeriodEnd)</MudLink></MudTd>
                    <MudTd>@PayrollFormat.Date(context.CheckDate)</MudTd>
                    <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@PayrollFormat.Color(context.Status)" Class="ma-0">@PayrollFormat.Label(context.Status)</MudChip></MudTd>
                    <MudTd Style="text-align:right">@PayrollFormat.Money(context.RegisterGross)</MudTd>
                    <MudTd>@context.JournalNumber</MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Class="mud-text-secondary">No payroll runs yet. Start one to send approved hours to your payroll provider.</MudText></NoRecordsContent>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Pay groups" data-testid="tab-groups">
            <MudTable T="PayGroupDto" Items="_groups" Dense="true" Class="mb-4">
                <HeaderContent>
                    <MudTh>Code</MudTh><MudTh>Name</MudTh><MudTh>Frequency</MudTh><MudTh>Provider</MudTh><MudTh>Company code</MudTh><MudTh>Anchor</MudTh><MudTh>Check date</MudTh><MudTh>Employees</MudTh><MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Code</MudTd>
                    <MudTd>@context.Name@(context.IsActive ? "" : " (inactive)")</MudTd>
                    <MudTd>@PayrollFormat.Label(context.Frequency)</MudTd>
                    <MudTd>@context.ProviderName</MudTd>
                    <MudTd>@context.CompanyCode</MudTd>
                    <MudTd>@PayrollFormat.Date(context.AnchorDate)</MudTd>
                    <MudTd>+@context.CheckDateOffsetDays days</MudTd>
                    <MudTd>@context.EmployeeCount</MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => GenerateAsync(context)">Generate @(DateTime.Today.Year + 1)</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => SyncAsync(context)">Sync employees</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
            <MudPaper Outlined="true" Class="pa-4" Style="max-width:900px">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">New pay group</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="3"><MudTextField @bind-Value="_newGroup.Code" Label="Code" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" sm="5"><MudTextField @bind-Value="_newGroup.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="PayFrequencyKind" @bind-Value="_newGroup.Frequency" Label="Frequency" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var f in Enum.GetValues<PayFrequencyKind>())
                            {
                                <MudSelectItem T="PayFrequencyKind" Value="f">@PayrollFormat.Label(f)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" @bind-Value="_newGroup.Provider" Label="Provider" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var p in _providers)
                            {
                                <MudSelectItem T="string" Value="p.Key" Disabled="!p.IsSupported">@p.Name@(p.IsSupported ? "" : " (coming soon)")</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="3"><MudTextField @bind-Value="_newGroup.CompanyCode" Label="Company code" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" sm="3"><MudDatePicker @bind-Date="_newGroup.Anchor" Label="First day of a period" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" sm="2"><MudNumericField @bind-Value="_newGroup.Offset" Label="Check +days" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="31" /></MudItem>
                </MudGrid>
                <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateGroupAsync" Disabled="_busy">Create pay group</MudButton>
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="Employee profiles" data-testid="tab-profiles">
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">Pay rates are what employees are paid, not the cost rates projects are charged. They're masked; revealing one is recorded in the security log.</MudAlert>
            <MudTable T="PayProfileDto" Items="_profiles" Dense="true" data-testid="profiles">
                <HeaderContent>
                    <MudTh>Employee</MudTh><MudTh>Exempt</MudTh><MudTh>Pay group</MudTh><MudTh>Provider id</MudTh><MudTh>Pay type</MudTh><MudTh>Pay rate</MudTh><MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.EmployeeName <span class="mud-text-secondary">@context.EmployeeNumber</span></MudTd>
                    <MudTd>@(context.IsExempt ? "Exempt" : "Non-exempt")</MudTd>
                    <MudTd>@(context.PayGroupCode ?? "—")</MudTd>
                    <MudTd>@context.ProviderEmployeeId</MudTd>
                    <MudTd>@(context.HasProfile ? context.PayType.ToString() : "—")</MudTd>
                    <MudTd data-testid="@($"rate-{context.EmployeeNumber}")">
                        @if (_revealed.TryGetValue(context.EmployeeId, out var r))
                        {
                            @(r.PayType == PayTypeKind.Salaried ? $"{PayrollFormat.Money(r.AnnualSalary)} / yr" : $"{PayrollFormat.Money(r.HourlyRate)} / h")
                        }
                        else if (context.HasRate)
                        {
                            <span>•••••</span>
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" aria-label="Reveal pay rate" OnClick="() => RevealAsync(context)" />
                        }
                        else
                        {
                            <span class="mud-text-secondary">none</span>
                        }
                    </MudTd>
                    <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => EditProfileAsync(context)">Edit</MudButton></MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Providers" data-testid="tab-providers">
            <MudGrid>
                @foreach (var p in _providers)
                {
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Outlined="true" Class="pa-4" data-provider="@p.Key">
                            <MudText Typo="Typo.subtitle1"><b>@p.Name</b></MudText>
                            <MudChip T="string" Size="Size.Small" Color="@(p.IsSupported ? Color.Success : Color.Default)" Variant="Variant.Outlined" Class="ml-0">@p.Status</MudChip>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
            @if (_settings is not null)
            {
                <MudPaper Outlined="true" Class="pa-4 mt-4" Style="max-width:720px">
                    <MudText Typo="Typo.h6" HtmlTag="h2">Paylocity earning codes</MudText>
                    <MudText Class="mud-text-secondary mb-3">REG and OT, plus each leave charge code, map to a Paylocity earning (Det) code in the hours import.</MudText>
                    @foreach (var row in _mappings)
                    {
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-1">
                            <MudTextField @bind-Value="row.Category" Label="Workbench" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:220px" />
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                            <MudTextField @bind-Value="row.Code" Label="Earning code" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:160px" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="Remove" OnClick="() => _mappings.Remove(row)" />
                        </MudStack>
                    }
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="() => _mappings.Add(new MappingRow())">Add mapping</MudButton>
                    <MudSwitch T="bool" @bind-Value="_exportSalariedRegular" Label="Export salaried employees' regular hours (off: Paylocity pays their salary)" Color="Color.Primary" Class="mt-2" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="SaveSettingsAsync" Disabled="_busy">Save earning codes</MudButton>
                </MudPaper>
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    private IReadOnlyList<PayGroupDto> _groups = [];
    private IReadOnlyList<PayPeriodDto> _periods = [];
    private IReadOnlyList<PayrollRunDto> _runs = [];
    private IReadOnlyList<PayProfileDto> _profiles = [];
    private IReadOnlyList<PayrollProviderDto> _providers = [];
    private readonly Dictionary<Guid, PayProfileDto> _revealed = [];
    private PayrollProviderSettingsDto? _settings;
    private List<MappingRow> _mappings = [];
    private bool _exportSalariedRegular;
    private Guid? _groupId;
    private Guid? _periodId;
    private int _tab;
    private bool _loading = true;
    private bool _busy;
    private bool _forbidden;
    private string? _error;
    private readonly NewGroup _newGroup = new();

    private sealed class MappingRow
    {
        public string Category { get; set; } = "";
        public string Code { get; set; } = "";
    }

    private sealed class NewGroup
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public PayFrequencyKind Frequency { get; set; } = PayFrequencyKind.Biweekly;
        public string Provider { get; set; } = "paylocity";
        public string CompanyCode { get; set; } = "";
        public DateTime? Anchor { get; set; } = DateTime.Today;
        public int Offset { get; set; } = 5;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadAsync();
            _groupId = _groups.FirstOrDefault(g => g.IsActive)?.Id;
            await LoadPeriodsAsync();
        }
        catch (Exception ex) when (PayrollFormat.IsExpected(ex))
        {
            (_error, _forbidden) = (PayrollFormat.Error(ex), PayrollFormat.IsForbidden(ex));
        }

        _loading = false;
    }

    private async Task ReloadAsync()
    {
        _groups = await PayGroups.ListAsync();
        _runs = await Runs.ListAsync();
        _profiles = await Profiles.ListAsync();
        _providers = await Providers.ListProvidersAsync();
        _settings = await Providers.GetSettingsAsync("paylocity");
        _mappings = _settings.EarningCodes.Select(m => new MappingRow { Category = m.Category, Code = m.EarningCode }).ToList();
        _exportSalariedRegular = _settings.ExportSalariedRegularHours;
    }

    private async Task GroupChangedAsync(Guid? id)
    {
        _groupId = id;
        await LoadPeriodsAsync();
    }

    /// <summary>Periods around today; the default is the latest period that has ended.</summary>
    private async Task LoadPeriodsAsync()
    {
        _periods = [];
        _periodId = null;
        if (_groupId is not { } id)
        {
            return;
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        var all = await PayGroups.ListPeriodsAsync(id);
        _periods = all.Where(p => p.Start <= today.AddDays(45) && p.End >= today.AddDays(-200)).OrderByDescending(p => p.Start).ToList();
        _periodId = _periods.FirstOrDefault(p => p.End < today)?.Id ?? _periods.FirstOrDefault()?.Id;
    }

    private async Task StartAsync()
    {
        await RunAsync(async () =>
        {
            var run = await Runs.StartAsync(_groupId!.Value, _periodId!.Value);
            Navigation.NavigateTo($"payroll/runs/{run.Id}");
        });
    }

    private async Task GenerateAsync(PayGroupDto group)
    {
        await RunAsync(async () =>
        {
            var added = await PayGroups.GeneratePeriodsAsync(group.Id, DateTime.Today.Year + 1);
            Snackbar.Add(added == 0 ? "Those periods already exist." : $"{added} pay periods added.", Severity.Success);
            await LoadPeriodsAsync();
        });
    }

    private async Task SyncAsync(PayGroupDto group)
    {
        await RunAsync(async () =>
        {
            var result = await Providers.SyncEmployeesAsync(group.Id, dryRun: true);
            Snackbar.Add($"Dry run: {string.Join(", ", result.Items.GroupBy(i => i.Action).Select(g => $"{g.Count()} {g.Key.ToString().ToLowerInvariant()}"))}. "
                + (_providers.Any(p => p.Key == group.ProviderKey && p.ApiConfigured) ? "" : "Configure Payroll:Paylocity API credentials to sync."), Severity.Info);
        });
    }

    private async Task CreateGroupAsync()
    {
        await RunAsync(async () =>
        {
            await PayGroups.CreateAsync(new SavePayGroupRequest(_newGroup.Code, _newGroup.Name, _newGroup.Frequency, _newGroup.Provider, _newGroup.CompanyCode,
                DateOnly.FromDateTime(_newGroup.Anchor ?? DateTime.Today), _newGroup.Offset));
            _groups = await PayGroups.ListAsync();
            Snackbar.Add("Pay group created. Generate its pay periods next.", Severity.Success);
        });
    }

    private async Task RevealAsync(PayProfileDto profile)
    {
        await RunAsync(async () => _revealed[profile.EmployeeId] = await Profiles.RevealAsync(profile.EmployeeId));
    }

    private async Task EditProfileAsync(PayProfileDto profile)
    {
        var parameters = new DialogParameters<PayProfileDialog> { { x => x.Profile, profile }, { x => x.Groups, _groups } };
        var dialog = await DialogService.ShowAsync<PayProfileDialog>($"Payroll profile · {profile.EmployeeName}", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
        {
            _revealed.Remove(profile.EmployeeId);
            _profiles = await Profiles.ListAsync();
        }
    }

    private async Task SaveSettingsAsync()
    {
        await RunAsync(async () =>
        {
            _settings = await Providers.SaveSettingsAsync("paylocity", new SavePayrollProviderSettingsRequest(
                _mappings.Where(m => m.Category.Length > 0).Select(m => new EarningCodeMapping(m.Category, m.Code)).ToList(), _exportSalariedRegular));
            Snackbar.Add("Earning codes saved.", Severity.Success);
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
        }
        catch (Exception ex) when (PayrollFormat.IsExpected(ex))
        {
            Snackbar.Add(PayrollFormat.Error(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
