@* Where the current page sits in the menu (Finance › Payables & purchasing › Bills › Bill), for nested and detail
   pages. Built from NavCatalog, so pages don't each repeat it. Pages that draw their own breadcrumbs are skipped. *@
@implements IDisposable
@inject NavigationManager Navigation

@if (_items.Count > 0)
{
    <AccessibleBreadcrumbs Items="_items" Class="px-0 pt-0 pb-2" TestId="page-breadcrumbs" />
}

@code {
    // These draw their own breadcrumbs or own their header (project pages belong to the Projects hub).
    private static readonly string[] OwnBreadcrumbs = ["expenses/", "payroll/runs/", "projects/"];

    [Parameter] public NavAccess Access { get; set; } = NavAccess.Anonymous;

    private List<BreadcrumbItem> _items = [];

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    protected override void OnParametersSet() => _items = Build(Navigation.ToBaseRelativePath(Navigation.Uri), Access);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(() =>
        {
            _items = Build(Navigation.ToBaseRelativePath(e.Location), Access);
            StateHasChanged();
        });

    /// <summary>The trail for <paramref name="relativePath"/>, or nothing for top-level pages.</summary>
    public static List<BreadcrumbItem> Build(string relativePath, NavAccess access)
    {
        var path = string.Join('/', NavCatalog.Segments(relativePath));
        if (path.Length == 0 || path == "m" || path.StartsWith("m/", StringComparison.Ordinal) || path.EndsWith("/print", StringComparison.Ordinal)
            || OwnBreadcrumbs.Any(p => path.StartsWith(p, StringComparison.OrdinalIgnoreCase)))
        {
            return [];
        }

        if (NavCatalog.Match(path, access) is not var (entry, tail) || entry.Href.Length == 0)
        {
            return [];
        }

        // A group's own pages show its tabs (GroupTabs), which say where you are; the trail would repeat them.
        if (tail.Length == 0 && NavCatalog.GroupPages(entry, access).Count > 1)
        {
            return [];
        }

        var nested = entry.Group is not null || entry.Section is NavCatalog.Finance or NavCatalog.Admin;
        if (tail.Length == 0 && !nested)
        {
            return [];
        }

        var section = NavCatalog.Sections.First(s => s.Key == entry.Section);
        var sectionTitle = NavCatalog.TitleFor(section, access);
        var items = new List<BreadcrumbItem> { new(sectionTitle, section.Href, disabled: section.Href is null) };
        if (entry.Group is not null && entry.Group != entry.Title && entry.Group != sectionTitle)
        {
            items.Add(new BreadcrumbItem(entry.Group, null, disabled: true));
        }

        if (entry.Title != sectionTitle || tail.Length > 0)
        {
            items.Add(new BreadcrumbItem(entry.Title, entry.Href, disabled: tail.Length == 0));
        }

        if (tail.Length > 0)
        {
            items.Add(new BreadcrumbItem(DetailLabel(entry, tail), null, disabled: true));
        }

        return items;
    }

    private static string DetailLabel(NavEntry entry, string[] tail)
    {
        var noun = entry.Detail ?? "Details";
        var newAt = Array.FindIndex(tail, t => t.Equals("new", StringComparison.OrdinalIgnoreCase));
        if (newAt == 0)
        {
            return entry.Detail is null ? "New" : $"New {noun.ToLowerInvariant()}";
        }

        // Something new inside a record (sheets/{id}/automations/new): name what's being added, not the record.
        if (newAt > 0)
        {
            var what = tail[newAt - 1].Replace('-', ' ');
            return $"New {(what.EndsWith('s') ? what[..^1] : what)}";
        }

        var edit = tail[^1].Equals("edit", StringComparison.OrdinalIgnoreCase);
        return edit ? $"Edit {noun.ToLowerInvariant()}" : noun;
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
