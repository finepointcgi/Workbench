@* The app-bar search button and the Ctrl+K / Cmd+K shortcut that open the command palette. It also remembers the
   pages visited on this device, for the palette's Recent results. *@
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Search" OnClick="OpenAsync"
           Class="wb-palette-button mr-1" Style="text-transform:none" aria-label="@($"Search ({_shortcut})")" aria-keyshortcuts="Control+K Meta+K" data-testid="palette-button">
    <span class="d-none d-sm-inline">Search</span>
    <kbd class="d-none d-md-inline ml-2 mud-text-secondary" style="font-size:0.75rem;border:1px solid currentColor;border-radius:4px;padding:0 4px;opacity:.8">@_shortcut</kbd>
</MudButton>

@code {
    [Parameter] public NavAccess Access { get; set; } = NavAccess.Anonymous;

    /// <summary>Raised with the question when the user picks "Ask the assistant" in the palette.</summary>
    [Parameter] public EventCallback<string> Ask { get; set; }

    /// <summary>Raised with the <see cref="NewAction"/> key when the user picks a "New …" item.</summary>
    [Parameter] public EventCallback<string> Create { get; set; }

    private IJSObjectReference? _module;
    private DotNetObjectReference<CommandPalette>? _self;
    private string _shortcut = "Ctrl K";
    private bool _open;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Workbench.Ui/navigation.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("registerShortcut", _self);
            if (await _module.InvokeAsync<bool>("isMac"))
            {
                _shortcut = "⌘K";
                StateHasChanged();
            }

            Navigation.LocationChanged += OnLocationChanged;
            await RecordAsync(Navigation.Uri);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // No shortcut or recent items; the search button still works.
        }
    }

    [JSInvokable]
    public Task OpenFromShortcut() => InvokeAsync(OpenAsync);

    private async Task OpenAsync()
    {
        if (_open)
        {
            return;
        }

        _open = true;
        try
        {
            var parameters = new DialogParameters<CommandPaletteDialog>
            {
                { d => d.Access, Access },
                { d => d.Recent, await RecentAsync() },
            };
            var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true, CloseOnEscapeKey = true, Position = DialogPosition.TopCenter };
            var dialog = await Dialogs.ShowAsync<CommandPaletteDialog>("Search", parameters, options);
            var result = await dialog.Result;
            if (result is { Canceled: false, Data: PaletteItem { Kind: PaletteKind.Ask, Keywords: { } question } })
            {
                _open = false;
                await Ask.InvokeAsync(question);
            }
            else if (result is { Canceled: false, Data: PaletteItem { Kind: PaletteKind.Create, Action: { } key } })
            {
                _open = false;
                await Create.InvokeAsync(key);
            }
        }
        finally
        {
            _open = false;
        }
    }

    private async Task<IReadOnlyList<PaletteItem>> RecentAsync()
    {
        if (_module is null)
        {
            return [];
        }

        try
        {
            var visits = await _module.InvokeAsync<RecentVisit[]>("getRecent");
            return visits
                .Where(v => !string.IsNullOrWhiteSpace(v.Href) && Uri.IsWellFormedUriString(v.Href, UriKind.Relative) && !v.Href.Contains("//"))
                .Select(v => new PaletteItem(PaletteKind.Recent, v.Title, v.Href, PaletteSearch.IconFor(PaletteKind.Recent), "Recently opened"))
                .ToList();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
            return [];
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(() => RecordAsync(e.Location));

    private async Task RecordAsync(string uri)
    {
        var href = Navigation.ToBaseRelativePath(uri);
        if (_module is null || href.Length == 0 || href == "m" || href.StartsWith("m/", StringComparison.Ordinal))
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("recordVisit", href);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
        }
    }

    private sealed record RecentVisit(string Href, string Title);

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unregisterShortcut");
                await _module.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
            {
            }
        }

        _self?.Dispose();
    }
}
