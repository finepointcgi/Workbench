@* Creates or changes a recurring journal: its schedule, what it creates, and its lines (fixed amounts or percentages of a base amount). *@
@inject IRecurringJournalService Recurring

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="5"><MudTextField T="string" @bind-Value="_name" Label="Name" Required="true" Immediate="true" AutoFocus="true" /></MudItem>
                <MudItem xs="12" sm="7"><MudTextField T="string" @bind-Value="_description" Label="Entry description" Required="true" Immediate="true" HelperText="Each entry adds its month, e.g. “(Oct 2026)”." /></MudItem>
                <MudItem xs="6" sm="3">
                    <MudSelect T="RecurrenceKind" @bind-Value="_frequency" Label="Repeats" Dense="true">
                        @foreach (var f in Enum.GetValues<RecurrenceKind>())
                        {
                            <MudSelectItem T="RecurrenceKind" Value="f">@PlanningFormat.Label(f)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudSelect T="RecurringDay" @bind-Value="_day" Label="Dated on the" Dense="true">
                        <MudSelectItem T="RecurringDay" Value="RecurringDay.FirstDay">First day of the month</MudSelectItem>
                        <MudSelectItem T="RecurringDay" Value="RecurringDay.LastDay">Last day of the month</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="3"><MudDatePicker Label="Starting" @bind-Date="_start" DateFormat="yyyy-MM-dd" Required="true" /></MudItem>
                <MudItem xs="6" sm="3">
                    <MudSelect T="string" @bind-Value="_endKind" Label="Ends" Dense="true">
                        <MudSelectItem T="string" Value="@("never")">Never</MudSelectItem>
                        <MudSelectItem T="string" Value="@("date")">On a date</MudSelectItem>
                        <MudSelectItem T="string" Value="@("count")">After a number of times</MudSelectItem>
                    </MudSelect>
                </MudItem>
                @if (_endKind == "date")
                {
                    <MudItem xs="6" sm="3"><MudDatePicker Label="Last date" @bind-Date="_end" DateFormat="yyyy-MM-dd" /></MudItem>
                }
                else if (_endKind == "count")
                {
                    <MudItem xs="6" sm="3"><MudNumericField T="int" @bind-Value="_occurrences" Label="Times" Min="1" Max="600" /></MudItem>
                }
                <MudItem xs="12" sm="6">
                    <MudSwitch T="bool" @bind-Value="_post" Color="Color.Primary" Label="@(_post ? "Post each entry" : "Create drafts to review and post")" />
                    <MudSwitch T="bool" @bind-Value="_reverse" Color="Color.Primary" Label="Reverse each entry on the first day of the next period (an accrual)" />
                </MudItem>
            </MudGrid>

            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudRadioGroup T="RecurringAmounts" @bind-Value="_mode">
                    <MudRadio T="RecurringAmounts" Value="RecurringAmounts.Fixed">Fixed amounts</MudRadio>
                    <MudRadio T="RecurringAmounts" Value="RecurringAmounts.Percentage">Percentages of an amount</MudRadio>
                </MudRadioGroup>
                @if (_mode == RecurringAmounts.Percentage)
                {
                    <MudTextField T="string" @bind-Value="_base" Label="Amount each time" Immediate="true" Style="max-width:180px"
                                  Error="@(PlanningFormat.Parse(_base) is null)" ErrorText="Dollars and cents" />
                }
            </MudStack>

            <MudPaper Outlined="true" Style="overflow-x:auto">
                <MudSimpleTable Dense="true">
                    <thead><tr><th>Account</th><th>Side</th><th style="text-align:right">@(_mode == RecurringAmounts.Fixed ? "Amount" : "Percent")</th><th>Org unit</th><th>Project</th><th>Memo</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var line in _lines)
                        {
                            <tr>
                                <td style="min-width:240px">
                                    <MudSelect T="Guid?" @bind-Value="line.AccountId" Dense="true" aria-label="Account" Placeholder="Choose an account">
                                        @foreach (var a in Accounts)
                                        {
                                            <MudSelectItem T="Guid?" Value="a.Id">@a.Number @a.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </td>
                                <td style="min-width:110px">
                                    <MudSelect T="LineSide" @bind-Value="line.Side" Dense="true" aria-label="Debit or credit">
                                        <MudSelectItem T="LineSide" Value="LineSide.Debit">Debit</MudSelectItem>
                                        <MudSelectItem T="LineSide" Value="LineSide.Credit">Credit</MudSelectItem>
                                    </MudSelect>
                                </td>
                                <td style="min-width:120px"><MudTextField T="string" @bind-Value="line.Value" Dense="true" Immediate="true" aria-label="@(_mode == RecurringAmounts.Fixed ? "Amount" : "Percent")" Style="text-align:right" /></td>
                                <td style="min-width:130px">
                                    <MudSelect T="Guid?" @bind-Value="line.OrgUnitId" Dense="true" Clearable="true" aria-label="Org unit">
                                        @foreach (var o in OrgUnits)
                                        {
                                            <MudSelectItem T="Guid?" Value="o.Id">@o.Code</MudSelectItem>
                                        }
                                    </MudSelect>
                                </td>
                                <td style="min-width:130px">
                                    <MudSelect T="Guid?" @bind-Value="line.ProjectId" Dense="true" Clearable="true" aria-label="Project">
                                        @foreach (var p in Projects)
                                        {
                                            <MudSelectItem T="Guid?" Value="p.Id">@p.Code</MudSelectItem>
                                        }
                                    </MudSelect>
                                </td>
                                <td style="min-width:160px"><MudTextField T="string" @bind-Value="line.Memo" Dense="true" aria-label="Memo" /></td>
                                <td><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="Remove line" OnClick="() => _lines.Remove(line)" Disabled="_lines.Count <= 2" /></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="() => _lines.Add(new Line())">Add line</MudButton>
                <MudSpacer />
                <MudText Typo="Typo.body2">@Totals</MudText>
            </MudStack>
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_busy" data-testid="save-template">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private sealed class Line
    {
        public Guid? AccountId { get; set; }
        public LineSide Side { get; set; }
        public string? Value { get; set; }
        public Guid? OrgUnitId { get; set; }
        public Guid? ProjectId { get; set; }
        public string? Memo { get; set; }
    }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public RecurringTemplateDto? Template { get; set; }

    [Parameter]
    public IReadOnlyList<AccountDto> Accounts { get; set; } = [];

    [Parameter]
    public IReadOnlyList<OrgUnitDto> OrgUnits { get; set; } = [];

    [Parameter]
    public IReadOnlyList<ProjectDto> Projects { get; set; } = [];

    private string? _name;
    private string? _description;
    private RecurrenceKind _frequency = RecurrenceKind.Monthly;
    private RecurringDay _day = RecurringDay.LastDay;
    private DateTime? _start = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private string _endKind = "never";
    private DateTime? _end;
    private int _occurrences = 12;
    private bool _post;
    private bool _reverse;
    private RecurringAmounts _mode = RecurringAmounts.Fixed;
    private string? _base;
    private List<Line> _lines = [new() { Side = LineSide.Debit }, new() { Side = LineSide.Credit }];
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        if (Template is not { } t)
        {
            return;
        }

        (_name, _description, _frequency, _day, _post, _reverse, _mode) = (t.Name, t.Description, t.Frequency, t.PostingDay, t.PostAutomatically, t.AutoReverse, t.AmountMode);
        _start = t.StartDate.ToDateTime(TimeOnly.MinValue);
        _endKind = t.Occurrences is not null ? "count" : t.EndDate is not null ? "date" : "never";
        _end = t.EndDate?.ToDateTime(TimeOnly.MinValue);
        _occurrences = t.Occurrences ?? 12;
        _base = t.BaseAmount == 0 ? null : t.BaseAmount.ToString("0.##", CultureInfo.InvariantCulture);
        _lines = t.Lines.Select(l => new Line
        {
            AccountId = l.AccountId, Side = l.Side, OrgUnitId = l.OrgUnitId, ProjectId = l.ProjectId, Memo = l.Memo,
            Value = (t.AmountMode == RecurringAmounts.Fixed ? l.Amount : l.Percent).ToString("0.####", CultureInfo.InvariantCulture),
        }).ToList();
    }

    private string Totals
    {
        get
        {
            decimal Sum(LineSide side) => _lines.Where(l => l.Side == side).Sum(l => PlanningFormat.Parse(l.Value) ?? 0);
            return _mode == RecurringAmounts.Fixed
                ? $"Debits {PlanningFormat.Amount(Sum(LineSide.Debit))} · credits {PlanningFormat.Amount(Sum(LineSide.Credit))}"
                : $"Debits {Sum(LineSide.Debit):0.####}% · credits {Sum(LineSide.Credit):0.####}% (each side adds up to 100%)";
        }
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (_lines.Any(l => l.AccountId is null))
        {
            _error = "Choose an account on every line.";
            return;
        }

        var values = _lines.Select(l => decimal.TryParse((l.Value ?? "").Replace(",", "").Replace("$", "").Trim(), NumberStyles.Number, CultureInfo.InvariantCulture, out var v) ? v : (decimal?)null).ToList();
        if (values.Any(v => v is null))
        {
            _error = _mode == RecurringAmounts.Fixed ? "Enter an amount on every line." : "Enter a percentage on every line.";
            return;
        }

        var lines = _lines.Select((l, i) => new RecurringLineInput(l.AccountId!.Value, l.Side,
            _mode == RecurringAmounts.Fixed ? values[i]!.Value : 0, _mode == RecurringAmounts.Percentage ? values[i]!.Value : 0,
            l.Memo, l.OrgUnitId, l.ProjectId)).ToList();
        var request = new SaveRecurringTemplateRequest(_name ?? "", _description ?? "", _frequency, DateOnly.FromDateTime(_start ?? DateTime.Today), lines, _day,
            _endKind == "date" && _end is { } end ? DateOnly.FromDateTime(end) : null, _endKind == "count" ? _occurrences : null,
            _mode, _mode == RecurringAmounts.Percentage ? PlanningFormat.Parse(_base) ?? 0 : 0, _post, _reverse);
        _busy = true;
        try
        {
            var saved = Template is null ? await Recurring.CreateTemplateAsync(request) : await Recurring.UpdateTemplateAsync(Template.Id, request);
            MudDialog.Close(DialogResult.Ok(saved));
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or HttpRequestException or UnauthorizedAccessException)
        {
            _error = ex.Message;
        }

        _busy = false;
    }
}
