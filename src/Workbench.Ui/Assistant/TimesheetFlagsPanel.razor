@* The flags of one timesheet, shown above it on the timesheet approval page. Nothing when there are none or the
   reviewer can't see them. *@
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services

@if (_flags is { Flags.Count: > 0 } flags)
{
    <MudAlert Severity="@(flags.Flags.Any(f => f.Severity == TimesheetFlagSeverity.Warning) ? Severity.Warning : Severity.Info)" Dense="true" Class="mb-3" data-testid="timesheet-flags-panel">
        <div class="d-flex align-center flex-wrap gap-2">
            <span>For review (doesn't block approval): @string.Join(", ", flags.Flags.Select(f => f.Title)).</span>
            <TimesheetFlagsButton Flags="flags" />
        </div>
    </MudAlert>
}

@code {
    [Parameter] public Guid TimesheetId { get; set; }

    private TimesheetFlagsDto? _flags;
    private Guid _loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == TimesheetId || Services.GetService<ITimesheetFlagService>() is not { } service)
        {
            return;
        }

        _loaded = TimesheetId;
        try
        {
            _flags = (await service.ListForTimesheetsAsync([TimesheetId])).FirstOrDefault();
        }
        catch (Exception ex) when (NavAccess.IsExpected(ex))
        {
            _flags = null;
        }
    }
}
