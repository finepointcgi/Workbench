@page "/billing"
@page "/billing/invoices"
@inject IInvoiceService Invoices

<PageTitle>Invoices · Billing · Workbench</PageTitle>

<BillingHeader Title="Invoices" Subtitle="Customer invoices and credit memos by contract. Approving an invoice posts it to the general ledger; voiding reverses it and frees what it billed.">
    <FinanceOnly Permission="@Workbench.Contracts.Identity.Permission.BillingInvoicesManage">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="billing/new" data-testid="new-invoice">New invoice</MudButton>
    </FinanceOnly>
</BillingHeader>

@if (_error is not null)
{
    <BillingError Message="@_error" Forbidden="_forbidden" />
}
else
{
    <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap" Class="mb-3">
        <MudSelect T="Guid?" Value="_contractId" ValueChanged="v => SetAsync(() => _contractId = v)" Label="Contract" Clearable="true" Dense="true" Style="min-width:220px">
            @foreach (var c in _contracts)
            {
                <MudSelectItem T="Guid?" Value="c.Id">@c.ContractNumber</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="InvoiceState?" Value="_status" ValueChanged="v => SetAsync(() => _status = v)" Label="Status" Clearable="true" Dense="true" Style="min-width:150px">
            @foreach (var s in Enum.GetValues<InvoiceState>())
            {
                <MudSelectItem T="InvoiceState?" Value="s">@BillingFormat.Label(s)</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="InvoiceKind?" Value="_type" ValueChanged="v => SetAsync(() => _type = v)" Label="Type" Clearable="true" Dense="true" Style="min-width:170px">
            @foreach (var t in Enum.GetValues<InvoiceKind>())
            {
                <MudSelectItem T="InvoiceKind?" Value="t">@BillingFormat.Label(t)</MudSelectItem>
            }
        </MudSelect>
        <MudTextField T="string" Value="_search" ValueChanged="v => SetAsync(() => _search = v)" Label="Search" DebounceInterval="300" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="min-width:200px" />
        <MudSwitch T="bool" Value="_openOnly" ValueChanged="v => SetAsync(() => _openOnly = v)" Color="Color.Primary" Label="Open balance only" />
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" />
    }
    else if (_invoices.Count == 0)
    {
        <MudPaper Outlined="true" Class="pa-4"><MudText Class="mud-text-secondary">No invoices match. Use New invoice to bill a contract for approved time and costs.</MudText></MudPaper>
    }
    else
    {
        <MudPaper Outlined="true" Style="overflow-x:auto">
            <MudSimpleTable Dense="true" Hover="true" data-testid="invoices">
                <thead>
                    <tr><th>Invoice</th><th>Contract</th><th>Customer</th><th>Type</th><th>Period</th><th>Date</th><th>Due</th>
                        <th style="text-align:right">Total</th><th style="text-align:right">Balance</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var i in _invoices)
                    {
                        <tr>
                            <td style="white-space:nowrap"><MudLink Href="@($"billing/invoices/{i.Id}")">@i.Number</MudLink></td>
                            <td style="white-space:nowrap">@i.ContractNumber</td>
                            <td>@i.CustomerName</td>
                            <td>@BillingFormat.Label(i.Type)</td>
                            <td style="white-space:nowrap">@BillingFormat.Date(i.PeriodFrom) – @BillingFormat.Date(i.PeriodTo)</td>
                            <td style="white-space:nowrap">@BillingFormat.Date(i.InvoiceDate)</td>
                            <td style="white-space:nowrap" class="@(i.DaysPastDue > 0 ? "mud-error-text" : "")">
                                @BillingFormat.Date(i.DueDate)@(i.DaysPastDue > 0 ? $" ({i.DaysPastDue} d late)" : "")
                            </td>
                            <td style="text-align:right; white-space:nowrap">@BillingFormat.Amount(i.Total)</td>
                            <td style="text-align:right; white-space:nowrap">@BillingFormat.Blank(i.Balance)</td>
                            <td><InvoiceStatusChip Status="i.Status" /></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="7"><strong>@_invoices.Count invoice@(_invoices.Count == 1 ? "" : "s")</strong></td>
                        <td style="text-align:right"><strong>@BillingFormat.Amount(_invoices.Where(i => i.Status != InvoiceState.Void && i.Status != InvoiceState.Draft).Sum(i => i.Total))</strong></td>
                        <td style="text-align:right"><strong>@BillingFormat.Amount(_invoices.Sum(i => i.Balance))</strong></td>
                        <td></td>
                    </tr>
                </tfoot>
            </MudSimpleTable>
        </MudPaper>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">The total counts approved invoices and credit memos (not drafts or void).</MudText>
    }
}

@code {
    private IReadOnlyList<BillingContractDto> _contracts = [];
    private IReadOnlyList<InvoiceSummaryDto> _invoices = [];
    private Guid? _contractId;
    private InvoiceState? _status;
    private InvoiceKind? _type;
    private string? _search;
    private bool _openOnly;
    private bool _loading = true;
    private string? _error;
    private bool _forbidden;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _contracts = await Invoices.ListBillingContractsAsync();
        }
        catch (Exception ex)
        {
            (_error, _forbidden) = (BillingFormat.Error(ex), BillingFormat.IsForbidden(ex));
        }

        if (_error is null)
        {
            await LoadAsync();
        }

        _loading = false;
    }

    private async Task SetAsync(Action set)
    {
        set();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _invoices = await Invoices.ListAsync(new InvoiceQuery(_contractId, null, _status, _type, _search, _openOnly));
        }
        catch (Exception ex)
        {
            (_error, _forbidden) = (BillingFormat.Error(ex), BillingFormat.IsForbidden(ex));
        }

        _loading = false;
    }
}
