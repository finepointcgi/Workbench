@page "/billing"
@page "/billing/invoices"
@inject IInvoiceService Invoices
@inject NavigationManager Navigation

<PageTitle>Invoices · Billing · Workbench</PageTitle>

<BillingHeader Title="Invoices" Subtitle="Customer invoices and credit memos by contract. Approving an invoice posts it to the general ledger; voiding reverses it and frees what it billed.">
    <FinanceOnly Permission="@Workbench.Contracts.Identity.Permission.BillingInvoicesManage">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="billing/new" data-testid="new-invoice">New invoice</MudButton>
    </FinanceOnly>
</BillingHeader>

@if (_error is not null)
{
    <BillingError Message="@_error" Forbidden="_forbidden" />
}
else
{
    <ConfigurableList T="InvoiceSummaryDto" Definition="_definition" Items="_invoices" Loading="_loading" SearchLabel="Search invoices" TestId="invoices"
                      RowClick="@(i => Navigation.NavigateTo($"billing/invoices/{i.Id}"))">
        <ToolBarContent>
            <MudSelect T="Guid?" Value="_contractId" ValueChanged="v => SetAsync(() => _contractId = v)" Label="Contract" Clearable="true" Dense="true" Style="min-width:200px">
                @foreach (var c in _contracts)
                {
                    <MudSelectItem T="Guid?" Value="c.Id">@c.ContractNumber</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="InvoiceState?" Value="_status" ValueChanged="v => SetAsync(() => _status = v)" Label="Status" Clearable="true" Dense="true" Style="min-width:140px">
                @foreach (var s in Enum.GetValues<InvoiceState>())
                {
                    <MudSelectItem T="InvoiceState?" Value="s">@BillingFormat.Label(s)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="InvoiceKind?" Value="_type" ValueChanged="v => SetAsync(() => _type = v)" Label="Type" Clearable="true" Dense="true" Style="min-width:150px">
                @foreach (var t in Enum.GetValues<InvoiceKind>())
                {
                    <MudSelectItem T="InvoiceKind?" Value="t">@BillingFormat.Label(t)</MudSelectItem>
                }
            </MudSelect>
            <MudSwitch T="bool" Value="_openOnly" ValueChanged="v => SetAsync(() => _openOnly = v)" Color="Color.Primary" Label="Open balance only" />
        </ToolBarContent>
        <NoRecordsContent><MudText Class="mud-text-secondary">No invoices match. Use New invoice to bill a contract for approved time and costs.</MudText></NoRecordsContent>
        <Summary>
            @if (context.Count > 0)
            {
                <MudStack Row="true" Spacing="4" Class="mt-2 px-2" Wrap="Wrap.Wrap" data-testid="invoice-totals">
                    <MudText Typo="Typo.body2"><strong>@context.Count invoice@(context.Count == 1 ? "" : "s")</strong></MudText>
                    <MudText Typo="Typo.body2">Total <strong>@BillingFormat.Amount(context.Where(i => i.Status != InvoiceState.Void && i.Status != InvoiceState.Draft).Sum(i => i.Total))</strong></MudText>
                    <MudText Typo="Typo.body2">Balance <strong>@BillingFormat.Amount(context.Sum(i => i.Balance))</strong></MudText>
                </MudStack>
                <MudText Typo="Typo.caption" Class="mud-text-secondary px-2">The total counts approved invoices and credit memos (not drafts or void).</MudText>
            }
        </Summary>
    </ConfigurableList>
}

@code {
    private IReadOnlyList<BillingContractDto> _contracts = [];
    private IReadOnlyList<InvoiceSummaryDto> _invoices = [];
    private Guid? _contractId;
    private InvoiceState? _status;
    private InvoiceKind? _type;
    private bool _openOnly;
    private bool _loading = true;
    private string? _error;
    private bool _forbidden;

    internal static readonly ListDefinition<InvoiceSummaryDto> _definition = new()
    {
        ListKey = CustomizableLists.Invoices,
        EntityType = CustomizableEntities.Invoice,
        Title = "Invoices",
        Id = i => i.Id,
        Columns =
        [
            new() { Key = "invoice", Title = "Invoice", Value = i => i.Number, Groupable = false,
                    Cell = i => @<span style="white-space:nowrap"><MudLink Href="@($"billing/invoices/{i.Id}")">@i.Number</MudLink></span> },
            new() { Key = "contract", Title = "Contract", Value = i => i.ContractNumber, Cell = i => @<span style="white-space:nowrap">@i.ContractNumber</span> },
            new() { Key = "customer", Title = "Customer", Value = i => i.CustomerName },
            new() { Key = "type", Title = "Type", Value = i => i.Type, Display = i => BillingFormat.Label(i.Type) },
            new() { Key = "period", Title = "Period", Value = i => i.PeriodFrom, Kind = ListColumnKind.Date, Groupable = false,
                    Display = i => $"{BillingFormat.Date(i.PeriodFrom)} – {BillingFormat.Date(i.PeriodTo)}" },
            new() { Key = "date", Title = "Date", Value = i => i.InvoiceDate, Kind = ListColumnKind.Date, Groupable = false, Display = i => BillingFormat.Date(i.InvoiceDate) },
            new() { Key = "due", Title = "Due", Value = i => i.DueDate, Kind = ListColumnKind.Date, Groupable = false,
                    Cell = i => @<span style="white-space:nowrap" class="@(i.DaysPastDue > 0 ? "mud-error-text" : "")">@BillingFormat.Date(i.DueDate)@(i.DaysPastDue > 0 ? $" ({i.DaysPastDue} d late)" : "")</span> },
            new() { Key = "daysPastDue", Title = "Days past due", Value = i => i.DaysPastDue, Kind = ListColumnKind.Number, Standard = false, Groupable = false },
            new() { Key = "total", Title = "Total", Value = i => i.Total, Kind = ListColumnKind.Money, Groupable = false, Cell = i => @<span style="white-space:nowrap">@BillingFormat.Amount(i.Total)</span> },
            new() { Key = "balance", Title = "Balance", Value = i => i.Balance, Kind = ListColumnKind.Money, Groupable = false, Cell = i => @<span style="white-space:nowrap">@BillingFormat.Blank(i.Balance)</span> },
            new() { Key = "status", Title = "Status", Value = i => i.Status, Display = i => BillingFormat.Label(i.Status), Cell = i => @<InvoiceStatusChip Status="i.Status" /> },
        ],
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _contracts = await Invoices.ListBillingContractsAsync();
        }
        catch (Exception ex)
        {
            (_error, _forbidden) = (BillingFormat.Error(ex), BillingFormat.IsForbidden(ex));
        }

        if (_error is null)
        {
            await LoadAsync();
        }

        _loading = false;
    }

    private async Task SetAsync(Action set)
    {
        set();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _invoices = await Invoices.ListAsync(new InvoiceQuery(_contractId, null, _status, _type, null, _openOnly));
        }
        catch (Exception ex)
        {
            (_error, _forbidden) = (BillingFormat.Error(ex), BillingFormat.IsForbidden(ex));
        }

        _loading = false;
    }
}
