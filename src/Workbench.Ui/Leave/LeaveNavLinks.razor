@* Leave: everyone with an employee record; approvals show a count for supervisors. *@
@inject ILeaveRequestService Requests

<MudNavLink Href="leave" Icon="@Icons.Material.Filled.BeachAccess" data-testid="leave-nav">Leave@(_pending > 0 ? $" ({_pending})" : "")</MudNavLink>

@code {
    private int _pending;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (await Requests.IsApproverAsync())
            {
                _pending = (await Requests.ListPendingApprovalsAsync()).Count;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException or ArgumentException or TaskCanceledException)
        {
            _pending = 0;
        }
    }
}
