@* Leave policies (administrators): charge code, accrual method and tiers, caps, carryover, waiting period, negative balances. *@
@inject ILeavePolicyService Policies
@inject ISnackbar Snackbar

<MudTable T="LeavePolicyDto" Items="_policies" Dense="true" Class="mb-4" data-testid="policies">
    <HeaderContent>
        <MudTh>Code</MudTh><MudTh>Name</MudTh><MudTh>Type</MudTh><MudTh>Charge code</MudTh><MudTh>Accrual</MudTh><MudTh>Cap</MudTh><MudTh>Carryover</MudTh><MudTh>Waiting</MudTh><MudTh>Negative</MudTh><MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Code</MudTd>
        <MudTd>@context.Name@(context.IsActive ? "" : " (inactive)")</MudTd>
        <MudTd>@context.Type</MudTd>
        <MudTd>@context.WbsCode</MudTd>
        <MudTd>
            @Method(context.Method)
            @foreach (var t in context.Tiers)
            {
                <div class="mud-text-secondary" style="font-size:12px">@t.MinYearsOfService+ yrs: @t.Rate.ToString("0.####", CultureInfo.InvariantCulture)@(t.MaxBalance is { } m ? $" (cap {LeavePage.Hours(m)})" : "")</div>
            }
        </MudTd>
        <MudTd>@(context.MaxBalance is { } cap ? LeavePage.Hours(cap) : "—")</MudTd>
        <MudTd>@(context.CarryoverLimit is { } c ? LeavePage.Hours(c) : "all")</MudTd>
        <MudTd>@context.WaitingPeriodDays d</MudTd>
        <MudTd>@(context.AllowNegativeBalance ? "Allowed" : "Blocked")</MudTd>
        <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => Edit(context)">Edit</MudButton></MudTd>
    </RowTemplate>
</MudTable>

<MudPaper Outlined="true" Class="pa-4" Style="max-width:960px">
    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@(_editingId is null ? "New policy" : $"Edit {_f.Code}")</MudText>
    <MudGrid Spacing="2">
        <MudItem xs="6" sm="2"><MudTextField @bind-Value="_f.Code" Label="Code" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="6" sm="4"><MudTextField @bind-Value="_f.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="6" sm="3">
            <MudSelect T="LeaveTypeKind" @bind-Value="_f.Type" Label="Type" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var t in Enum.GetValues<LeaveTypeKind>())
                {
                    <MudSelectItem T="LeaveTypeKind" Value="t">@t</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudSelect T="Guid?" @bind-Value="_f.WbsElementId" Label="Leave charge code" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var c in _codes)
                {
                    <MudSelectItem T="Guid?" Value="c.WbsElementId">@c.Code · @c.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudSelect T="AccrualMethodKind" @bind-Value="_f.Method" Label="Accrual" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var m in Enum.GetValues<AccrualMethodKind>())
                {
                    <MudSelectItem T="AccrualMethodKind" Value="m">@Method(m)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="2"><MudNumericField T="decimal?" @bind-Value="_f.MaxBalance" Label="Cap (h)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="6" sm="2"><MudNumericField T="decimal?" @bind-Value="_f.Carryover" Label="Carryover (h)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="6" sm="2"><MudNumericField T="int" @bind-Value="_f.Waiting" Label="Waiting (days)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" sm="3"><MudSwitch T="bool" @bind-Value="_f.AllowNegative" Label="Allow negative balance" Color="Color.Primary" /></MudItem>
        <MudItem xs="12" sm="2"><MudSwitch T="bool" @bind-Value="_f.Active" Label="Active" Color="Color.Primary" /></MudItem>
    </MudGrid>
    <MudText Typo="Typo.subtitle2" Class="mt-3">Tiers by years of service (@RateUnit(_f.Method))</MudText>
    @foreach (var tier in _f.Tiers)
    {
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-1">
            <MudNumericField T="int" @bind-Value="tier.Years" Label="From years" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:120px" />
            <MudNumericField T="decimal" @bind-Value="tier.Rate" Label="Rate" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:140px" />
            <MudNumericField T="decimal?" @bind-Value="tier.Cap" Label="Tier cap (h)" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:140px" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="Remove tier" OnClick="() => _f.Tiers.Remove(tier)" />
        </MudStack>
    }
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="() => _f.Tiers.Add(new TierRow())">Add tier</MudButton>
    <MudStack Row="true" Spacing="2" Class="mt-3">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(_busy || _f.WbsElementId is null)">Save policy</MudButton>
        @if (_editingId is not null)
        {
            <MudButton Variant="Variant.Text" OnClick="() => { _editingId = null; _f = new(); }">New policy instead</MudButton>
        }
    </MudStack>
</MudPaper>

@code {
    private IReadOnlyList<LeavePolicyDto> _policies = [];
    private IReadOnlyList<LeaveChargeCodeDto> _codes = [];
    private Guid? _editingId;
    private Form _f = new();
    private bool _busy;

    private sealed class TierRow
    {
        public int Years { get; set; }
        public decimal Rate { get; set; }
        public decimal? Cap { get; set; }
    }

    private sealed class Form
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public LeaveTypeKind Type { get; set; } = LeaveTypeKind.Pto;
        public Guid? WbsElementId { get; set; }
        public AccrualMethodKind Method { get; set; } = AccrualMethodKind.PerPayPeriod;
        public decimal? MaxBalance { get; set; }
        public decimal? Carryover { get; set; }
        public int Waiting { get; set; }
        public bool AllowNegative { get; set; }
        public bool Active { get; set; } = true;
        public List<TierRow> Tiers { get; set; } = [new()];
    }

    protected override async Task OnInitializedAsync()
    {
        _codes = await Policies.ListLeaveChargeCodesAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _policies = await Policies.ListAsync(includeInactive: true);

    private void Edit(LeavePolicyDto p)
    {
        _editingId = p.Id;
        _f = new Form
        {
            Code = p.Code, Name = p.Name, Type = p.Type, WbsElementId = p.WbsElementId, Method = p.Method, MaxBalance = p.MaxBalance, Carryover = p.CarryoverLimit,
            Waiting = p.WaitingPeriodDays, AllowNegative = p.AllowNegativeBalance, Active = p.IsActive,
            Tiers = p.Tiers.Select(t => new TierRow { Years = t.MinYearsOfService, Rate = t.Rate, Cap = t.MaxBalance }).ToList(),
        };
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var request = new SaveLeavePolicyRequest(_f.Code, _f.Name, _f.Type, _f.WbsElementId!.Value, _f.Method,
                _f.Tiers.Select(t => new AccrualTierDto(t.Years, t.Rate, t.Cap)).ToList(), _f.MaxBalance, _f.Carryover, _f.Waiting, _f.AllowNegative, _f.Active);
            _ = _editingId is { } id ? await Policies.UpdateAsync(id, request) : await Policies.CreateAsync(request);
            Snackbar.Add("Policy saved.", Severity.Success);
            _editingId = null;
            _f = new();
            await LoadAsync();
        }
        catch (Exception ex) when (LeavePage.IsExpected(ex))
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Method(AccrualMethodKind m) => m switch
    {
        AccrualMethodKind.PerPayPeriod => "Per pay period",
        AccrualMethodKind.PerHourWorked => "Per hour worked",
        AccrualMethodKind.AnnualGrant => "Annual grant",
        _ => "None",
    };

    private static string RateUnit(AccrualMethodKind m) => m switch
    {
        AccrualMethodKind.PerPayPeriod => "hours per pay period",
        AccrualMethodKind.PerHourWorked => "hours per hour worked",
        AccrualMethodKind.AnnualGrant => "hours per year",
        _ => "no accrual",
    };
}
