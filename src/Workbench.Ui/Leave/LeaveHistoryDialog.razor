@inject ILeaveBalanceService Balances

<MudDialog>
    <DialogContent>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning">@_error</MudAlert>
        }
        else if (_rows is null)
        {
            <MudProgressLinear aria-label="Loading" Indeterminate="true" />
        }
        else
        {
            <MudText Class="mb-2">@Balance.EmployeeName · balance @LeavePage.Hours(Balance.Balance) h</MudText>
            <MudSimpleTable Dense="true" data-testid="history">
                <thead><tr><th>Date</th><th>Kind</th><th style="text-align:right">Hours</th><th style="text-align:right">Balance</th><th>Reason</th><th>By</th></tr></thead>
                <tbody>
                    @foreach (var r in _rows)
                    {
                        <tr>
                            <td>@r.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                            <td>@r.Kind</td>
                            <td style="text-align:right">@(r.Hours > 0 ? "+" : "")@LeavePage.Hours(r.Hours)</td>
                            <td style="text-align:right">@LeavePage.Hours(r.BalanceAfter)</td>
                            <td>@r.Reason</td>
                            <td class="mud-text-secondary">@r.CreatedBy</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </DialogContent>
    <DialogActions><MudButton OnClick="() => MudDialog.Close()">Close</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public LeaveBalanceDto Balance { get; set; } = default!;

    private IReadOnlyList<LeaveLedgerEntryDto>? _rows;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _rows = await Balances.GetHistoryAsync(Balance.EmployeeId, Balance.PolicyId);
        }
        catch (Exception ex) when (LeavePage.IsExpected(ex))
        {
            _error = ex.Message;
        }
    }
}
