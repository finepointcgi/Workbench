@* A month of approved (and pending) leave and holidays for the user's team. *@
@inject ILeaveRequestService Requests

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" aria-label="Previous month" OnClick="() => MoveAsync(-1)" />
    <MudText Typo="Typo.h6" data-testid="calendar-month">@_month.ToString("MMMM yyyy", CultureInfo.InvariantCulture)</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="Next month" OnClick="() => MoveAsync(1)" />
    <MudSpacer />
    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Approved</MudChip>
    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Pending</MudChip>
    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Holiday</MudChip>
</MudStack>
@if (_error is not null)
{
    <MudAlert Severity="Severity.Warning">@_error</MudAlert>
}
<div style="display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px" data-testid="team-calendar">
    @foreach (var d in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
    {
        <div class="mud-text-secondary" style="font-size:12px;padding:2px 4px">@d</div>
    }
    @for (var day = GridStart; day <= GridEnd; day = day.AddDays(1))
    {
        var date = day;
        var items = _entries.Where(e => e.Date == date).ToList();
        <div style="min-height:84px;border:1px solid var(--mud-palette-lines-default);border-radius:4px;padding:4px;@(date.Month != _month.Month ? "opacity:.45;" : "")"
             data-date="@date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
            <div style="font-size:12px;font-weight:600">@date.Day</div>
            @foreach (var e in items)
            {
                <div title="@e.Title" style="font-size:11px;line-height:1.3;margin-top:2px;padding:1px 4px;border-radius:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;background:@Background(e.Kind)">
                    @e.Title@(e.Hours is { } h && e.Kind != TeamCalendarEntryKind.Holiday ? $" · {LeavePage.Hours(h)} h" : "")
                </div>
            }
        </div>
    }
</div>

@code {
    private DateOnly _month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private IReadOnlyList<TeamCalendarEntryDto> _entries = [];
    private string? _error;

    private DateOnly GridStart => _month.AddDays(-(((int)_month.DayOfWeek + 6) % 7));

    private DateOnly GridEnd
    {
        get
        {
            var last = _month.AddMonths(1).AddDays(-1);
            return last.AddDays((7 - ((int)last.DayOfWeek + 6) % 7 - 1) % 7);
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task MoveAsync(int months)
    {
        _month = _month.AddMonths(months);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _error = null;
            _entries = await Requests.GetTeamCalendarAsync(GridStart, GridEnd);
        }
        catch (Exception ex) when (LeavePage.IsExpected(ex))
        {
            _error = ex.Message;
        }
    }

    private static string Background(TeamCalendarEntryKind kind) => kind switch
    {
        TeamCalendarEntryKind.Leave => "rgba(76,175,80,.18)",
        TeamCalendarEntryKind.PendingLeave => "rgba(255,152,0,.18)",
        _ => "rgba(33,150,243,.16)",
    };
}
