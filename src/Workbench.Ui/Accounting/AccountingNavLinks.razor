@* The Accounting menu, for Finance and administrators. The pages and the server check again. *@
@inject ICurrentUserContext UserContext

@if (_show)
{
    <MudNavGroup Title="Accounting" Icon="@Icons.Material.Filled.AccountBalance" data-testid="accounting-nav">
        <MudNavLink Href="accounting/reports" Icon="@Icons.Material.Filled.Assessment">Reports</MudNavLink>
        <MudNavLink Href="accounting/journal" Icon="@Icons.Material.Filled.MenuBook">Journal entries</MudNavLink>
        <MudNavLink Href="accounting/accounts" Icon="@Icons.Material.Filled.AccountTree">Chart of accounts</MudNavLink>
        <MudNavLink Href="accounting/posting-rules" Icon="@Icons.Material.Filled.Rule">Posting rules</MudNavLink>
        <MudNavLink Href="accounting/close" Icon="@Icons.Material.Filled.EventAvailable">Period close</MudNavLink>
        <MudNavLink Href="accounting/indirect-rates" Icon="@Icons.Material.Filled.Percent">Indirect rates</MudNavLink>
        <MudNavLink Href="accounting/revenue" Icon="@Icons.Material.Filled.TrendingUp">Revenue</MudNavLink>
        <Workbench.Ui.Cash.CashNavLinks />
    </MudNavGroup>
}

@code {
    private bool _show;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _show = (await UserContext.GetAsync()).IsFinance;
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException or TaskCanceledException)
        {
            _show = false;
        }
    }
}
