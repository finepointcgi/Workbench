@page "/accounting/consolidated"
@using Workbench.Contracts.Companies
@inject IFiscalCalendarService Calendar
@inject ICompanyService Companies
@inject IConsolidationService Consolidation

<PageTitle>Consolidated statements · Accounting · Workbench</PageTitle>

<AccountingHeader Title="Consolidated statements"
                  Subtitle="The companies' statements side by side, the intercompany eliminations and the consolidated total. Due-to and due-from balances between the chosen companies are eliminated.">
    @if (_periods.Count > 0)
    {
        <MudSelect T="Guid?" Value="_period?.Id" ValueChanged="PeriodChangedAsync" Label="Fiscal period" Dense="true" Style="min-width:200px" data-testid="consolidation-period">
            @foreach (var p in _periods.OrderByDescending(p => p.Start))
            {
                <MudSelectItem T="Guid?" Value="p.Id">@p.Name@(p.Status == FiscalPeriodState.Closed ? " (closed)" : "")</MudSelectItem>
            }
        </MudSelect>
    }
</AccountingHeader>

@if (_error is not null)
{
    <LoadError Message="@_error" Forbidden="_forbidden" />
}
else if (_period is null || _companies is null)
{
    <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (_companies.Count < 2)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" data-testid="consolidation-single">
            There's one company, so these match the ordinary statements. Add companies under <MudLink Href="setup/companies" Typo="Typo.body2">Setup › Companies</MudLink> to consolidate.
        </MudAlert>
    }
    else
    {
        <fieldset class="mb-3" style="border:0;padding:0;margin:0">
            <legend class="mud-typography mud-typography-subtitle2">Companies to consolidate</legend>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="0">
                @foreach (var c in _companies)
                {
                    var id = c.Id;
                    <MudCheckBox T="bool" Value="_chosen.Contains(id)" ValueChanged="v => ToggleAsync(id, v)" Label="@($"{c.Code} · {c.LegalName}")" data-testid="consolidation-company" />
                }
            </MudStack>
        </fieldset>
    }

    <MudTabs Outlined="true" Rounded="true" TabPanelsClass="pa-4" ActivePanelIndex="_tab" ActivePanelIndexChanged="TabChangedAsync">
        <MudTabPanel Text="Trial balance" />
        <MudTabPanel Text="Income statement" />
        <MudTabPanel Text="Balance sheet" />
    </MudTabs>

    <div class="mt-4">
        @if (_reportError is not null)
        {
            <MudAlert Severity="Severity.Error">@_reportError</MudAlert>
        }
        else if (_report is null)
        {
            <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            var r = _report;
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@r.Title, @r.FiscalPeriodName</MudText>
            @foreach (var note in r.Notes)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2" data-testid="consolidation-note">@note</MudAlert>
            }

            <div style="overflow-x:auto">
                <MudSimpleTable Dense="true" aria-label="@($"{r.Title}, {r.FiscalPeriodName}")" data-testid="consolidation-table">
                    <thead>
                        <tr>
                            <th scope="col">@r.AmountLabel</th>
                            @foreach (var c in r.Companies)
                            {
                                <th scope="col" style="text-align:right">@c.Code</th>
                            }
                            <th scope="col" style="text-align:right">Eliminations</th>
                            <th scope="col" style="text-align:right">Consolidated</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var section in r.Rows.GroupBy(x => x.Section))
                        {
                            @if (section.Key is not ("Summary" or "Totals"))
                            {
                                <tr><th scope="rowgroup" colspan="@(r.Companies.Count + 3)" class="pt-4" style="text-align:left"><MudText Typo="Typo.subtitle2" HtmlTag="span">@section.Key</MudText></th></tr>
                            }
                            @foreach (var row in section)
                            {
                                <tr style="@(row.IsTotal ? "font-weight:600" : "")" data-testid="consolidation-row">
                                    <th scope="row" style="font-weight:inherit;text-align:left;@(row.IsTotal ? "" : "padding-left:24px")">@(row.AccountNumber is null ? "" : row.AccountNumber + " ")@row.Label</th>
                                    @foreach (var amount in row.Companies)
                                    {
                                        <td style="text-align:right">@AccountingFormat.Amount(amount)</td>
                                    }
                                    <td style="text-align:right" data-testid="consolidation-elimination">@AccountingFormat.Amount(row.Eliminations)</td>
                                    <td style="text-align:right">@AccountingFormat.Amount(row.Total)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
            @if (r.Report == ConsolidatedReport.TrialBalance)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Balances are debit-positive; credits show in parentheses.</MudText>
            }

            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-6 mb-2">Eliminations</MudText>
            @if (r.Eliminations.Count == 0)
            {
                <MudText Class="mud-text-secondary">Nothing to eliminate between these companies.</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" aria-label="Eliminations" data-testid="consolidation-eliminations">
                    <thead><tr><th scope="col">In the books of</th><th scope="col">With</th><th scope="col">Account</th><th scope="col" style="text-align:right">Elimination</th></tr></thead>
                    <tbody>
                        @foreach (var e in r.Eliminations)
                        {
                            <tr>
                                <td>@e.CompanyCode</td>
                                <td>@e.CounterpartyCode</td>
                                <td>@e.AccountNumber @e.AccountName</td>
                                <td style="text-align:right">@AccountingFormat.Amount(e.Amount)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        }
    </div>
}

@code {
    private static readonly ConsolidatedReport[] Reports = [ConsolidatedReport.TrialBalance, ConsolidatedReport.IncomeStatement, ConsolidatedReport.BalanceSheet];

    private IReadOnlyList<FiscalPeriodDto> _periods = [];
    private IReadOnlyList<CompanyDto>? _companies;
    private HashSet<Guid> _chosen = [];
    private FiscalPeriodDto? _period;
    private ConsolidationDto? _report;
    private int _tab;
    private string? _error;
    private string? _reportError;
    private bool _forbidden;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _periods = await Calendar.ListPeriodsAsync();
            _period = AccountingFormat.DefaultPeriod(_periods);
            _companies = (await Companies.GetContextAsync()).Companies;
            _chosen = _companies.Select(c => c.Id).ToHashSet();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            (_error, _forbidden) = (AccountingFormat.Error(ex), AccountingFormat.IsForbidden(ex));
        }
    }

    private async Task LoadAsync()
    {
        if (_period is null)
        {
            return;
        }

        (_report, _reportError) = (null, null);
        try
        {
            _report = await Consolidation.GetAsync(Reports[_tab], new ConsolidationRequest(_period.Id, _chosen.ToList()));
        }
        catch (Exception ex)
        {
            _reportError = AccountingFormat.Error(ex);
        }
    }

    private async Task PeriodChangedAsync(Guid? id)
    {
        _period = _periods.FirstOrDefault(p => p.Id == id);
        await LoadAsync();
    }

    private async Task TabChangedAsync(int tab)
    {
        _tab = tab;
        await LoadAsync();
    }

    private async Task ToggleAsync(Guid id, bool on)
    {
        if (on)
        {
            _chosen.Add(id);
        }
        else if (_chosen.Count > 1)
        {
            _chosen.Remove(id);
        }

        await LoadAsync();
    }
}
