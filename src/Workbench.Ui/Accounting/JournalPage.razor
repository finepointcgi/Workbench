@page "/accounting/journal"
@inject IJournalService Journal
@inject IFiscalCalendarService Calendar
@inject IAccountingReportService Reports
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Journal entries · Accounting · Workbench</PageTitle>

<AccountingHeader Title="Journal entries" Subtitle="Manual entries and the entries posted automatically from approved timesheets and ODCs. Posted entries are immutable; correct them with a reversal.">
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportAsync" Disabled="_error is not null">Export CSV</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="accounting/journal/new" data-testid="new-entry">New entry</MudButton>
</AccountingHeader>

@if (_error is not null)
{
    <LoadError Message="@_error" Forbidden="_forbidden" />
}
else
{
    <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap" Class="mb-3">
        <MudSelect T="Guid?" Value="_periodId" ValueChanged="v => SetAsync(() => _periodId = v)" Label="Period" Clearable="true" Dense="true" Style="min-width:160px">
            @foreach (var p in _periods.OrderByDescending(p => p.Start))
            {
                <MudSelectItem T="Guid?" Value="p.Id">@p.Name@(p.Status == FiscalPeriodState.Closed ? " (closed)" : "")</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="JournalEntryState?" Value="_status" ValueChanged="v => SetAsync(() => _status = v)" Label="Status" Clearable="true" Dense="true" Style="min-width:140px">
            @foreach (var s in Enum.GetValues<JournalEntryState>())
            {
                <MudSelectItem T="JournalEntryState?" Value="s">@s</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="JournalEntrySource?" Value="_source" ValueChanged="v => SetAsync(() => _source = v)" Label="Source" Clearable="true" Dense="true" Style="min-width:140px">
            @foreach (var s in Enum.GetValues<JournalEntrySource>())
            {
                <MudSelectItem T="JournalEntrySource?" Value="s">@AccountingFormat.Label(s)</MudSelectItem>
            }
        </MudSelect>
        <MudTextField T="string" Value="_search" ValueChanged="v => SetAsync(() => _search = v)" Label="Search" DebounceInterval="300" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="min-width:220px" />
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_entries.Count == 0)
    {
        <MudPaper Outlined="true" Class="pa-4"><MudText Class="mud-text-secondary">No journal entries match.</MudText></MudPaper>
    }
    else
    {
        <MudPaper Outlined="true" Style="overflow-x:auto">
            <MudSimpleTable Dense="true" Hover="true" data-testid="journal-entries">
                <thead><tr><th>Entry</th><th>Date</th><th>Period</th><th>Source</th><th>Description</th><th style="text-align:right">Amount</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var e in _entries)
                    {
                        <tr>
                            <td style="white-space:nowrap"><MudLink Href="@($"accounting/journal/{e.Id}")">@e.Number</MudLink></td>
                            <td style="white-space:nowrap">@AccountingFormat.Date(e.Date)</td>
                            <td>@e.FiscalPeriodName</td>
                            <td><MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@AccountingFormat.Label(e.Source)</MudChip></td>
                            <td>@e.Description</td>
                            <td style="text-align:right; white-space:nowrap">@AccountingFormat.Amount(e.TotalDebit)</td>
                            <td><JournalStatusChip Status="e.Status" /></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
        @if (_entries.Count >= Take)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Showing the latest @Take entries; filter to narrow down.</MudText>
        }
    }
}

@code {
    private const int Take = 200;
    private IReadOnlyList<FiscalPeriodDto> _periods = [];
    private IReadOnlyList<JournalEntrySummaryDto> _entries = [];
    private Guid? _periodId;
    private JournalEntryState? _status;
    private JournalEntrySource? _source;
    private string? _search;
    private bool _loading = true;
    private string? _error;
    private bool _forbidden;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _periods = await Calendar.ListPeriodsAsync();
        }
        catch (Exception ex)
        {
            (_error, _forbidden) = (AccountingFormat.Error(ex), AccountingFormat.IsForbidden(ex));
        }

        await LoadAsync();
    }

    private async Task SetAsync(Action set)
    {
        set();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _entries = await Journal.ListAsync(new JournalQuery(_periodId, _status, _source, _search, Take));
        }
        catch (Exception ex)
        {
            (_error, _forbidden) = (AccountingFormat.Error(ex), AccountingFormat.IsForbidden(ex));
        }

        _loading = false;
    }

    private async Task ExportAsync()
    {
        try
        {
            await AccountingFormat.DownloadAsync(JS, await Reports.ExportCsvAsync(new AccountingExportRequest(AccountingReport.JournalEntries, _periodId)));
        }
        catch (Exception ex)
        {
            Snackbar.Add(AccountingFormat.Error(ex), Severity.Error);
        }
    }
}
