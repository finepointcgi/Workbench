@* Dialog wrapper around SupportForm, opened from the user menu, the help panel, the not-found page and error screens. *@
@using Workbench.Contracts.Support

<MudDialog data-testid="report-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6" HtmlTag="h2">@(FromError ? "Report this problem" : "Report a problem or send feedback")</MudText>
    </TitleContent>
    <DialogContent>
        <SupportForm PagePath="@PagePath" FromError="FromError" Kind="Kind" Done="d => MudDialog.Close(DialogResult.Ok(d))" Cancelled="() => MudDialog.Cancel()" />
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string? PagePath { get; set; }

    [Parameter] public bool FromError { get; set; }

    [Parameter] public SupportKind Kind { get; set; } = SupportKind.Problem;
}
