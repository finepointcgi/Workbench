@page "/materials"
@inject IPartService PartService
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Parts · Materials · Workbench</PageTitle>

<MaterialsHeader Title="Parts" BackHref="" BackLabel="Home"
                 Subtitle="The part master: what you buy and build, how it's costed and tracked, and what's on hand. Government-furnished material is counted but never valued.">
    @if (MaterialsFormat.CanEdit(User))
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NewAsync" Disabled="_options is null" data-testid="new-part">New part</MudButton>
    }
</MaterialsHeader>

@if (_error is not null)
{
    <MaterialsError Message="@_error" Forbidden="_forbidden" />
}
else
{
    <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap" Class="mb-3" AlignItems="AlignItems.Center">
        <MudTextField T="string" Value="_search" ValueChanged="v => SetAsync(() => _search = v)" Label="Search parts" DebounceInterval="300" Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="min-width:240px" />
        <MudSelect T="PartSourceKind?" Value="_source" ValueChanged="v => SetAsync(() => _source = v)" Label="Make or buy" Clearable="true" Dense="true" Style="min-width:140px">
            <MudSelectItem T="PartSourceKind?" Value="PartSourceKind.Buy">Buy</MudSelectItem>
            <MudSelectItem T="PartSourceKind?" Value="PartSourceKind.Make">Make</MudSelectItem>
        </MudSelect>
        <MudSwitch T="bool" Value="_inactive" ValueChanged="v => SetAsync(() => _inactive = v)" Label="Show inactive" Color="Color.Primary" />
        <MudSpacer />
        <MudText>Inventory value <b>@MaterialsFormat.Amount(_parts.Sum(p => p.Value))</b></MudText>
    </MudStack>
    <MudPaper Outlined="true" Class="pa-2" Style="overflow-x:auto">
        @if (_parts.Count == 0)
        {
            <MudText Class="mud-text-secondary">No parts yet.@(MaterialsFormat.CanEdit(User) ? " Add the parts you buy and build." : "")</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true" Elevation="0" data-testid="parts">
<caption class="wb-sr-only">Parts</caption>
                <thead><tr><th scope="col">Part</th><th scope="col">Description</th><th scope="col">Make/buy</th><th scope="col">Tracking</th><th scope="col">Costing</th><th scope="col" style="text-align:right">Unit cost</th><th scope="col" style="text-align:right">On hand</th><th scope="col" style="text-align:right">GFM</th><th scope="col" style="text-align:right">Value</th><th scope="col">Vendor</th><th scope="col" style="text-align:right">Lead (days)</th></tr></thead>
                <tbody>
                    @foreach (var p in _parts)
                    {
                        <tr data-testid="@($"part-{p.Number}")">
                            <td style="white-space:nowrap"><MudLink Href="@($"materials/parts/{p.Id}")">@p.Display</MudLink>@if (!p.IsActive) { <span class="mud-text-secondary"> (inactive)</span> }</td>
                            <td>@p.Description</td>
                            <td>@p.Source@(p.HasBom ? " · BOM" : "")</td>
                            <td>@MaterialsFormat.Label(p.Tracking)</td>
                            <td>@MaterialsFormat.Label(p.CostMethod)</td>
                            <td style="text-align:right">@MaterialsFormat.Cost(p.CostMethod == PartCostMethod.Standard ? p.StandardCost : p.AverageCost)</td>
                            <td style="text-align:right">@MaterialsFormat.Qty(p.OnHand) @p.UnitOfMeasure</td>
                            <td style="text-align:right">@(p.OnHandGovernment == 0 ? "" : MaterialsFormat.Qty(p.OnHandGovernment))</td>
                            <td style="text-align:right">@MaterialsFormat.Amount(p.Value)</td>
                            <td>@p.PreferredVendor</td>
                            <td style="text-align:right">@p.LeadTimeDays</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>
}

@code {
    [CascadingParameter] public CurrentUserInfo? User { get; set; }

    private IReadOnlyList<PartSummaryDto> _parts = [];
    private MaterialsOptionsDto? _options;
    private string? _search;
    private PartSourceKind? _source;
    private bool _inactive;
    private string? _error;
    private bool _forbidden;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        try
        {
            _options = await PartService.GetOptionsAsync();
        }
        catch (Exception ex) when (MaterialsFormat.IsExpected(ex))
        {
            _options = null;
        }
    }

    private async Task SetAsync(Action set)
    {
        set();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _parts = await PartService.ListAsync(new PartQuery(_search, !_inactive, _source));
        }
        catch (Exception ex) when (MaterialsFormat.IsExpected(ex))
        {
            (_error, _forbidden) = (MaterialsFormat.Error(ex), MaterialsFormat.IsForbidden(ex));
        }
    }

    private async Task NewAsync()
    {
        var dialog = await DialogService.ShowAsync<PartDialog>("New part", new DialogParameters<PartDialog> { { d => d.Options, _options } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: SavePartRequest request })
        {
            try
            {
                var part = await PartService.CreateAsync(request);
                Navigation.NavigateTo($"materials/parts/{part.Summary.Id}");
            }
            catch (Exception ex) when (MaterialsFormat.IsExpected(ex))
            {
                Snackbar.Add(MaterialsFormat.Error(ex), Severity.Error);
            }
        }
    }
}
