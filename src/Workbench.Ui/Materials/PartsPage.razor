@page "/materials"
@inject IPartService PartService
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IServiceProvider Services

<PageTitle>Parts · Materials · Workbench</PageTitle>

<MaterialsHeader Title="Parts" BackHref="" BackLabel="Home"
                 Subtitle="The part master: what you buy and build, how it's costed and tracked, and what's on hand. Government-furnished material is counted but never valued.">
    @if (MaterialsFormat.CanEdit(User))
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NewAsync" Disabled="_options is null" data-testid="new-part">New part</MudButton>
    }
</MaterialsHeader>

@if (_error is not null)
{
    <MaterialsError Message="@_error" Forbidden="_forbidden" />
}
else
{
    <ConfigurableList T="PartSummaryDto" Definition="_definition" Items="_parts" SearchLabel="Search parts" TestId="parts"
                      RowClick="@(p => Navigation.NavigateTo($"materials/parts/{p.Id}"))">
        <ToolBarContent>
            <MudSelect T="PartSourceKind?" Value="_source" ValueChanged="v => SetAsync(() => _source = v)" Label="Make or buy" Clearable="true" Dense="true" Style="min-width:140px">
                <MudSelectItem T="PartSourceKind?" Value="PartSourceKind.Buy">Buy</MudSelectItem>
                <MudSelectItem T="PartSourceKind?" Value="PartSourceKind.Make">Make</MudSelectItem>
            </MudSelect>
            <MudSwitch T="bool" Value="_inactive" ValueChanged="v => SetAsync(() => _inactive = v)" Label="Show inactive" Color="Color.Primary" />
        </ToolBarContent>
        <NoRecordsContent>
            <MudText Class="mud-text-secondary">No parts yet.@(MaterialsFormat.CanEdit(User) ? " Add the parts you buy and build." : "")</MudText>
        </NoRecordsContent>
        <Summary>
            <MudText Class="mt-2 px-2" data-testid="inventory-value">Inventory value <b>@MaterialsFormat.Amount(context.Sum(p => p.Value))</b></MudText>
        </Summary>
    </ConfigurableList>
}

@code {
    [CascadingParameter] public CurrentUserInfo? User { get; set; }

    private IReadOnlyList<PartSummaryDto> _parts = [];
    private MaterialsOptionsDto? _options;
    private PartSourceKind? _source;
    private bool _inactive;
    private string? _error;
    private bool _forbidden;

    internal static readonly ListDefinition<PartSummaryDto> _definition = new()
    {
        ListKey = CustomizableLists.Parts,
        EntityType = CustomizableEntities.Part,
        Title = "Parts",
        Id = p => p.Id,
        Columns =
        [
            new() { Key = "part", Title = "Part", Value = p => p.Number, Display = p => p.Display, Groupable = false,
                    Cell = p => @<span style="white-space:nowrap" data-testid="@($"part-{p.Number}")"><MudLink Href="@($"materials/parts/{p.Id}")">@p.Display</MudLink>@if (!p.IsActive) { <span class="mud-text-secondary"> (inactive)</span> }</span> },
            new() { Key = "description", Title = "Description", Value = p => p.Description, Groupable = false },
            new() { Key = "source", Title = "Make/buy", Value = p => p.Source, Display = p => $"{p.Source}{(p.HasBom ? " · BOM" : "")}" },
            new() { Key = "tracking", Title = "Tracking", Value = p => p.Tracking, Display = p => MaterialsFormat.Label(p.Tracking) },
            new() { Key = "costing", Title = "Costing", Value = p => p.CostMethod, Display = p => MaterialsFormat.Label(p.CostMethod) },
            new() { Key = "unitCost", Title = "Unit cost", Value = p => p.CostMethod == PartCostMethod.Standard ? p.StandardCost : p.AverageCost, Kind = ListColumnKind.Money, Groupable = false,
                    Cell = p => @<text>@MaterialsFormat.Cost(p.CostMethod == PartCostMethod.Standard ? p.StandardCost : p.AverageCost)</text> },
            new() { Key = "onHand", Title = "On hand", Value = p => p.OnHand, Kind = ListColumnKind.Number, Groupable = false, Cell = p => @<text>@MaterialsFormat.Qty(p.OnHand) @p.UnitOfMeasure</text> },
            new() { Key = "gfm", Title = "GFM", Value = p => p.OnHandGovernment == 0 ? null : p.OnHandGovernment, Kind = ListColumnKind.Number, Groupable = false,
                    Cell = p => @<text>@(p.OnHandGovernment == 0 ? "" : MaterialsFormat.Qty(p.OnHandGovernment))</text> },
            new() { Key = "value", Title = "Value", Value = p => p.Value, Kind = ListColumnKind.Money, Groupable = false, Cell = p => @<text>@MaterialsFormat.Amount(p.Value)</text> },
            new() { Key = "vendor", Title = "Vendor", Value = p => p.PreferredVendor },
            new() { Key = "lead", Title = "Lead (days)", Value = p => p.LeadTimeDays, Kind = ListColumnKind.Number, Groupable = false },
            new() { Key = "uom", Title = "Unit", Value = p => p.UnitOfMeasure, Standard = false },
            new() { Key = "active", Title = "Active", Value = p => p.IsActive, Kind = ListColumnKind.Bool, Standard = false },
        ],
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        try
        {
            _options = await PartService.GetOptionsAsync();
        }
        catch (Exception ex) when (MaterialsFormat.IsExpected(ex))
        {
            _options = null;
        }
    }

    private async Task SetAsync(Action set)
    {
        set();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _parts = await PartService.ListAsync(new PartQuery(null, !_inactive, _source));
        }
        catch (Exception ex) when (MaterialsFormat.IsExpected(ex))
        {
            (_error, _forbidden) = (MaterialsFormat.Error(ex), MaterialsFormat.IsForbidden(ex));
        }
    }

    private async Task NewAsync()
    {
        var custom = new CustomFieldValues();
        var dialog = await DialogService.ShowAsync<PartDialog>("New part", new DialogParameters<PartDialog> { { d => d.Options, _options }, { d => d.CustomValues, custom } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: SavePartRequest request })
        {
            try
            {
                var part = await PartService.CreateAsync(request);
                await ConfigurableForm.SaveCustomFieldsAsync(Services, CustomizableEntities.Part, part.Summary.Id, custom);
                Navigation.NavigateTo($"materials/parts/{part.Summary.Id}");
            }
            catch (Exception ex) when (MaterialsFormat.IsExpected(ex))
            {
                Snackbar.Add(MaterialsFormat.Error(ex), Severity.Error);
            }
        }
    }
}
