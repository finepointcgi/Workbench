@* Government-furnished material received for a project (FAR 52.245-1): quantity and traceability only, never a cost. *@
<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudSelect T="Guid?" @bind-Value="_partId" Label="Part" Dense="true" Required="true">
                    @foreach (var p in Parts) { <MudSelectItem T="Guid?" Value="p.Id">@p.Display · @p.Description</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="Guid?" @bind-Value="_projectId" Label="Furnished for project" Dense="true" Required="true">
                    @foreach (var p in Options.Projects) { <MudSelectItem T="Guid?" Value="p.Id">@p.Code · @p.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="6"><MudDatePicker @bind-Date="_date" Label="Received on" DateFormat="yyyy-MM-dd" Editable="true" AutoClose="true" /></MudItem>
            <MudItem xs="6"><MudNumericField T="decimal" @bind-Value="_quantity" Label="Quantity" Min="0" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12"><BinSelect Options="Options" @bind-Value="_binId" Label="Put away to" /></MudItem>
            <MudItem xs="12"><MudTextField T="string" @bind-Value="_reference" Label="Shipping document (e.g. DD Form 1149 number)" Required="true" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6"><MudTextField T="string" @bind-Value="_lot" Label="Lot (if tracked)" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6"><MudTextField T="string" @bind-Value="_serials" Label="Serial numbers (if tracked)" Margin="Margin.Dense" /></MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_partId is null || _projectId is null || _binId is null || _quantity <= 0 || string.IsNullOrWhiteSpace(_reference) || _date is null)"
                   OnClick="Save" data-testid="gfm-save">Receive</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public MaterialsOptionsDto Options { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<PartSummaryDto> Parts { get; set; } = [];

    private Guid? _partId;
    private Guid? _projectId;
    private DateTime? _date = DateTime.Today;
    private decimal _quantity;
    private Guid? _binId;
    private string? _reference;
    private string? _lot;
    private string? _serials;

    private void Save()
    {
        var serials = (_serials ?? "").Split([',', ' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var warehouse = Options.Warehouses.First(w => w.Bins.Any(b => b.Id == _binId)).Id;
        MudDialog.Close(DialogResult.Ok(new GovernmentReceiptRequest(_partId!.Value, _projectId!.Value, _quantity, DateOnly.FromDateTime(_date!.Value), warehouse, _binId!.Value,
            _reference!, _lot, serials.Length == 0 ? null : serials)));
    }
}
