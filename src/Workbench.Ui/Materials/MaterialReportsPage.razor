@page "/materials/reports"
@inject IMaterialReportService Reports
@inject IInventoryService Inventory

<PageTitle>Inventory reports · Materials · Workbench</PageTitle>

<MaterialsHeader Title="Inventory reports" Subtitle="Valuation against the GL, aging, the government-furnished material listing, work in process and lot/serial traceability."><MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.LocalShipping" Href="materials/landed-cost" data-testid="reports-landed-cost">Landed cost</MudButton><MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FactCheck" Href="materials/physical-inventory">Physical inventory</MudButton></MaterialsHeader>

<MudTabs Elevation="0" Rounded="true" TabPanelsClass="pt-3" ActivePanelIndexChanged="TabAsync">
    <MudTabPanel Text="Valuation">
        @if (_valuation is { } v)
        {
            <MudStack Row="true" Spacing="4" Wrap="Wrap.Wrap" Class="mb-2">
                <MudText>Inventory at cost <b>@MaterialsFormat.Amount(v.TotalValue)</b></MudText>
                <MudText>GL inventory <b>@MaterialsFormat.Amount(v.GlInventory)</b></MudText>
                <MudText>Stock WIP <b>@MaterialsFormat.Amount(v.WipValue)</b></MudText>
                <MudText>GL WIP <b>@MaterialsFormat.Amount(v.GlWip)</b></MudText>
            </MudStack>
            @foreach (var n in v.Notes) { <MudText Typo="Typo.body2" Class="mud-text-secondary">@n</MudText> }
            <MudPaper Outlined="true" Class="pa-2 mt-2" Style="overflow-x:auto">
                <MudSimpleTable Dense="true" Elevation="0" data-testid="valuation">
<caption class="wb-sr-only">Inventory valuation</caption>
                    <thead><tr><th scope="col">Part</th><th scope="col">Costing</th><th scope="col" style="text-align:right">Quantity</th><th scope="col" style="text-align:right">Unit cost</th><th scope="col" style="text-align:right">Value</th><th scope="col" style="text-align:right">Of which contract</th></tr></thead>
                    <tbody>
                        @foreach (var r in v.Rows)
                        {
                            <tr><td><MudLink Href="@($"materials/parts/{r.PartId}")">@r.PartNumber</MudLink> <span class="mud-text-secondary">@r.PartDescription</span></td><td>@MaterialsFormat.Label(r.CostMethod)</td>
                                <td style="text-align:right">@MaterialsFormat.Qty(r.Quantity)</td><td style="text-align:right">@MaterialsFormat.Cost(r.UnitCost)</td><td style="text-align:right">@MaterialsFormat.Amount(r.Value)</td>
                                <td style="text-align:right">@(r.ContractQuantity == 0 ? "" : $"{MaterialsFormat.Qty(r.ContractQuantity)} · {MaterialsFormat.Amount(r.ContractValue)}")</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        }
    </MudTabPanel>
    <MudTabPanel Text="Aging">
        @if (_aging is { } a)
        {
            <MudPaper Outlined="true" Class="pa-2" Style="overflow-x:auto">
                <MudSimpleTable Dense="true" Elevation="0">
<caption class="wb-sr-only">Inventory aging as of @MaterialsFormat.Date(a.AsOf)</caption>
                    <thead><tr><th scope="col">Part</th><th scope="col" style="text-align:right">0–90 days</th><th scope="col" style="text-align:right">91–180</th><th scope="col" style="text-align:right">181–365</th><th scope="col" style="text-align:right">Over a year</th><th scope="col" style="text-align:right">Total</th></tr></thead>
                    <tbody>
                        @foreach (var r in a.Rows)
                        {
                            <tr><td>@r.PartNumber <span class="mud-text-secondary">@r.PartDescription</span></td><td style="text-align:right">@MaterialsFormat.Amount(r.Days0To90)</td><td style="text-align:right">@MaterialsFormat.Amount(r.Days91To180)</td>
                                <td style="text-align:right">@MaterialsFormat.Amount(r.Days181To365)</td><td style="text-align:right">@MaterialsFormat.Amount(r.Over365)</td><td style="text-align:right">@MaterialsFormat.Amount(r.Total)</td></tr>
                        }
                        <tr><th scope="row">Total</th><td style="text-align:right"><b>@MaterialsFormat.Amount(a.Days0To90)</b></td><td style="text-align:right"><b>@MaterialsFormat.Amount(a.Days91To180)</b></td><td style="text-align:right"><b>@MaterialsFormat.Amount(a.Days181To365)</b></td><td style="text-align:right"><b>@MaterialsFormat.Amount(a.Over365)</b></td><td style="text-align:right"><b>@MaterialsFormat.Amount(a.Total)</b></td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        }
    </MudTabPanel>
    <MudTabPanel Text="Government-furnished">
        <MudText Class="mud-text-secondary mb-2">Government property in our custody (FAR 52.245-1): tracked by project, location, lot and serial; never valued or costed.</MudText>
        <MudPaper Outlined="true" Class="pa-2" Style="overflow-x:auto">
            @if (_gfm.Count == 0)
            {
                <MudText Class="mud-text-secondary">No government-furnished material on hand.</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Elevation="0" data-testid="gfm">
<caption class="wb-sr-only">Government-furnished material</caption>
                    <thead><tr><th scope="col">Project</th><th scope="col">Part</th><th scope="col">Location</th><th scope="col">Lot</th><th scope="col">Serial</th><th scope="col" style="text-align:right">Quantity</th><th scope="col">Received</th><th scope="col">Document</th></tr></thead>
                    <tbody>
                        @foreach (var g in _gfm)
                        {
                            <tr><td>@g.ProjectCode <span class="mud-text-secondary">@g.ProjectName</span></td><td>@g.PartNumber <span class="mud-text-secondary">@g.PartDescription</span></td><td>@g.Location</td><td>@g.Lot</td><td>@g.Serial</td>
                                <td style="text-align:right">@MaterialsFormat.Qty(g.Quantity) @g.UnitOfMeasure</td><td>@MaterialsFormat.Date(g.ReceivedOn)</td><td>@g.Reference</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>
    </MudTabPanel>
    @if (User?.Can(Workbench.Contracts.Identity.Permission.MaterialsCosting) == true)
    {
        <MudTabPanel Text="Work in process">
            @if (_wip is { } w)
            {
                <MudStack Row="true" Spacing="4" Class="mb-2" Wrap="Wrap.Wrap">
                    <MudText>Stock WIP <b>@MaterialsFormat.Amount(w.StockWipBalance)</b></MudText>
                    <MudText>GL WIP <b>@MaterialsFormat.Amount(w.GlWip)</b></MudText>
                    <MudText>Collected on project orders <b>@MaterialsFormat.Amount(w.ProjectCollectedCost)</b> (already project cost)</MudText>
                </MudStack>
                <MudPaper Outlined="true" Class="pa-2" Style="overflow-x:auto">
                    <MudSimpleTable Dense="true" Elevation="0" data-testid="wip">
<caption class="wb-sr-only">Work in process</caption>
                        <thead><tr><th scope="col">Work order</th><th scope="col">Part</th><th scope="col">For</th><th scope="col">Status</th><th scope="col" style="text-align:right">Material</th><th scope="col" style="text-align:right">Labor</th><th scope="col" style="text-align:right">Scrap</th><th scope="col" style="text-align:right">Completed</th><th scope="col" style="text-align:right">WIP</th></tr></thead>
                        <tbody>
                            @foreach (var r in w.Rows)
                            {
                                <tr><td><MudLink Href="@($"materials/work-orders/{r.WorkOrderId}")">@r.Number</MudLink></td><td>@r.PartNumber</td><td>@(r.ProjectCode ?? "Stock")</td><td>@MaterialsFormat.Label(r.Status)</td>
                                    <td style="text-align:right">@MaterialsFormat.Amount(r.MaterialCost)</td><td style="text-align:right">@MaterialsFormat.Amount(r.LaborCost)</td><td style="text-align:right">@MaterialsFormat.Amount(r.ScrapCost)</td>
                                    <td style="text-align:right">@MaterialsFormat.Amount(r.CompletedCost)</td><td style="text-align:right">@(r.IsForProject ? "—" : MaterialsFormat.Amount(r.WipBalance))</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            }
        </MudTabPanel>
    }
    <MudTabPanel Text="Lot / serial trace">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
            <MudTextField T="string" @bind-Value="_lot" Label="Lot" Margin="Margin.Dense" Style="max-width:180px" />
            <MudTextField T="string" @bind-Value="_serial" Label="Serial" Margin="Margin.Dense" Style="max-width:180px" />
            <MudButton Variant="Variant.Outlined" Disabled="@(string.IsNullOrWhiteSpace(_lot) && string.IsNullOrWhiteSpace(_serial))" OnClick="TraceAsync" data-testid="trace">Trace</MudButton>
        </MudStack>
        @if (_trace is { } t)
        {
            <MudText Typo="Typo.subtitle1" HtmlTag="h2">History</MudText>
            <MudPaper Outlined="true" Class="pa-2 mb-3" Style="overflow-x:auto"><TransactionsTable Transactions="t.History" ShowPart="true" Caption="Trace history" /></MudPaper>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle1" HtmlTag="h2">Made from</MudText>
                    @TraceList(t.MadeFrom, "Components it was made from")
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle1" HtmlTag="h2">Used in</MudText>
                    @TraceList(t.UsedIn, "Finished units it went into")
                </MudItem>
            </MudGrid>
        }
    </MudTabPanel>
</MudTabs>

@code {
    [CascadingParameter] public CurrentUserInfo? User { get; set; }

    private InventoryValuationDto? _valuation;
    private InventoryAgingDto? _aging;
    private IReadOnlyList<GfmRowDto> _gfm = [];
    private WipReportDto? _wip;
    private TraceDto? _trace;
    private string? _lot;
    private string? _serial;

    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _valuation = await Reports.ValuationAsync();
            _aging = await Reports.AgingAsync();
            _gfm = await Reports.GovernmentFurnishedAsync();
        }
        catch (Exception ex) when (MaterialsFormat.IsExpected(ex))
        {
            Snackbar.Add(MaterialsFormat.Error(ex), Severity.Error);
        }
    }

    private async Task TabAsync(int index)
    {
        if (index == 3 && User?.Can(Workbench.Contracts.Identity.Permission.MaterialsCosting) == true && _wip is null)
        {
            try
            {
                _wip = await Reports.WipAsync();
            }
            catch (Exception ex) when (MaterialsFormat.IsExpected(ex))
            {
                Snackbar.Add(MaterialsFormat.Error(ex), Severity.Error);
            }
        }
    }

    private async Task TraceAsync()
    {
        try
        {
            _trace = await Inventory.TraceAsync(_lot, _serial);
        }
        catch (Exception ex) when (MaterialsFormat.IsExpected(ex))
        {
            Snackbar.Add(MaterialsFormat.Error(ex), Severity.Error);
        }
    }

    private RenderFragment TraceList(IReadOnlyList<TraceNodeDto> nodes, string caption) => __builder =>
    {
        if (nodes.Count == 0)
        {
            <MudText Class="mud-text-secondary">None.</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Elevation="0">
<caption class="wb-sr-only">@caption</caption>
                <thead><tr><th scope="col">Part</th><th scope="col">Lot</th><th scope="col">Serial</th><th scope="col" style="text-align:right">Qty</th><th scope="col">Work order</th><th scope="col">Date</th></tr></thead>
                <tbody>
                    @foreach (var n in nodes)
                    {
                        <tr><td>@n.PartNumber</td><td>@n.Lot</td><td>@n.Serial</td><td style="text-align:right">@MaterialsFormat.Qty(n.Quantity)</td><td>@n.Document</td><td>@MaterialsFormat.Date(n.Date)</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    };
}
