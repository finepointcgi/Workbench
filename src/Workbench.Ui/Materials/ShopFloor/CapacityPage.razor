@page "/materials/capacity"
@using Workbench.Contracts.Sheets
@using Workbench.Ui.Gantt
@inject ICapacitySchedulingService Capacity
@inject ISnackbar Snackbar

<PageTitle>Capacity schedule · Materials · Workbench</PageTitle>

<MaterialsHeader Title="Capacity schedule" Subtitle="Open work order operations placed against each work center's hours. Drag a bar to set its start, or change a work center's queue order." />

@if (_error is not null)
{
    <MaterialsError Message="@_error" Forbidden="_forbidden" />
}
else if (_schedule is not { } s)
{
    <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (Editable)
    {
        <MudPaper Outlined="true" Class="pa-3 mb-3">
            <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                <MudSelect T="ScheduleMode" @bind-Value="_direction" Label="Schedule" Dense="true" Style="min-width:230px">
                    <MudSelectItem T="ScheduleMode" Value="ScheduleMode.Forward">Forward from each order's start</MudSelectItem>
                    <MudSelectItem T="ScheduleMode" Value="ScheduleMode.Backward">Backward from each order's due date</MudSelectItem>
                </MudSelect>
                <MudSwitch T="bool" @bind-Value="_finite" Label="@(_finite ? "Within capacity" : "Ignore capacity (show overload)")" Color="Color.Primary" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunAsync" Disabled="_busy" data-testid="capacity-run">Schedule now</MudButton>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @(s.RunAtUtc is { } at ? $"Last scheduled {at.ToLocalTime():MMM d, h:mm tt} · {(s.Direction == ScheduleMode.Forward ? "forward" : "backward")}, {(s.Finite ? "within capacity" : "ignoring capacity")}" : "Not scheduled yet.")
                </MudText>
            </MudStack>
        </MudPaper>
    }
    @if (s.LateCount > 0)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2" data-testid="capacity-late">@s.LateCount @(s.LateCount == 1 ? "operation ends" : "operations end") after the work order's due date.</MudAlert>
    }
    @foreach (var m in s.Messages)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">@m</MudAlert>
    }

    <MudTabs Elevation="0" Rounded="true" TabPanelsClass="pt-3">
        <MudTabPanel Text="Load by week">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" aria-label="Earlier weeks" OnClick="() => ShiftAsync(-4)" />
                <MudText>Weeks from @MaterialsFormat.Date(s.From)</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="Later weeks" OnClick="() => ShiftAsync(4)" />
            </MudStack>
            <MudPaper Outlined="true" Class="pa-2" Style="overflow-x:auto">
                <MudSimpleTable Dense="true" Elevation="0" data-testid="capacity-load">
                    <caption class="wb-sr-only">Scheduled hours and capacity by work center and week</caption>
                    <thead>
                        <tr>
                            <th scope="col">Work center</th>
                            @foreach (var w in s.Weeks) { <th scope="col" style="min-width:110px">Week of @w.ToString("MMM d", CultureInfo.InvariantCulture)</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in s.Load)
                        {
                            <tr>
                                <th scope="row">@c.Code <span class="mud-text-secondary">@c.Name</span></th>
                                @foreach (var w in c.Weeks)
                                {
                                    var pct = w.Capacity > 0 ? (double)(w.Load / w.Capacity) : w.Load > 0 ? 1.5 : 0;
                                    <td>
                                        <div class="load-bar" aria-hidden="true">
                                            <div class="@(w.IsOverloaded ? "load-fill over" : "load-fill")" style="width:@(Math.Min(100, pct * 100).ToString("0", CultureInfo.InvariantCulture))%"></div>
                                        </div>
                                        <span class="@(w.IsOverloaded ? "load-text over" : "load-text")">@MaterialsFormat.Qty(w.Load) / @MaterialsFormat.Qty(w.Capacity) h</span>
                                        @if (w.IsOverloaded) { <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="my-0 ml-1">Over</MudChip> }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="Timeline">
            @if (_rows.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Nothing is scheduled. Release work orders with routings, then schedule.</MudAlert>
            }
            else
            {
                <div class="capacity-gantt">
                    <div class="capacity-list" role="table" aria-label="Scheduled operations">
                        <div class="capacity-head" role="row" style="height:@(GanttLayout.HeaderHeight.ToString(CultureInfo.InvariantCulture))px"><span role="columnheader">Operation</span></div>
                        @foreach (var row in _rows)
                        {
                            <div class="@(row.IsSummary ? "capacity-row summary" : "capacity-row")" role="row" style="height:@(GanttLayout.RowHeight.ToString(CultureInfo.InvariantCulture))px">
                                <span role="cell" style="padding-left:@((4 + row.Depth * 16).ToString(CultureInfo.InvariantCulture))px">
                                    @row.Item.Title
                                    @if (!row.IsSummary && _ops.TryGetValue(row.Item.Id, out var op))
                                    {
                                        @if (op.IsLate) { <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="my-0 ml-1">Late</MudChip> }
                                        @if (op.IsPinned) { <MudChip T="string" Size="Size.Small" Class="my-0 ml-1">Pinned</MudChip> }
                                    }
                                </span>
                            </div>
                        }
                    </div>
                    <GanttTimeline Rows="_rows" Scale="_scale" Today="MaterialsFormat.Today" OnBarDropped="DropAsync" />
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
                    @(Editable ? "Drag a bar to pin the operation to a new start date; the rest is rescheduled around it. Without a mouse, use the queues below." : "Only the Materials role changes the schedule.")
                </MudText>
            }
        </MudTabPanel>

        <MudTabPanel Text="Queues">
            @foreach (var group in s.Operations.GroupBy(o => o.WorkCenterId))
            {
                var list = group.OrderBy(o => o.QueuePosition).ToList();
                <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="mt-2 mb-1">@list[0].WorkCenter</MudText>
                <MudPaper Outlined="true" Class="pa-2 mb-2" Style="overflow-x:auto">
                    <MudSimpleTable Dense="true" Elevation="0" data-testid="@($"queue-{list[0].WorkCenter}")">
                        <caption class="wb-sr-only">@list[0].WorkCenter queue</caption>
                        <thead><tr><th scope="col">#</th><th scope="col">Work order</th><th scope="col">Operation</th><th scope="col" style="text-align:right">Open hours</th><th scope="col">Start</th><th scope="col">End</th><th scope="col">Due</th>@if (Editable) { <th scope="col"><span class="wb-sr-only">Order</span></th> }</tr></thead>
                        <tbody>
                            @for (var i = 0; i < list.Count; i++)
                            {
                                var o = list[i];
                                var index = i;
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td><MudLink Href="@($"materials/work-orders/{o.WorkOrderId}")">@o.WorkOrderNumber</MudLink> <span class="mud-text-secondary">@o.PartNumber</span></td>
                                    <td>@o.Sequence @o.Description</td>
                                    <td style="text-align:right">@MaterialsFormat.Qty(o.Hours)</td>
                                    <td>@MaterialsFormat.Date(o.Start)@if (o.IsPinned) { <span class="mud-text-secondary"> (pinned)</span> }</td>
                                    <td>@MaterialsFormat.Date(o.End)@if (o.IsLate) { <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="my-0 ml-1">Late</MudChip> }</td>
                                    <td>@MaterialsFormat.Date(o.DueDate)</td>
                                    @if (Editable)
                                    {
                                        <td style="white-space:nowrap">
                                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="@(index == 0 || _busy)" OnClick="() => MoveInQueueAsync(list, index, -1)" aria-label="@($"Move {o.WorkOrderNumber} up")" />
                                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="@(index == list.Count - 1 || _busy)" OnClick="() => MoveInQueueAsync(list, index, 1)" aria-label="@($"Move {o.WorkOrderNumber} down")" />
                                            @if (o.IsPinned) { <MudButton Size="Size.Small" OnClick="() => PinAsync(o.Id, null)" Disabled="_busy">Unpin</MudButton> }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            }
            @if (s.Operations.Count == 0)
            {
                <MudText Class="mud-text-secondary">No operations scheduled.</MudText>
            }
        </MudTabPanel>

        <MudTabPanel Text="Work center calendars">
            @foreach (var c in _calendars)
            {
                <MudPaper Outlined="true" Class="pa-3 mb-2" data-testid="@($"calendar-{c.Code}")">
                    <MudText Typo="Typo.subtitle1" HtmlTag="h2">@c.Code <span class="mud-text-secondary">@c.Name</span></MudText>
                    <MudText Class="mud-text-secondary mb-2">@ShopFloorFormat.Weekdays(c.WorkingDays) · @MaterialsFormat.Qty(c.HoursPerDay) h × @c.Units = @MaterialsFormat.Qty(c.DailyCapacity) h a day</MudText>
                    @if (Editable && _edits.TryGetValue(c.WorkCenterId, out var e))
                    {
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                            @for (var d = 0; d < 7; d++)
                            {
                                var day = d;
                                <MudCheckBox T="bool" Value="e.Days[day]" ValueChanged="v => e.Days[day] = v" Label="@(new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" }[day])" Dense="true" />
                            }
                            <MudNumericField T="decimal" @bind-Value="e.Hours" Label="Hours a day" Min="0" Max="24" Margin="Margin.Dense" Style="max-width:120px" />
                            <MudNumericField T="int" @bind-Value="e.Units" Label="Units in parallel" Min="1" Max="100" Margin="Margin.Dense" Style="max-width:140px" />
                            <MudButton Variant="Variant.Outlined" OnClick="() => SaveCalendarAsync(c.WorkCenterId)" Disabled="_busy">Save</MudButton>
                        </MudStack>
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mt-2">
                            <MudDatePicker @bind-Date="e.ExceptionDate" Label="Different day" DateFormat="yyyy-MM-dd" Editable="true" AutoClose="true" Style="max-width:160px" />
                            <MudNumericField T="decimal" @bind-Value="e.ExceptionHours" Label="Hours that day" Min="0" Margin="Margin.Dense" Style="max-width:130px" />
                            <MudTextField T="string" @bind-Value="e.ExceptionReason" Label="Why (holiday, overtime)" Margin="Margin.Dense" Style="max-width:220px" />
                            <MudButton Variant="Variant.Outlined" OnClick="() => AddExceptionAsync(c.WorkCenterId)" Disabled="@(_busy || e.ExceptionDate is null)">Add</MudButton>
                        </MudStack>
                    }
                    @foreach (var x in c.Exceptions)
                    {
                        <MudText Typo="Typo.body2">
                            @MaterialsFormat.Date(x.Date): @MaterialsFormat.Qty(x.Hours) h@(x.Reason is { } r ? $" · {r}" : "")
                            @if (Editable) { <MudButton Size="Size.Small" OnClick="() => DeleteExceptionAsync(x.Id)" aria-label="@($"Remove {MaterialsFormat.Date(x.Date)}")">Remove</MudButton> }
                        </MudText>
                    }
                </MudPaper>
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    [CascadingParameter] public CurrentUserInfo? User { get; set; }

    private sealed class CalendarEdit
    {
        public bool[] Days { get; init; } = new bool[7];
        public decimal Hours { get; set; }
        public int Units { get; set; }
        public DateTime? ExceptionDate { get; set; }
        public decimal ExceptionHours { get; set; }
        public string? ExceptionReason { get; set; }
    }

    private CapacityScheduleDto? _schedule;
    private IReadOnlyList<WorkCenterCalendarDto> _calendars = [];
    private readonly Dictionary<Guid, CalendarEdit> _edits = [];
    private IReadOnlyList<GanttRow> _rows = [];
    private Dictionary<Guid, ScheduledOperationDto> _ops = [];
    private GanttScale _scale = default!;
    private ScheduleMode _direction = ScheduleMode.Forward;
    private bool _finite = true;
    private DateOnly? _from;
    private string? _error;
    private bool _forbidden;
    private bool _busy;

    private bool Editable => MaterialsFormat.CanEdit(User);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Show(await Capacity.GetAsync());
            await LoadCalendarsAsync();
            (_direction, _finite) = (_schedule!.Direction, _schedule.Finite);
        }
        catch (Exception ex) when (MaterialsFormat.IsExpected(ex))
        {
            (_error, _forbidden) = (MaterialsFormat.Error(ex), MaterialsFormat.IsForbidden(ex));
        }
    }

    private async Task LoadCalendarsAsync()
    {
        _calendars = await Capacity.ListCalendarsAsync();
        _edits.Clear();
        foreach (var c in _calendars)
        {
            _edits[c.WorkCenterId] = new CalendarEdit { Days = c.WorkingDays.Select(ch => ch == 'Y').ToArray(), Hours = c.HoursPerDay, Units = c.Units };
        }
    }

    private void Show(CapacityScheduleDto schedule)
    {
        _schedule = schedule;
        _ops = schedule.Operations.ToDictionary(o => o.Id);
        var items = new List<ItemDto>();
        var order = 0;
        foreach (var group in schedule.Operations.Where(o => o.Start is not null).GroupBy(o => (o.WorkCenterId, o.WorkCenter)).OrderBy(g => g.Key.WorkCenter, StringComparer.Ordinal))
        {
            items.Add(new ItemDto(group.Key.WorkCenterId, null, order++, group.Key.WorkCenter, null, null, null, new Dictionary<string, string?>()));
            foreach (var o in group.OrderBy(o => o.QueuePosition))
            {
                items.Add(new ItemDto(o.Id, group.Key.WorkCenterId, o.QueuePosition, $"{o.WorkOrderNumber} · {o.Sequence} {o.Description}", o.Start, o.End ?? o.Start, null,
                    new Dictionary<string, string?>()));
            }
        }

        _rows = GanttLayout.BuildRows(items, new HashSet<Guid>());
        _scale = GanttScale.Create(GanttZoom.Day, items.SelectMany(i => new[] { i.Start, i.Finish }).OfType<DateOnly>(), MaterialsFormat.Today);
    }

    private async Task RunActionAsync(Func<Task<CapacityScheduleDto>> action, string message)
    {
        _busy = true;
        try
        {
            Show(await action());
            Snackbar.Add(message, Severity.Success);
        }
        catch (Exception ex) when (MaterialsFormat.IsExpected(ex))
        {
            Snackbar.Add(MaterialsFormat.Error(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task RunAsync() => RunActionAsync(() => Capacity.RunAsync(new RunScheduleRequest(_direction, _finite)), "Scheduled.");

    private async Task ShiftAsync(int weeks)
    {
        _from = (_from ?? _schedule!.From).AddDays(7 * weeks);
        try
        {
            Show(await Capacity.GetAsync(_from));
        }
        catch (Exception ex) when (MaterialsFormat.IsExpected(ex))
        {
            Snackbar.Add(MaterialsFormat.Error(ex), Severity.Error);
        }
    }

    private Task PinAsync(Guid scheduleId, DateOnly? start) =>
        RunActionAsync(() => Capacity.MoveAsync(scheduleId, new MoveOperationRequest(start)), start is null ? "Unpinned and rescheduled." : $"Pinned to {MaterialsFormat.Date(start)} and rescheduled.");

    private Task DropAsync(GanttBarDrop drop)
    {
        if (!Editable || drop.Row.IsSummary || drop.Row.Start is not { } start || drop.Days == 0)
        {
            return Task.CompletedTask;
        }

        return PinAsync(drop.Row.Item.Id, start.AddDays(drop.Days));
    }

    private Task MoveInQueueAsync(List<ScheduledOperationDto> list, int index, int by)
    {
        var ids = list.Select(o => o.Id).ToList();
        (ids[index], ids[index + by]) = (ids[index + by], ids[index]);
        return RunActionAsync(() => Capacity.ResequenceAsync(list[0].WorkCenterId, new ResequenceRequest(ids)), "Queue reordered and rescheduled.");
    }

    private async Task CalendarActionAsync(Func<Task> action, string message)
    {
        _busy = true;
        try
        {
            await action();
            await LoadCalendarsAsync();
            Snackbar.Add(message, Severity.Success);
        }
        catch (Exception ex) when (MaterialsFormat.IsExpected(ex))
        {
            Snackbar.Add(MaterialsFormat.Error(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task SaveCalendarAsync(Guid id)
    {
        var e = _edits[id];
        return CalendarActionAsync(() => Capacity.SaveCalendarAsync(id, new SaveWorkCenterCalendarRequest(new string(e.Days.Select(d => d ? 'Y' : 'N').ToArray()), e.Hours, e.Units)),
            "Calendar saved. Schedule again to use it.");
    }

    private Task AddExceptionAsync(Guid id)
    {
        var e = _edits[id];
        return CalendarActionAsync(() => Capacity.SaveExceptionAsync(id, new SaveCapacityExceptionRequest(DateOnly.FromDateTime(e.ExceptionDate!.Value), e.ExceptionHours, e.ExceptionReason)),
            "Day added. Schedule again to use it.");
    }

    private Task DeleteExceptionAsync(Guid exceptionId) => CalendarActionAsync(() => Capacity.DeleteExceptionAsync(exceptionId), "Day removed.");
}
