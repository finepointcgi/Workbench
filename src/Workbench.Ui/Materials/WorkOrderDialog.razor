@* A new work order: for a project (its WBS element is charged and is the shop floor's timesheet charge code) or to stock. *@
<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudSelect T="Guid?" @bind-Value="_partId" Label="Make part" Dense="true" Required="true">
                    @foreach (var p in Parts.Where(p => p.Source == PartSourceKind.Make && p.IsActive)) { <MudSelectItem T="Guid?" Value="p.Id">@p.Display · @p.Description@(p.HasBom ? "" : " (no BOM)")</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="4"><MudNumericField T="decimal" @bind-Value="_quantity" Label="Quantity" Min="0" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="4"><MudDatePicker @bind-Date="_start" Label="Start" DateFormat="yyyy-MM-dd" Editable="true" AutoClose="true" /></MudItem>
            <MudItem xs="4"><MudDatePicker @bind-Date="_due" Label="Due" DateFormat="yyyy-MM-dd" Editable="true" AutoClose="true" /></MudItem>
            <MudItem xs="12">
                <MudRadioGroup T="bool" @bind-Value="_forProject">
                    <MudRadio T="bool" Value="true" Color="Color.Primary">For a project (cost goes to its WBS element)</MudRadio>
                    <MudRadio T="bool" Value="false" Color="Color.Primary">To stock (cost collects in work in process)</MudRadio>
                </MudRadioGroup>
            </MudItem>
            @if (_forProject)
            {
                <MudItem xs="12">
                    <MudSelect T="Guid?" @bind-Value="_wbsId" Label="Project WBS element" Dense="true" Required="true">
                        @foreach (var c in Options.ChargeCodes) { <MudSelectItem T="Guid?" Value="c.WbsElementId">@c.ProjectCode @c.WbsCode · @c.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
            }
            else
            {
                <MudItem xs="12">
                    <MudSelect T="Guid?" @bind-Value="_laborWbsId" Label="Shop labor charge code (indirect, optional)" Dense="true" Clearable="true">
                        @foreach (var c in Options.IndirectChargeCodes) { <MudSelectItem T="Guid?" Value="c.WbsElementId">@c.ProjectCode @c.WbsCode · @c.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12"><BinSelect Options="Options" @bind-Value="_binId" Label="Complete to (default: the part's location)" Clearable="true" /></MudItem>
            }
            <MudItem xs="12"><MudTextField T="string" @bind-Value="_notes" Label="Notes" Lines="2" Margin="Margin.Dense" /></MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_partId is null || _quantity <= 0 || _start is null || _due is null || (_forProject && _wbsId is null))" OnClick="Save" data-testid="wo-save">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public MaterialsOptionsDto Options { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<PartSummaryDto> Parts { get; set; } = [];

    private Guid? _partId;
    private decimal _quantity = 1;
    private DateTime? _start = DateTime.Today;
    private DateTime? _due = DateTime.Today.AddDays(14);
    private bool _forProject = true;
    private Guid? _wbsId;
    private Guid? _laborWbsId;
    private Guid? _binId;
    private string? _notes;

    private void Save() => MudDialog.Close(DialogResult.Ok(new SaveWorkOrderRequest(_partId!.Value, _quantity, DateOnly.FromDateTime(_start!.Value), DateOnly.FromDateTime(_due!.Value),
        _forProject ? _wbsId : null, _forProject ? null : _laborWbsId, null, _forProject ? null : _binId, _notes)));
}
