@* An opportunity's details: identification, the buy, value and dates, people and probabilities. *@

<ConfigurableForm EntityType="@CustomizableEntities.Opportunity" RecordId="RecordId" ReadOnly="ReadOnly" Spacing="3" @ref="_layout"
                  SectionTitles="@(new Dictionary<string, string> { ["opportunity"] = "The opportunity", ["value"] = "Value and dates", ["people"] = "People and probability" })">
    <FormField Key="name" Md="8">
        <MudTextField T="string" @bind-Value="Model.Name" Label="Name" Required="true" MaxLength="300" ReadOnly="ReadOnly" data-testid="opp-name" />
    </FormField>
    <FormField Key="solicitationNumber" Md="4" Context="field">
        <MudTextField T="string" @bind-Value="Model.SolicitationNumber" Label="Solicitation number" MaxLength="100" ReadOnly="ReadOnly" HelperText="Used to spot duplicates from SAM.gov" Required="field.Required" />
    </FormField>
    <FormField Key="description" Context="field">
        <MudTextField T="string" @bind-Value="Model.Description" Label="Description" Lines="3" MaxLength="4000" ReadOnly="ReadOnly" Required="field.Required" />
    </FormField>
    <FormField Key="agencyAccountId" Md="6" Context="field">
        <MudSelect T="Guid?" @bind-Value="Model.AgencyAccountId" Label="Agency or office" Clearable="true" ReadOnly="ReadOnly" data-testid="opp-agency" Required="field.Required">
            @foreach (var a in Accounts.Where(a => a.Kind.IsGovernment()))
            {
                <MudSelectItem T="Guid?" Value="a.Id">@(a.ParentName is { } p ? $"{a.Name} ({p})" : a.Name)</MudSelectItem>
            }
        </MudSelect>
    </FormField>
    <FormField Key="agencyName" Md="6" Context="field">
        @if (Model.AgencyAccountId is null)
        {
            <MudTextField T="string" @bind-Value="Model.AgencyName" Label="Agency (not an account yet)" MaxLength="300" ReadOnly="ReadOnly" Required="field.Required" />
        }
    </FormField>
    <FormField Key="naicsCode" Xs="6" Md="3" Context="field">
        <MudTextField T="string" @bind-Value="Model.NaicsCode" Label="NAICS" MaxLength="6" ReadOnly="ReadOnly" Required="field.Required" />
    </FormField>
    <FormField Key="setAside" Xs="6" Md="3">
        <MudSelect T="SetAside" @bind-Value="Model.SetAside" Label="Set-aside" ReadOnly="ReadOnly">
            @foreach (var s in Enum.GetValues<SetAside>())
            {
                <MudSelectItem T="SetAside" Value="s">@OpportunityStages.Label(s)</MudSelectItem>
            }
        </MudSelect>
    </FormField>
    <FormField Key="contractVehicle" Xs="6" Md="3" Context="field">
        <MudTextField T="string" @bind-Value="Model.ContractVehicle" Label="Contract vehicle" MaxLength="200" ReadOnly="ReadOnly" HelperText="e.g. GSA MAS, OASIS+, standalone" Required="field.Required" />
    </FormField>
    <FormField Key="contractType" Xs="6" Md="3" Context="field">
        <MudSelect T="ContractKind?" @bind-Value="Model.ContractType" Label="Contract type" Clearable="true" ReadOnly="ReadOnly" Required="field.Required">
            @foreach (var k in Enum.GetValues<ContractKind>())
            {
                <MudSelectItem T="ContractKind?" Value="k">@CrmFormat.ContractKind(k)</MudSelectItem>
            }
        </MudSelect>
    </FormField>
    <FormField Key="placeOfPerformance" Md="6" Context="field">
        <MudTextField T="string" @bind-Value="Model.PlaceOfPerformance" Label="Place of performance" MaxLength="300" ReadOnly="ReadOnly" Required="field.Required" />
    </FormField>
    <FormField Key="kind" Xs="6" Md="3">
        <MudSelect T="OpportunityKind" @bind-Value="Model.Kind" Label="New or recompete" ReadOnly="ReadOnly">
            <MudSelectItem T="OpportunityKind" Value="OpportunityKind.New">New business</MudSelectItem>
            <MudSelectItem T="OpportunityKind" Value="OpportunityKind.Recompete">Recompete</MudSelectItem>
        </MudSelect>
    </FormField>
    <FormField Key="incumbentAccountId" Xs="6" Md="3">
        @if (Model.Kind == OpportunityKind.Recompete)
        {
            <MudSelect T="Guid?" @bind-Value="Model.IncumbentAccountId" Label="Incumbent" Clearable="true" ReadOnly="ReadOnly">
                @foreach (var a in Accounts.Where(a => !a.Kind.IsGovernment()))
                {
                    <MudSelectItem T="Guid?" Value="a.Id">@a.Name</MudSelectItem>
                }
            </MudSelect>
            @if (Model.IncumbentAccountId is null)
            {
                <MudTextField T="string" @bind-Value="Model.IncumbentName" Label="Incumbent (name)" MaxLength="200" ReadOnly="ReadOnly" />
            }
        }
    </FormField>
    <FormField Key="estimatedValue" Section="value" Xs="6" Md="3">
        <MudNumericField T="decimal" @bind-Value="Model.EstimatedValue" Label="Estimated value ($)" Min="0" Format="N0" ReadOnly="ReadOnly" data-testid="opp-value"
                         HelperText="Whole period, options included" />
    </FormField>
    <FormField Key="periodOfPerformanceMonths" Section="value" Xs="6" Md="3">
        <MudNumericField T="int?" @bind-Value="Model.PeriodOfPerformanceMonths" Label="Period of performance (months)" Min="1" Max="600" ReadOnly="ReadOnly" />
    </FormField>
    <FormField Key="estimatedAwardDate" Section="value" Xs="6" Md="3" Context="field">
        <MudDatePicker Label="Estimated award date" @bind-Date="Model.EstimatedAwardDate" DateFormat="yyyy-MM-dd" ReadOnly="ReadOnly" Clearable="true" Required="field.Required" />
    </FormField>
    <FormContent After="estimatedAwardDate" Xs="6" Md="3" />
    <FormField Key="rfiDueOn" Section="value" Xs="6" Md="3" Context="field">
        <MudDatePicker Label="RFI response due" @bind-Date="Model.RfiDueOn" DateFormat="yyyy-MM-dd" ReadOnly="ReadOnly" Clearable="true" Required="field.Required" />
    </FormField>
    <FormField Key="rfpReleaseOn" Section="value" Xs="6" Md="3" Context="field">
        <MudDatePicker Label="RFP release" @bind-Date="Model.RfpReleaseOn" DateFormat="yyyy-MM-dd" ReadOnly="ReadOnly" Clearable="true" Required="field.Required" />
    </FormField>
    <FormField Key="proposalDueOn" Section="value" Xs="6" Md="3" Context="field">
        <MudDatePicker Label="Proposal due" @bind-Date="Model.ProposalDueOn" DateFormat="yyyy-MM-dd" ReadOnly="ReadOnly" Clearable="true" Required="field.Required" />
    </FormField>
    <FormField Key="captureManagerEmail" Section="people" Md="6" Context="field">
        <MudSelect T="string" @bind-Value="Model.CaptureManagerEmail" Label="Capture manager" Clearable="true" ReadOnly="ReadOnly" data-testid="opp-capture" Required="field.Required">
            @foreach (var u in People)
            {
                <MudSelectItem T="string" Value="u.Email">@u.DisplayName (@u.Email)</MudSelectItem>
            }
        </MudSelect>
    </FormField>
    <FormField Key="proposalManagerEmail" Section="people" Md="6" Context="field">
        <MudSelect T="string" @bind-Value="Model.ProposalManagerEmail" Label="Proposal manager" Clearable="true" ReadOnly="ReadOnly" Required="field.Required">
            @foreach (var u in People)
            {
                <MudSelectItem T="string" Value="u.Email">@u.DisplayName (@u.Email)</MudSelectItem>
            }
        </MudSelect>
    </FormField>
    <FormField Key="pwin" Section="people" Xs="6" Md="3">
        <MudNumericField T="int" @bind-Value="Model.Pwin" Label="Pwin (%)" Min="0" Max="100" ReadOnly="ReadOnly" HelperText="Probability we win" />
    </FormField>
    <FormField Key="pgo" Section="people" Xs="6" Md="3">
        <MudNumericField T="int" @bind-Value="Model.Pgo" Label="Pgo (%)" Min="0" Max="100" ReadOnly="ReadOnly" HelperText="Probability it's awarded" />
    </FormField>
    <FormField Key="weightedValue" Section="people" Md="6" ItemClass="d-flex align-center">
        <MudText data-testid="opp-weighted">Weighted value: <strong>@CrmFormat.Money(Model.Weighted)</strong></MudText>
    </FormField>
</ConfigurableForm>

@code {
    [Parameter, EditorRequired] public OpportunityModel Model { get; set; } = default!;

    [Parameter] public IReadOnlyList<CrmAccountDto> Accounts { get; set; } = [];

    [Parameter] public IReadOnlyList<UserDto> People { get; set; } = [];

    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>The opportunity, once saved (its custom field values are read for it).</summary>
    [Parameter] public Guid? RecordId { get; set; }

    private ConfigurableForm? _layout;

    /// <summary>Saves the custom field values (after the opportunity itself is saved).</summary>
    public Task SaveCustomFieldsAsync(Guid opportunityId) => _layout?.SaveCustomFieldsAsync(opportunityId) ?? Task.CompletedTask;
}
