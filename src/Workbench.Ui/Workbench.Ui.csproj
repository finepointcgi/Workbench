<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help center articles and the What's new list, read by Help/HelpLibrary.cs. -->
    <EmbeddedResource Include="Help\Articles\*.md" LogicalName="Workbench.Ui.Help.Articles.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Help\WhatsNew.md" LogicalName="Workbench.Ui.Help.WhatsNew.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Workbench.Contracts\Workbench.Contracts.csproj" />
  </ItemGroup>

</Project>
