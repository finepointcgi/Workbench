@page "/accounting/incurred-cost/{Id:guid}"
@inject IIncurredCostService IncurredCost
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>@(_package is null ? "Incurred cost" : $"FY{_package.FiscalYear} incurred cost") · Accounting · Workbench</PageTitle>

@if (_error is not null)
{
    <AccountingHeader Title="Incurred cost submission" />
    <LoadError Message="@_error" Forbidden="_forbidden" />
}
else if (_package is null)
{
    <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" />
}
else
{
    var p = _package;
    <AccountingHeader Title="@($"FY{p.FiscalYear} incurred cost submission")"
                      Subtitle="@($"{p.YearStart:MM/dd/yyyy} to {p.YearEnd:MM/dd/yyyy}. Revision {p.Revision}, generated by {p.GeneratedBy} on {IceFormat.When(p.GeneratedAtUtc)}.")">
        <IceStatusChip Status="p.Status" />
        @if (p.CanEdit)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RegenerateAsync" Disabled="_busy" data-testid="ice-regenerate">Regenerate</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync" Disabled="@(_busy || _edits.Count == 0)" data-testid="ice-save">Save inputs</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.FactCheck" OnClick="ReviewAsync" Disabled="@(_busy || _edits.Count > 0 || p.Errors > 0)" data-testid="ice-review">Mark reviewed</MudButton>
        }
        @if (p.Status == IncurredCostState.Reviewed)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Verified" OnClick="CertifyAsync" Disabled="_busy" data-testid="ice-certify">Certify</MudButton>
        }
        @if (p.Status == IncurredCostState.Certified)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Send" OnClick="SubmitAsync" Disabled="_busy" data-testid="ice-submit">Mark submitted</MudButton>
        }
        @if (p.Status is IncurredCostState.Reviewed or IncurredCostState.Certified)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="ReopenAsync" Disabled="_busy" data-testid="ice-reopen">Back to draft</MudButton>
        }
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportAsync" Disabled="_busy" data-testid="ice-export">Export .xlsx</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" Href="@($"accounting/incurred-cost/{p.Id}/print")" data-testid="ice-print">Print view</MudButton>
    </AccountingHeader>

    <MudPaper Outlined="true" Class="pa-3 mb-3" data-testid="ice-workflow">
        <MudStack Row="true" Spacing="6" Wrap="Wrap.Wrap">
            <Step Label="Generated" Who="@p.GeneratedBy" When="p.GeneratedAtUtc" Done="true" />
            <Step Label="Reviewed" Who="@p.ReviewedBy" When="p.ReviewedAtUtc" Done="@(p.ReviewedAtUtc is not null)" />
            <Step Label="Certified" Who="@(p.CertifierName is null ? null : $"{p.CertifierName}, {p.CertifierTitle} (by {p.CertifiedBy})")" When="p.CertifiedAtUtc" Done="@(p.CertifiedAtUtc is not null)" />
            <Step Label="Submitted" Who="@(p.SubmittedBy is null ? null : p.SubmissionReference is null ? p.SubmittedBy : $"{p.SubmittedBy}, ref. {p.SubmissionReference}")" When="p.SubmittedAtUtc" Done="@(p.SubmittedAtUtc is not null)" />
        </MudStack>
        @if (p.IsLocked)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2"><MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" /> Submitted packages are locked: the schedules and inputs no longer change.</MudText>
        }
        else if (!p.CanEdit)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">Take the package back to draft to change inputs or regenerate it; that clears the review and certification.</MudText>
        }
    </MudPaper>

    @if (p.CanEdit && p.LastChanges.Count > 0)
    {
        <MudExpansionPanels Class="mb-3" Outlined="true">
            <MudExpansionPanel Text="@($"Last regeneration changed {p.LastChanges.Count} total{(p.LastChanges.Count == 1 ? "" : "s")}")" Expanded="_showChanges" data-testid="ice-changes">
                <MudSimpleTable Dense="true" Elevation="0">
                    <thead><tr><th>Schedule</th><th>Total</th><th style="text-align:right">Before</th><th style="text-align:right">After</th><th style="text-align:right">Change</th></tr></thead>
                    <tbody>
                        @foreach (var c in p.LastChanges)
                        {
                            <tr>
                                <td>@c.Schedule</td>
                                <td>@c.Label</td>
                                <td style="text-align:right">@Total(c.Key, c.Before)</td>
                                <td style="text-align:right">@Total(c.Key, c.After)</td>
                                <td style="text-align:right">@Total(c.Key, c.Change)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }

    <MudPaper Outlined="true" Class="pa-3 mb-3" data-testid="ice-checks">
        <MudText Typo="Typo.h6" Class="mb-2">Checks</MudText>
        <MudStack Spacing="1">
            @foreach (var c in p.Checks.Where(c => c.Severity != IceCheckSeverity.Info || _showInfo))
            {
                <MudAlert Severity="@IceFormat.Severity(c.Severity)" Dense="true" data-testid="ice-check" data-code="@c.Code">
                    <b>Schedule @c.Schedule: @c.Title.</b> @c.Detail
                    @if (c.Difference is { } d && d != 0)
                    {
                        <span> (expected @AccountingFormat.Amount(c.Expected!.Value), actual @AccountingFormat.Amount(c.Actual!.Value), difference @AccountingFormat.Amount(d))</span>
                    }
                </MudAlert>
            }
        </MudStack>
        <MudSwitch T="bool" @bind-Value="_showInfo" Label="@($"Show passed checks and notes ({p.Checks.Count(c => c.Severity == IceCheckSeverity.Info)})")" Color="Color.Primary" Class="mt-1" />
    </MudPaper>

    @if (_edits.Count > 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">@_edits.Count unsaved input@(_edits.Count == 1 ? "" : "s"). Save to recalculate the schedules.</MudAlert>
    }

    <MudTabs Elevation="0" Outlined="true" Rounded="true" TabPanelsClass="pa-4" @bind-ActivePanelIndex="_tab" data-testid="ice-tabs">
        @foreach (var schedule in p.Schedules)
        {
            <MudTabPanel Text="@IceFormat.Tab(schedule.Code)" ToolTip="@schedule.Title">
                <MudText Typo="Typo.h6">@(schedule.Code is "Cover" or "U" ? schedule.Title : $"Schedule {schedule.Code}: {schedule.Title}")</MudText>
                <MudText Class="mud-text-secondary mb-3" Typo="Typo.body2">@schedule.Description</MudText>
                <IceScheduleTable Schedule="schedule" CanEdit="p.CanEdit" Edits="_edits" EditsChanged="StateHasChanged" />
            </MudTabPanel>
        }
    </MudTabs>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private IncurredCostPackageDto? _package;
    private readonly Dictionary<(string, string, string), string?> _edits = [];
    private string? _error;
    private bool _forbidden;
    private bool _busy;
    private bool _showInfo;
    private bool _showChanges;
    private int _tab;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _package = await IncurredCost.GetAsync(Id);
        }
        catch (Exception ex)
        {
            (_error, _forbidden) = (AccountingFormat.Error(ex), AccountingFormat.IsForbidden(ex));
        }
    }

    private static string Total(string key, decimal? value) =>
        value is not { } v ? "" : key.StartsWith("rate:", StringComparison.Ordinal) ? IceFormat.Rate(v) : AccountingFormat.Amount(v);

    private async Task<bool> RunAsync(Func<Task<IncurredCostPackageDto>> action, string done)
    {
        _busy = true;
        try
        {
            _package = await action();
            Snackbar.Add(done, Severity.Success);
            return true;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException or HttpRequestException or WorkbenchNotFoundException)
        {
            Snackbar.Add(AccountingFormat.Error(ex), Severity.Error);
            return false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RegenerateAsync()
    {
        if (_edits.Count > 0 && await Dialogs.ShowMessageBoxAsync("Unsaved inputs", "Regenerating discards the inputs you haven't saved.", yesText: "Regenerate", cancelText: "Cancel") != true)
        {
            return;
        }

        _edits.Clear();
        _showChanges = true;
        if (await RunAsync(() => IncurredCost.RegenerateAsync(Id), "Regenerated from the current books.") && _package is { LastChanges.Count: 0 })
        {
            Snackbar.Add("No totals changed.", Severity.Info);
        }
    }

    private async Task SaveAsync()
    {
        var inputs = _edits.Select(e => new IceInputDto(e.Key.Item1, e.Key.Item2, e.Key.Item3, e.Value)).ToList();
        if (await RunAsync(() => IncurredCost.SaveInputsAsync(Id, new SaveIceInputsRequest(inputs)), "Inputs saved."))
        {
            _edits.Clear();
        }
    }

    private Task<bool> ReviewAsync() => RunAsync(() => IncurredCost.MarkReviewedAsync(Id), "Marked reviewed.");

    private async Task CertifyAsync()
    {
        var text = _package!.Schedule("N").Row("text")?.TextOf("value") ?? "";
        var dialog = await Dialogs.ShowAsync<CertifyDialog>("Certificate of final indirect costs", new DialogParameters<CertifyDialog> { { d => d.Certificate, text } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: CertifyIncurredCostRequest request })
        {
            await RunAsync(() => IncurredCost.CertifyAsync(Id, request), "Certified.");
        }
    }

    private async Task SubmitAsync()
    {
        var dialog = await Dialogs.ShowAsync<IceTextDialog>("Mark submitted", new DialogParameters<IceTextDialog>
        {
            { d => d.Message, "Record that the certified package was submitted to the contracting officer and DCAA. The package is locked from then on." },
            { d => d.Label, "Submission reference (optional)" },
            { d => d.Helper, "For example the transmittal or DCAA receipt number." },
            { d => d.Button, "Mark submitted" },
        });
        if (await dialog.Result is { Canceled: false, Data: string reference })
        {
            await RunAsync(() => IncurredCost.SubmitAsync(Id, new SubmitIncurredCostRequest(reference.Length == 0 ? null : reference)), "Submitted. The package is locked.");
        }
    }

    private async Task ReopenAsync()
    {
        var dialog = await Dialogs.ShowAsync<IceTextDialog>("Back to draft", new DialogParameters<IceTextDialog>
        {
            { d => d.Message, "The package goes back to draft: the review and certification are cleared and must be done again." },
            { d => d.Label, "Reason" },
            { d => d.Helper, "Recorded in the audit log." },
            { d => d.Button, "Back to draft" },
            { d => d.Required, true },
        });
        if (await dialog.Result is { Canceled: false, Data: string reason })
        {
            await RunAsync(() => IncurredCost.ReopenAsync(Id, new ReopenIncurredCostRequest(reason)), "Back to draft.");
        }
    }

    private async Task ExportAsync()
    {
        _busy = true;
        try
        {
            await IceFormat.DownloadAsync(JS, await IncurredCost.ExportWorkbookAsync(Id));
        }
        catch (Exception ex)
        {
            Snackbar.Add(AccountingFormat.Error(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
