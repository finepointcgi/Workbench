@* Shown when a cash page can't load: explains who may use it when access is refused. *@
<MudAlert Severity="@(Forbidden ? Severity.Info : Severity.Error)" Class="mb-4" data-testid="load-error">
    @(Forbidden ? "Cash management and bank reconciliation are for Finance and administrators." : Message)
</MudAlert>

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool Forbidden { get; set; }
}
