@inherits SheetViewBase
@* Placeholder grid. Replaced by the virtualized, editable SheetGrid. *@

<MudSimpleTable Dense="true" Hover="true" Bordered="true">
    <thead>
        <tr>
            <th>Title</th>
            @if (Sheet.Summary.SchedulingEnabled)
            {
                <th>Start</th>
                <th>Finish</th>
            }
            @foreach (var column in Sheet.Columns)
            {
                <th>@column.Name</th>
            }
            <th>WBS</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var (item, depth) in Flatten())
        {
            <tr>
                <td style="padding-left:@(12 + depth * 20)px">@item.Title</td>
                @if (Sheet.Summary.SchedulingEnabled)
                {
                    <td>@item.Start?.ToString("yyyy-MM-dd")</td>
                    <td>@item.Finish?.ToString("yyyy-MM-dd")</td>
                }
                @foreach (var column in Sheet.Columns)
                {
                    <td>@ValueOf(item, column)</td>
                }
                <td>@item.CostpointWbsId</td>
            </tr>
        }
    </tbody>
</MudSimpleTable>

@code {
    private IEnumerable<(ItemDto Item, int Depth)> Flatten(Guid? parentId = null, int depth = 0)
    {
        foreach (var item in Items.Where(i => i.ParentId == parentId).OrderBy(i => i.Order))
        {
            yield return (item, depth);
            foreach (var child in Flatten(item.Id, depth + 1))
            {
                yield return child;
            }
        }
    }
}
