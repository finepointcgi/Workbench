@inherits SheetViewBase
@using System.Globalization
@using Workbench.Contracts
@using Workbench.Contracts.Scheduling
@using Workbench.Ui.Gantt
@using Microsoft.Extensions.DependencyInjection
@inject IItemService ItemService
@inject IDependencyService DependencyService
@inject IBaselineService BaselineService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IServiceProvider Services

<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="3" Class="mb-3">
    <MudToggleGroup T="GanttZoom" Value="_zoom" ValueChanged="SetZoom" Size="Size.Small" Color="Color.Primary" Outlined="true" aria-label="Zoom">
        <MudToggleItem Value="GanttZoom.Day" Text="Day" />
        <MudToggleItem Value="GanttZoom.Week" Text="Week" />
        <MudToggleItem Value="GanttZoom.Month" Text="Month" />
    </MudToggleGroup>
    <MudSelect T="Guid" Value="_baselineId" ValueChanged="SelectBaselineAsync" Label="Compare to baseline" Dense="true"
               Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:220px; max-width:280px">
        <MudSelectItem Value="Guid.Empty">None</MudSelectItem>
        @foreach (var baseline in _baselines)
        {
            <MudSelectItem Value="baseline.Id">@baseline.Name (@baseline.CapturedAtUtc.ToLocalTime().ToString("MMM d", CultureInfo.InvariantCulture))</MudSelectItem>
        }
    </MudSelect>
    @if (CanEdit && _baselineId != Guid.Empty)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="DeleteBaselineAsync"
                       aria-label="Delete this baseline" title="Delete this baseline" data-testid="gantt-baseline-delete" />
    }
    @if (CanEdit)
    {
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.CameraAlt" OnClick="CaptureBaselineAsync">
            Save baseline
        </MudButton>
    }
    @if (PlanService is not null)
    {
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.EventBusy" OnClick="CalendarAsync" data-testid="gantt-calendar">
            Working calendar
        </MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="PdfAsync" data-testid="gantt-pdf">
            PDF
        </MudButton>
    }
    <MudSpacer />
    @if (_analysis?.ProjectFinish is { } projectFinish)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            <span class="gantt-legend critical" aria-hidden="true"></span>Critical path: @_analysis.CriticalPath.Count task@(_analysis.CriticalPath.Count == 1 ? "" : "s")
            · Finish @projectFinish.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
            @if (_comparison?.FinishVarianceDays is { } slip)
            {
                <span data-testid="gantt-finish-variance">&nbsp;· @(slip == 0 ? "on the baseline finish" : slip > 0 ? $"{slip} working day{(slip == 1 ? "" : "s")} later than the baseline" : $"{-slip} working day{(slip == -1 ? "" : "s")} earlier than the baseline")</span>
            }
        </MudText>
    }
</MudStack>

@if (_rows.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Add items with start and finish dates to see them on the Gantt.</MudAlert>
}
else
{
    <div class="gantt">
        <GanttTaskList Rows="_rows" SheetId="SheetId" Collapsed="_collapsed" Critical="_critical" OnToggle="ToggleAsync"
                       Assignees="@(Tasks is { } tasks ? tasks.For : null)" CanAssign="CanAssign" OnAssign="AssignAsync"
                       Comparison="_comparison" Constraints="_constraints" Conflicts="_conflicts" CanConstrain="@(CanEdit && Plan is not null)"
                       OnConstrain="ConstrainAsync" />
        <GanttTimeline Rows="_rows" Scale="_scale" Dependencies="_dependencies" Analysis="_analysis" Baseline="_baseline"
                       Today="_today" OnBarDropped="MoveBarAsync" OnLinkDropped="LinkAsync" OnDependencyClick="UnlinkAsync"
                       IsWorkingDay="@(Plan is { } plan ? plan.IsWorkingDay : null)" Constraints="_constraints" Conflicts="_conflicts" />
    </div>
    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block" hidden="@(!CanEdit)">
        Drag a bar to move it or its right edge to change the finish. Drag the dot after a bar onto another task to link them; click an arrow to remove the link.
        Use the pin beside a task for a date constraint (Start No Earlier Than, Must Start On, a deadline). Without a mouse, change dates in the Grid view.
        Shaded days are days off on the plan's working calendar.
    </MudText>

    @* The accessible alternative to the timeline (WCAG 1.1.1, 1.3.1): the whole schedule, links and critical path as a table. *@
    <details class="wb-chart-data mt-2" data-testid="gantt-table">
        <summary>Show the schedule as a table</summary>
        <div class="wb-chart-data-scroll">
            <table class="wb-data-table">
                <caption>Schedule: dates, links and critical path</caption>
                <thead>
                    <tr>
                        <th scope="col">Task</th>
                        <th scope="col">Start</th>
                        <th scope="col">Finish</th>
                        <th scope="col">Days</th>
                        <th scope="col">Depends on</th>
                        <th scope="col">Critical path</th>
                        <th scope="col">Slack (days)</th>
                        @if (Plan is not null)
                        {
                            <th scope="col">Constraint</th>
                        }
                        @if (_baseline is not null)
                        {
                            <th scope="col">Baseline start</th>
                            <th scope="col">Baseline finish</th>
                            <th scope="col">Finish variance (days)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in GanttLayout.BuildRows(Items, new HashSet<Guid>()))
                    {
                        var slack = _analysis?.Items.FirstOrDefault(i => i.ItemId == row.Item.Id);
                        <tr>
                            <th scope="row" style="padding-left:@((10 + row.Depth * 16).ToString(CultureInfo.InvariantCulture))px">
                                @row.Item.Title@(row.IsSummary ? " (summary)" : row.IsMilestone ? " (milestone)" : "")
                            </th>
                            <td>@TableDate(row.Start)</td>
                            <td>@TableDate(row.Finish)</td>
                            <td>@Days(row)</td>
                            <td style="text-align:left; white-space:normal">@Predecessors(row.Item.Id)</td>
                            <td>@(_critical.Contains(row.Item.Id) ? "Yes" : "No")</td>
                            <td>@(slack?.SlackDays.ToString(CultureInfo.CurrentCulture) ?? "—")</td>
                            @if (Plan is not null)
                            {
                                var constraint = _constraints?.GetValueOrDefault(row.Item.Id);
                                var conflict = _conflicts?.GetValueOrDefault(row.Item.Id);
                                <td style="text-align:left; white-space:normal">
                                    @(constraint is null ? "—" : $"{constraint.Label} {TableDate(constraint.Date)}")@(conflict is null ? "" : $". Conflict: {conflict.Message}")
                                </td>
                            }
                            @if (_baseline is not null)
                            {
                                var b = _baseline.TryGetValue(row.Item.Id, out var span) ? span : (null, null);
                                <td>@TableDate(b.Start)</td>
                                <td>@TableDate(b.Finish)</td>
                                <td>@(_comparison?.For(row.Item.Id)?.FinishVarianceDays?.ToString("+0;-0;0", CultureInfo.InvariantCulture) ?? "—")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
}

@code {
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private readonly HashSet<Guid> _collapsed = [];
    private GanttZoom _zoom = GanttZoom.Day;
    private IReadOnlyList<GanttRow> _rows = [];
    private GanttScale _scale = default!;
    private IReadOnlyList<DependencyDto> _dependencies = [];
    private ScheduleAnalysis? _analysis;
    private HashSet<Guid> _critical = [];
    private IReadOnlyList<BaselineSummary> _baselines = [];
    private Guid _baselineId;
    private BaselineDetail? _baselineDetail;
    private Dictionary<Guid, (DateOnly? Start, DateOnly? Finish)>? _baseline;
    private BaselineComparison? _comparison;
    private Dictionary<Guid, PlanConstraintDto>? _constraints;
    private Dictionary<Guid, PlanConflictDto>? _conflicts;
    private Guid _loadedSheetId;

    private IPlanScheduleService? PlanService => Services.GetService<IPlanScheduleService>();

    protected override async Task OnParametersSetAsync()
    {
        _constraints = Plan?.Tasks.Where(t => t.Constraint is not null).ToDictionary(t => t.ItemId, t => t.Constraint!);
        _conflicts = Plan?.AllConflicts.GroupBy(c => c.ItemId).ToDictionary(g => g.Key, g => g.First());
        Layout();
        await RunAsync(async () =>
        {
            if (_loadedSheetId != SheetId)
            {
                _loadedSheetId = SheetId;
                _baselineId = Guid.Empty;
                _baselineDetail = null;
                _baselines = await BaselineService.ListAsync(SheetId);
            }

            await LoadScheduleAsync();
        });
    }

    private async Task LoadScheduleAsync()
    {
        _dependencies = await DependencyService.ListAsync(SheetId);
        _analysis = await DependencyService.AnalyzeAsync(SheetId);
        _critical = _analysis.CriticalPath.ToHashSet();
        _comparison = _baselineId == Guid.Empty ? null : await BaselineService.CompareAsync(SheetId, _baselineId);
    }

    /// <summary>Rebuilds rows, baseline spans and the time scale from the current items.</summary>
    private void Layout()
    {
        _rows = GanttLayout.BuildRows(Items, _collapsed);
        _baseline = null;
        if (_baselineDetail is not null)
        {
            var entries = _baselineDetail.Entries.ToDictionary(e => e.ItemId);
            var children = GanttLayout.ChildLookup(Items);
            _baseline = Items.ToDictionary(
                i => i.Id,
                i => GanttLayout.Span(i, x => entries.TryGetValue(x.Id, out var e) ? (e.Start, e.Finish) : (null, null), children));
        }

        var dates = _rows.SelectMany(r => new[] { r.Start, r.Finish })
            .Concat(_baseline?.Values.SelectMany(b => new[] { b.Start, b.Finish }) ?? [])
            .OfType<DateOnly>();
        _scale = GanttScale.Create(_zoom, dates, _today);
    }

    private static string TableDate(DateOnly? date) => date?.ToString("ddd MMM d, yyyy", CultureInfo.InvariantCulture) ?? "—";

    /// <summary>Working days on the plan's calendar (from the plan editor), else calendar days.</summary>
    private string Days(GanttRow row) =>
        Plan?.For(row.Item.Id)?.DurationDays is { } days ? days.ToString(CultureInfo.CurrentCulture)
        : row.Start is { } s0 && row.Finish is { } f0 ? (f0.DayNumber - s0.DayNumber + 1).ToString(CultureInfo.CurrentCulture) : "—";

    private string Predecessors(Guid itemId)
    {
        var titles = _dependencies.Where(d => d.SuccessorId == itemId)
            .Select(d => (Title: Items.FirstOrDefault(i => i.Id == d.PredecessorId)?.Title ?? "(hidden)", d))
            .Select(x => x.Title + (x.d.Type == DependencyKind.FinishToStart ? "" : $" ({x.d.Type})") + (x.d.LagDays != 0 ? $" {x.d.LagDays:+0;-0} d" : ""))
            .ToList();
        return titles.Count == 0 ? "—" : string.Join(", ", titles);
    }

    private void SetZoom(GanttZoom zoom)
    {
        _zoom = zoom;
        Layout();
    }

    private void ToggleAsync(Guid itemId)
    {
        if (!_collapsed.Remove(itemId))
        {
            _collapsed.Add(itemId);
        }

        Layout();
    }

    private async Task SelectBaselineAsync(Guid baselineId)
    {
        _baselineId = baselineId;
        await RunAsync(async () =>
        {
            _baselineDetail = baselineId == Guid.Empty ? null : await BaselineService.GetAsync(SheetId, baselineId);
            _comparison = baselineId == Guid.Empty ? null : await BaselineService.CompareAsync(SheetId, baselineId);
        });
        Layout();
    }

    private async Task DeleteBaselineAsync()
    {
        var baseline = _baselines.FirstOrDefault(b => b.Id == _baselineId);
        if (baseline is null || await DialogService.ShowMessageBoxAsync("Delete baseline", $"Delete the baseline \"{baseline.Name}\"? The plan doesn't change.",
                yesText: "Delete", cancelText: "Cancel") != true)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await BaselineService.DeleteAsync(SheetId, baseline.Id);
            _baselines = await BaselineService.ListAsync(SheetId);
            Snackbar.Add($"Deleted \"{baseline.Name}\".", Severity.Success);
        });
        await SelectBaselineAsync(Guid.Empty);
    }

    private async Task CalendarAsync()
    {
        var parameters = new DialogParameters<PlanCalendarDialog> { { d => d.SheetId, SheetId }, { d => d.CanEdit, CanEdit } };
        var dialog = await DialogService.ShowAsync<PlanCalendarDialog>("Working calendar", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
        {
            await Changed.InvokeAsync();
        }
    }

    private async Task PdfAsync()
    {
        var parameters = new DialogParameters<GanttPdfDialog>
        {
            { d => d.SheetId, SheetId },
            { d => d.BaselineId, _baselineId == Guid.Empty ? null : _baselineId },
            { d => d.BaselineName, _baselines.FirstOrDefault(b => b.Id == _baselineId)?.Name },
        };
        await DialogService.ShowAsync<GanttPdfDialog>("Gantt to PDF", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    }

    private async Task ConstrainAsync(GanttRow row)
    {
        if (!CanEdit)
        {
            return;
        }

        await TaskConstraintEditor.EditAsync(DialogService, SheetId, row.Item.Id, row.Item.Title, Plan, row.Start);
        await Changed.InvokeAsync();
    }

    private async Task CaptureBaselineAsync()
    {
        var dialog = await DialogService.ShowAsync<CaptureBaselineDialog>("Save a baseline");
        if (await dialog.Result is not { Canceled: false, Data: string name })
        {
            return;
        }

        await RunAsync(async () =>
        {
            var captured = await BaselineService.CaptureAsync(SheetId, new CaptureBaselineRequest(name));
            _baselines = await BaselineService.ListAsync(SheetId);
            Snackbar.Add($"Saved the baseline \"{captured.Name}\". Its bars show under the plan's.", Severity.Success);
            await SelectBaselineAsync(captured.Id);
        });
    }

    private async Task MoveBarAsync(GanttBarDrop drop)
    {
        if (!CanEdit)
        {
            return;
        }

        var item = drop.Row.Item;
        DateOnly? start = item.Start, finish = item.Finish;
        if (drop.Mode == GanttDragMode.Move)
        {
            start = start?.AddDays(drop.Days);
            finish = finish?.AddDays(drop.Days);
        }
        else if ((finish ?? start) is { } end)
        {
            finish = end.AddDays(drop.Days);
            if (start is { } s && finish < s)
            {
                finish = s;
            }
        }

        await RunAsync(async () =>
        {
            await ItemService.UpdateAsync(SheetId, item.Id, new UpdateItemRequest(item.Title, start, finish, item.CostpointWbsId, item.Values));
            await Changed.InvokeAsync();
        });
    }

    private async Task LinkAsync((Guid PredecessorId, Guid SuccessorId) link)
    {
        if (!CanEdit)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await DependencyService.AddAsync(SheetId, new CreateDependencyRequest(link.PredecessorId, link.SuccessorId));
            await LoadScheduleAsync();
        });
    }

    private async Task UnlinkAsync(DependencyDto dependency)
    {
        if (!CanEdit)
        {
            return;
        }

        var from = Items.FirstOrDefault(i => i.Id == dependency.PredecessorId)?.Title;
        var to = Items.FirstOrDefault(i => i.Id == dependency.SuccessorId)?.Title;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remove dependency", $"Remove the link from \"{from}\" to \"{to}\"?", yesText: "Remove", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await DependencyService.RemoveAsync(SheetId, dependency.Id);
            await LoadScheduleAsync();
        });
    }

    /// <summary>Runs a service call and reports expected failures (validation, missing rows, network) in a snackbar.</summary>
    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is ArgumentException or WorkbenchNotFoundException or UnauthorizedAccessException or HttpRequestException or TaskCanceledException)
        {
            Snackbar.Add(ex.Message, ex is ArgumentException ? Severity.Warning : Severity.Error);
        }
    }

    private async Task AssignAsync(ItemDto item)
    {
        if (await TaskView.AssignAsync(DialogService, SheetId, item, Tasks?.For(item.Id) ?? []))
        {
            await Changed.InvokeAsync();
        }
    }
}
