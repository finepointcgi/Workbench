@page "/admin/integrations/accounting-live/callback/{TargetName}"
@using Workbench.Contracts.AccountingExport
@using Workbench.Contracts.AccountingLive
@inject IAccountingConnectionService Connections
@inject NavigationManager Navigation

<PageTitle>Connecting · Accounting export · Workbench</PageTitle>

@if (_error is null)
{
    <MudProgressLinear aria-label="Connecting" Indeterminate="true" Color="Color.Primary" />
    <MudText Class="mt-2">Finishing the connection...</MudText>
}
else
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="callback-error">@_error</MudAlert>
    <MudButton Variant="Variant.Text" Href="/admin/integrations/accounting-export?tab=connections" Class="mt-2">Back to connections</MudButton>
}

@code {
    [Parameter] public string? TargetName { get; set; }

    [SupplyParameterFromQuery(Name = "code")] public string? Code { get; set; }

    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }

    [SupplyParameterFromQuery(Name = "realmId")] public string? RealmId { get; set; }

    [SupplyParameterFromQuery(Name = "error")] public string? ProviderError { get; set; }

    private string? _error;
    private bool _done;

    protected override async Task OnParametersSetAsync()
    {
        if (_done)
        {
            return;
        }

        _done = true;
        if (!Enum.TryParse<AccountingTarget>(TargetName, true, out var target) || target == AccountingTarget.Generic)
        {
            _error = "That isn't a provider Workbench can connect to.";
            return;
        }

        try
        {
            await Connections.CompleteAsync(new AccountingOAuthCallback(target, Code, State, RealmId, ProviderError));
            // The code and state are in this address; leave for a clean one.
            Navigation.NavigateTo("/admin/integrations/accounting-export?tab=connections", replace: true);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException or HttpRequestException or TaskCanceledException)
        {
            _error = ex.Message;
        }
    }
}
