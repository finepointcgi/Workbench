@using Workbench.Contracts.AccountingLive
@using Workbench.Contracts.AccountingExport

<div data-testid="push-run">
    <MudAlert Severity="@Severity" Variant="Variant.Outlined" Class="mb-2" data-testid="push-run-summary">
        <strong>@Run.Status switch { AccountingPushRunStatus.Completed => "Done", AccountingPushRunStatus.PartlyFailed => "Some records failed", AccountingPushRunStatus.Failed => "Nothing was sent", _ => Run.Status }.</strong>
        @Run.Message
    </MudAlert>
    @if (Run.Items.Count > 0)
    {
        <MudSimpleTable Dense="true" Hover="true" Style="max-height: 360px; overflow:auto;" data-testid="push-items">
            <thead>
                <tr><th scope="col">Record</th><th scope="col">Result</th><th scope="col">In @ProviderName</th><th scope="col">Message</th></tr>
            </thead>
            <tbody>
                @foreach (var i in Run.Items)
                {
                    <tr data-status="@i.Status">
                        <td>@i.RecordNumber</td>
                        <td>@ResultText(i)</td>
                        <td>@(i.ProviderNumber ?? i.ProviderId)</td>
                        <td>@i.Message</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }

    @if (Run.Failed > 0 && OnRetry.HasDelegate)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" StartIcon="@Icons.Material.Filled.Replay" OnClick="() => OnRetry.InvokeAsync(Run)" Disabled="Busy" data-testid="push-retry">Retry the @Run.Failed that failed</MudButton>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Only the failed records are sent again. Fix what the messages say first (a missing account, a name that isn't mapped).</MudText>
    }
</div>

@code {
    [Parameter, EditorRequired] public AccountingPushRunDto Run { get; set; } = default!;

    [Parameter] public EventCallback<AccountingPushRunDto> OnRetry { get; set; }

    [Parameter] public bool Busy { get; set; }

    private string ProviderName => Run.Target == AccountingTarget.QuickBooks ? "QuickBooks" : "Xero";

    private Severity Severity => Run.Status switch
    {
        AccountingPushRunStatus.Completed => Severity.Success,
        AccountingPushRunStatus.PartlyFailed => Severity.Warning,
        _ => Severity.Error,
    };

    private static string ResultText(AccountingPushItemDto i) => i.Status switch
    {
        AccountingPushItemStatus.Created => "Created",
        AccountingPushItemStatus.Skipped => "Already there",
        AccountingPushItemStatus.NotSent => "Not sent",
        _ => "Failed" + (i.Attempts > 1 ? $" (attempt {i.Attempts})" : ""),
    };
}
