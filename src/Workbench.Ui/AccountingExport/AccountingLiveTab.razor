@using Workbench.Contracts.AccountingExport
@using Workbench.Contracts.AccountingLive
@inject IAccountingConnectionService Connections
@inject IAccountingPushService Push
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
    Connect QuickBooks Online or Xero so exports can be pushed straight into the books. Workbench keeps the sign-in encrypted, renews it by itself and never
    shows it. The file export on the first tab keeps working with or without a connection.
</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3" data-testid="live-error">@_error</MudAlert>
}

<MudGrid Spacing="3">
    @foreach (var c in _connections)
    {
        <MudItem xs="12" md="6">
            <MudPaper Outlined="true" Class="pa-4" data-testid="@($"connection-{c.Target.ToString().ToLowerInvariant()}")">
                <MudText Typo="Typo.h6" HtmlTag="h2">@c.ProviderName</MudText>
                @if (!c.Configured)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2" data-testid="not-configured">
                        Not set up on this server. The host administrator registers an app with @c.ProviderName and sets <code>Accounting:@c.Target</code> in the server's configuration (see the live-push admin guide).
                    </MudAlert>
                }
                else if (c.Status is null)
                {
                    <MudText Class="mud-text-secondary my-2">Not connected.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => ConnectAsync(c.Target)" Disabled="_busy" data-testid="connect">Connect @c.ProviderName</MudButton>
                    @if (c.IsSandbox)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">This server is set to the sandbox: connect a test company.</MudText>
                    }
                }
                else
                {
                    <MudStack Spacing="1" Class="my-2" data-testid="connection-details">
                        <MudText>
                            <strong>@(c.CompanyName ?? c.CompanyId ?? "Organisation not chosen")</strong>
                            @if (c.IsSandbox)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Sandbox</MudChip>
                            }
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Connected by @c.ConnectedBy, @c.ConnectedAtUtc?.ToString("yyyy-MM-dd HH:mm") UTC. Sign-in valid until @c.RefreshTokenExpiresUtc?.ToString("yyyy-MM-dd") if unused.</MudText>
                        @if (c.Status == AccountingConnectionStatus.NeedsReconnect)
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="needs-reconnect">The connection needs to be made again: @c.LastError</MudAlert>
                        }
                        else if (c.Status == AccountingConnectionStatus.ChooseOrganisation)
                        {
                            <MudSelect T="string" Label="Which organisation should Workbench post to?" @bind-Value="_choice" data-testid="choose-org">
                                @foreach (var o in c.Choices)
                                {
                                    <MudSelectItem T="string" Value="o.Id">@o.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrEmpty(_choice))" OnClick="() => ChooseAsync(c.Target)" data-testid="choose-org-save">Use this organisation</MudButton>
                        }
                        else
                        {
                            <MudText data-testid="last-sync">
                                @if (c.LastSyncUtc is { } at)
                                {
                                    <span>Last push: @at.ToString("yyyy-MM-dd HH:mm") UTC, @(c.LastSyncStatus switch { AccountingPushRunStatus.Completed => "completed", AccountingPushRunStatus.PartlyFailed => "some records failed", _ => "failed" }). @c.LastSyncMessage</span>
                                }
                                else
                                {
                                    <span class="mud-text-secondary">Nothing pushed yet.</span>
                                }
                            </MudText>
                        }
                    </MudStack>
                    <MudStack Row="true" Spacing="2">
                        @if (c.Status == AccountingConnectionStatus.NeedsReconnect)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => ConnectAsync(c.Target)" Disabled="_busy">Connect again</MudButton>
                        }
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="() => DisconnectAsync(c)" Disabled="_busy" data-testid="disconnect">Disconnect</MudButton>
                    </MudStack>
                }
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-4 mb-1">Recent pushes</MudText>
@if (_runs.Count == 0)
{
    <MudText Class="mud-text-secondary">No pushes yet.</MudText>
}
else
{
    <MudSimpleTable Dense="true" Hover="true" data-testid="push-runs">
        <thead>
            <tr><th scope="col">When (UTC)</th><th scope="col">To</th><th scope="col">What</th><th scope="col">Period</th><th scope="col">Result</th><th scope="col"><span class="wb-sr-only">Open</span></th></tr>
        </thead>
        <tbody>
            @foreach (var r in _runs)
            {
                <tr>
                    <td>@r.StartedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@r.Target</td>
                    <td>@r.Kind</td>
                    <td>@r.From.ToString("yyyy-MM-dd") to @r.To.ToString("yyyy-MM-dd")</td>
                    <td>@r.Message</td>
                    <td><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => OpenAsync(r)">@(_open?.RunId == r.RunId ? "Hide" : "Details")</MudButton></td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@if (_open is { } open)
{
    <div class="mt-3"><AccountingPushRunView Run="open" OnRetry="RetryAsync" Busy="_busy" /></div>
}

@code {
    [Parameter] public int Version { get; set; }

    private IReadOnlyList<AccountingConnectionDto> _connections = [];
    private IReadOnlyList<AccountingPushRunDto> _runs = [];
    private AccountingPushRunDto? _open;
    private string? _choice;
    private string? _error;
    private bool _busy;

    protected override Task OnInitializedAsync() => LoadAsync();

    private static bool IsExpected(Exception ex) => ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException or HttpRequestException or TaskCanceledException;

    private async Task LoadAsync()
    {
        try
        {
            _connections = await Connections.ListAsync();
            _runs = await Push.ListRunsAsync(null, 20);
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            _error = ex.Message;
        }
    }

    private async Task ConnectAsync(AccountingTarget target)
    {
        _busy = true;
        _error = null;
        try
        {
            var start = await Connections.StartAsync(target);
            Navigation.NavigateTo(start.Url, forceLoad: true);
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            _error = ex.Message;
            _busy = false;
        }
    }

    private async Task ChooseAsync(AccountingTarget target)
    {
        _busy = true;
        _error = null;
        try
        {
            await Connections.ChooseOrganisationAsync(target, _choice!);
            await LoadAsync();
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DisconnectAsync(AccountingConnectionDto c)
    {
        _busy = true;
        _error = null;
        try
        {
            await Connections.DisconnectAsync(c.Target);
            Snackbar.Add($"{c.ProviderName} disconnected. Records already pushed stay in the history.", Severity.Info);
            await LoadAsync();
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenAsync(AccountingPushRunDto run)
    {
        try
        {
            _open = _open?.RunId == run.RunId ? null : await Push.GetRunAsync(run.RunId);
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            _error = ex.Message;
        }
    }

    private async Task RetryAsync(AccountingPushRunDto run)
    {
        _busy = true;
        _error = null;
        try
        {
            _open = await Push.RetryFailedAsync(run.RunId);
            await LoadAsync();
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
