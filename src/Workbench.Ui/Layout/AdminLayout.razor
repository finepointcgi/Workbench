@* Administrator-only pages (for example the Costpoint integration). Others get a friendly 403; the server refuses their calls too. *@
@inherits LayoutComponentBase
@layout MainLayout
@inject ICurrentUserContext CurrentUser

@if (_allowed is null)
{
    <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" />
}
else if (_allowed.Value)
{
    @Body
}
else
{
    <ForbiddenNotice Title="You don't have access to this page"
                     Message="This page is for administrators. Ask an administrator if you need it." />
}

@code {
    private bool? _allowed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _allowed = (await CurrentUser.GetAsync()).IsAdmin;
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException or TaskCanceledException)
        {
            _allowed = false;
        }
    }
}
