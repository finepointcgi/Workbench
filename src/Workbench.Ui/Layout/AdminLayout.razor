@* Administration pages: each needs the permission its menu entry names (an Administration permission otherwise). Others get a friendly 403; the server refuses their calls too. *@
@inherits LayoutComponentBase
@layout MainLayout
@inject ICurrentUserContext CurrentUser
@inject NavigationManager Navigation

@if (_allowed is null)
{
    <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" />
}
else if (_allowed.Value)
{
    @Body
}
else
{
    <ForbiddenNotice Title="You don't have access to this page"
                     Message="@_message" />
}

@code {
    private bool? _allowed;
    private CurrentUserInfo? _user;
    private string _message = "";

    // Checked on every navigation (a layout instance outlives its pages): the menu entry that owns the page decides.
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _user ??= await CurrentUser.GetAsync();
            var path = Navigation.ToBaseRelativePath(Navigation.Uri);
            _allowed = NavCatalog.PageAllowed(path, _user, p => p.Any(k => PermissionCatalog.Find(k)?.Area is { } area && (area == PermissionCatalog.AreaAdministration)));
            _message = NavCatalog.Explain(path) ?? "This page is for administrators. Ask an administrator if you need it.";
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException or TaskCanceledException)
        {
            _allowed = false;
        }
    }
}
