@inherits LayoutComponentBase
@using Workbench.Ui.Navigation
@inject NavigationManager Navigation

<ThemeTokens Dark="_darkMode" />
<MudThemeProvider Theme="WorkbenchTheme.Default" @bind-IsDarkMode="_darkMode" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" DefaultFocus="DefaultFocus.FirstChild" />
<MudSnackbarProvider />

<a class="wb-skip-link" href="@SkipHref" @onclick="SkipToMainAsync" @onclick:preventDefault>Skip to main content</a>
<MudLayout>
    <MudAppBar Elevation="0">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" aria-label="Toggle navigation" aria-expanded="@(_drawerOpen ? "true" : "false")" />
        <span class="wb-brand"><span class="wb-brand-mark" aria-hidden="true">W</span>Workbench</span>
        <MudSpacer />
        <NewMenu @ref="_new" Access="_access" />
        <Workbench.Ui.Companies.CompanySwitcher />
        <CommandPalette Access="_access" Ask="AskAssistantAsync" Create="CreateAsync" />
        <Workbench.Ui.Assistant.AssistantButton @ref="_assistant" Access="_access" />
        <HelpButton Access="_access" />
        <Workbench.Ui.Time.TimerAppBarChip />
        <NotificationBell />
        <UserMenu />
        <MudIconButton Icon="@(_darkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="ToggleDarkMode" aria-label="Toggle dark mode" aria-pressed="@(_darkMode ? "true" : "false")" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Breakpoint="Breakpoint.Md">
        <NavMenu AccessLoaded="OnAccessLoaded" />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            <PageBreadcrumbs Access="_access" />
            <GroupTabs Access="_access" />
            <main id="main-content" tabindex="-1" @ref="_main" class="wb-main">
                <Workbench.Ui.Approvals.DecideHere />
                <Workbench.Ui.Support.FriendlyErrorBoundary>@Body</Workbench.Ui.Support.FriendlyErrorBoundary>
            </main>
        </MudContainer>
    </MudMainContent>
</MudLayout>
<MobileRedirect />
<ReauthenticationPrompt />

@code {
    private bool _drawerOpen = true;
    private bool _darkMode;
    private NavAccess _access = NavAccess.Anonymous;
    private ElementReference _main;

    // The skip link names the current page so it still works before the circuit starts (base href is "/").
    private string SkipHref => $"{Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0]}#main-content";

    private async Task SkipToMainAsync() => await _main.FocusAsync();

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void ToggleDarkMode() => _darkMode = !_darkMode;

    private void OnAccessLoaded(NavAccess access) => _access = access;

    private Workbench.Ui.Assistant.AssistantButton? _assistant;

    private Task AskAssistantAsync(string question) => _assistant?.AskAsync(question) ?? Task.CompletedTask;

    private NewMenu? _new;

    private Task CreateAsync(string key) => _new?.LaunchAsync(key) ?? Task.CompletedTask;
}
