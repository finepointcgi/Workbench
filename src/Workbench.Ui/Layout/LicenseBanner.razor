@using Workbench.Contracts.Identity
@using Workbench.Contracts.Licensing
@using Workbench.Ui.Navigation
@inject ILicenseService Licenses
@inject NavigationManager Navigation

@* Tells administrators a trial is about to end (7 days or fewer) or has ended. Others never see it, except a hosted organization
   that has gone read-only (lapsed trial, cancelled or suspended): everyone is told why they can't save, and administrators get the export. *@
@if (_readOnly is not null)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" data-testid="readonly-banner">
        @_readOnly
        @if (_isAdmin)
        {
            <MudLink Href="api/v1/organization/export" Target="_blank" Class="ml-1" data-testid="export-link">Export all my data</MudLink>
        }
    </MudAlert>
}
else if (_message is not null)
{
    <MudAlert Severity="@(_lapsed ? Severity.Warning : Severity.Info)" Dense="true" Class="mb-3" data-testid="license-banner">
        @_message
        @if (_hosted)
        {
            <span class="ml-1">Contact your Workbench provider to subscribe.</span>
        }
        else
        {
            <MudLink Href="setup/license" Class="ml-1">Add a license key</MudLink>
        }
    </MudAlert>
}

@code {
    [Parameter] public NavAccess Access { get; set; } = NavAccess.Anonymous;

    private string? _message;
    private string? _readOnly;
    private bool _lapsed;
    private bool _hosted;
    private bool _isAdmin;

    protected override async Task OnParametersSetAsync()
    {
        _message = null;
        _readOnly = null;
        _isAdmin = Access.Can(Permission.AdminOrganization);
        try
        {
            var status = await Licenses.GetStatusAsync();
            _hosted = status.Source == EditionSource.HostedPlan;
            if (status.ReadOnly)
            {
                _readOnly = status.Problem ?? "This organization is read-only.";
                return;
            }

            if (!_isAdmin)
            {
                return;
            }

            if (_hosted && status.InGracePeriod && status.Problem is { } overdue)
            {
                _lapsed = true;
                _message = overdue;
            }
            else if (status is { Trial: true, DaysLeft: { } days } && days <= 7)
            {
                _lapsed = days < 0;
                _message = _lapsed
                    ? "Your Workbench trial has ended, so Business features are off. Your data is untouched."
                    : days == 0 ? "Your Workbench trial ends today." : $"Your Workbench trial ends in {days} {(days == 1 ? "day" : "days")}.";
            }
        }
        catch (Exception ex) when (NavAccess.IsExpected(ex))
        {
        }
    }
}
