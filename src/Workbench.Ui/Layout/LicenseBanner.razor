@using Workbench.Contracts.Identity
@using Workbench.Contracts.Licensing
@using Workbench.Ui.Navigation
@inject ILicenseService Licenses
@inject NavigationManager Navigation

@* Tells administrators a trial is about to end (7 days or fewer) or has ended. Others never see it. *@
@if (_message is not null)
{
    <MudAlert Severity="@(_lapsed ? Severity.Warning : Severity.Info)" Dense="true" Class="mb-3" data-testid="license-banner">
        @_message
        <MudLink Href="setup/license" Class="ml-1">@_link</MudLink>
    </MudAlert>
}

@code {
    [Parameter] public NavAccess Access { get; set; } = NavAccess.Anonymous;

    private string? _message;
    private bool _lapsed;
    private string _link = "Add a license key";

    private static string Since(LicenseRefreshDto r) => r.LastSuccessUtc is { } ok ? ok.ToString("d MMM yyyy") : "it was activated";

    protected override async Task OnParametersSetAsync()
    {
        _message = null;
        _link = "Add a license key";
        if (!Access.Can(Permission.AdminOrganization))
        {
            return;
        }

        try
        {
            var status = await Licenses.GetStatusAsync();
            if (status.Refresh is { Stale: true } refresh)
            {
                _lapsed = true;
                _message = refresh.Outcome == "refused"
                    ? $"The license server has not renewed this license since {Since(refresh)}. {refresh.Message}"
                    : $"This install has not been able to refresh its license from the license server since {Since(refresh)}. Nothing has changed: the current key keeps working until it expires.";
                _link = "Details";
            }
            else if (status is { Trial: true, DaysLeft: { } days } && days <= 7)
            {
                _lapsed = days < 0;
                _message = _lapsed
                    ? "Your Workbench trial has ended, so Business features are off. Your data is untouched."
                    : days == 0 ? "Your Workbench trial ends today." : $"Your Workbench trial ends in {days} {(days == 1 ? "day" : "days")}.";
            }
        }
        catch (Exception ex) when (NavAccess.IsExpected(ex))
        {
        }
    }
}
