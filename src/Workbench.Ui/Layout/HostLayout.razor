@inherits LayoutComponentBase
@* The host admin site (MultiTenant): no tenant, so none of the tenant layout's menus, bell or user lookups. *@

<ThemeTokens />
<MudThemeProvider Theme="WorkbenchTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" DefaultFocus="DefaultFocus.FirstChild" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudText Typo="Typo.h6" HtmlTag="span">Workbench host administration</MudText>
        <MudSpacer />
        <MudButton Href="host/support" Color="Color.Inherit" Variant="Variant.Text">Support requests</MudButton>
        <MudButton Href="account/signout" Color="Color.Inherit" Variant="Variant.Text">Sign out</MudButton>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            <main id="main-content">
                @Body
            </main>
        </MudContainer>
    </MudMainContent>
</MudLayout>
