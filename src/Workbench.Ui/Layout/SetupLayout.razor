@* Pages under /setup: Finance and administrators only. Others get a friendly 403; the server refuses their changes too. *@
@inherits LayoutComponentBase
@layout MainLayout
@inject ICurrentUserContext CurrentUser

@if (_allowed is null)
{
    <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" />
}
else if (_allowed.Value)
{
    @Body
}
else
{
    <ForbiddenNotice Title="You don't have access to Setup"
                     Message="Setup (people, rates, contracts, projects, the fiscal calendar and the audit log) is for Finance and administrators. Ask an administrator if you need it." />
}

@code {
    private bool? _allowed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _allowed = (await CurrentUser.GetAsync()).IsFinance;
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException or TaskCanceledException)
        {
            _allowed = false;
        }
    }
}
