@* Navigation for administrators only. The pages check again, and the server enforces it. *@
@inject IUserDirectory Users

@if (_isAdmin)
{
    <MudNavLink Href="admin/users" Icon="@Icons.Material.Filled.ManageAccounts">Users</MudNavLink>
}

@code {
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAdmin = (await Users.GetMeAsync()).IsAdmin;
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException or TaskCanceledException)
        {
            _isAdmin = false;
        }
    }
}
