@* ODC approvals, for people with something waiting for their approval, and Finance and administrators. *@
@inject ICurrentUserContext CurrentUser
@inject Workbench.Contracts.Odcs.IOdcApprovalService OdcApprovals

@if (_show)
{
    <MudNavLink Href="odcs/approvals" Icon="@Icons.Material.Filled.FactCheck">ODC approvals</MudNavLink>
}

@code {
    private bool _show;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if ((await CurrentUser.GetAsync()).IsFinance)
            {
                _show = true;
                return;
            }

            var queue = await OdcApprovals.GetMyQueueAsync();
            _show = queue.Reports.Count > 0 || queue.VendorOdcs.Count > 0;
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException or TaskCanceledException
            or Workbench.Contracts.WorkbenchNotFoundException)
        {
            _show = false;
        }
    }
}
