@* Pages under /accounting: Finance and administrators only. Others get a friendly 403; the server refuses their calls too. *@
@inherits LayoutComponentBase
@layout MainLayout
@inject ICurrentUserContext CurrentUser

@if (_allowed is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_allowed.Value)
{
    @Body
}
else
{
    <ForbiddenNotice Title="You don't have access to Accounting"
                     Message="The general ledger, journal entries, posting rules, period close and financial statements are for Finance and administrators. Ask an administrator if you need them." />
}

@code {
    private bool? _allowed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _allowed = (await CurrentUser.GetAsync()).IsFinance;
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException or TaskCanceledException)
        {
            _allowed = false;
        }
    }
}
