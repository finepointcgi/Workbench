@page "/admin/customization"
@inject IUserDirectory Users
@inject NavigationManager Navigation

<PageTitle>Customization · Workbench</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-1">Customization</MudText>
<MudText Class="mud-text-secondary mb-4">
    Shape Workbench to how your organization works, without code: add fields to records, manage the lists behind dropdowns,
    rename statuses and set how document numbers look.
</MudText>

@if (_loading)
{
    <MudProgressLinear aria-label="Loading" Indeterminate="true" Color="Color.Primary" />
}
else if (_me is not { IsAdmin: true })
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Only administrators can change customization.</MudAlert>
}
else
{
    <MudTabs Elevation="0" Outlined="true" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4"
             ActivePanelIndex="_tab" ActivePanelIndexChanged="OnTabChanged" KeepPanelsAlive="false">
        <MudTabPanel Text="Fields" Icon="@Icons.Material.Filled.DynamicForm">
            <CustomFieldsTab EntityType="@EntityQuery" />
        </MudTabPanel>
        <MudTabPanel Text="Picklists" Icon="@Icons.Material.Filled.List">
            <ValueListsTab />
        </MudTabPanel>
        <MudTabPanel Text="Status labels" Icon="@Icons.Material.Filled.Label">
            <StatusLabelsTab />
        </MudTabPanel>
        <MudTabPanel Text="Numbering" Icon="@Icons.Material.Filled.Pin">
            <NumberingTab />
        </MudTabPanel>
    </MudTabs>
}

@code {
    private static readonly string[] Tabs = ["fields", "picklists", "statuses", "numbering"];

    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    [SupplyParameterFromQuery(Name = "entity")]
    public string? EntityQuery { get; set; }

    private UserDto? _me;
    private bool _loading = true;
    private int _tab;

    protected override void OnParametersSet() => _tab = Math.Max(0, Array.IndexOf(Tabs, TabQuery ?? "fields"));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _me = await Users.GetMeAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException or TaskCanceledException)
        {
            _me = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnTabChanged(int index)
    {
        _tab = index;
        Navigation.NavigateTo($"admin/customization?tab={Tabs[index]}", replace: true);
    }
}
