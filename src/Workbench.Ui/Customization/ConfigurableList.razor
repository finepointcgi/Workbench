@typeparam T
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@using Workbench.Contracts.Reports
@inject IServiceProvider Services
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@*
    A list page's grid with saved views: choose and order columns (custom fields too), sort, filter with saved conditions,
    group by a column, save named views (personal, or for a role or everyone with permission), pick a default view and
    export exactly what the view shows. Rows come from the page (its permission-checked services); columns come from the
    page's ListDefinition, minus those whose field permission the viewer lacks, plus the entity's custom fields.
*@

<div data-testid="@TestId" data-list="@Definition.ListKey">
    @* Kept short: search, the page's own buttons, Filter, and one View menu for saved views, columns, grouping and export. *@
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2">
        @if (ShowSearch)
        {
            <MudTextField T="string" Value="_search" ValueChanged="SearchChanged" aria-label="@SearchLabel" Placeholder="@SearchLabel" Immediate="true" DebounceInterval="200"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Style="min-width: 240px; max-width: 360px" data-testid="@SearchTestId" />
        }
        @ToolBarContent
        @* Filter and View stay together on the right, wrapping as one when the page's own buttons fill the row. *@
        <div class="d-flex align-center flex-nowrap gap-2 ml-auto" data-testid="list-view-controls">
            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterList" OnClick="FiltersAsync" data-testid="list-filter">
                Filter@(FilterCount > 0 ? $" ({FilterCount})" : "")
            </MudButton>
            <MudMenu Label="@ViewButtonLabel" Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Tune" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                     AriaLabel="@($"View options: {ViewName}")" Dense="true" data-testid="view-menu">
                @if (_views is not null)
                {
                    <MudMenuItem OnClick="() => SelectAsync(null)" Icon="@(_selected is null ? Icons.Material.Filled.Check : Icons.Material.Filled.ViewList)">Standard view</MudMenuItem>
                    @foreach (var view in _views.Views)
                    {
                        <MudMenuItem OnClick="() => SelectAsync(view)" Icon="@(_selected?.Id == view.Id ? Icons.Material.Filled.Check : Icons.Material.Filled.ViewList)" data-view="@view.Name">
                            @view.Name@(view.Visibility == ListViewVisibility.Personal ? "" : $" ({ShareLabel(view)})")@(_views.DefaultViewId == view.Id ? " · default" : "")
                        </MudMenuItem>
                    }
                    @if (_selected is { CanEdit: true } && _dirty)
                    {
                        <MudMenuItem OnClick="SaveAsync" Icon="@Icons.Material.Filled.Save">Save changes to "@_selected.Name"</MudMenuItem>
                    }
                    <MudMenuItem OnClick="SaveAsNewAsync" Icon="@Icons.Material.Filled.SaveAs" data-testid="view-save-as">Save as a new view…</MudMenuItem>
                    @if (_selected is { CanEdit: true } editable)
                    {
                        <MudMenuItem OnClick="() => RenameAsync(editable)" Icon="@Icons.Material.Filled.Edit">Rename or share…</MudMenuItem>
                        <MudMenuItem OnClick="() => DeleteAsync(editable)" Icon="@Icons.Material.Filled.Delete">Delete this view</MudMenuItem>
                    }
                    @if (_views.DefaultViewId != _selected?.Id)
                    {
                        <MudMenuItem OnClick="SetDefaultAsync" Icon="@Icons.Material.Filled.Star">Make this my default view</MudMenuItem>
                    }
                    <MudDivider />
                }
                <MudMenuItem OnClick="ColumnsAsync" Icon="@Icons.Material.Filled.ViewColumn" data-testid="list-columns">Columns…</MudMenuItem>
                @if (_available.Any(c => c.Groupable))
                {
                    <MudMenuItem OnClick="() => GroupBy(null)" Icon="@(_group is null ? Icons.Material.Filled.Check : Icons.Material.Filled.Workspaces)" data-testid="list-group">No grouping</MudMenuItem>
                    @foreach (var column in _available.Where(c => c.Groupable))
                    {
                        <MudMenuItem OnClick="() => GroupBy(column.Key)" Icon="@(_group?.Key == column.Key ? Icons.Material.Filled.Check : Icons.Material.Filled.Workspaces)">Group by @column.Title.ToLowerInvariant()</MudMenuItem>
                    }
                }
                @if (_canExport)
                {
                    <MudDivider />
                    <MudMenuItem OnClick="() => ExportAsync(ReportFileFormat.Xlsx)" Icon="@Icons.Material.Filled.GridOn" data-testid="list-export">Export to Excel</MudMenuItem>
                    <MudMenuItem OnClick="() => ExportAsync(ReportFileFormat.Csv)" Icon="@Icons.Material.Filled.Description">Export to CSV</MudMenuItem>
                }
            </MudMenu>
        </div>
    </MudStack>

    @if (FilterCount > 0 || _dirty)
    {
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2" data-testid="list-conditions">
            @foreach (var filter in _current.Filters ?? [])
            {
                <MudChip T="string" Size="Size.Small" OnClose="() => RemoveFilter(filter)" CloseIcon="@Icons.Material.Filled.Close">@Describe(filter)</MudChip>
            }
            @if (_dirty && _views is not null)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary ml-1">Changed from "@ViewName".</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="RevertAsync">Undo changes</MudButton>
            }
        </MudStack>
    }

    <MudDataGrid T="T" Items="_rows" Loading="Loading" Dense="true" Hover="true" SortMode="SortMode.None" Filterable="false"
                 Groupable="@(_group is not null)" GroupExpanded="true" RowClick="RowClicked" RowStyle="@(RowClick.HasDelegate ? "cursor:pointer" : null)"
                 TableAttributes="@(new Dictionary<string, object> { ["aria-label"] = AriaLabel ?? Definition.Title })" Elevation="Elevation" Outlined="Outlined"
                 Breakpoint="Breakpoint.Sm" HorizontalScrollbar="true">
        <Columns>
            @if (_group is { } group)
            {
                <TemplateColumn T="T" Title="@group.Title" Hidden="true" Grouping="true" GroupBy="@(row => ListViewEngine.GroupKey(group, row))" @key="@($"group:{group.Key}")">
                    <GroupTemplate>
                        <span style="font-weight:600">@group.Title: @context.Grouping.Key</span>
                        <span class="mud-text-secondary"> · @context.Grouping.Count()</span>
                    </GroupTemplate>
                </TemplateColumn>
            }
            @foreach (var column in _visible)
            {
                <TemplateColumn T="T" Title="@column.Title" @key="column.Key"
                                HeaderStyle="@(column.AlignRight ? "text-align:right" : null)" CellStyle="@(column.AlignRight ? "text-align:right" : null)">
                    <HeaderTemplate>
                        <button type="button" class="wb-sort-button" style="@SortButtonStyle(column)" @onclick="() => ToggleSort(column)"
                                aria-label="@SortLabel(column)" data-sort="@column.Key">
                            <span>@column.Title</span>
                            @if (SortOf(column) is { } sort)
                            {
                                <MudIcon Icon="@(sort.Descending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)" Size="Size.Small" aria-hidden="true" />
                            }
                        </button>
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (column.Cell is { } cell)
                        {
                            @cell(context.Item)
                        }
                        else
                        {
                            @ListViewEngine.Text(column, context.Item)
                        }
                    </CellTemplate>
                </TemplateColumn>
            }
        </Columns>
        <NoRecordsContent>
            @if (NoRecordsContent is not null)
            {
                @NoRecordsContent
            }
            else
            {
                <MudText>Nothing matches this view.</MudText>
            }
        </NoRecordsContent>
    </MudDataGrid>
    @if (Summary is not null)
    {
        @Summary(_rows)
    }
    <div class="wb-sr-only" role="status">@_rows.Count rows</div>
</div>

@code {
    [Parameter, EditorRequired]
    public ListDefinition<T> Definition { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<T>? Items { get; set; }

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public EventCallback<T> RowClick { get; set; }

    /// <summary>The page's own controls (status filters, toggles), shown in the toolbar.</summary>
    [Parameter]
    public RenderFragment? ToolBarContent { get; set; }

    [Parameter]
    public RenderFragment? NoRecordsContent { get; set; }

    /// <summary>Below the grid, given the rows the view shows (totals of what's on screen).</summary>
    [Parameter]
    public RenderFragment<IReadOnlyList<T>>? Summary { get; set; }

    [Parameter]
    public bool ShowSearch { get; set; } = true;

    [Parameter]
    public string SearchLabel { get; set; } = "Search";

    [Parameter]
    public string? SearchTestId { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public int Elevation { get; set; } = 1;

    [Parameter]
    public bool Outlined { get; set; }

    private IReadOnlyList<ListColumn<T>> _available = [];
    private IReadOnlyList<ListColumn<T>> _visible = [];
    private IReadOnlyList<T> _rows = [];
    private ListColumn<T>? _group;
    private ListViewDefinition _current = new([]);
    private SavedListViewDto? _selected;
    private ListViewsDto? _views;
    private IReadOnlyList<CustomizationRole> _roles = [];
    private string? _search;
    private bool _dirty;
    private bool _canExport;
    private bool _initialized;
    private ListDefinition<T>? _definitionFor;
    private readonly Dictionary<(Guid, string), object?> _custom = [];
    private IReadOnlyList<EntityFieldDto> _customFields = [];

    private IListViewService? Views => Services.GetService<IListViewService>();

    // "View" until a saved view or grouping is in use, so the toolbar says what's different.
    private string ViewButtonLabel => _selected is not null ? $"View: {_selected.Name}" : _group is not null ? $"View: by {_group.Title.ToLowerInvariant()}" : "View";

    private string ViewName => _selected?.Name ?? "Standard view";

    private int FilterCount => _current.Filters?.Count ?? 0;

    /// <summary>The rows as shown (search, filters, grouping and sort applied).</summary>
    public IReadOnlyList<T> Rows => _rows;

    /// <summary>The columns as shown.</summary>
    public IReadOnlyList<ListColumn<T>> VisibleColumns => _visible;

    protected override async Task OnParametersSetAsync()
    {
        if (!ReferenceEquals(_definitionFor, Definition))
        {
            var first = _definitionFor is null;
            _definitionFor = Definition;
            await LoadColumnsAsync();
            if (first)
            {
                await LoadViewsAsync();
            }
        }

        if (!_initialized)
        {
            _initialized = true;
            _current = ListViewEngine.Restrict(_available, _selected?.Definition ?? Definition.StandardView);
        }

        await RecomputeAsync();
    }

    private async Task LoadColumnsAsync()
    {
        var columns = Definition.Columns.ToList();
        var keys = columns.Select(c => c.PermissionKey).OfType<string>().ToList();
        if (Services.GetService<IEntityFieldCatalog>() is { } catalog)
        {
            try
            {
                _customFields = (await catalog.GetFieldsAsync(Definition.EntityType)).Where(f => f.IsCustom).ToList();
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                _customFields = [];
            }
        }

        keys.AddRange(_customFields.Select(f => f.PermissionKey).OfType<string>());
        IReadOnlySet<string> granted = new HashSet<string>();
        if (keys.Count > 0 && Services.GetService<ICustomizationAccess>() is { } access)
        {
            try
            {
                granted = await access.GrantedAsync(keys.Distinct());
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                granted = new HashSet<string>();
            }
        }

        // A column whose permission the viewer lacks isn't offered at all.
        columns.RemoveAll(c => c.PermissionKey is { } key && !granted.Contains(key));
        columns.AddRange(_customFields
            .Where(f => f.PermissionKey is null || granted.Contains(f.PermissionKey))
            .Select(f => new ListColumn<T>
            {
                Key = $"custom:{f.Key}",
                Title = f.Label,
                Value = row => CustomValue(row, f.Key),
                Kind = KindOf(f.FieldType),
                Standard = false,
                IsCustom = true,
            }));
        _available = columns;
    }

    private async Task LoadViewsAsync()
    {
        _canExport = Views is not null;
        if (Views is not { } views)
        {
            return;
        }

        try
        {
            _views = await views.ListAsync(Definition.ListKey);
            _selected = _views.Views.FirstOrDefault(v => v.Id == _views.DefaultViewId);
            if (Services.GetService<ICustomizationAccess>() is { } access && _views.CanShare)
            {
                _roles = await access.ListRolesAsync();
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _views = null; // Views can't be read: the standard view still works.
        }
    }

    private async Task RecomputeAsync()
    {
        _current = _current with { Search = _search };
        _visible = ListViewEngine.Visible(_available, _current);
        _group = _current.GroupBy is { } g ? _available.FirstOrDefault(c => c.Key == g) : null;
        await LoadCustomValuesAsync();
        _rows = ListViewEngine.Apply(Items ?? [], _available, _current);
    }

    private async Task LoadCustomValuesAsync()
    {
        var needed = _available.Where(c => c.IsCustom && (_visible.Contains(c) || _group == c || (_current.Filters ?? []).Any(f => f.Field == c.Key) || (_current.Sort ?? []).Any(s => s.Field == c.Key)))
            .Select(c => c.Key["custom:".Length..]).ToList();
        if (needed.Count == 0 || Items is null || Services.GetService<IEntityFieldCatalog>() is not { } catalog)
        {
            return;
        }

        foreach (var row in Items)
        {
            var id = Definition.Id(row);
            foreach (var key in needed.Where(k => !_custom.ContainsKey((id, k))))
            {
                try
                {
                    _custom[(id, key)] = await catalog.GetValueAsync(Definition.EntityType, id, key);
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    _custom[(id, key)] = null;
                }
            }
        }
    }

    private object? CustomValue(T row, string key) => _custom.GetValueOrDefault((Definition.Id(row), key)) switch
    {
        System.Text.Json.JsonElement e => e.ToString(),
        var v => v,
    };

    private static ListColumnKind KindOf(string fieldType) => FormFieldTypes.Of(fieldType) switch
    {
        "Number" => ListColumnKind.Number,
        "Money" => ListColumnKind.Money,
        "Date" => ListColumnKind.Date,
        "Bool" => ListColumnKind.Bool,
        _ => ListColumnKind.Text,
    };

    private async Task ChangeAsync(ListViewDefinition next)
    {
        _current = ListViewEngine.Restrict(_available, next);
        _dirty = true;
        await RecomputeAsync();
    }

    private async Task SearchChanged(string? value)
    {
        _search = value;
        await RecomputeAsync();
    }

    private async Task SelectAsync(SavedListViewDto? view)
    {
        _selected = view;
        _current = ListViewEngine.Restrict(_available, view?.Definition ?? Definition.StandardView);
        _dirty = false;
        await RecomputeAsync();
    }

    private Task RevertAsync() => SelectAsync(_selected);

    private ListSort? SortOf(ListColumn<T> column) => (_current.Sort ?? []).FirstOrDefault(s => s.Field == column.Key);

    private string SortLabel(ListColumn<T> column) => SortOf(column) switch
    {
        null => $"{column.Title}: sort ascending",
        { Descending: false } => $"{column.Title}, sorted ascending: sort descending",
        _ => $"{column.Title}, sorted descending: clear the sort",
    };

    private async Task ToggleSort(ListColumn<T> column)
    {
        var sort = SortOf(column);
        IReadOnlyList<ListSort> next = sort switch
        {
            null => [new ListSort(column.Key)],
            { Descending: false } => [new ListSort(column.Key, true)],
            _ => [],
        };
        await ChangeAsync(_current with { Sort = next });
    }

    private async Task GroupBy(string? key) => await ChangeAsync(_current with { GroupBy = key });

    private async Task RemoveFilter(ListFilterCondition filter) =>
        await ChangeAsync(_current with { Filters = (_current.Filters ?? []).Where(f => !ReferenceEquals(f, filter)).ToList() });

    private string Describe(ListFilterCondition filter)
    {
        var column = _available.FirstOrDefault(c => c.Key == filter.Field);
        var title = column?.Title ?? filter.Field;
        var value = column?.Kind == ListColumnKind.Bool ? (filter.Value == "true" ? "yes" : "no") : filter.Value;
        return ListViewEngine.NeedsValue(filter.Operator) ? $"{title} {ListViewEngine.Label(filter.Operator)} {value}" : $"{title} {ListViewEngine.Label(filter.Operator)}";
    }

    private async Task ColumnsAsync()
    {
        var parameters = new DialogParameters<ListColumnsDialog>
        {
            { d => d.Columns, _available.Select(c => (c.Key, c.Title, c.Standard)).ToList() },
            { d => d.Shown, _visible.Select(c => c.Key).ToList() },
        };
        var dialog = await DialogService.ShowAsync<ListColumnsDialog>("Columns", parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: List<string> keys })
        {
            await ChangeAsync(_current with { Columns = keys });
        }
    }

    private async Task FiltersAsync()
    {
        var parameters = new DialogParameters<ListFilterDialog>
        {
            { d => d.Columns, _available.Select(c => (c.Key, c.Title, c.Kind)).ToList() },
            { d => d.Filters, _current.Filters ?? [] },
        };
        var dialog = await DialogService.ShowAsync<ListFilterDialog>("Filter", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: List<ListFilterCondition> filters })
        {
            await ChangeAsync(_current with { Filters = filters });
        }
    }

    private ListViewDefinition ToSave() => _current with { Search = null };

    private async Task SaveAsync()
    {
        if (_selected is not { } view || Views is not { } views)
        {
            return;
        }

        await RunAsync(async () =>
        {
            _selected = await views.UpdateAsync(view.Id, new SaveListViewRequest(Definition.ListKey, view.Name, view.Visibility, view.RoleKey, ToSave()));
            await ReloadViewsAsync();
            _dirty = false;
            Snackbar.Add($"Saved \"{_selected.Name}\".", Severity.Success);
        });
    }

    private async Task SaveAsNewAsync()
    {
        if (Views is not { } views || await AskAsync(null) is not { } answer)
        {
            return;
        }

        await RunAsync(async () =>
        {
            _selected = await views.CreateAsync(new SaveListViewRequest(Definition.ListKey, answer.Name, answer.Visibility, answer.RoleKey, ToSave()));
            await ReloadViewsAsync();
            _dirty = false;
            Snackbar.Add($"Saved the view \"{_selected.Name}\".", Severity.Success);
        });
    }

    private async Task RenameAsync(SavedListViewDto view)
    {
        if (Views is not { } views || await AskAsync(view) is not { } answer)
        {
            return;
        }

        await RunAsync(async () =>
        {
            _selected = await views.UpdateAsync(view.Id, new SaveListViewRequest(Definition.ListKey, answer.Name, answer.Visibility, answer.RoleKey, _dirty ? ToSave() : view.Definition));
            await ReloadViewsAsync();
            _dirty = false;
        });
    }

    private async Task DeleteAsync(SavedListViewDto view)
    {
        if (Views is not { } views
            || await DialogService.ShowMessageBoxAsync("Delete view", $"Delete the view \"{view.Name}\"?", yesText: "Delete", cancelText: "Cancel") != true)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await views.DeleteAsync(view.Id);
            await ReloadViewsAsync();
            await SelectAsync(null);
        });
    }

    private async Task SetDefaultAsync()
    {
        if (Views is not { } views)
        {
            return;
        }

        await RunAsync(async () =>
        {
            await views.SetDefaultAsync(Definition.ListKey, new SetDefaultListViewRequest(_selected?.Id));
            await ReloadViewsAsync();
            Snackbar.Add($"\"{ViewName}\" opens first from now on.", Severity.Success);
        });
    }

    private async Task<SaveListViewDialog.Result?> AskAsync(SavedListViewDto? existing)
    {
        var parameters = new DialogParameters<SaveListViewDialog>
        {
            { d => d.Name, existing?.Name },
            { d => d.Visibility, existing?.Visibility ?? ListViewVisibility.Personal },
            { d => d.RoleKey, existing?.RoleKey },
            { d => d.CanShare, _views?.CanShare == true },
            { d => d.Roles, _roles },
        };
        var dialog = await DialogService.ShowAsync<SaveListViewDialog>(existing is null ? "Save view" : "Rename or share view", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        return await dialog.Result is { Canceled: false, Data: SaveListViewDialog.Result result } ? result : null;
    }

    private async Task ReloadViewsAsync()
    {
        if (Views is { } views)
        {
            _views = await views.ListAsync(Definition.ListKey);
        }
    }

    private async Task ExportAsync(ReportFileFormat format)
    {
        if (Views is not { } views)
        {
            return;
        }

        await RunAsync(async () =>
        {
            var columns = _group is { } g && !_visible.Contains(g) ? [g, .. _visible] : _visible;
            var file = await views.ExportAsync(ListViewEngine.Export(Definition.ListKey, $"{Definition.Title} - {ViewName}", _rows, columns, format));
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Workbench.Ui/reports.js");
            await module.InvokeVoidAsync("downloadBase64", file.FileName, file.ContentType, Convert.ToBase64String(file.Content));
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is HttpRequestException or UnauthorizedAccessException or ArgumentException or InvalidOperationException or JSException
                                   or Workbench.Contracts.WorkbenchNotFoundException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        await RecomputeAsync();
    }

    private static string SortButtonStyle(ListColumn<T> column) =>
        "background:none;border:0;padding:0;font:inherit;font-weight:inherit;color:inherit;cursor:pointer;display:inline-flex;align-items:center;gap:2px"
        + (column.AlignRight ? ";margin-left:auto" : "");

    private Task RowClicked(DataGridRowClickEventArgs<T> args) => RowClick.InvokeAsync(args.Item);

    private string ShareLabel(SavedListViewDto view) => view.Visibility switch
    {
        ListViewVisibility.Everyone => "everyone",
        ListViewVisibility.Role => CustomizationRoles.NameOf(view.RoleKey),
        _ => "mine",
    };
}
