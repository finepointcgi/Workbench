@implements IDisposable
@*
    Something on a ConfigurableForm that isn't a field (helper buttons, a warning, a deliberate gap). It stays right after
    the field named by After wherever the layout moves that field, and at the end of the form when that field is hidden.
*@

@code {
    [CascadingParameter]
    private ConfigurableForm? Form { get; set; }

    /// <summary>The field this follows.</summary>
    [Parameter, EditorRequired]
    public string After { get; set; } = "";

    [Parameter]
    public int Xs { get; set; } = 12;

    [Parameter]
    public int Sm { get; set; }

    [Parameter]
    public int Md { get; set; }

    [Parameter]
    public int Lg { get; set; }

    [Parameter]
    public string? ItemClass { get; set; }

    [Parameter]
    public bool When { get; set; } = true;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool? _lastWhen;

    protected override void OnInitialized() => Form?.Register(this);

    protected override void OnParametersSet()
    {
        if (_lastWhen is { } last && last != When)
        {
            Form?.Refresh();
        }

        _lastWhen = When;
    }

    public void Dispose() => Form?.Unregister(this);
}
