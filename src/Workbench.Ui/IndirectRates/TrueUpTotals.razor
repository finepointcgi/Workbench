<MudPaper Outlined="true" Style="overflow-x:auto">
    <MudSimpleTable Dense="true">
        <thead><tr><th>Code</th><th>Name</th><th style="text-align:right">Direct cost</th><th style="text-align:right">At provisional</th><th style="text-align:right">At actual</th><th style="text-align:right">Difference</th></tr></thead>
        <tbody>
            @if (Rows.Count == 0)
            {
                <tr><td colspan="6" class="mud-text-secondary">No direct cost in the year.</td></tr>
            }
            @foreach (var t in Rows)
            {
                <tr>
                    <td>@t.Code</td>
                    <td>@t.Name</td>
                    <td style="text-align:right">@AccountingFormat.Amount(t.DirectCost)</td>
                    <td style="text-align:right">@AccountingFormat.Amount(t.ProvisionalBurden)</td>
                    <td style="text-align:right">@AccountingFormat.Amount(t.ActualBurden)</td>
                    <td style="text-align:right"><b>@AccountingFormat.Amount(t.Difference)</b></td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TrueUpTotalDto> Rows { get; set; } = [];
}
