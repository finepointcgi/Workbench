@* Nonconformance reports and the vendor debit memos returns create. *@
@inject INonconformanceService Ncrs
@inject IInspectionService Inspections
@inject IInventoryService Inventory
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap" Class="mb-3" AlignItems="AlignItems.Center">
    <MudSwitch T="bool" Value="_openOnly" ValueChanged="v => { _openOnly = v; return LoadAsync(); }" Label="Open only" Color="Color.Primary" />
    <MudSpacer />
    @if (MaterialsFormat.CanEdit(User))
    {
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ReportProblem" OnClick="NewAsync" data-testid="new-ncr">Report nonconforming stock</MudButton>
    }
</MudStack>

@if (_error is not null)
{
    <MaterialsError Message="@_error" Forbidden="_forbidden" />
}
else
{
    @if (_rows.Count == 0)
    {
        <MudText Class="mud-text-secondary mb-4">No NCRs.</MudText>
    }
    else
    {
        <div style="overflow-x:auto" class="mb-6">
            <MudSimpleTable Dense="true" Hover="true" Elevation="0" data-testid="ncrs">
                <caption class="wb-sr-only">Nonconformance reports</caption>
                <thead>
                    <tr><th scope="col">NCR</th><th scope="col">Part</th><th scope="col">Lot / serial</th><th scope="col" style="text-align:right">Quantity</th><th scope="col">Defects</th>
                        <th scope="col">Source</th><th scope="col">Vendor</th><th scope="col">Disposition</th><th scope="col">Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var n in _rows)
                    {
                        <tr>
                            <td><MudLink Href="@($"materials/quality/ncrs/{n.Id}")">@n.Number</MudLink></td>
                            <td>@n.PartNumber <span class="mud-text-secondary">@n.PartDescription</span></td>
                            <td>@string.Join(" ", new[] { n.Lot, n.Serial }.Where(x => x.Length > 0))</td>
                            <td style="text-align:right">@MaterialsFormat.Qty(n.Quantity) @n.UnitOfMeasure</td>
                            <td>@string.Join(", ", n.DefectCodes)</td>
                            <td>@QualityFormat.Label(n.Source)</td>
                            <td>@n.Vendor</td>
                            <td>@(n.Disposition is { } d ? QualityFormat.Label(d) : "")</td>
                            <td><MudChip T="string" Size="Size.Small" Color="QualityFormat.Color(n.Status)" Class="my-0">@QualityFormat.Label(n.Status)</MudChip></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    }

    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Vendor debit memos</MudText>
    @if (_memos.Count == 0)
    {
        <MudText Class="mud-text-secondary">No debit memos. Returning material to a vendor writes one.</MudText>
    }
    else
    {
        <div style="overflow-x:auto">
            <MudSimpleTable Dense="true" Elevation="0" data-testid="debit-memos">
                <caption class="wb-sr-only">Vendor debit memos</caption>
                <thead><tr><th scope="col">Memo</th><th scope="col">Vendor</th><th scope="col">NCR</th><th scope="col">Part</th><th scope="col" style="text-align:right">Quantity</th>
                    <th scope="col" style="text-align:right">Amount</th><th scope="col">RMA</th><th scope="col">Status</th><th scope="col"><span class="wb-sr-only">Actions</span></th></tr></thead>
                <tbody>
                    @foreach (var m in _memos)
                    {
                        <tr>
                            <td>@m.Number</td><td>@m.Vendor</td>
                            <td><MudLink Href="@($"materials/quality/ncrs/{m.NonconformanceId}")">@m.NonconformanceNumber</MudLink></td>
                            <td>@m.PartNumber</td>
                            <td style="text-align:right">@MaterialsFormat.Qty(m.Quantity)</td>
                            <td style="text-align:right">@MaterialsFormat.Amount(m.Amount)</td>
                            <td>@m.ReturnAuthorization</td>
                            <td>@(m.Status == DebitMemoState.Applied ? $"Applied ({m.AppliedReference})" : m.Status.ToString())</td>
                            <td>
                                @if (m.Status == DebitMemoState.Open && CanApply)
                                {
                                    <MudButton Size="Size.Small" OnClick="() => ApplyAsync(m)" aria-label="@($"Mark {m.Number} applied")">Mark applied</MudButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    }
}

@code {
    [CascadingParameter] public CurrentUserInfo? User { get; set; }

    private IReadOnlyList<NcrSummaryDto> _rows = [];
    private IReadOnlyList<DebitMemoDto> _memos = [];
    private bool _openOnly = true;
    private string? _error;
    private bool _forbidden;

    private bool CanApply => User is null || User.Can(Workbench.Contracts.Identity.Permission.QualityDispositions);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _rows = await Ncrs.ListAsync(new NcrQuery(OpenOnly: _openOnly));
            _memos = await Ncrs.ListDebitMemosAsync();
            _error = null;
        }
        catch (Exception ex) when (MaterialsFormat.IsExpected(ex))
        {
            (_error, _forbidden) = (MaterialsFormat.Error(ex), MaterialsFormat.IsForbidden(ex));
        }
    }

    private async Task NewAsync()
    {
        try
        {
            var stock = (await Inventory.ListBalancesAsync(new BalanceQuery())).Where(b => b.Status == StockStatus.Available).ToList();
            var codes = await Inspections.ListDefectCodesAsync();
            var dialog = await DialogService.ShowAsync<NewNcrDialog>("Report nonconforming stock",
                new DialogParameters<NewNcrDialog> { { d => d.Stock, stock }, { d => d.DefectCodes, codes } }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
            if (await dialog.Result is { Canceled: false, Data: CreateNcrRequest request })
            {
                var ncr = await Ncrs.CreateAsync(request);
                Navigation.NavigateTo($"materials/quality/ncrs/{ncr.Summary.Id}");
            }
        }
        catch (Exception ex) when (MaterialsFormat.IsExpected(ex))
        {
            Snackbar.Add(MaterialsFormat.Error(ex), Severity.Error);
        }
    }

    private async Task ApplyAsync(DebitMemoDto memo)
    {
        var reference = await QualityPromptDialog.AskAsync(DialogService, $"Mark {memo.Number} applied", "Bill or payment it was taken against", "Mark applied", required: true,
            $"{memo.Vendor} owes {MaterialsFormat.Amount(memo.Amount)} for the returned {memo.PartNumber}.");
        if (reference is null)
        {
            return;
        }

        try
        {
            await Ncrs.ApplyDebitMemoAsync(memo.Id, new ApplyDebitMemoRequest(reference));
            Snackbar.Add($"{memo.Number} marked applied.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) when (MaterialsFormat.IsExpected(ex))
        {
            Snackbar.Add(MaterialsFormat.Error(ex), Severity.Error);
        }
    }
}
