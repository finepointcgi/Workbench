@* Rejects per vendor: what was inspected, how much failed, NCRs, returns and open corrective actions. *@
@inject ICorrectiveActionService Cars

<MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap" Class="mb-3" AlignItems="AlignItems.Center">
    <MudDatePicker Date="_from" DateChanged="d => { _from = d; return LoadAsync(); }" Label="From" DateFormat="yyyy-MM-dd" Editable="true" AutoClose="true" Style="max-width:170px" />
    <MudDatePicker Date="_to" DateChanged="d => { _to = d; return LoadAsync(); }" Label="To" DateFormat="yyyy-MM-dd" Editable="true" AutoClose="true" Style="max-width:170px" />
</MudStack>

@if (_error is not null)
{
    <MaterialsError Message="@_error" Forbidden="_forbidden" />
}
else if (_report is { } r)
{
    @if (r.Rows.Count == 0)
    {
        <MudText Class="mud-text-secondary">No receiving inspections or supplier NCRs between @MaterialsFormat.Date(r.From) and @MaterialsFormat.Date(r.To).</MudText>
    }
    else
    {
        <div style="overflow-x:auto">
            <MudSimpleTable Dense="true" Elevation="0" data-testid="supplier-quality">
                <caption class="wb-sr-only">Supplier quality from @MaterialsFormat.Date(r.From) to @MaterialsFormat.Date(r.To)</caption>
                <thead><tr><th scope="col">Vendor</th><th scope="col" style="text-align:right">Inspections</th><th scope="col" style="text-align:right">Inspected</th>
                    <th scope="col" style="text-align:right">Accepted</th><th scope="col" style="text-align:right">Rejected</th><th scope="col" style="text-align:right">Reject rate</th>
                    <th scope="col" style="text-align:right">NCRs (open)</th><th scope="col" style="text-align:right">Returned</th><th scope="col" style="text-align:right">Open CARs</th></tr></thead>
                <tbody>
                    @foreach (var v in r.Rows)
                    {
                        <tr>
                            <td>@v.VendorCode <span class="mud-text-secondary">@v.Vendor</span></td>
                            <td style="text-align:right">@v.Inspections</td>
                            <td style="text-align:right">@MaterialsFormat.Qty(v.QuantityInspected)</td>
                            <td style="text-align:right">@MaterialsFormat.Qty(v.QuantityAccepted)</td>
                            <td style="text-align:right">@MaterialsFormat.Qty(v.QuantityRejected)</td>
                            <td style="text-align:right">
                                @v.RejectRatePercent.ToString("0.0", CultureInfo.InvariantCulture)%
                                @if (v.RejectRatePercent >= 5) { <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" aria-label="High reject rate" /> }
                            </td>
                            <td style="text-align:right">@v.Ncrs (@v.OpenNcrs)</td>
                            <td style="text-align:right">@MaterialsFormat.Amount(v.ReturnedValue)</td>
                            <td style="text-align:right">@v.OpenCorrectiveActions</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    }
}

@code {
    private SupplierQualityDto? _report;
    private DateTime? _from = DateTime.Today.AddMonths(-12).AddDays(1);
    private DateTime? _to = DateTime.Today;
    private string? _error;
    private bool _forbidden;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _report = await Cars.SupplierQualityAsync(PurchasingFormat.ToDateOnly(_from), PurchasingFormat.ToDateOnly(_to));
            _error = null;
        }
        catch (Exception ex) when (MaterialsFormat.IsExpected(ex))
        {
            (_error, _forbidden) = (MaterialsFormat.Error(ex), MaterialsFormat.IsForbidden(ex));
        }
    }
}
