<MudDialog>
    <DialogContent>
        <MudText Class="mud-text-secondary mb-3">Saves today's start and finish of every task so you can compare against them later.</MudText>
        <MudTextField @bind-Value="_name" Label="Name" AutoFocus="true" Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="string.IsNullOrWhiteSpace(_name)" OnClick="Submit">Capture</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _name = $"Baseline {DateTime.Now:yyyy-MM-dd}";

    private void Cancel() => MudDialog.Cancel();

    private void Submit() => MudDialog.Close(DialogResult.Ok(_name.Trim()));
}
