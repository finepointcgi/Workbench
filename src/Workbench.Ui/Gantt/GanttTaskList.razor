@using System.Globalization
@inject NavigationManager Navigation

<div class="@ListClass" role="table" aria-label="Tasks">
    <div class="gantt-task-header" role="row" style="height:@(Px(GanttLayout.HeaderHeight))">
        <span class="gantt-col-name" role="columnheader">Task</span>
        @if (ShowConstraints)
        {
            <span class="gantt-col-constraint" role="columnheader"><span class="wb-sr-only">Date constraint</span></span>
        }
        <span class="gantt-col-date" role="columnheader">Start</span>
        <span class="gantt-col-date" role="columnheader">Finish</span>
        @if (Comparison is not null)
        {
            <span class="gantt-col-date" role="columnheader" title="Baseline start">BL start</span>
            <span class="gantt-col-date" role="columnheader" title="Baseline finish">BL finish</span>
            <span class="gantt-col-variance" role="columnheader" title="Finish variance in working days: + is later than the baseline">Var.</span>
        }
        @if (Assignees is not null)
        {
            <span class="gantt-col-assignee" role="columnheader">Assigned</span>
        }
    </div>
    @foreach (var row in Rows)
    {
        <div class="@(row.IsSummary ? "gantt-task-row summary" : "gantt-task-row")" role="row" style="height:@(Px(GanttLayout.RowHeight))">
            <span class="gantt-col-name" role="cell" style="padding-left:@(Px(4 + row.Depth * 18))">
                @if (row.IsSummary)
                {
                    var collapsed = Collapsed.Contains(row.Item.Id);
                    <button type="button" class="gantt-toggle" @onclick="() => OnToggle.InvokeAsync(row.Item.Id)"
                            aria-label="@(collapsed ? "Expand" : "Collapse") @row.Item.Title" aria-expanded="@(!collapsed)">
                        <MudIcon Icon="@(collapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                    </button>
                }
                else
                {
                    <span class="gantt-toggle-spacer"></span>
                }
                @if (row.IsMilestone)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Diamond" Size="Size.Small" Class="gantt-milestone-icon" aria-hidden="true" />
                    <span class="wb-sr-only">Milestone:</span>
                }
                <a href="@Workbench.Ui.Views.ItemLinks.Details(Navigation, row.Item.Id)" class="@(Critical.Contains(row.Item.Id) ? "gantt-task-link critical" : "gantt-task-link")"
                   title="@row.Item.Title">@row.Item.Title</a>
                @if (Critical.Contains(row.Item.Id))
                {
                    <span class="wb-sr-only">(critical path)</span>
                }
            </span>
            @if (ShowConstraints)
            {
                var constraint = Constraints?.GetValueOrDefault(row.Item.Id);
                var conflict = Conflicts?.GetValueOrDefault(row.Item.Id);
                <span class="gantt-col-constraint" role="cell">
                    @if (!row.IsSummary && (CanConstrain || constraint is not null))
                    {
                        var label = constraint is null ? $"Set a date constraint on {row.Item.Title}" : $"{row.Item.Title}: {constraint.Label} {Format(constraint.Date)}{(conflict is null ? "" : " (conflict)")}";
                        <button type="button" class="@ConstraintClass(constraint, conflict)" title="@(conflict?.Message ?? label)" aria-label="@label"
                                disabled="@(!CanConstrain)" @onclick="() => OnConstrain.InvokeAsync(row)" data-testid="gantt-constraint">
                            <MudIcon Icon="@(conflict is not null ? Icons.Material.Filled.Warning : constraint is not null ? Icons.Material.Filled.PushPin : Icons.Material.Outlined.PushPin)" Size="Size.Small" />
                        </button>
                    }
                </span>
            }
            <span class="gantt-col-date" role="cell">@Format(row.Start)</span>
            <span class="gantt-col-date" role="cell">@Format(row.Finish)</span>
            @if (Comparison is not null)
            {
                var variance = Comparison.For(row.Item.Id);
                <span class="gantt-col-date" role="cell">@Format(variance?.BaselineStart)</span>
                <span class="gantt-col-date" role="cell">@Format(variance?.BaselineFinish)</span>
                <span class="@VarianceClass(variance?.FinishVarianceDays)" role="cell">@Variance(variance?.FinishVarianceDays)</span>
            }
            @if (Assignees is not null)
            {
                var people = Assignees(row.Item.Id);
                var text = people.Count == 0 ? (CanAssign ? "+" : "—") : string.Join(" ", people.Select(Workbench.Ui.Tasks.TaskView.Initials));
                <span class="gantt-col-assignee" role="cell" title="@Workbench.Ui.Tasks.TaskView.Names(people)">
                    @if (CanAssign)
                    {
                        <button type="button" class="gantt-assign" @onclick="() => OnAssign.InvokeAsync(row.Item)" data-testid="gantt-assign"
                                aria-label="@($"Assign {row.Item.Title} (now: {Workbench.Ui.Tasks.TaskView.Names(people)})")">@text</button>
                    }
                    else
                    {
                        <span aria-label="@Workbench.Ui.Tasks.TaskView.Names(people)">@text</span>
                    }
                </span>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<GanttRow> Rows { get; set; } = [];

    [Parameter, EditorRequired]
    public Guid SheetId { get; set; }

    [Parameter]
    public IReadOnlySet<Guid> Collapsed { get; set; } = new HashSet<Guid>();

    [Parameter]
    public IReadOnlySet<Guid> Critical { get; set; } = new HashSet<Guid>();

    [Parameter]
    public EventCallback<Guid> OnToggle { get; set; }

    /// <summary>The assignees of an item; null hides the Assigned column (no task assignment on this page).</summary>
    [Parameter]
    public Func<Guid, IReadOnlyList<Workbench.Contracts.Tasks.TaskAssigneeDto>>? Assignees { get; set; }

    [Parameter]
    public bool CanAssign { get; set; }

    [Parameter]
    public EventCallback<ItemDto> OnAssign { get; set; }

    /// <summary>The plan's baseline comparison: adds baseline start, finish and finish variance columns. Null hides them.</summary>
    [Parameter]
    public Workbench.Contracts.Scheduling.BaselineComparison? Comparison { get; set; }

    /// <summary>Date constraints by item id; non-null shows the constraint column.</summary>
    [Parameter]
    public IReadOnlyDictionary<Guid, Workbench.Contracts.Scheduling.PlanConstraintDto>? Constraints { get; set; }

    [Parameter]
    public IReadOnlyDictionary<Guid, Workbench.Contracts.Scheduling.PlanConflictDto>? Conflicts { get; set; }

    [Parameter]
    public bool CanConstrain { get; set; }

    [Parameter]
    public EventCallback<GanttRow> OnConstrain { get; set; }

    private bool ShowConstraints => Constraints is not null;

    private string ListClass =>
        "gantt-task-list" + (Assignees is null ? "" : " with-assignees") + (Comparison is null ? "" : " with-baseline") + (ShowConstraints ? " with-constraints" : "");

    private static string ConstraintClass(Workbench.Contracts.Scheduling.PlanConstraintDto? constraint, Workbench.Contracts.Scheduling.PlanConflictDto? conflict) =>
        conflict is not null ? "gantt-constraint conflict" : constraint is not null ? "gantt-constraint set" : "gantt-constraint";

    private static string Variance(int? days) => days switch
    {
        null => "—",
        0 => "0d",
        > 0 => $"+{days}d",
        _ => $"{days}d",
    };

    private static string VarianceClass(int? days) => days > 0 ? "gantt-col-variance late" : "gantt-col-variance";

    private static string Px(double value) => value.ToString("0.##", CultureInfo.InvariantCulture) + "px";

    private static string Format(DateOnly date) => date.ToString("MMM d", CultureInfo.InvariantCulture);

    private static string Format(DateOnly? date) => date?.ToString("MMM d", CultureInfo.InvariantCulture) ?? "—";
}
