@using Workbench.Contracts.Collaboration
@inject NavigationManager Navigation
@inject IDialogService DialogService

@* Opens when the sheet page URL has ?item={id}. Views open it by navigating to sheets/{sheetId}?item={itemId}. *@
<MudDrawer Open="@(_item is not null)" OpenChanged="OnOpenChanged" Anchor="Anchor.End" Variant="@DrawerVariant.Temporary"
           Width="min(520px, 100vw)" Elevation="4" Class="item-details-drawer" aria-label="Item details">
    @if (_item is { } item)
    {
        <div class="pa-4" style="height:100%; overflow-y:auto">
            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="1">
                <MudText Typo="Typo.h6" HtmlTag="h2" Style="flex:1; overflow-wrap:anywhere">@item.Title</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Close" aria-label="Close details" />
            </MudStack>
            @if (Parent(item) is { } parent)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">In @parent.Title</MudText>
            }

            @if (Tasks is { } tasks)
            {
                @* Task assignment: who it's assigned to; Editors assign; assignees (any role) update status and % complete. *@
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3" Wrap="Wrap.Wrap" data-testid="drawer-assignees">
                    <MudText Typo="Typo.subtitle2" HtmlTag="h3">Assigned to</MudText>
                    <AssigneeChips Assignees="tasks.For(item.Id)" ShowNames="true" Max="5" Empty="Nobody" />
                    @if (tasks.CanAssign)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="() => AssignAsync(item)"
                                   data-testid="drawer-assign">@(tasks.For(item.Id).Count == 0 ? "Assign" : "Change")</MudButton>
                    }
                </MudStack>
                @if (tasks.CanAssign || TaskView.IsMine(tasks, Sheet, item))
                {
                    <div class="mt-2"><TaskStatusEditor Item="item" Changed="Changed" /></div>
                }
            }

            <MudSimpleTable Dense="true" Elevation="0" Class="mt-3 mb-4 item-details-fields">
                <caption class="wb-sr-only">Fields</caption>
                <tbody>
                    @if (item.Start is not null || item.Finish is not null || Sheet.Summary.SchedulingEnabled)
                    {
                        <tr><th scope="row">Start</th><td>@(item.Start?.ToString("MMM d, yyyy") ?? "—")</td></tr>
                        <tr><th scope="row">Finish</th><td>@(item.Finish?.ToString("MMM d, yyyy") ?? "—")</td></tr>
                    }
                    @if (item.IsMilestone)
                    {
                        <tr><th scope="row">Milestone</th><td data-testid="details-milestone">◆ Yes, a key date</td></tr>
                    }
                    @foreach (var column in Sheet.Columns)
                    {
                        <tr><th scope="row">@column.Name</th><td style="overflow-wrap:anywhere">@Display(item, column)</td></tr>
                    }
                    @if (item.CostpointWbsId is { } wbs)
                    {
                        <tr><th scope="row">WBS</th><td>@wbs</td></tr>
                    }
                </tbody>
            </MudSimpleTable>

            @if (Sheet.Summary.SchedulingEnabled)
            {
                <Workbench.Ui.Gantt.ItemDependencies SheetId="Sheet.Summary.Id" Item="item" Items="Items" Version="Version" />
            }

            <MudTabs Elevation="0" Rounded="true" TabPanelsClass="pt-3" KeepPanelsAlive="false">
                <MudTabPanel Text="Comments" Icon="@Icons.Material.Outlined.ChatBubbleOutline">
                    <CommentThread SheetId="Sheet.Summary.Id" ItemId="item.Id" People="_people" Version="Version" />
                </MudTabPanel>
                <MudTabPanel Text="Files" Icon="@Icons.Material.Outlined.AttachFile">
                    <AttachmentList SheetId="Sheet.Summary.Id" ItemId="item.Id" Version="Version" />
                </MudTabPanel>
                <MudTabPanel Text="Activity" Icon="@Icons.Material.Outlined.History">
                    <ActivityFeed SheetId="Sheet.Summary.Id" ItemId="item.Id" Items="Items" Version="Version" Limit="50" />
                </MudTabPanel>
            </MudTabs>
        </div>
    }
</MudDrawer>

@code {
    [Parameter, EditorRequired]
    public SheetDetail Sheet { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<ItemDto> Items { get; set; } = [];

    /// <summary>Task assignment for this sheet, from the sheet page (null: not shown).</summary>
    [CascadingParameter]
    public SheetTasksDto? Tasks { get; set; }

    /// <summary>Reloads the sheet after an assignment or status change made here.</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    /// <summary>Bumped by the sheet page after a live reload so the open panel refreshes.</summary>
    [Parameter]
    public int Version { get; set; }

    // Bound as a string: a Guid? query parameter throws on a malformed value and crashes the page.
    [SupplyParameterFromQuery(Name = "item")]
    public string? ItemQuery { get; set; }

    private ItemDto? _item;
    private IReadOnlyList<string> _people = [];

    protected override void OnParametersSet()
    {
        _item = Guid.TryParse(ItemQuery, out var id) ? Items.FirstOrDefault(i => i.Id == id) : null;
        _people = CollaborationFormat.People(Sheet, Items);
    }

    private async Task AssignAsync(ItemDto item)
    {
        if (await TaskView.AssignAsync(DialogService, Sheet.Summary.Id, item, Tasks?.For(item.Id) ?? []))
        {
            await Changed.InvokeAsync();
        }
    }

    private ItemDto? Parent(ItemDto item) => item.ParentId is { } p ? Items.FirstOrDefault(i => i.Id == p) : null;

    private static string Display(ItemDto item, ColumnDto column)
    {
        var value = item.Values.GetValueOrDefault(column.Id.ToString());
        if (string.IsNullOrEmpty(value))
        {
            return "—";
        }

        return column.Type switch
        {
            ColumnKind.Checkbox => value == "true" ? "Yes" : "No",
            ColumnKind.Currency when decimal.TryParse(value, System.Globalization.CultureInfo.InvariantCulture, out var amount) => amount.ToString("C"),
            ColumnKind.Date when DateOnly.TryParseExact(value, "yyyy-MM-dd", out var date) => date.ToString("MMM d, yyyy"),
            _ => value,
        };
    }

    private Task OnOpenChanged(bool open)
    {
        if (!open)
        {
            Close();
        }

        return Task.CompletedTask;
    }

    private void Close() => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("item", (string?)null));
}
