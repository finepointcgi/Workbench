@using Workbench.Contracts.Collaboration
@implements IAsyncDisposable
@inject ISheetLiveUpdates LiveUpdates

@* Renders nothing. Subscribes to the sheet's live changes and raises Changed once things settle (debounced). *@

@code {
    [Parameter, EditorRequired]
    public Guid SheetId { get; set; }

    [Parameter]
    public EventCallback Changed { get; set; }

    [Parameter]
    public TimeSpan Debounce { get; set; } = TimeSpan.FromMilliseconds(300);

    private IAsyncDisposable? _subscription;
    private Guid _subscribedTo;
    private Timer? _timer;
    private bool _disposed;

    // Subscribe after the first interactive render so prerendering doesn't leave a subscription behind.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_subscribedTo == SheetId || _disposed)
        {
            return;
        }

        await UnsubscribeAsync();
        _subscribedTo = SheetId;
        try
        {
            _subscription = await LiveUpdates.SubscribeAsync(SheetId, OnChangeAsync);
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or IOException)
        {
            // Live updates are a convenience; the page still works with manual reloads.
        }
    }

    private Task OnChangeAsync(SheetChange change)
    {
        if (change.SheetId == SheetId && !_disposed)
        {
            _timer ??= new Timer(_ => _ = InvokeAsync(RaiseAsync));
            _timer.Change(Debounce, Timeout.InfiniteTimeSpan);
        }

        return Task.CompletedTask;
    }

    private async Task RaiseAsync()
    {
        if (!_disposed)
        {
            await Changed.InvokeAsync();
        }
    }

    private async Task UnsubscribeAsync()
    {
        if (_subscription is not null)
        {
            await _subscription.DisposeAsync();
            _subscription = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_timer is not null)
        {
            await _timer.DisposeAsync();
        }

        await UnsubscribeAsync();
    }
}
