@* The Fixed assets menu, for Finance and administrators. *@
@inject ICurrentUserContext UserContext

@if (_finance)
{
    <MudNavGroup Title="Fixed assets" Icon="@Icons.Material.Filled.Inventory2" data-testid="assets-nav">
        <MudNavLink Href="assets" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ListAlt">Asset register</MudNavLink>
        <MudNavLink Href="assets/capitalize" Icon="@Icons.Material.Filled.AddBox">Capitalize</MudNavLink>
        <MudNavLink Href="assets/depreciation" Icon="@Icons.Material.Filled.TrendingDown">Depreciation</MudNavLink>
        <MudNavLink Href="assets/reports" Icon="@Icons.Material.Filled.Assessment">Asset reports</MudNavLink>
    </MudNavGroup>
}

@code {
    private bool _finance;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _finance = (await UserContext.GetAsync()).IsFinance;
        }
        catch (Exception ex) when (PurchasingFormat.IsExpected(ex))
        {
            _finance = false;
        }
    }
}
