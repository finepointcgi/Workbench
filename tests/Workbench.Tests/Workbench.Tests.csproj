<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.11.3" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- The official MCP C# client (MIT), test only: proves real MCP clients such as Hearth can use /api/v1/mcp. -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.3.1" />
    <!-- Azure.Extensions.AspNetCore.DataProtection.Keys pulls 10.0.10 (GHSA-7hqp-7c5m-4vq6); the web SDK prunes it, this project does not. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sample hotel folios and receipts for the receipt reading tests. -->
    <None Include="Receipts\Samples\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- MS Project XML files for the import and export tests. -->
    <None Include="Scheduling\Samples\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Recorded ADP, Paychex and Gusto API responses for the payroll adapter tests. -->
    <!-- Golden files for the accounting export layouts. -->
    <None Include="AccountingExport\Golden\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Integrations\GitLab\Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- A WB2 key issued by the license server's own signer, for the cross-check test. -->
    <None Include="Licensing\Samples\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The private module repository's tests reuse this project's kits (TestDb, fixtures, the web factory): see docs/operations/module-extraction-govcon.md. -->
    <InternalsVisibleTo Include="Workbench.Module.GovCon.Tests" />
    <InternalsVisibleTo Include="Workbench.Module.Capture.Tests" />
    <InternalsVisibleTo Include="Workbench.Module.Materials.Tests" />
    <InternalsVisibleTo Include="Workbench.Module.ProjectControls.Tests" />
    <InternalsVisibleTo Include="Workbench.Module.Workforce.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Workbench.Application\Workbench.Application.csproj" />
    <ProjectReference Include="..\..\src\Workbench.Infrastructure\Workbench.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Workbench.Ui\Workbench.Ui.csproj" />
    <ProjectReference Include="..\..\src\Workbench.Web\Workbench.Web.csproj" />
    <ProjectReference Include="..\..\src\Workbench.ApiClient\Workbench.ApiClient.csproj" />
    <ProjectReference Include="..\..\src\Workbench.Migrations.PostgreSql\Workbench.Migrations.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Workbench.Migrations.Sqlite\Workbench.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Workbench.Modules.Abstractions\Workbench.Modules.Abstractions.csproj" />
    <!-- The sample license module stays out of the host's references: the module loader tests load it from a folder, like a real plugin. -->
    <ProjectReference Include="..\Workbench.SampleModule\Workbench.SampleModule.csproj" ReferenceOutputAssembly="false" OutputItemType="SampleModuleOutput" />
  </ItemGroup>

  <Target Name="CopySampleModule" AfterTargets="CopyFilesToOutputDirectory">
    <Copy SourceFiles="@(SampleModuleOutput)" DestinationFolder="$(OutDir)modules-sample" />
  </Target>

</Project>