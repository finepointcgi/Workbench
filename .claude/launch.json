{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "workbench-web",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Workbench.Web", "--launch-profile", "http"],
      "port": 5104
    },
    {
      "name": "workbench-docs",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ASPNETCORE_ENVIRONMENT=Development",
        "ASPNETCORE_URLS=http://localhost:5210",
        "ConnectionStrings__Workbench=Data Source=/Users/finepointcgi/CostpointSmartsheets/tools/docs-screenshots/docs.db",
        "Email__PickupFolder=/Users/finepointcgi/CostpointSmartsheets/tools/docs-screenshots/mail",
        "dotnet", "run", "--project", "src/Workbench.Web", "--no-launch-profile"
      ],
      "port": 5210
    },
    {
      "name": "workbench-multitenant-postgres",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ASPNETCORE_ENVIRONMENT=Development",
        "ASPNETCORE_URLS=http://localhost:5251",
        "Tenancy__Mode=MultiTenant",
        "Database__Provider=PostgreSQL",
        "ConnectionStrings__Catalog=Host=localhost;Database=workbench_catalog;Username=workbench;Password=workbench",
        "Tenancy__TenantConnectionString=Host=localhost;Database=workbench_{tenant};Username=workbench;Password=workbench",
        "dotnet", "run", "--project", "src/Workbench.Web", "--no-launch-profile"
      ],
      "port": 5251
    }
  ]
}
